{
  "manifest_version": 3,
  "name": "光镜 · 单图采集开发版",
  "version": "0.1.0",
  "description": "用户主动右键采集原图，通过本机桥接入库并读取真实回执。",
  "key": "",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "光镜采集待处理",
    "default_popup": "capture.html"
  }
}
