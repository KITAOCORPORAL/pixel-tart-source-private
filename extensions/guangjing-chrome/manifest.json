{
  "manifest_version": 3,
  "name": "光镜 · 页面采集开发版",
  "version": "0.2.0",
  "description": "主动扫描当前页，筛选勾选原图，经本机真实回执逐张入库。",
  "key": "",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging",
    "sidePanel"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开光镜页面采集侧栏"
  },
  "minimum_chrome_version": "116",
  "side_panel": {
    "default_path": "sidebar.html"
  }
}
