+ {public RawDecoderCapability GetCapability()=>new(true,"Supplied","test",[".raf"],[".raf"]);public Task<RawDecodedImage> DecodeAsync(string p,RawToJpegOptions o,CancellationToken token=default)=>Task.FromResult(decoded);}
