<view class="page" style="padding-bottom:130rpx">
  <view wx:if="{{confirmed}}" class="muted">选片结果已提交，照片仍可查看。</view><view wx:elif="{{syncing}}" class="muted">正在同步</view>
  <view class="photo-grid">
    <view class="photo-card" wx:for="{{assets}}" wx:key="selectionAssetId">
      <image src="{{item.thumbUrl}}" mode="aspectFill" data-id="{{item.selectionAssetId}}" bindtap="openPhoto" />
      <view class="photo-meta"><text>{{item.originalFileName}}</text><button size="mini" data-id="{{item.selectionAssetId}}" bindtap="choose" disabled="{{confirmed}}">{{item.selected ? '已选' : '选择'}}</button><button size="mini" data-id="{{item.selectionAssetId}}" bindtap="favorite" disabled="{{confirmed}}">{{item.favorite ? '★' : '☆'}}</button></view>
    </view>
  </view>
</view>
<view class="bottom-bar" bindtap="openSelected">已选 {{selectedCount}} / {{targetCount}}　　查看已选</view>
