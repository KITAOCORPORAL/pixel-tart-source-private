<view class="page" wx:if="{{asset}}"><image style="width:100%;height:760rpx;background:#ded9d3" src="{{asset.previewUrl || asset.thumbUrl}}" mode="aspectFit"/><view class="title" style="font-size:30rpx;margin-top:20rpx">{{asset.originalFileName}}</view><button class="button" bindtap="choose" disabled="{{confirmed}}">{{selected ? '取消选择' : '选择'}}</button><button bindtap="favorite" disabled="{{confirmed}}">{{favorite ? '取消收藏' : '收藏'}}</button><textarea value="{{comment}}" bindblur="comment" disabled="{{confirmed}}" placeholder="添加备注"/></view>
