<UserControl x:Class="PixelTart.Modules.AssetLibrary.AssetLibraryPage"
             x:Name="AssetLibraryRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTart.Modules.AssetLibrary"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True"
             AutomationProperties.AutomationId="AssetLibraryPage"
             AutomationProperties.Name="素材库工作区">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="AssetLibraryThumbnail.xaml" />
            <ResourceDictionary Source="AssetActionIcons.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:HexToBrushConverter x:Key="HexToBrushConverter" />
        <local:BooleanToOpacityConverter x:Key="BooleanToOpacityConverter" />
        <local:RatingAtLeastConverter x:Key="RatingAtLeastConverter" />
        <Style x:Key="QuickLoupeRevealHost" TargetType="Grid">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Opacity" Value="1" />
                    <Setter Property="IsHitTestVisible" Value="True" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="True" />
                    <DataTrigger.EnterActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14" /></Storyboard></BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.10" /></Storyboard></BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AssetInspectorStarButton" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{DynamicResource PhotographyGoldBrush}" /></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource PhotographyGoldBrush}" /></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AssetInspectorTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" /><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AssetContextSectionHeader" TargetType="MenuItem">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border Padding="8,6,8,2"><ContentPresenter ContentSource="Header" /></Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ContextMenu x:Key="AssetP2ContextMenu" x:Shared="False"
                     Opened="AssetContextMenu_Opened"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Style="{DynamicResource PixelTart.Menu.Context}"
                     AutomationProperties.AutomationId="AssetVisualContextMenu">
            <ContextMenu.Resources>
                <Style TargetType="MenuItem" BasedOn="{StaticResource PixelTart.Menu.Item}" />
            </ContextMenu.Resources>
            <MenuItem Header="查看" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextViewGroup" />
            <Separator />
            <MenuItem Header="查看大图" Command="{Binding Owner.OpenContextViewerCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextOpenViewer">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.ViewLarge}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="快速预览" Click="ContextQuickPreview_Click" AutomationProperties.AutomationId="AssetContextQuickPreview">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Search}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="默认程序打开" Command="{Binding Owner.OpenContextExternalCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextOpenExternal">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.OpenExternal}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="打开文件位置" Command="{Binding Owner.RevealContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextReveal">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Reveal}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="复制文件" Command="{Binding Owner.CopyContextFileCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextCopyFile">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.CopyFile}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="用于创作"><MenuItem Header="放到自由画布" Click="ContextCanvas_Click" /></MenuItem>
            <MenuItem Header="视觉分析" AutomationProperties.AutomationId="AssetContextVisualAnalysis">
                <MenuItem Header="查看配色" Click="OpenVisualAnalysisPalette_Click" />
                <MenuItem Header="黑白预览" Click="OpenVisualAnalysisMonochrome_Click" />
                <MenuItem Header="影调分区" Click="OpenVisualAnalysisZones_Click" />
                <MenuItem Header="直方图" Click="OpenVisualAnalysisHistogram_Click" />
                <MenuItem Header="查找相似图片" Click="FindSimilarVisualMenu_Click" />
            </MenuItem>
            <MenuItem Header="整理" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextOrganizeGroup" />
            <Separator />
            <MenuItem Header="移到文件夹" AutomationProperties.AutomationId="AssetContextFolder">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Folder}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                <MenuItem Header="加入当前文件夹" Command="{Binding Owner.AddContextFolderCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextAddFolder" />
                <MenuItem Header="移出当前文件夹" Command="{Binding Owner.RemoveContextFolderCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveFolder" />
            </MenuItem>
            <MenuItem Header="添加标签" AutomationProperties.AutomationId="AssetContextTag">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Tag}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                <MenuItem Header="加入当前标签" Command="{Binding Owner.AddContextTagCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextAddTag" />
                <MenuItem Header="移出当前标签" Command="{Binding Owner.RemoveContextTagCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveTag" />
            </MenuItem>
            <MenuItem Header="颜色标记" AutomationProperties.AutomationId="AssetContextColor">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Color}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                <MenuItem Header="按此素材配色筛选" Command="{Binding Owner.FindPaletteSimilarCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="查找相似视觉" Command="{Binding Owner.FindSimilarCommand}" CommandParameter="{Binding}" />
            </MenuItem>
            <MenuItem Header="评分" AutomationProperties.AutomationId="AssetContextRating">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Rating}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                    <MenuItem Header="0 星" Command="{Binding Owner.RateContextZeroCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="1 星" Command="{Binding Owner.RateContextOneCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="2 星" Command="{Binding Owner.RateContextTwoCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="3 星" Command="{Binding Owner.RateContextThreeCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="4 星" Command="{Binding Owner.RateContextFourCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="5 星" Command="{Binding Owner.RateContextFiveCommand}" CommandParameter="{Binding}" />
            </MenuItem>

            <MenuItem Header="项目" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextProjectGroup" />
            <Separator />
            <MenuItem Header="关联项目…" Command="{Binding Owner.OpenProjectPickerCommand}" AutomationProperties.AutomationId="AssetContextProject">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Project}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="关联拍摄…" Command="{Binding Owner.OpenBookingPickerCommand}" AutomationProperties.AutomationId="AssetContextBooking">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Booking}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="处理状态" AutomationProperties.AutomationId="AssetContextStatus">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Workflow}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                    <MenuItem Header="未处理" Command="{Binding Owner.WorkflowUnprocessedCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="客户选择" Command="{Binding Owner.WorkflowClientSelectedCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="待精修" Command="{Binding Owner.WorkflowPendingRetouchCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="已精修" Command="{Binding Owner.WorkflowRetouchedCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="已交付" Command="{Binding Owner.WorkflowDeliveredCommand}" CommandParameter="{Binding}" />
            </MenuItem>

            <MenuItem Header="灵感" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextInspirationGroup" />
            <Separator />
            <MenuItem Header="加入灵感板" AutomationProperties.AutomationId="AssetContextAddToInspirationBoard">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Inspiration}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                <MenuItem Header="临时收集" Command="{Binding Owner.AddToInspirationTrayCommand}" CommandParameter="{Binding}" ToolTip="仅保存素材引用，不复制源文件" AutomationProperties.AutomationId="AssetContextAddToTray" />
                <MenuItem Header="选择灵感板…" Command="{Binding Owner.OpenCollectionsCommand}" AutomationProperties.AutomationId="AssetContextAddToCollection" />
            </MenuItem>
            <MenuItem Header="导出" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextExportGroup" />
            <Separator />
            <MenuItem Header="导出图片" AutomationProperties.AutomationId="AssetContextExport">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Export}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
                <MenuItem Header="原文件副本" Command="{Binding Owner.ExportOriginalContextCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="素材库中的副本" Command="{Binding Owner.ExportManagedContextCommand}" CommandParameter="{Binding}" />
                <MenuItem Header="元数据 CSV" Command="{Binding Owner.ExportMetadataContextCommand}" CommandParameter="{Binding}" />
            </MenuItem>
            <MenuItem Header="复制路径" Command="{Binding Owner.CopyContextPathCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextCopyPath">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.CopyFile}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>

            <MenuItem Header="管理" Style="{StaticResource AssetContextSectionHeader}" AutomationProperties.AutomationId="AssetContextManageGroup" />
            <Separator />
            <MenuItem Header="从当前位置移除" Command="{Binding Owner.RemoveContextFromViewCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveFromView">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Remove}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="归档" Command="{Binding Owner.ArchiveContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextArchive">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Archive}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="恢复归档" Command="{Binding Owner.RestoreContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRestore">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Undo}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="移到回收站" Command="{Binding Owner.TrashContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextTrash">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Trash}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="从回收站恢复" Command="{Binding Owner.RestoreTrashContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextTrashRestore">
                <MenuItem.Icon><Path Data="{StaticResource AssetAction.Undo}" Style="{StaticResource AssetActionIcon}" /></MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <Style x:Key="AssetP2ListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource PixelTart.Thumbnail}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ContextMenu" Value="{StaticResource AssetP2ContextMenu}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>

        <DataTemplate x:Key="AssetGridCardTemplate">
            <Border Background="Transparent">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="Transparent" ClipToBounds="True"><Grid>
                        <Image x:Name="AssetGridThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.AssetId="{Binding Asset.AssetId}" local:AsyncThumbnail.ContentHash="{Binding Asset.ContentHash}" local:AsyncThumbnail.DecodeWidth="320" Stretch="Uniform" />
                        <TextBlock Text="文件缺失" Visibility="{Binding Asset.IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetGridThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetGridThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="{DynamicResource RadiusSmall}"
                                AutomationProperties.AutomationId="VisualMatchScores">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDetail}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource Type.Caption.FontSize}" ToolTip="{Binding Detail}" />
                        </Border>
                        <Grid Style="{StaticResource QuickLoupeRevealHost}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{DynamicResource PixelTart.Button.Ghost}" Width="32" Height="32" Padding="6" Margin="6" ToolTip="快速查看"
                                    AutomationProperties.Name="快速查看高清预览" AutomationProperties.AutomationId="AssetGridQuickLoupeButton"
                                    Click="QuickLoupeButton_Click" MouseEnter="QuickLoupeButton_MouseEnter" MouseLeave="QuickLoupeButton_MouseLeave">
                                <Path Data="{StaticResource AssetAction.Search}" Style="{StaticResource AssetActionIcon}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="4,3,4,0"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DimensionsText}" Style="{DynamicResource PixelTart.Type.Metadata}" AutomationProperties.Name="素材分辨率" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetMasonryCardTemplate">
            <Border Background="Transparent">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="Transparent" ClipToBounds="True"><Grid>
                        <Image x:Name="AssetMasonryThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.AssetId="{Binding Asset.AssetId}" local:AsyncThumbnail.ContentHash="{Binding Asset.ContentHash}" local:AsyncThumbnail.DecodeWidth="320" Stretch="Uniform" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetMasonryThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetMasonryThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                        <Grid Style="{StaticResource QuickLoupeRevealHost}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{DynamicResource PixelTart.Button.Ghost}" Width="32" Height="32" Padding="6" Margin="6" ToolTip="快速查看"
                                    AutomationProperties.Name="快速查看高清预览" AutomationProperties.AutomationId="AssetMasonryQuickLoupeButton"
                                    Click="QuickLoupeButton_Click" MouseEnter="QuickLoupeButton_MouseEnter" MouseLeave="QuickLoupeButton_MouseLeave">
                                <Path Data="{StaticResource AssetAction.Search}" Style="{StaticResource AssetActionIcon}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="4,3,4,0"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DimensionsText}" Style="{DynamicResource PixelTart.Type.Metadata}" AutomationProperties.Name="素材分辨率" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetJustifiedCardTemplate">
            <Border Background="Transparent">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="Transparent" ClipToBounds="True"><Grid>
                        <Image x:Name="AssetJustifiedThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.AssetId="{Binding Asset.AssetId}" local:AsyncThumbnail.ContentHash="{Binding Asset.ContentHash}" local:AsyncThumbnail.DecodeWidth="360" Stretch="Uniform" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetJustifiedThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetJustifiedThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                        <Grid Style="{StaticResource QuickLoupeRevealHost}" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <Button Style="{DynamicResource PixelTart.Button.Ghost}" Width="32" Height="32" Padding="6" Margin="6" ToolTip="快速查看"
                                    AutomationProperties.Name="快速查看高清预览" AutomationProperties.AutomationId="AssetJustifiedQuickLoupeButton"
                                    Click="QuickLoupeButton_Click" MouseEnter="QuickLoupeButton_MouseEnter" MouseLeave="QuickLoupeButton_MouseLeave">
                                <Path Data="{StaticResource AssetAction.Search}" Style="{StaticResource AssetActionIcon}" Width="16" Height="16" />
                            </Button>
                        </Grid>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="4,3,4,0"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DimensionsText}" Style="{DynamicResource PixelTart.Type.Metadata}" AutomationProperties.Name="素材分辨率" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetListRowTemplate">
            <Border Background="Transparent" Padding="{DynamicResource Space.Inset.1}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Width="46" Height="54" Background="{DynamicResource Brush.Background}"><Grid>
                        <Image x:Name="AssetListThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.AssetId="{Binding Asset.AssetId}" local:AsyncThumbnail.ContentHash="{Binding Asset.ContentHash}" local:AsyncThumbnail.DecodeWidth="96" Stretch="Uniform" />
                        <TextBlock Text="缩略图失败" Foreground="{DynamicResource Brush.Text.Primary}" Background="{DynamicResource Brush.Surface.Elevated}" Padding="2" FontSize="{DynamicResource Type.Caption.FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ElementName=AssetListThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="AssetThumbnailFailure" />
                    </Grid></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Asset.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{DynamicResource SpacingHorizontal8}" />
                    <TextBlock Grid.Column="2" Text="{Binding Asset.MediaType}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="3" Text="{Binding DimensionsText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="4" Text="{Binding CaptureTimeText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="5" Text="{Binding AddedTimeText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="6" Text="{Binding Asset.Rating, StringFormat=★ {0}}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" Visibility="{Binding HasRating, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Grid.Column="7" Text="{Binding TagSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource PixelTart.Type.Metadata}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetP2AdaptiveItemTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource AssetGridCardTemplate}" />
                        <Style.Triggers>
                            <!-- Grid, Masonry, and Justified share the photo-card tree; VirtualizingAssetPanel supplies their distinct geometry. -->
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Masonry"><Setter Property="ContentTemplate" Value="{StaticResource AssetMasonryCardTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Justified"><Setter Property="ContentTemplate" Value="{StaticResource AssetJustifiedCardTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="List"><Setter Property="ContentTemplate" Value="{StaticResource AssetListRowTemplate}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
            </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
      <Grid x:Name="LibraryWorkspace">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Popup x:Name="AssetQuickLoupePopup" Placement="Center" AllowsTransparency="True" StaysOpen="False"
               AutomationProperties.AutomationId="AssetQuickLoupePopup" AutomationProperties.Name="素材高清速览">
            <Border x:Name="QuickLoupeContainer" MinWidth="420" MaxWidth="860" MinHeight="300" MaxHeight="680" Padding="10"
                    Background="{DynamicResource Brush.Surface.Elevated}" BorderBrush="{DynamicResource Brush.Border.Strong}" BorderThickness="1" CornerRadius="8"
                    MouseLeave="QuickLoupePopup_MouseLeave">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Image x:Name="QuickLoupeImage" MaxHeight="620" Stretch="Uniform" AutomationProperties.AutomationId="AssetQuickLoupeImage" />
                    <TextBlock x:Name="QuickLoupeTitle" Grid.Row="1" Margin="2,6,2,1" Foreground="{DynamicResource Brush.Text.Primary}" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Popup>
        <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                      AutomationProperties.AutomationId="AssetBrowserToolbar">
        <Grid Margin="12,8" MinWidth="980">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Row="0" Grid.Column="0" MinWidth="240" Margin="0,0,8,0">
                <TextBox x:Name="AssetLibrarySearchBox" Padding="30,0,8,0"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         PreviewKeyDown="AssetLibrarySearchBox_PreviewKeyDown"
                         ToolTip="搜索名称、标签、文件夹与备注" AutomationProperties.Name="搜索素材"
                         AutomationProperties.AutomationId="AssetLibrarySearch" VerticalAlignment="Center" />
                <Path Data="{StaticResource AssetAction.Search}" Style="{StaticResource AssetActionIcon}" Width="15" Height="15" Margin="9,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
            </Grid>
            <Button Grid.Row="0" Grid.Column="1" Click="Filter_Click" ToolTip="颜色筛选" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}"
                     Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryColorFilter"
                     AutomationProperties.Name="颜色筛选"><Path Data="{StaticResource AssetAction.Color}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Border Grid.Row="0" Grid.Column="1" Panel.ZIndex="2" Margin="0,-8,-6,0" Padding="5,1" CornerRadius="8"
                    Background="{DynamicResource Brush.Accent}" HorizontalAlignment="Right" VerticalAlignment="Top"
                    IsHitTestVisible="False" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="AssetFilterCountBadge">
                <TextBlock Text="{Binding ActiveFilterCount}" Foreground="{DynamicResource Brush.Background}" FontWeight="SemiBold" />
            </Border>
            <Button Grid.Row="0" Grid.Column="2" Click="TagFilter_Click" ToolTip="标签筛选" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}"
                     Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryTagFilter"
                     AutomationProperties.Name="标签筛选"><Path Data="{StaticResource AssetAction.Tag}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="3" Click="RatingFilter_Click" ToolTip="评分筛选" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}"
                     Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryRatingFilter"
                     AutomationProperties.Name="评分筛选"><Path Data="{StaticResource AssetAction.Rating}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="4" Click="DateFilter_Click" ToolTip="日期筛选" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}" Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryDateFilter" AutomationProperties.Name="日期筛选"><Path Data="{StaticResource AssetAction.Date}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="5" Click="SortMenu_Click" ToolTip="排序" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}" Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibrarySortMenu" AutomationProperties.Name="选择素材排序"><Path Data="{StaticResource AssetAction.Sort}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="6" Click="ViewMenu_Click" ToolTip="布局" Width="36" Height="34" Padding="8"
                     Margin="{DynamicResource Space.Inline.Start.1}" Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryViewMenu" AutomationProperties.Name="选择素材布局"><Path Data="{StaticResource AssetAction.Layout}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="7" ToolTip="导入" Width="36" Height="34" Padding="8" Margin="{DynamicResource Space.Inline.Start.1}"
                     Style="{DynamicResource PixelTart.Button.Primary}"
                     Command="{Binding ImportCommand}"
                     AutomationProperties.AutomationId="AssetLibraryImport" AutomationProperties.Name="导入素材"><Path Data="{StaticResource AssetAction.Import}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="8" ToolTip="撤销" Width="36" Height="34" Padding="8" Margin="{DynamicResource Space.Inline.Start.1}" Command="{Binding P2UndoCommand}"
                     Style="{DynamicResource PixelTart.Button.Ghost}" AutomationProperties.AutomationId="AssetBrowserUndo" AutomationProperties.Name="撤销"><Path Data="{StaticResource AssetAction.Undo}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="9" ToolTip="重做" Width="36" Height="34" Padding="8" Margin="{DynamicResource Space.Inline.Start.1}" Command="{Binding P2RedoCommand}"
                     Style="{DynamicResource PixelTart.Button.Ghost}" AutomationProperties.AutomationId="AssetBrowserRedo" AutomationProperties.Name="重做"><Path Data="{StaticResource AssetAction.Redo}" Style="{StaticResource AssetActionIcon}" /></Button>
            <Button Grid.Row="0" Grid.Column="10" ToolTip="更多" Width="36" Height="34" Padding="8" Margin="{DynamicResource Space.Inline.Start.1}" Click="More_Click"
                     Style="{DynamicResource PixelTart.Button.Ghost}"
                     AutomationProperties.AutomationId="AssetLibraryMore"
                     AutomationProperties.Name="更多操作">
                <Path Data="{StaticResource AssetAction.More}" Style="{StaticResource AssetActionIcon}" />
                <Button.ContextMenu><ContextMenu Style="{DynamicResource PixelTart.Menu.Context}" /></Button.ContextMenu>
            </Button>
            <Button Grid.Row="0" Grid.Column="11" Content="组织" Visibility="Collapsed"
                     Command="{Binding ToggleOrganizationPaneCommand}" Style="{DynamicResource PixelTart.Button.Ghost}"
                    AutomationProperties.AutomationId="ToggleAssetOrganizationPane"
                    AutomationProperties.Name="{Binding OrganizationPaneToggleLabel}" />
            <Button Grid.Row="0" Grid.Column="12" Content="详情" Visibility="Collapsed"
                    Command="{Binding ToggleInspectorPaneCommand}" Style="{DynamicResource PixelTart.Button.Ghost}"
                    AutomationProperties.AutomationId="ToggleAssetInspectorPane"
                    AutomationProperties.Name="{Binding InspectorPaneToggleLabel}" />
            <Button Grid.Row="0" Grid.Column="13" Content="固定" Visibility="Collapsed"
                    Command="{Binding ToggleInspectorPinCommand}" Style="{DynamicResource PixelTart.Button.Ghost}"
                    AutomationProperties.AutomationId="PinAssetInspectorPane"
                    AutomationProperties.Name="{Binding InspectorPinLabel}" />
        </Grid>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="60" Width="360" MaxHeight="440" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="12,50,12,0" Padding="8" Background="{DynamicResource Brush.Surface.Elevated}"
                Style="{DynamicResource PixelTart.Surface.Border}"
                Visibility="{Binding P3QuerySurfaceVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="AssetFilterPopover"
                AutomationProperties.Name="素材筛选浮层">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <local:AssetQueryComposerView />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" AutomationProperties.AutomationId="AssetLibraryThreePaneWorkspace">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding P3SmartFolderOpen}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AssetOrganizationColumn"
                                  Width="{Binding OrganizationPaneColumnWidth}"
                                  MinWidth="{Binding OrganizationPaneMinimumWidth}"
                                  MaxWidth="420" />
                <ColumnDefinition Width="{Binding OrganizationSplitterColumnWidth}" />
                <ColumnDefinition x:Name="AssetCollectionColumn" Width="*" MinWidth="360" />
                <ColumnDefinition Width="{Binding InspectorSplitterColumnWidth}" />
                <ColumnDefinition x:Name="AssetInspectorColumn"
                                  Width="{Binding InspectorPaneColumnWidth}"
                                  MinWidth="{Binding InspectorPaneMinimumWidth}"
                                  MaxWidth="{DynamicResource Size.Inspector.MaxWidth}" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource PixelTart.Surface.Panel}"
                    IsEnabled="{Binding IsReady}"
                    Visibility="{Binding IsOrganizationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderThickness="0,0,1,0"
                    AutomationProperties.AutomationId="AssetOrganizationPane">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="素材库" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding SystemCollections}" Margin="0,8,0,4"
                                      AutomationProperties.AutomationId="AssetSystemCollections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding SelectCommand}" IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Stretch"
                                            Style="{DynamicResource PixelTart.Button.Ghost}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}"
                                            AutomationProperties.Name="{Binding AccessibleName}"
                                            ToolTip="{Binding Description}"
                                            local:AssetLibraryDragDropBehavior.DropTarget="{Binding DropTarget}">
                                        <Border Padding="6,4" CornerRadius="4">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <Path Data="{Binding IconData}" Width="15" Height="15">
                                                    <Path.Style><Style TargetType="Path" BasedOn="{StaticResource AssetActionIcon}"><Style.Triggers><DataTrigger Binding="{Binding IsActive}" Value="True"><Setter Property="Stroke" Value="{DynamicResource Brush.Accent}" /></DataTrigger></Style.Triggers></Style></Path.Style>
                                                </Path>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Text="{Binding Count, StringFormat=N0}" Foreground="{DynamicResource Brush.Text.Muted}" VerticalAlignment="Center" Margin="8,0,2,0" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                         <Separator Margin="0,8" />
                        <Expander Header="模块诊断" Margin="0,0,0,10"
                                  IsExpanded="{Binding IsPreviewDiagnosticsEnabled, Mode=OneWay}"
                                  Visibility="{Binding IsPreviewDiagnosticsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="ModuleDiagnostics">
                            <ItemsControl ItemsSource="{Binding ModuleDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Text}" AutomationProperties.AutomationId="{Binding AutomationId}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Space.Stack.1.Symmetric}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <DockPanel>
                            <TextBlock Text="文件夹" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                            <Button Content="+" HorizontalAlignment="Right" Command="{Binding NewFolderCommand}"
                                    Style="{DynamicResource PixelTart.Button.Ghost}"
                                    ToolTip="新建文件夹" AutomationProperties.Name="新建文件夹" />
                        </DockPanel>
                        <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="新文件夹名称" Margin="{DynamicResource Space.Stack.1}" />
                            <TextBlock Text="正在加载组织栏…" Style="{DynamicResource PixelTart.Type.Metadata}"
                                       Visibility="{Binding IsOrganizationLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationLoadingState" />
                            <TextBlock Text="{Binding OrganizationError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasOrganizationError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationErrorState" />
                            <TextBlock Text="还没有文件夹、智能文件夹或标签。" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap"
                                       Visibility="{Binding IsOrganizationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationEmptyState" />
                            <TreeView BorderThickness="0" Background="Transparent" ItemsSource="{Binding OrganizationFolders}"
                                      AutomationProperties.AutomationId="AssetFolderTree" MaxHeight="260">
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="MinHeight" Value="30" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="BorderThickness" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                        <Setter Property="local:AssetLibraryDragDropBehavior.DropTarget" Value="{Binding DropTarget}" />
                                    </Style>
                                    <HierarchicalDataTemplate DataType="{x:Type local:AssetLibraryFolderNodeView}" ItemsSource="{Binding Children}">
                                        <Grid MinWidth="150" MinHeight="30" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="22" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <Path Data="{StaticResource AssetAction.Folder}" Style="{StaticResource AssetActionIcon}" Width="15" Height="15" VerticalAlignment="Center" />
                                            <TextBlock x:Name="FolderNameText" Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBox x:Name="FolderNameEditor" Grid.Column="1" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                                     AutomationProperties.Name="重命名文件夹" />
                                            <TextBlock Grid.Column="2" Text="{Binding CountText}" Style="{DynamicResource PixelTart.Type.Metadata}" Foreground="{DynamicResource Brush.Text.Muted}" Margin="8,0,2,0" VerticalAlignment="Center" />
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="重命名" Command="{Binding BeginRenameCommand}" />
                                                    <MenuItem Header="完成重命名" Command="{Binding CommitRenameCommand}" />
                                                    <MenuItem Header="创建同级文件夹" Command="{Binding CreateSiblingCommand}" />
                                                    <MenuItem Header="创建子文件夹" Command="{Binding CreateChildCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="向上移动" Command="{Binding MoveUpCommand}" AutomationProperties.AutomationId="AssetFolderMoveUp" />
                                                    <MenuItem Header="向下移动" Command="{Binding MoveDownCommand}" AutomationProperties.AutomationId="AssetFolderMoveDown" />
                                                    <MenuItem Header="提升一级" Command="{Binding PromoteCommand}" AutomationProperties.AutomationId="AssetFolderPromote" />
                                                    <Separator />
                                                    <MenuItem Header="归档或恢复" Command="{Binding ToggleArchiveCommand}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter TargetName="FolderNameText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FolderNameEditor" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <TextBlock Text="智能文件夹" Style="{DynamicResource PixelTart.Type.SectionTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding OrganizationSmartFolders}" AutomationProperties.AutomationId="SmartFolders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Description}">
                                            <Button DockPanel.Dock="Right" Content="编辑" Command="{Binding EditCommand}" Margin="{DynamicResource Space.Inline.Start.1}"
                                                    Style="{DynamicResource PixelTart.Button.Ghost}" AutomationProperties.Name="编辑智能文件夹条件" />
                                            <Button Content="{Binding Name}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Left"
                                                    Style="{DynamicResource PixelTart.Button.Ghost}"
                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                    AutomationProperties.Name="{Binding AccessibleName}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="标签分组" Style="{DynamicResource PixelTart.Type.SectionTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding OrganizationTagGroups}" AutomationProperties.AutomationId="AssetTags">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                        <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                                  AutomationProperties.Name="{Binding AccessibleName}">
                                            <ItemsControl ItemsSource="{Binding Children}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left"
                                                                Style="{DynamicResource PixelTart.Button.Ghost}"
                                                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                                local:AssetLibraryDragDropBehavior.DropTarget="{Binding DropTarget}">
                                                            <DockPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding UsageCount}" DockPanel.Dock="Right" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="6,0,0,0" /></DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource Brush.Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragCompleted="OnPaneSplitterDragCompleted"
                          PreviewKeyUp="OnPaneSplitterPreviewKeyUp"
                          Visibility="{Binding IsOrganizationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="AssetOrganizationSplitter"
                          AutomationProperties.Name="调整组织栏宽度"
                          Focusable="True" IsTabStop="True" />

            <Border Grid.Column="2" Style="{DynamicResource PixelTart.Surface.Panel}" AutomationProperties.AutomationId="AssetCollectionPane">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsReady}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentViewLabel, StringFormat={}素材{0}}" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                            <TextBlock Text="{Binding VisibleCount, StringFormat= · {0} 项}" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="{DynamicResource Space.Inline.Start.1}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="120" Maximum="280" Value="{Binding ThumbnailWidth}" ToolTip="缩略图大小"
                                AutomationProperties.AutomationId="AssetThumbnailSizeSlider"
                                AutomationProperties.Name="缩略图大小"
                                Focusable="True" IsTabStop="True" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="VisualFilterChips">
                        <DockPanel>
                            <ItemsControl ItemsSource="{Binding ActiveVisualChips}" AutomationProperties.AutomationId="ActiveVisualFilterChips">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveVisualChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                 Style="{DynamicResource PixelTart.Button.Ghost}"
                                                 Tag="Active"
                                                 Padding="{DynamicResource Space.Control.Compact.Padding}"
                                                 Margin="{DynamicResource Space.Inline.End.1}"
                                                AutomationProperties.Name="{Binding Label, StringFormat={}移除筛选 {0}}">
                                            <TextBlock><Run Text="{Binding Label}" /><Run Text="  ×" /></TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button DockPanel.Dock="Right" Content="分析当前视图" Command="{Binding AnalyzeVisibleCommand}"
                                    Style="{DynamicResource PixelTart.Button.Secondary}" Margin="{DynamicResource Space.Inline.Start.1}"
                                    AutomationProperties.AutomationId="AnalyzeVisibleAssets" AutomationProperties.Name="分析当前视图中的素材" />
                            <Button DockPanel.Dock="Right" Content="退出临时结果" Command="{Binding ClearVisualModeCommand}"
                                    Style="{DynamicResource PixelTart.Button.Secondary}"
                                    Visibility="{Binding IsTemporaryVisualMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="ClearVisualResults" />
                        </DockPanel>
                        <Border Margin="{DynamicResource Space.Stack.1}" Padding="{DynamicResource Space.Control.Compact.Padding}" Background="{DynamicResource Brush.Panel}"
                                Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetListColumnHeaders">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预览" Style="{DynamicResource PixelTart.Type.Metadata}" />
                                <Button Grid.Column="1" Content="名称" Command="{Binding SortBrowserCommand}" CommandParameter="FileName" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortName" />
                                <TextBlock Grid.Column="2" Text="类型" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="尺寸" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="拍摄时间" Command="{Binding SortBrowserCommand}" CommandParameter="CaptureTime" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortCaptureTime" />
                                <Button Grid.Column="5" Content="添加时间" Command="{Binding SortBrowserCommand}" CommandParameter="AddedAt" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortAddedAt" />
                                <Button Grid.Column="6" Content="评分" Command="{Binding SortBrowserCommand}" CommandParameter="Rating" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortRating" />
                                <TextBlock Grid.Column="7" Text="标签" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                     <!-- RC12 current view contract retains the stable AssetViewGrid automation route. -->
                     <local:AssetLibrarySelectionListBox x:Name="AssetGrid" BorderThickness="0" Grid.Row="2" ItemsSource="{Binding AssetCards}"
                             IsEnabled="{Binding IsReady}"
                             Background="Transparent"
                             SelectionMode="Extended" SelectionChanged="AssetGrid_SelectionChanged"
                             ItemTemplate="{StaticResource AssetP2AdaptiveItemTemplate}"
                             ItemContainerStyle="{StaticResource AssetP2ListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             local:AssetLibraryDragDropBehavior.IsAssetSource="True"
                             AllowDrop="True" DragOver="AssetGrid_DragOver" Drop="AssetGrid_Drop"
                             AutomationProperties.AutomationId="AssetGrid"
                             AutomationProperties.Name="素材浏览结果">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:VirtualizingAssetPanel
                                    ViewMode="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    ThumbnailWidth="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                             </ItemsPanelTemplate>
                         </ListBox.ItemsPanel>
                      </local:AssetLibrarySelectionListBox>

                      <Border Grid.Row="3" Margin="0,8,0,0" Padding="{DynamicResource Space.Inset.2}"
                              Background="{DynamicResource Brush.Panel}"
                              Visibility="{Binding IsLoadMoreVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
