<UserControl x:Class="PixelTart.Modules.AssetLibrary.AssetLibraryPage"
             x:Name="AssetLibraryRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTart.Modules.AssetLibrary"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded"
             SizeChanged="OnSizeChanged"
             PreviewKeyDown="OnPreviewKeyDown"
             Focusable="True"
             AutomationProperties.AutomationId="AssetLibraryPage"
             AutomationProperties.Name="素材库工作区">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="AssetLibraryThumbnail.xaml" />
        </ResourceDictionary.MergedDictionaries>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <ContextMenu x:Key="AssetP2ContextMenu" x:Shared="False"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                     Style="{DynamicResource PixelTart.Menu.Context}"
                     AutomationProperties.AutomationId="AssetVisualContextMenu">
            <MenuItem Header="查看信息" Command="{Binding Owner.ShowContextInfoCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextShowInfo" />
            <MenuItem Header="在新窗口打开" IsEnabled="False" ToolTip="独立预览窗口尚未接入" />
            <MenuItem Header="在默认应用打开" IsEnabled="False" ToolTip="安全外部打开尚未接入" />
            <MenuItem Header="使用其他应用打开 ›" IsEnabled="False" />
            <MenuItem Header="在文件资源管理器中显示" IsEnabled="False" />
            <MenuItem Header="打开原文件位置 ›" IsEnabled="False" />
            <Separator />
            <MenuItem Header="用于策划 ›" AutomationProperties.AutomationId="AssetContextPlanning">
                <MenuItem Header="加入灵感托盘" Command="{Binding Owner.AddToInspirationTrayCommand}" CommandParameter="{Binding}" ToolTip="仅保存素材引用，不复制源文件" AutomationProperties.AutomationId="AssetContextAddToTray" />
                <MenuItem Header="加入当前情绪板" IsEnabled="False" />
                <MenuItem Header="加入项目策划" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="加入与整理 ›" AutomationProperties.AutomationId="AssetContextOrganize">
                <MenuItem Header="添加至当前文件夹" Command="{Binding Owner.AddContextFolderCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextAddFolder" />
                <MenuItem Header="移出当前文件夹" Command="{Binding Owner.RemoveContextFolderCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveFolder" />
                <MenuItem Header="添加至当前标签" Command="{Binding Owner.AddContextTagCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextAddTag" />
                <MenuItem Header="移出当前标签" Command="{Binding Owner.RemoveContextTagCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveTag" />
                <MenuItem Header="设置评分" AutomationProperties.AutomationId="AssetContextRating">
                    <MenuItem Header="0 星" Command="{Binding Owner.RateContextZeroCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="1 星" Command="{Binding Owner.RateContextOneCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="2 星" Command="{Binding Owner.RateContextTwoCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="3 星" Command="{Binding Owner.RateContextThreeCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="4 星" Command="{Binding Owner.RateContextFourCommand}" CommandParameter="{Binding}" />
                    <MenuItem Header="5 星" Command="{Binding Owner.RateContextFiveCommand}" CommandParameter="{Binding}" />
                </MenuItem>
            </MenuItem>
            <MenuItem Header="素材编辑 ›" AutomationProperties.AutomationId="AssetContextEdit">
                <MenuItem Header="用其他文件替换" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="工作流 ›" AutomationProperties.AutomationId="AssetContextWorkflow">
                <MenuItem Header="客户选择" IsEnabled="False" />
                <MenuItem Header="待精修" IsEnabled="False" />
                <MenuItem Header="已精修" IsEnabled="False" />
                <MenuItem Header="已交付" IsEnabled="False" />
            </MenuItem>
            <MenuItem Header="导出 ›" IsEnabled="False" AutomationProperties.AutomationId="AssetContextExport" />
            <Separator />
            <MenuItem Header="查看模式 ›" AutomationProperties.AutomationId="AssetContextViewMode">
                <MenuItem Header="查找相似配色" Command="{Binding Owner.FindPaletteSimilarCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="FindSimilarPaletteContext" />
                <MenuItem Header="查找相似视觉" Command="{Binding Owner.FindSimilarCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="FindSimilarVisualContext" />
                <MenuItem Header="分析视觉数据" Command="{Binding Owner.AnalyzeSelectionCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AnalyzeVisualContext" />
            </MenuItem>
            <MenuItem Header="复制 ›"><MenuItem Header="复制文件路径" Command="{Binding Owner.CopyContextPathCommand}" CommandParameter="{Binding}" /></MenuItem>
            <Separator />
            <MenuItem Header="从当前文件夹移除" Command="{Binding Owner.RemoveContextFromViewCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextRemoveFromView" />
            <MenuItem Header="归档" Command="{Binding Owner.ArchiveContextCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="AssetContextArchive" />
        </ContextMenu>

        <Style x:Key="AssetP2ListBoxItem" TargetType="ListBoxItem" BasedOn="{StaticResource PixelTart.Thumbnail}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="ContextMenu" Value="{StaticResource AssetP2ContextMenu}" />
            <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
        </Style>

        <DataTemplate x:Key="AssetGridCardTemplate">
            <Border Background="Transparent" Padding="{DynamicResource Space.Inset.1}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource Brush.Background}"><Grid>
                        <Image x:Name="AssetGridThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.DecodeWidth="240" Stretch="Uniform" />
                        <TextBlock Text="文件缺失" Visibility="{Binding Asset.IsMissing, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetGridThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetGridThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="{DynamicResource RadiusSmall}"
                                AutomationProperties.AutomationId="VisualMatchScores">
                            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasDetail}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Primary}" FontSize="{DynamicResource Type.Caption.FontSize}" ToolTip="{Binding Detail}" />
                        </Border>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="{DynamicResource Space.Stack.1}"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Asset.Rating, StringFormat=★ {0}}" Style="{DynamicResource PixelTart.Type.Metadata}" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetMasonryCardTemplate">
            <Border Background="Transparent" Padding="{DynamicResource Space.Inset.1}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource Brush.Background}"><Grid>
                        <Image x:Name="AssetMasonryThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.DecodeWidth="280" Stretch="Uniform" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetMasonryThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetMasonryThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="{DynamicResource Space.Stack.1}"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding DimensionsText}" Style="{DynamicResource PixelTart.Type.Metadata}" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetJustifiedCardTemplate">
            <Border Background="Transparent" Padding="{DynamicResource Space.Inset.1}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="40" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource Brush.Background}"><Grid>
                        <Image x:Name="AssetJustifiedThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.DecodeWidth="320" Stretch="Uniform" />
                        <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="{Binding ElementName=AssetJustifiedThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetThumbnailFailure">
                            <TextBlock Text="{Binding ElementName=AssetJustifiedThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        </Border>
                    </Grid></Border>
                    <StackPanel Grid.Row="1" Margin="{DynamicResource Space.Stack.1}"><TextBlock Text="{Binding Asset.DisplayName}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Asset.MediaType}" Style="{DynamicResource PixelTart.Type.Metadata}" /></StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetListRowTemplate">
            <Border Background="Transparent" Padding="{DynamicResource Space.Inset.1}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="56" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <Border Width="46" Height="54" Background="{DynamicResource Brush.Background}"><Grid>
                        <Image x:Name="AssetListThumbnail" local:AsyncThumbnail.SourcePath="{Binding ThumbnailPath}" local:AsyncThumbnail.DecodeWidth="96" Stretch="Uniform" />
                        <TextBlock Text="缩略图失败" Foreground="{DynamicResource Brush.Text.Primary}" Background="{DynamicResource Brush.Surface.Elevated}" Padding="2" FontSize="{DynamicResource Type.Caption.FontSize}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Visibility="{Binding ElementName=AssetListThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                   AutomationProperties.AutomationId="AssetThumbnailFailure" />
                    </Grid></Border>
                    <TextBlock Grid.Column="1" Text="{Binding Asset.DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="{DynamicResource SpacingHorizontal8}" />
                    <TextBlock Grid.Column="2" Text="{Binding Asset.MediaType}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="3" Text="{Binding DimensionsText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="4" Text="{Binding CaptureTimeText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="5" Text="{Binding AddedTimeText}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="6" Text="{Binding Asset.Rating, StringFormat=★ {0}}" VerticalAlignment="Center" Style="{DynamicResource PixelTart.Type.Metadata}" />
                    <TextBlock Grid.Column="7" Text="{Binding TagSummary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Style="{DynamicResource PixelTart.Type.Metadata}" />
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AssetP2AdaptiveItemTemplate">
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate" Value="{StaticResource AssetGridCardTemplate}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Masonry"><Setter Property="ContentTemplate" Value="{StaticResource AssetMasonryCardTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="Justified"><Setter Property="ContentTemplate" Value="{StaticResource AssetJustifiedCardTemplate}" /></DataTrigger>
                            <DataTrigger Binding="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="List"><Setter Property="ContentTemplate" Value="{StaticResource AssetListRowTemplate}" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DataTemplate>
            </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush.Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="{DynamicResource Space.Inset.3}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="AssetLibrarySearchBox" Grid.Row="0" Grid.Column="0" MinWidth="240" Margin="{DynamicResource Space.Inline.End.1}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     PreviewKeyDown="AssetLibrarySearchBox_PreviewKeyDown"
                     ToolTip="搜索名称、标签、文件夹与备注" AutomationProperties.Name="搜索素材"
                     AutomationProperties.AutomationId="AssetLibrarySearch"
                     VerticalAlignment="Center" />
            <Button Grid.Row="0" Grid.Column="1" Content="筛选" Click="Filter_Click"
                    Margin="{DynamicResource Space.Inline.Start.1}"
                    Style="{DynamicResource PixelTart.Button.Ghost}"
                    AutomationProperties.AutomationId="AssetLibraryFilter"
                    AutomationProperties.Name="展开或收起筛选" />
            <Button Grid.Row="0" Grid.Column="2" Content="排序" Click="SortMenu_Click"
                    Margin="{DynamicResource Space.Inline.Start.1}"
                    Style="{DynamicResource PixelTart.Button.Ghost}"
                    ToolTip="选择排序字段和方向"
                    AutomationProperties.AutomationId="AssetLibrarySortMenu"
                    AutomationProperties.Name="选择素材排序" />
            <Button Grid.Row="0" Grid.Column="3" Content="布局" Click="ViewMenu_Click"
                    Margin="{DynamicResource Space.Inline.Start.1}"
                    Style="{DynamicResource PixelTart.Button.Ghost}"
                    ToolTip="网格、瀑布流、两端对齐或列表"
                    AutomationProperties.AutomationId="AssetLibraryViewMenu"
                    AutomationProperties.Name="选择素材布局" />
            <Button Grid.Row="0" Grid.Column="4" Content="导入" Margin="{DynamicResource Space.Inline.Start.1}"
                    Style="{DynamicResource PixelTart.Button.Primary}"
                    Command="{Binding ImportCommand}"
                    AutomationProperties.AutomationId="AssetLibraryImport" />
            <Button Grid.Row="0" Grid.Column="5" Content="更多" Margin="{DynamicResource Space.Inline.Start.1}" Click="More_Click"
                    Style="{DynamicResource PixelTart.Button.Ghost}"
                    AutomationProperties.AutomationId="AssetLibraryMore"
                    ToolTip="组织栏、检查器、灵感托盘与整理工具">
                <Button.ContextMenu><ContextMenu Style="{DynamicResource PixelTart.Menu.Context}" /></Button.ContextMenu>
            </Button>
            <Border Grid.Row="1" Grid.ColumnSpan="6" Margin="{DynamicResource Space.Stack.1}"
                    Style="{DynamicResource PixelTart.Surface.Panel}"
                    Visibility="{Binding P3QueryPanelOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="AssetFilterPanel">
                <local:AssetQueryComposerView />
            </Border>
        </Grid>

        <Grid Grid.Row="2" AutomationProperties.AutomationId="AssetLibraryThreePaneWorkspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="AssetOrganizationColumn"
                                  Width="{Binding OrganizationPaneColumnWidth}"
                                  MinWidth="{Binding OrganizationPaneMinimumWidth}"
                                  MaxWidth="240" />
                <ColumnDefinition Width="{Binding OrganizationSplitterColumnWidth}" />
                <ColumnDefinition x:Name="AssetCollectionColumn" Width="*" MinWidth="360" />
                <ColumnDefinition Width="{Binding InspectorSplitterColumnWidth}" />
                <ColumnDefinition x:Name="AssetInspectorColumn"
                                  Width="{Binding InspectorPaneColumnWidth}"
                                  MinWidth="{Binding InspectorPaneMinimumWidth}"
                                  MaxWidth="{DynamicResource Size.Inspector.MaxWidth}" />
            </Grid.ColumnDefinitions>

            <Border Style="{DynamicResource PixelTart.Surface.Panel}"
                    IsEnabled="{Binding IsReady}"
                    Visibility="{Binding IsOrganizationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    BorderThickness="0,0,1,0"
                    AutomationProperties.AutomationId="AssetOrganizationPane">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="分类" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                        <ItemsControl ItemsSource="{Binding SystemCollections}" Margin="0,8,0,4"
                                      AutomationProperties.AutomationId="AssetSystemCollections">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding Label}" Command="{Binding SelectCommand}"
                                            IsEnabled="{Binding IsEnabled}" HorizontalContentAlignment="Left"
                                            Style="{DynamicResource PixelTart.Button.Ghost}"
                                            AutomationProperties.AutomationId="{Binding AutomationId}"
                                            AutomationProperties.Name="{Binding AccessibleName}"
                                            ToolTip="{Binding Description}"
                                            local:AssetLibraryDragDropBehavior.DropTarget="{Binding DropTarget}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,8" />
                        <Expander Header="模块诊断" Margin="0,0,0,10"
                                  IsExpanded="{Binding IsPreviewDiagnosticsEnabled, Mode=OneWay}"
                                  Visibility="{Binding IsPreviewDiagnosticsEnabled, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  AutomationProperties.AutomationId="ModuleDiagnostics">
                            <ItemsControl ItemsSource="{Binding ModuleDiagnostics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Text}" AutomationProperties.AutomationId="{Binding AutomationId}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Space.Stack.1.Symmetric}" /></DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <DockPanel>
                            <TextBlock Text="文件夹" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                            <Button Content="+" HorizontalAlignment="Right" Command="{Binding NewFolderCommand}"
                                    Style="{DynamicResource PixelTart.Button.Ghost}"
                                    ToolTip="新建文件夹" AutomationProperties.Name="新建文件夹" />
                        </DockPanel>
                        <TextBox Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}" ToolTip="新文件夹名称" Margin="{DynamicResource Space.Stack.1}" />
                            <TextBlock Text="正在加载组织栏…" Style="{DynamicResource PixelTart.Type.Metadata}"
                                       Visibility="{Binding IsOrganizationLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationLoadingState" />
                            <TextBlock Text="{Binding OrganizationError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                                       Visibility="{Binding HasOrganizationError, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationErrorState" />
                            <TextBlock Text="还没有文件夹、智能文件夹或标签。" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap"
                                       Visibility="{Binding IsOrganizationEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       AutomationProperties.AutomationId="AssetOrganizationEmptyState" />
                            <TreeView BorderThickness="0" Background="Transparent" ItemsSource="{Binding OrganizationFolders}"
                                      AutomationProperties.AutomationId="AssetFolderTree" MaxHeight="260">
                                <TreeView.Resources>
                                    <Style TargetType="TreeViewItem">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                        <Setter Property="IsTabStop" Value="True" />
                                        <Setter Property="AutomationProperties.AutomationId" Value="{Binding AutomationId}" />
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                        <Setter Property="local:AssetLibraryDragDropBehavior.DropTarget" Value="{Binding DropTarget}" />
                                    </Style>
                                    <HierarchicalDataTemplate DataType="{x:Type local:AssetLibraryFolderNodeView}" ItemsSource="{Binding Children}">
                                        <Grid MinWidth="150" ToolTip="{Binding Path}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock x:Name="FolderNameText" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <TextBox x:Name="FolderNameEditor" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Visibility="Collapsed"
                                                     AutomationProperties.Name="重命名文件夹" />
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="6,0,2,0" VerticalAlignment="Center" />
                                            <Grid.ContextMenu>
                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                    <MenuItem Header="重命名" Command="{Binding BeginRenameCommand}" />
                                                    <MenuItem Header="完成重命名" Command="{Binding CommitRenameCommand}" />
                                                    <MenuItem Header="创建同级文件夹" Command="{Binding CreateSiblingCommand}" />
                                                    <MenuItem Header="创建子文件夹" Command="{Binding CreateChildCommand}" />
                                                    <Separator />
                                                    <MenuItem Header="向上移动" Command="{Binding MoveUpCommand}" AutomationProperties.AutomationId="AssetFolderMoveUp" />
                                                    <MenuItem Header="向下移动" Command="{Binding MoveDownCommand}" AutomationProperties.AutomationId="AssetFolderMoveDown" />
                                                    <MenuItem Header="提升一级" Command="{Binding PromoteCommand}" AutomationProperties.AutomationId="AssetFolderPromote" />
                                                    <Separator />
                                                    <MenuItem Header="归档或恢复" Command="{Binding ToggleArchiveCommand}" />
                                                </ContextMenu>
                                            </Grid.ContextMenu>
                                        </Grid>
                                        <HierarchicalDataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                <Setter TargetName="FolderNameText" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="FolderNameEditor" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </HierarchicalDataTemplate.Triggers>
                                    </HierarchicalDataTemplate>
                                </TreeView.Resources>
                            </TreeView>
                            <TextBlock Text="智能文件夹" Style="{DynamicResource PixelTart.Type.SectionTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding OrganizationSmartFolders}" AutomationProperties.AutomationId="SmartFolders">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel ToolTip="{Binding Description}">
                                            <Button DockPanel.Dock="Right" Content="编辑" Command="{Binding EditCommand}" Margin="{DynamicResource Space.Inline.Start.1}"
                                                    Style="{DynamicResource PixelTart.Button.Ghost}" AutomationProperties.Name="编辑智能文件夹条件" />
                                            <Button Content="{Binding Name}" Command="{Binding SelectCommand}" HorizontalContentAlignment="Left"
                                                    Style="{DynamicResource PixelTart.Button.Ghost}"
                                                    AutomationProperties.AutomationId="{Binding AutomationId}"
                                                    AutomationProperties.Name="{Binding AccessibleName}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="标签分组" Style="{DynamicResource PixelTart.Type.SectionTitle}" Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding OrganizationTagGroups}" AutomationProperties.AutomationId="AssetTags">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                        <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                                  AutomationProperties.AutomationId="{Binding AutomationId}"
                                                  AutomationProperties.Name="{Binding AccessibleName}">
                                            <ItemsControl ItemsSource="{Binding Children}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Command="{Binding SelectCommand}" HorizontalContentAlignment="Left"
                                                                Style="{DynamicResource PixelTart.Button.Ghost}"
                                                                AutomationProperties.AutomationId="{Binding AutomationId}"
                                                                AutomationProperties.Name="{Binding AccessibleName}"
                                                                local:AssetLibraryDragDropBehavior.DropTarget="{Binding DropTarget}">
                                                            <DockPanel><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding UsageCount}" DockPanel.Dock="Right" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="6,0,0,0" /></DockPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Expander>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" Background="{DynamicResource Brush.Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragCompleted="OnPaneSplitterDragCompleted"
                          PreviewKeyUp="OnPaneSplitterPreviewKeyUp"
                          Visibility="{Binding IsOrganizationPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="AssetOrganizationSplitter"
                          AutomationProperties.Name="调整组织栏宽度"
                          Focusable="True" IsTabStop="True" />

            <Border Grid.Column="2" Style="{DynamicResource PixelTart.Surface.Panel}" AutomationProperties.AutomationId="AssetCollectionPane">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8" IsEnabled="{Binding IsReady}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="176" /></Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentViewLabel, StringFormat={}素材{0}}" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                            <TextBlock Text="{Binding VisibleCount, StringFormat= · {0} 项}" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="{DynamicResource Space.Inline.Start.1}" VerticalAlignment="Center" />
                        </StackPanel>
                        <Slider Grid.Column="1" Minimum="120" Maximum="280" Value="{Binding ThumbnailWidth}" ToolTip="缩略图大小"
                                AutomationProperties.AutomationId="AssetThumbnailSizeSlider"
                                AutomationProperties.Name="缩略图大小"
                                Focusable="True" IsTabStop="True" />
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,8" IsEnabled="{Binding IsReady}" AutomationProperties.AutomationId="VisualFilterChips">
                        <DockPanel>
                            <ItemsControl ItemsSource="{Binding ActiveVisualChips}" AutomationProperties.AutomationId="ActiveVisualFilterChips">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.RemoveVisualChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                 Style="{DynamicResource PixelTart.Button.Ghost}"
                                                 Tag="Active"
                                                 Padding="{DynamicResource Space.Control.Compact.Padding}"
                                                 Margin="{DynamicResource Space.Inline.End.1}"
                                                AutomationProperties.Name="{Binding Label, StringFormat={}移除筛选 {0}}">
                                            <TextBlock><Run Text="{Binding Label}" /><Run Text="  ×" /></TextBlock>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button DockPanel.Dock="Right" Content="退出临时结果" Command="{Binding ClearVisualModeCommand}"
                                    Style="{DynamicResource PixelTart.Button.Secondary}"
                                    Visibility="{Binding IsTemporaryVisualMode, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="ClearVisualResults" />
                        </DockPanel>
                        <Border Margin="{DynamicResource Space.Stack.1}" Padding="{DynamicResource Space.Control.Compact.Padding}" Background="{DynamicResource Brush.Panel}"
                                Visibility="{Binding IsListView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetListColumnHeaders">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="54" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="1.6*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="预览" Style="{DynamicResource PixelTart.Type.Metadata}" />
                                <Button Grid.Column="1" Content="名称" Command="{Binding SortBrowserCommand}" CommandParameter="FileName" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortName" />
                                <TextBlock Grid.Column="2" Text="类型" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="尺寸" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                                <Button Grid.Column="4" Content="拍摄时间" Command="{Binding SortBrowserCommand}" CommandParameter="CaptureTime" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortCaptureTime" />
                                <Button Grid.Column="5" Content="添加时间" Command="{Binding SortBrowserCommand}" CommandParameter="AddedAt" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortAddedAt" />
                                <Button Grid.Column="6" Content="评分" Command="{Binding SortBrowserCommand}" CommandParameter="Rating" Style="{DynamicResource PixelTart.Button.Ghost}" Height="{DynamicResource Size.Control.Compact}" MinHeight="0" Padding="{DynamicResource Space.Control.Compact.Padding}" AutomationProperties.AutomationId="AssetListSortRating" />
                                <TextBlock Grid.Column="7" Text="标签" Style="{DynamicResource PixelTart.Type.Metadata}" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </StackPanel>

                     <local:AssetLibrarySelectionListBox x:Name="AssetGrid" BorderThickness="0" Grid.Row="2" ItemsSource="{Binding AssetCards}"
                             IsEnabled="{Binding IsReady}"
                             Background="Transparent"
                             SelectionMode="Extended" SelectionChanged="AssetGrid_SelectionChanged"
                             ItemTemplate="{StaticResource AssetP2AdaptiveItemTemplate}"
                             ItemContainerStyle="{StaticResource AssetP2ListBoxItem}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling"
                             local:AssetLibraryDragDropBehavior.IsAssetSource="True"
                             AutomationProperties.AutomationId="AssetGrid"
                             AutomationProperties.Name="素材浏览结果">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <local:VirtualizingAssetPanel
                                    ViewMode="{Binding DataContext.ViewMode, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    ThumbnailWidth="{Binding DataContext.ThumbnailWidth, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                             </ItemsPanelTemplate>
                         </ListBox.ItemsPanel>
                      </local:AssetLibrarySelectionListBox>

                      <Border Grid.Row="3" Margin="0,8,0,0" Padding="{DynamicResource Space.Inset.2}"
                              Background="{DynamicResource Brush.Panel}"
                              Visibility="{Binding IsLoadMoreVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                              AutomationProperties.AutomationId="AssetLoadMoreBar">
                          <DockPanel LastChildFill="True">
                              <Button DockPanel.Dock="Right" Content="加载更多" Command="{Binding LoadMoreCommand}"
                                      IsEnabled="{Binding CanLoadMore}"
                                      Style="{DynamicResource PixelTart.Button.Secondary}"
                                      AutomationProperties.AutomationId="AssetLoadMoreButton"
                                      AutomationProperties.Name="加载更多素材" />
                              <TextBlock Text="{Binding LoadMoreStatus}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                         VerticalAlignment="Center" TextWrapping="Wrap"
                                         AutomationProperties.AutomationId="AssetLoadMoreStatus" />
                          </DockPanel>
                      </Border>

                     <Canvas x:Name="AssetSelectionMarqueeLayer" Grid.Row="2" Panel.ZIndex="6"
                             IsHitTestVisible="False" ClipToBounds="True"
                             AutomationProperties.AutomationId="AssetSelectionMarqueeLayer">
                         <Border x:Name="AssetSelectionMarquee" Width="0" Height="0" Visibility="Collapsed"
                                 Background="{DynamicResource Brush.Accent.Subtle}" BorderBrush="{DynamicResource Brush.Accent}"
                                 BorderThickness="1" AutomationProperties.AutomationId="AssetSelectionMarquee"
                                 AutomationProperties.Name="框选范围" />
                     </Canvas>

                     <Border Grid.Row="2" Panel.ZIndex="4" Background="{DynamicResource Brush.Background}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AssetLibraryLoadingState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="5"
                                         AutomationProperties.AutomationId="AssetLibraryLoadingProgress" />
                            <TextBlock Text="正在加载素材库…" FontSize="{DynamicResource Type.SectionTitle.FontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="正在读取本地索引与已保存的视觉分析，不会修改源文件。" Style="{DynamicResource PixelTart.Type.Metadata}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Panel.ZIndex="5" Background="{DynamicResource Brush.Background}"
                            Visibility="{Binding HasLoadError, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AssetLibraryErrorState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="素材库暂时无法加载" FontSize="{DynamicResource Type.SectionTitle.FontSize}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding LoadErrorMessage}" Style="{DynamicResource PixelTart.Type.Metadata}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,12"
                                       AutomationProperties.AutomationId="AssetLibraryLoadErrorMessage" />
                            <Button Content="重试" Command="{Binding RetryLoadCommand}" HorizontalAlignment="Center"
                                    Style="{DynamicResource PixelTart.Button.Primary}"
                                    AutomationProperties.AutomationId="RetryAssetLibraryLoad"
                                    AutomationProperties.Name="重试"
                                    Focusable="True" IsTabStop="True" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Panel.ZIndex="3" Background="{DynamicResource Brush.Background}"
                            Visibility="{Binding IsEmptyStateVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                            AutomationProperties.AutomationId="AssetLibraryEmptyState">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460">
                            <TextBlock Text="{Binding EmptyStateTitle}" FontSize="{DynamicResource Type.SectionTitle.FontSize}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       AutomationProperties.AutomationId="AssetLibraryEmptyStateTitle" />
                            <TextBlock Text="{Binding EmptyStateDescription}" Style="{DynamicResource PixelTart.Type.Metadata}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,12" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="导入引用" Command="{Binding ImportCommand}" Style="{DynamicResource PixelTart.Button.Secondary}"
                                        AutomationProperties.AutomationId="ImportFromEmptyAssetLibrary" />
                                <Button Content="清除条件" Click="ClearFilters_Click" Margin="{DynamicResource Space.Inline.Start.1}"
                                        Style="{DynamicResource PixelTart.Button.Secondary}"
                                        Visibility="{Binding HasActiveQuery, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" Background="{DynamicResource Brush.Background}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                          DragCompleted="OnPaneSplitterDragCompleted"
                          PreviewKeyUp="OnPaneSplitterPreviewKeyUp"
                          Visibility="{Binding IsInspectorPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                          AutomationProperties.AutomationId="AssetInspectorSplitter"
                          AutomationProperties.Name="调整检查器宽度"
                          Focusable="True" IsTabStop="True" />

            <Border Grid.Column="4" Style="{DynamicResource PixelTart.Surface.Inspector}"
                    Visibility="{Binding IsInspectorPaneVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                    AutomationProperties.AutomationId="AssetInspectorPane">
                <ScrollViewer VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="AssetInspectorScroll">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="检查器" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                            <TextBlock Text="{Binding SelectionCount, StringFormat={}{0} 项}" Style="{DynamicResource PixelTart.Type.Metadata}" HorizontalAlignment="Right" />
                        </DockPanel>
                        <Border x:Name="AssetInspectorEmptyState" Visibility="Collapsed" AutomationProperties.AutomationId="AssetInspectorEmptyState" />
                        <StackPanel Visibility="{Binding IsSingleInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="AssetInspectorSingleState">
                        <Border Height="200" Background="{DynamicResource Brush.Background}" Margin="{DynamicResource SpacingVertical8}">
                            <Grid>
                                <Image x:Name="SelectedAssetThumbnail" local:AsyncThumbnail.SourcePath="{Binding SelectedAssetThumbnailPath}" local:AsyncThumbnail.DecodeWidth="420" Stretch="Uniform" />
                                <Border Background="{DynamicResource Brush.Surface.Elevated}" Padding="{DynamicResource Space.Control.Compact.Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ElementName=SelectedAssetThumbnail, Path=(local:AsyncThumbnail.HasFailure), Converter={StaticResource BooleanToVisibilityConverter}}"
                                        AutomationProperties.AutomationId="SelectedAssetThumbnailFailure">
                                    <TextBlock Text="{Binding ElementName=SelectedAssetThumbnail, Path=(local:AsyncThumbnail.FailureMessage)}" Foreground="{DynamicResource Brush.Text.Primary}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="{Binding SelectedAsset.DisplayName, TargetNullValue=请选择素材}" Style="{DynamicResource PixelTart.Type.SectionTitle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="项目：暂未建立关联" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="{DynamicResource Space.Stack.1}" />
                        <TextBlock Text="{Binding SingleTagSummary, StringFormat=标签：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AssetInspectorTags" AutomationProperties.Name="标签" />
                        <TextBlock Text="{Binding SelectedAsset.Rating, StringFormat=评分：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                   AutomationProperties.AutomationId="AssetInspectorRating" AutomationProperties.Name="评分" />
                        <Expander Header="拍摄信息" IsExpanded="False" Margin="{DynamicResource SpacingVertical12}">
                            <StackPanel><TextBlock Text="{Binding SelectedAsset.CaptureTime, TargetNullValue=未记录, StringFormat=拍摄时间：{0:yyyy-MM-dd HH:mm}}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                   AutomationProperties.AutomationId="AssetInspectorCaptureTime" AutomationProperties.Name="拍摄时间" /></StackPanel>
                        </Expander>
                        <Expander Header="技术信息" IsExpanded="False" Margin="{DynamicResource Space.Stack.1}">
                            <StackPanel>
                        <TextBlock Text="{Binding SingleFolderSummary, StringFormat=所属文件夹：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="AssetInspectorFolders" AutomationProperties.Name="所属文件夹" />
                        <TextBlock Text="{Binding SelectedAsset.MediaType, StringFormat=格式：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" />
                        <TextBlock Text="{Binding SelectedAsset.SourcePath, StringFormat=路径：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.AutomationId="AssetInspectorSourcePath" AutomationProperties.Name="素材路径" />
                        <TextBlock Text="{Binding SelectedAsset.FileSize, StringFormat=文件大小：{0:N0} 字节}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                   AutomationProperties.AutomationId="AssetInspectorFileSize" AutomationProperties.Name="文件大小" />
                        <TextBlock Style="{DynamicResource PixelTart.Type.Metadata}" AutomationProperties.AutomationId="AssetInspectorDimensions" AutomationProperties.Name="素材尺寸">
                            <Run Text="尺寸：" /><Run Text="{Binding SelectedAsset.Width, TargetNullValue=未知}" /><Run Text=" × " /><Run Text="{Binding SelectedAsset.Height, TargetNullValue=未知}" />
                        </TextBlock>

                        <TextBlock Text="{Binding SelectedAsset.AddedAt, StringFormat=添加时间：{0:yyyy-MM-dd HH:mm}}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                   AutomationProperties.AutomationId="AssetInspectorAddedTime" AutomationProperties.Name="添加时间" />

                        <TextBlock Text="{Binding SelectedAsset.IsMissing, StringFormat=文件缺失：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}"
                                   AutomationProperties.AutomationId="AssetInspectorMissingState" AutomationProperties.Name="文件缺失状态" />
                            </StackPanel>
                        </Expander>
                        </StackPanel>
                        <Expander AutomationProperties.AutomationId="VisualSmartFolderBuilder"
                                  Visibility="{Binding P3SmartFolderOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  IsExpanded="{Binding P3SmartFolderOpen, Mode=OneWay}"
                                  HorizontalContentAlignment="Stretch" Header="智能文件夹">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="保存" Command="{Binding SaveSmartFolderCommand}"
                                        Style="{DynamicResource PixelTart.Button.Secondary}"
                                        AutomationProperties.AutomationId="SaveVisualSmartFolder"
                                        AutomationProperties.Name="保存智能文件夹" Focusable="True" IsTabStop="True" />
                                <TextBlock Text="在“更多”中打开智能文件夹编辑器。" Style="{DynamicResource PixelTart.Type.Metadata}" />
                            </DockPanel>
                        </Expander>
                        <Border Style="{DynamicResource PixelTart.Surface.Border}" Padding="{DynamicResource Space.Inset.3}" Margin="{DynamicResource SpacingVertical8}"
                                Visibility="{Binding IsMultipleInspectorVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                                AutomationProperties.AutomationId="AssetInspectorMultipleState">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectionCount, StringFormat={}已选择 {0} 项}" Style="{DynamicResource PixelTart.Type.SectionTitle}" />
                                <TextBlock Text="{Binding MultipleFolderSummary, StringFormat={}共同文件夹：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Space.Stack.1}" />
                                <TextBlock Text="{Binding MultipleTagSummary, StringFormat={}共同标签：{0}}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Space.Stack.1}" />
                                <TextBlock Text="{Binding MultipleRatingSummary}" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource Space.Stack.1}" />
                                <TextBlock Text="批量操作只更新素材库元数据，不会修改、移动或删除源文件。" Style="{DynamicResource PixelTart.Type.Metadata}" TextWrapping="Wrap" Margin="{DynamicResource SpacingVertical8}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="2" Panel.ZIndex="30" Width="820" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MaxHeight="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Padding="{DynamicResource Space.Inset.3}" Background="{DynamicResource Brush.Surface.Elevated}"
                Style="{DynamicResource PixelTart.Surface.Border}"
                Visibility="{Binding P3SmartFolderOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:AssetSmartFolderEditorView />
        </Border>
        <Border Grid.Row="2" Panel.ZIndex="29" Width="900" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MaxHeight="620" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                Padding="{DynamicResource Space.Inset.3}" Background="{DynamicResource Brush.Surface.Elevated}"
                Style="{DynamicResource PixelTart.Surface.Border}"
                Visibility="{Binding P3TagManagerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <local:AssetTagManagerView />
        </Border>

        <Border Grid.Row="2" Panel.ZIndex="28" Width="760" MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                MaxHeight="260" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12"
                Padding="{DynamicResource Space.Inset.3}" Background="{DynamicResource Brush.Surface.Elevated}"
                Style="{DynamicResource PixelTart.Surface.Border}"
                Visibility="{Binding IsInspirationTrayOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="InspirationTrayDrawer">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="灵感托盘" FontSize="{DynamicResource Type.Body.FontSize}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding InspirationTrayCount, StringFormat={} · {0} 项}" Style="{DynamicResource PixelTart.Type.Metadata}" Margin="6,2,0,0" />
                    <Button DockPanel.Dock="Right" Content="清空" Command="{Binding ClearInspirationTrayCommand}" Style="{DynamicResource PixelTart.Button.Secondary}" Margin="12,0,0,0" AutomationProperties.AutomationId="InspirationTrayClear" />
                    <Button DockPanel.Dock="Right" Content="收起" Command="{Binding ToggleInspirationTrayCommand}" Style="{DynamicResource PixelTart.Button.Secondary}" Margin="4,0,0,0" AutomationProperties.AutomationId="InspirationTrayClose" />
                </StackPanel>
                <ListBox ItemsSource="{Binding InspirationTrayEntries}" DisplayMemberPath="Reference.AssetId" MaxHeight="190" AutomationProperties.AutomationId="InspirationTrayItems" />
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <TextBlock Text="F 聚焦分类 · Shift+D 重复分类 · T 标签 · 0–5 评分" Style="{DynamicResource PixelTart.Type.Metadata}" />
            <TextBlock Text="{Binding Status}" Style="{DynamicResource PixelTart.Type.Metadata}" HorizontalAlignment="Right" />
        </DockPanel>
    </Grid>
</UserControl>
