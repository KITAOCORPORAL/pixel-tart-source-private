          <StackPanel><TextBlock Text="发现完全重复素材" Style="{DynamicResource PixelTart.Type.SectionTitle}" /><TextBlock x:Name="DuplicateImportName" Margin="0,8" /><TextBlock Text="内容与已有素材一致。默认跳过，不修改原照片。" Style="{DynamicResource PixelTart.Type.Metadata}" />
              <Grid x:Name="DuplicateImportComparison" Visibility="Collapsed" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions><StackPanel><Image x:Name="DuplicateIncomingImage" Height="240" Stretch="Uniform" /><TextBlock x:Name="DuplicateIncomingName" TextTrimming="CharacterEllipsis" /></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><Image x:Name="DuplicateExistingImage" Height="240" Stretch="Uniform" /><TextBlock x:Name="DuplicateExistingName" TextTrimming="CharacterEllipsis" /></StackPanel></Grid>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="DuplicateSkipButton" Content="跳过" IsDefault="True" Click="DuplicateSkip_Click" Style="{DynamicResource PixelTart.Button.Primary}" /><Button Content="查看重复" Click="DuplicateView_Click" Style="{DynamicResource PixelTart.Button.Secondary}" Margin="8,0" /><Button Content="仍然导入" Click="DuplicateAnyway_Click" Style="{DynamicResource PixelTart.Button.Ghost}" /></StackPanel>
          </StackPanel>
      </Border>
    </Grid>
</UserControl>
