<UserControl x:Class="PixelTart.Modules.AssetLibrary.AssetQueryComposerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:PixelTart.Modules.AssetLibrary"
             AutomationProperties.AutomationId="P3QueryComposer"
             AutomationProperties.Name="筛选照片">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AssetLibraryP3Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <local:HueToBrushConverter x:Key="HueToBrushConverter" />
            <local:HexToBrushConverter x:Key="HexToBrushConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <ToggleButton Content="当前范围" IsChecked="{Binding IsP3CurrentScope, Mode=TwoWay}"
                              Style="{StaticResource AssetLibraryP3Toggle}"
                              AutomationProperties.AutomationId="P3QueryScopeCurrent"
                              AutomationProperties.Name="在当前文件夹、标签或集合内筛选" />
                <ToggleButton Content="全部素材" IsChecked="{Binding IsP3AllAssetsScope, Mode=TwoWay}"
                              Style="{StaticResource AssetLibraryP3Toggle}"
                              AutomationProperties.AutomationId="P3QueryScopeAllAssets"
                              AutomationProperties.Name="在全部普通素材内筛选" />
                <Button Content="筛选条件" Command="{Binding ToggleP3QueryPanelCommand}"
                        Style="{StaticResource AssetLibraryP3SecondaryButton}"
                        AutomationProperties.AutomationId="P3QueryPanelToggle"
                        AutomationProperties.Name="打开或关闭筛选条件" />
            </StackPanel>
            <TextBlock Text="{Binding P3QueryResultSummary}" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center"
                       TextAlignment="Right" AutomationProperties.AutomationId="P3QueryResultSummary"
                       AutomationProperties.Name="当前筛选范围和结果数量" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding P3QueryChips}" Margin="0,5,0,0"
                      AutomationProperties.AutomationId="P3QueryActiveChips">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding DataContext.RemoveP3ChipCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}" Content="{Binding Label, StringFormat={}{0}  ×}"
                            Tag="Active" Style="{StaticResource AssetLibraryP3ChipButton}"
                            ToolTip="移除此筛选条件"
                            AutomationProperties.AutomationId="{Binding AutomationId}"
                            AutomationProperties.Name="{Binding AccessibleName}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Margin="0,5,0,0" Style="{StaticResource AssetLibraryP3PopupSurface}"
                Visibility="{Binding P3SuggestionsVisible, Converter={StaticResource P3BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="P3QuerySuggestionsPanel"
                AutomationProperties.Name="搜索建议">
            <ScrollViewer MaxHeight="180"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding P3QuerySuggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.ApplyP3SuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" HorizontalContentAlignment="Stretch"
                                    Style="{StaticResource AssetLibraryP3SecondaryButton}"
                                    AutomationProperties.AutomationId="{Binding Value, StringFormat=P3QuerySuggestion_{0}}"
                                    AutomationProperties.Name="{Binding Label, StringFormat=使用搜索建议 {0}}">
                                <DockPanel>
                                    <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource Brush.Text.Primary}" />
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="8,0,0,0" />
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Margin="0,5,0,0" Style="{StaticResource AssetLibraryP3PopupSurface}"
                Visibility="{Binding P3QueryPanelOpen, Converter={StaticResource P3BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="P3QueryRulesPanel"
                AutomationProperties.Name="筛选条件">
            <StackPanel>
                <Border Margin="0,0,0,4" Padding="4" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="4"
                        AutomationProperties.AutomationId="AssetFilterColorPicker">
                    <StackPanel>
                        <TextBlock Text="颜色" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" />
                        <TextBlock Text="拖动色板实时筛选" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,2,0,6" />
                        <Grid x:Name="ColorPlane" Height="108" Background="{Binding ColorHue, Converter={StaticResource HueToBrushConverter}}" Cursor="Cross"
                              MouseLeftButtonDown="ColorPlane_MouseLeftButtonDown" MouseMove="ColorPlane_MouseMove" MouseLeftButtonUp="ColorPlane_MouseLeftButtonUp"
                              AutomationProperties.AutomationId="AssetFilterColorPlane" AutomationProperties.Name="二维颜色选择区">
                            <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource TextPrimaryColor}" Offset="0" /><GradientStop Color="{DynamicResource Color.Transparent}" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="{DynamicResource Color.Transparent}" Offset="0" /><GradientStop Color="{DynamicResource Color.Shadow}" Offset="1" /></LinearGradientBrush></Rectangle.Fill></Rectangle>
                            <Canvas IsHitTestVisible="False"><Ellipse x:Name="ColorPlaneCursor" Width="12" Height="12" Stroke="{DynamicResource Brush.Text.Primary}" StrokeThickness="2" /></Canvas>
                        </Grid>
                        <TextBlock Text="色相" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,7,0,2" />
                        <Border Height="4" CornerRadius="2" Background="{Binding ElementName=HueSlider, Path=Background}" />
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="{Binding ColorHue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="18"
                                AutomationProperties.AutomationId="AssetFilterHueSlider" AutomationProperties.Name="色相">
                            <Slider.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#FFFF0000" Offset="0" /><GradientStop Color="#FFFFFF00" Offset="0.166" /><GradientStop Color="#FF00FF00" Offset="0.333" /><GradientStop Color="#FF00FFFF" Offset="0.5" /><GradientStop Color="#FF0000FF" Offset="0.666" /><GradientStop Color="#FFFF00FF" Offset="0.833" /><GradientStop Color="#FFFF0000" Offset="1" /></LinearGradientBrush></Slider.Background>
                        </Slider>
                        <UniformGrid Columns="7">
                            <UniformGrid.Resources>
                                <Style x:Key="AssetLibraryP3SecondaryButton" TargetType="Button" BasedOn="{StaticResource AssetLibraryP3SecondaryButton}">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0" />
                                    <Setter Property="MinWidth" Value="0" />
                                    <Setter Property="FontSize" Value="11" />
                                </Style>
                            </UniformGrid.Resources>
                            <Button Content="红" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#D75A45" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorRed" AutomationProperties.Name="筛选红色" />
                            <Button Content="橙" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#D9822B" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorOrange" AutomationProperties.Name="筛选橙色" />
                            <Button Content="黄" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#D6B94C" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorYellow" AutomationProperties.Name="筛选黄色" />
                            <Button Content="绿" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#3E9B68" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorGreen" AutomationProperties.Name="筛选绿色" />
                            <Button Content="蓝" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#467DC2" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorBlue" AutomationProperties.Name="筛选蓝色" />
                            <Button Content="紫" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#8A65B8" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorPurple" AutomationProperties.Name="筛选紫色" />
                            <Button Content="黑白" Command="{Binding SearchPaletteColorCommand}" CommandParameter="#808080" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterColorNeutral" AutomationProperties.Name="筛选黑白灰" />
                        </UniformGrid>
                        <DockPanel Margin="0,6,0,0">
                            <TextBox Text="{Binding TargetColor, UpdateSourceTrigger=PropertyChanged}" Width="110" Style="{StaticResource AssetLibraryP3TextBox}" AutomationProperties.AutomationId="AssetFilterColorValue" AutomationProperties.Name="颜色值" />
                            <Border Width="34" Height="24" Margin="6,0,0,0" Background="{Binding TargetColor, Converter={StaticResource HexToBrushConverter}}" />
                        </DockPanel>
                        <TextBlock Text="颜色范围" Foreground="{DynamicResource Brush.Text.Secondary}" Margin="0,7,0,2" />
                        <Slider Minimum="1" Maximum="100" Value="{Binding ColorTolerance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="AssetFilterColorRange" AutomationProperties.Name="颜色范围" />
                    </StackPanel>
                </Border>
                <TextBlock Text="视觉相似" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,7">
                    <Button Content="与选中照片相似" Command="{Binding FindSimilarCommand}" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterVisualSimilar" AutomationProperties.Name="与选中照片相似" />
                    <Button Content="相似配色" Command="{Binding FindPaletteSimilarCommand}" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterPaletteSimilar" AutomationProperties.Name="查找相似配色" />
                    <Button Content="已分析" Command="{Binding VisualChipCommand}" CommandParameter="Valid" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterAnalyzed" AutomationProperties.Name="只看已分析照片" />
                    <Button Content="未分析" Command="{Binding VisualChipCommand}" CommandParameter="NotAnalyzed" Style="{StaticResource AssetLibraryP3SecondaryButton}" AutomationProperties.AutomationId="AssetFilterNotAnalyzed" AutomationProperties.Name="只看未分析照片" />
                </WrapPanel>
                <TextBlock Text="摄影与项目" Foreground="{DynamicResource Brush.Text.Primary}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <WrapPanel Margin="0,0,0,7">
                    <Button Content="项目" Command="{Binding OpenProjectFilterPickerCommand}" Style="{StaticResource AssetLibraryP3SecondaryButton}"
                            AutomationProperties.AutomationId="AssetFilterProject" AutomationProperties.Name="按项目筛选" />
                    <TextBlock Text="相机 · 镜头 · 日期 · 文件夹 · 标签可在下方条件中选择" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                </WrapPanel>
                <DockPanel LastChildFill="True">
                    <WrapPanel DockPanel.Dock="Left">
                        <Button Content="清除未锁定" Command="{Binding ClearP3UnlockedCommand}"
                                Style="{StaticResource AssetLibraryP3SecondaryButton}"
                                AutomationProperties.AutomationId="P3QueryClearUnlocked"
                                AutomationProperties.Name="清除所有没有锁定的筛选条件" />
                        <Button Content="清除全部" Command="{Binding ClearP3AllCommand}"
                                Style="{StaticResource AssetLibraryP3DangerButton}"
                                AutomationProperties.AutomationId="P3QueryClearAll"
                                AutomationProperties.Name="清除全部筛选条件" />
                    </WrapPanel>
                    <TextBlock Text="锁定条件会在切换文件夹或标签后保留。" Foreground="{DynamicResource Brush.Text.Secondary}" VerticalAlignment="Center" />
                </DockPanel>

                <TreeView ItemsSource="{Binding P3QueryRoots}" ItemTemplate="{StaticResource AssetLibraryP3QueryNodeTemplate}"
                          ItemContainerStyle="{StaticResource AssetLibraryP3TreeItem}"
                          Style="{StaticResource AssetLibraryP3Tree}" Margin="0,7,0,0"
                          AutomationProperties.AutomationId="P3QueryRuleTree"
                          AutomationProperties.Name="照片筛选条件" />

                <Border Margin="0,6,0,0" Style="{StaticResource AssetLibraryP3ErrorSurface}"
                        Visibility="{Binding P3QueryHasError, Converter={StaticResource P3BooleanToVisibilityConverter}}">
                    <TextBlock Text="{Binding P3QueryValidationMessage}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="P3QueryValidationError"
                               AutomationProperties.Name="筛选条件错误" />
                </Border>

                <DockPanel Margin="0,7,0,0" LastChildFill="False">
                    <TextBox Text="{Binding P3NewSmartFolderName, UpdateSourceTrigger=PropertyChanged}" Width="210"
                             Style="{StaticResource AssetLibraryP3TextBox}"
                             ToolTip="输入名称后，把当前筛选保存为智能文件夹"
                             AutomationProperties.AutomationId="P3QuerySmartFolderName"
                             AutomationProperties.Name="新智能文件夹名称" />
                    <Button Content="保存为智能文件夹" Command="{Binding SaveP3QueryAsSmartFolderCommand}"
                            Style="{StaticResource AssetLibraryP3PrimaryButton}" Margin="6,0,0,0"
                            AutomationProperties.AutomationId="P3QuerySaveAsSmartFolder"
                            AutomationProperties.Name="把当前条件保存为智能文件夹" />
                </DockPanel>

                <Expander Header="搜索历史" Margin="0,7,0,0" Foreground="{DynamicResource Brush.Text.Primary}"
                          AutomationProperties.AutomationId="P3QueryHistory"
                          AutomationProperties.Name="搜索历史">
                    <StackPanel Margin="5">
                        <Button Content="清空历史" Command="{Binding ClearP3HistoryCommand}"
                                HorizontalAlignment="Left" Style="{StaticResource AssetLibraryP3DangerButton}"
                                AutomationProperties.AutomationId="P3QueryHistoryClear"
                                AutomationProperties.Name="清空全部搜索历史" />
                        <ItemsControl ItemsSource="{Binding P3QueryHistory}" Margin="0,5,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="删除"
                                                Command="{Binding DataContext.RemoveP3HistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Style="{StaticResource AssetLibraryP3DangerButton}"
                                                AutomationProperties.AutomationId="{Binding Text, StringFormat=P3QueryHistoryRemove_{0}}"
                                                AutomationProperties.Name="{Binding Text, StringFormat=删除搜索历史 {0}}" />
                                        <Button Content="{Binding Text}"
                                                Command="{Binding DataContext.ApplyP3HistoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource AssetLibraryP3SecondaryButton}"
                                                AutomationProperties.AutomationId="{Binding Text, StringFormat=P3QueryHistoryUse_{0}}"
                                                AutomationProperties.Name="{Binding Text, StringFormat=再次搜索 {0}}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
