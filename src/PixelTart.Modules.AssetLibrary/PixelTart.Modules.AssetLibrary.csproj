<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PixelTart.Modules.AssetLibrary</RootNamespace>
    <DefineConstants Condition="'$(ModularHarnessDevPreview)' == 'true' and '$(AssetLibraryP1AutomatedAcceptance)' == 'true' and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' == 'Debug'">$(DefineConstants);ASSET_LIBRARY_P1_AUTOMATED_ACCEPTANCE</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PixelTart.Kernel\PixelTart.Kernel.csproj" />
    <ProjectReference Include="..\RAWSelectionAssistant.Core\RAWSelectionAssistant.Core.csproj" />
  </ItemGroup>
</Project>
