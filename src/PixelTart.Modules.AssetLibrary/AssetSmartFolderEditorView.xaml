<UserControl x:Class="PixelTart.Modules.AssetLibrary.AssetSmartFolderEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.AutomationId="P3SmartFolderEditor"
             AutomationProperties.Name="智能文件夹通用规则编辑器">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="AssetLibraryP3Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  MaxHeight="220" ClipToBounds="True">
    <StackPanel>
        <Button Content="新建智能文件夹" Command="{Binding NewP3SmartFolderCommand}" HorizontalAlignment="Left" Margin="0,7,0,0"
                Style="{StaticResource AssetLibraryP3SecondaryButton}"
                Visibility="{Binding P3SmartFolderClosed, Converter={StaticResource P3BooleanToVisibilityConverter}}"
                AutomationProperties.AutomationId="P3SmartFolderNew"
                AutomationProperties.Name="打开新建智能文件夹通用规则编辑器" />
    <Border Margin="0,7,0,0" Style="{StaticResource AssetLibraryP3PopupSurface}"
            Visibility="{Binding P3SmartFolderOpen, Converter={StaticResource P3BooleanToVisibilityConverter}}">
        <StackPanel>
            <DockPanel>
                <TextBlock Text="{Binding P3SmartFolderTitle}" FontSize="16" FontWeight="SemiBold"
                           Foreground="#F2F6F7" VerticalAlignment="Center" />
                <WrapPanel DockPanel.Dock="Right">
                    <Button Content="复制" Command="{Binding CopyP3SmartFolderCommand}"
                            Style="{StaticResource AssetLibraryP3SecondaryButton}"
                            AutomationProperties.AutomationId="P3SmartFolderCopy"
                            AutomationProperties.Name="复制当前智能文件夹" />
                    <Button Content="{Binding P3SmartFolderArchiveLabel}" Command="{Binding ToggleArchiveP3SmartFolderCommand}"
                            Style="{StaticResource AssetLibraryP3DangerButton}"
                            AutomationProperties.AutomationId="P3SmartFolderArchiveToggle"
                            AutomationProperties.Name="归档或恢复当前智能文件夹" />
                    <Button Content="取消" Command="{Binding CancelP3SmartFolderCommand}"
                            Style="{StaticResource AssetLibraryP3SecondaryButton}"
                            AutomationProperties.AutomationId="P3SmartFolderCancel"
                            AutomationProperties.Name="取消编辑且不保存" />
                    <Button Content="保存" Command="{Binding SaveP3SmartFolderCommand}"
                            Style="{StaticResource AssetLibraryP3PrimaryButton}"
                            AutomationProperties.AutomationId="P3SmartFolderSave"
                            AutomationProperties.Name="保存智能文件夹名称、说明和规则" />
                </WrapPanel>
            </DockPanel>

            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="230" /><ColumnDefinition Width="10" /><ColumnDefinition /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="名称" Foreground="#CBD5DA" />
                    <TextBox Text="{Binding P3SmartFolderName, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AssetLibraryP3TextBox}"
                             AutomationProperties.AutomationId="P3SmartFolderName"
                             AutomationProperties.Name="智能文件夹名称" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="说明" Foreground="#CBD5DA" />
                    <TextBox Text="{Binding P3SmartFolderDescription, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource AssetLibraryP3TextBox}"
                             AutomationProperties.AutomationId="P3SmartFolderDescription"
                             AutomationProperties.Name="智能文件夹说明" />
                </StackPanel>
            </Grid>

            <WrapPanel Margin="0,7,0,0">
                <TextBlock Text="排序" Foreground="#CBD5DA" VerticalAlignment="Center" Margin="0,0,5,0" />
                <ComboBox ItemsSource="{Binding P3SmartFolderSortFieldOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding P3SmartFolderSortField, Mode=TwoWay}" Width="145"
                          Style="{StaticResource AssetLibraryP3ComboBox}"
                          AutomationProperties.AutomationId="P3SmartFolderSortField"
                          AutomationProperties.Name="智能文件夹排序字段" />
                <ComboBox ItemsSource="{Binding P3SmartFolderSortDirectionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value"
                          SelectedValue="{Binding P3SmartFolderSortDirection, Mode=TwoWay}" Width="105" Margin="5,0,0,0"
                          Style="{StaticResource AssetLibraryP3ComboBox}"
                          AutomationProperties.AutomationId="P3SmartFolderSortDirection"
                          AutomationProperties.Name="智能文件夹排序方向" />
                <ToggleButton Content="包含已归档素材" IsChecked="{Binding P3SmartFolderIncludeArchived, Mode=TwoWay}"
                              Style="{StaticResource AssetLibraryP3Toggle}" Margin="5,0,0,0"
                              AutomationProperties.AutomationId="P3SmartFolderIncludeArchived"
                              AutomationProperties.Name="切换智能文件夹是否包含已归档素材" />
                <TextBlock Text="{Binding P3SmartFolderPreservedScopeAndSearch}" Foreground="#ADB8C0"
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           AutomationProperties.AutomationId="P3SmartFolderPreservedScopeAndSearch"
                           AutomationProperties.Name="智能文件夹保留的范围与搜索条件" />
            </WrapPanel>

            <Grid Margin="0,7,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="330">
                    <TreeView ItemsSource="{Binding P3SmartFolderRoots}" ItemTemplate="{StaticResource AssetLibraryP3QueryNodeTemplate}"
                              ItemContainerStyle="{StaticResource AssetLibraryP3TreeItem}"
                              Style="{StaticResource AssetLibraryP3Tree}"
                              AutomationProperties.AutomationId="P3SmartFolderRuleTree"
                              AutomationProperties.Name="可嵌套的智能文件夹规则树" />
                </ScrollViewer>
                <Border Grid.Column="2" Style="{StaticResource AssetLibraryP3PopupSurface}"
                        AutomationProperties.AutomationId="P3SmartFolderPreview"
                        AutomationProperties.Name="智能文件夹实时预览">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="实时预览" FontWeight="SemiBold" Foreground="#F2F6F7" />
                            <Button DockPanel.Dock="Right" Content="重试预览" Command="{Binding RetryP3SmartFolderPreviewCommand}"
                                    Style="{StaticResource AssetLibraryP3SecondaryButton}"
                                    AutomationProperties.AutomationId="P3SmartFolderPreviewRetry"
                                    AutomationProperties.Name="重新计算智能文件夹预览" />
                        </DockPanel>
                        <TextBlock Text="{Binding P3SmartFolderPreviewStatus}" Foreground="#CBD5DA" Margin="0,5,0,0" TextWrapping="Wrap"
                                   AutomationProperties.AutomationId="P3SmartFolderPreviewStatus"
                                   AutomationProperties.Name="预览状态、结果数和耗时" />
                        <ItemsControl ItemsSource="{Binding P3SmartFolderPreviewItems}" Margin="0,5,0,0"
                                      AutomationProperties.AutomationId="P3SmartFolderPreviewItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayName}" Foreground="#F2F6F7" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding DisplayName}"
                                               AutomationProperties.Name="{Binding DisplayName, StringFormat=预览素材 {0}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,6,0,0" Style="{StaticResource AssetLibraryP3ErrorSurface}"
                    Visibility="{Binding P3SmartFolderHasError, Converter={StaticResource P3BooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding P3SmartFolderValidationMessage}" Foreground="#FFCBC5" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="P3SmartFolderValidationError"
                           AutomationProperties.Name="智能文件夹规则错误" />
            </Border>
        </StackPanel>
    </Border>
    </StackPanel>
    </ScrollViewer>
</UserControl>
