<UserControl x:Class="PixelTart.Modules.AssetLibrary.AssetInspectorTagPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="272" AutomationProperties.Name="选择素材标签">
    <UserControl.Resources>
        <DataTemplate x:Key="TagChoice">
            <CheckBox IsChecked="{Binding IsChecked, Mode=OneWay}" IsThreeState="True"
                      Command="{Binding ToggleCommand}" Content="{Binding Label}" ToolTip="{Binding Name}"
                      AutomationProperties.Name="{Binding Label}" MinHeight="30" Margin="0,2" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Margin="8" IsEnabled="{Binding CanEditInspectorRelations}">
        <TextBox Text="{Binding InspectorTagSearch, UpdateSourceTrigger=PropertyChanged}" MaxLength="120"
                 ToolTip="搜索标签或输入新标签名称" AutomationProperties.AutomationId="AssetInspectorTagSearch" AutomationProperties.Name="搜索标签" />
        <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0">
            <StackPanel>
                <TextBlock Text="已选标签" Foreground="{DynamicResource Brush.Text.Muted}" />
                <ItemsControl ItemsSource="{Binding InspectorSelectedTags}" ItemTemplate="{StaticResource TagChoice}" />
                <Separator Margin="0,6" />
                <TextBlock Text="可用标签" Foreground="{DynamicResource Brush.Text.Muted}" />
                <ItemsControl ItemsSource="{Binding InspectorAvailableTags}" ItemTemplate="{StaticResource TagChoice}" />
            </StackPanel>
        </ScrollViewer>
        <Button Content="{Binding InspectorCreateTagLabel}" Command="{Binding CreateInspectorTagCommand}"
                Style="{DynamicResource PixelTart.Button.Ghost}" Margin="0,8,0,0" HorizontalContentAlignment="Left"
                AutomationProperties.AutomationId="AssetInspectorCreateTag" />
    </StackPanel>
</UserControl>
