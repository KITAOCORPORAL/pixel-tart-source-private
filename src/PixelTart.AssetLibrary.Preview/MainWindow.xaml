<Window x:Class="PixelTart.AssetLibrary.Preview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PixelTart.AssetLibrary.Preview"
        Title="像素蛋挞 · 素材库开发预览" Width="1500" Height="900" MinWidth="1120" MinHeight="680" Loaded="OnLoaded" Closed="OnClosed">
    <Window.Resources><local:AssetThumbnailConverter x:Key="Thumb" /></Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="Pixel Tart Asset Library" FontSize="25" FontWeight="SemiBold" /><TextBlock Text="虚拟分类与元数据索引 · 默认不移动、不改名、不删除源文件" Style="{StaticResource Caption}" Margin="0,4,0,0" /></StackPanel>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.AutomationId="AssetLibrarySearch" />
            <Button Grid.Column="2" Content="搜索" Command="{Binding RefreshCommand}" VerticalAlignment="Center" Margin="8,0,6,0" />
            <Button Grid.Column="3" Content="导入引用" Style="{StaticResource PrimaryButton}" Command="{Binding ImportCommand}" VerticalAlignment="Center" AutomationProperties.AutomationId="AssetLibraryImport" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <Grid><TextBlock Text="虚拟文件夹" Style="{StaticResource Section}" /><Button Content="+" HorizontalAlignment="Right" Command="{Binding NewFolderCommand}" /></Grid>
                    <TextBlock Text="F：打开分类工具 · Shift+D：重复上次文件夹分类" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,4,0,4" />
                    <ListBox x:Name="FolderList" ItemsSource="{Binding Folders}" SelectedItem="{Binding SelectedFolder}" DisplayMemberPath="Name" Margin="0,8,0,16" AutomationProperties.AutomationId="AssetFolders" />
                    <TextBlock Text="智能文件夹" Style="{StaticResource Section}" /><ListBox ItemsSource="{Binding SmartFolders}" SelectedItem="{Binding SelectedSmartFolder}" DisplayMemberPath="Name" Margin="0,8,0,16" AutomationProperties.AutomationId="SmartFolders" />
                    <Grid><TextBlock Text="标签" Style="{StaticResource Section}" /><Button Content="+" HorizontalAlignment="Right" Command="{Binding NewTagCommand}" /></Grid>
                    <ListBox ItemsSource="{Binding Tags}" SelectedItem="{Binding SelectedTag}" DisplayMemberPath="Name" Margin="0,8,0,14" AutomationProperties.AutomationId="AssetTags" />
                    <Button Content="清除筛选" HorizontalAlignment="Left" Click="ClearFilters_Click" />
                </StackPanel></ScrollViewer>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Panel}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8"><TextBlock Text="素材网格" Style="{StaticResource Section}" /><TextBlock Text="{Binding VisibleCount, StringFormat=可见 {0:N0}}" Style="{StaticResource Caption}" HorizontalAlignment="Right" /></DockPanel>
                    <ListBox x:Name="AssetGrid" Grid.Row="1" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="AssetGrid" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Width" Value="186" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Margin" Value="0,0,0,6" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><Border Width="174" Height="160" Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Margin="4" Padding="6"><Grid><Grid.RowDefinitions><RowDefinition Height="116" /><RowDefinition Height="*" /></Grid.RowDefinitions><Border Background="#0D0F10"><Image Source="{Binding SourcePath, Converter={StaticResource Thumb}}" Stretch="UniformToFill" /></Border><StackPanel Grid.Row="1" Margin="2,5,2,0"><TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding MediaType}" Style="{StaticResource Caption}" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Panel}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="检查器" Style="{StaticResource Section}" />
                    <Border Height="180" Background="#0D0F10" Margin="0,10,0,12"><Image Source="{Binding SelectedAsset.SourcePath, Converter={StaticResource Thumb}}" Stretch="Uniform" /></Border>
                    <TextBlock Text="{Binding SelectedAsset.DisplayName, TargetNullValue=请选择素材}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding SelectedAsset.SourcePath, TargetNullValue=来源路径会显示在这里}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <TextBlock Text="{Binding SelectedAsset.MediaType, StringFormat=媒体类型：{0}}" Style="{StaticResource Caption}" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding SelectedAsset.FileSize, StringFormat=文件大小：{0:N0} bytes}" Style="{StaticResource Caption}" />
                    <TextBlock Text="{Binding SelectedAsset.Rating, StringFormat=评分：{0}/5}" Style="{StaticResource Caption}" />
                    <WrapPanel Margin="0,16,0,0"><Button Content="加入文件夹" Command="{Binding AddFolderCommand}" /><Button Content="添加标签" Command="{Binding AddTagCommand}" /></WrapPanel>
                    <Button Content="撤销上一项" Command="{Binding UndoCommand}" HorizontalAlignment="Left" Margin="0,8,0,0" />
                    <Border Background="#28231C" BorderBrush="{StaticResource AccentDarkBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,18,0,0"><TextBlock Text="安全：引用模式仅写入 metadata。移除分类或标签不会删除源文件。" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" /></Border>
                </StackPanel></ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,10,0,0"><TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" VerticalAlignment="Center" /><Button Content="加载更多" Command="{Binding LoadMoreCommand}" HorizontalAlignment="Right" /></DockPanel>
    </Grid>
</Window>
