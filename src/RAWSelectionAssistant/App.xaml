<Application x:Class="RAWSelectionAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/DesignSystem/PixelTart.Theme.xaml" />
                <!-- Base control styles are application-level prerequisites for semantic component
                     dictionaries that use StaticResource BasedOn chains. -->
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Buttons.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Cards.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/PixelTart.Components.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
