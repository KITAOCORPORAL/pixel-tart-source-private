<Application x:Class="RAWSelectionAssistant.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Replaceable runtime theme slot. AppearanceService depends on this top-level entry. -->
                <ResourceDictionary Source="Resources/DesignSystem/Theme.Dark.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/PixelTart.Theme.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/PixelTart.Components.xaml" />
                <!-- Compatibility markers: DesignTokens.xaml and Controls.Status.xaml are loaded by the canonical/compatibility entries below. -->

                <!--
                    Transitional top-level compatibility layer. WPF static-resource lookup from
                    compiled views does not reliably traverse a nested aggregate dictionary.
                    Keep these entries until their page references have migrated, then remove them
                    one dictionary at a time. PixelTart.Components remains the canonical API.
                -->
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Buttons.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Inputs.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Cards.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Tables.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Navigation.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Icons.Navigation.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Icons.Tools.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Dialogs.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Controls.Status.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Buttons.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Inputs.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Cards.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Navigation.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Icons.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Calendar.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Modal.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Drawer.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/Tooltip.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/ContextMenu.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/ScrollBars.xaml" />
                <ResourceDictionary Source="Resources/DesignSystem/EmptyState.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
