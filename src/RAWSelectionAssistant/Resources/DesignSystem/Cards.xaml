<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="WorkspaceSurface" TargetType="Border"><Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" /></Style>
    <Style x:Key="PanelSurface" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface01Brush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" /><Setter Property="Padding" Value="16" /></Style>
    <Style x:Key="CardSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="Background" Value="{DynamicResource Surface02Brush}" /></Style>
    <Style x:Key="ElevatedSurface" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /></Style>
    <Style x:Key="SemanticInfoPanel" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}" /></Style>
    <Style x:Key="SemanticWarningPanel" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" /></Style>
    <Style x:Key="SemanticDangerPanel" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" /></Style>
    <Style x:Key="SemanticSuccessPanel" TargetType="Border" BasedOn="{StaticResource PanelSurface}"><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></Style>
</ResourceDictionary>
