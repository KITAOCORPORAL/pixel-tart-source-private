<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="Icon20" TargetType="Path"><Setter Property="Width" Value="20" /><Setter Property="Height" Value="20" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="Fill" Value="Transparent" /><Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="StrokeThickness" Value="1.6" /><Setter Property="StrokeLineJoin" Value="Round" /><Setter Property="StrokeStartLineCap" Value="Round" /><Setter Property="StrokeEndLineCap" Value="Round" /></Style>
    <Style x:Key="Icon22" TargetType="Path" BasedOn="{StaticResource Icon20}"><Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" /></Style>
    <Style x:Key="PhotographyPinIcon" TargetType="Path" BasedOn="{StaticResource Icon20}"><Setter Property="Fill" Value="{DynamicResource PhotographyGoldBrush}" /><Setter Property="Stroke" Value="{DynamicResource PhotographyGoldBrush}" /></Style>
</ResourceDictionary>
