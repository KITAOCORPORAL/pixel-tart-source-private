<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Single semantic theme entry point. Keep the legacy dictionaries nested so existing views
         can migrate incrementally without changing runtime theme behavior. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Theme.Dark.xaml" />
        <ResourceDictionary Source="AccentColors.xaml" />
        <ResourceDictionary Source="Spacing.xaml" />
        <ResourceDictionary Source="Radius.xaml" />
        <ResourceDictionary Source="DesignTokens.xaml" />
        <ResourceDictionary Source="Elevation.xaml" />
        <ResourceDictionary Source="Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
