<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Pixel Tart Design System v1.0 token entry point.
        Theme.Dark/Light/HighContrast stays in App.xaml as the replaceable runtime slot.
        Legacy dictionaries remain merged here until all pages have migrated.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/DesignSystem/AccentColors.xaml" />
        <ResourceDictionary Source="/Resources/DesignSystem/Spacing.xaml" />
        <ResourceDictionary Source="/Resources/DesignSystem/Radius.xaml" />
        <ResourceDictionary Source="/Resources/DesignSystem/DesignTokens.xaml" />
        <ResourceDictionary Source="/Resources/DesignSystem/Typography.xaml" />
        <ResourceDictionary Source="/Resources/DesignSystem/Elevation.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>
