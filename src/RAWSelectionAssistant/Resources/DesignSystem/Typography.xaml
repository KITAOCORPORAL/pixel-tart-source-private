<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="ChineseFontFamily">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="LatinNumericFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="Font.Family.UI">Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="Font.Family.Numeric">Segoe UI Variable, Segoe UI</FontFamily>
    <sys:Double x:Key="Type.Display.FontSize">32</sys:Double>
    <sys:Double x:Key="Type.PageTitle.FontSize">24</sys:Double>
    <sys:Double x:Key="Type.SectionTitle.FontSize">16</sys:Double>
    <sys:Double x:Key="Type.Body.FontSize">14</sys:Double>
    <sys:Double x:Key="Type.Metadata.FontSize">12</sys:Double>
    <sys:Double x:Key="Type.Caption.FontSize">12</sys:Double>
    <sys:Double x:Key="Type.Display.LineHeight">40</sys:Double>
    <sys:Double x:Key="Type.PageTitle.LineHeight">32</sys:Double>
    <sys:Double x:Key="Type.SectionTitle.LineHeight">24</sys:Double>
    <sys:Double x:Key="Type.Body.LineHeight">22</sys:Double>
    <sys:Double x:Key="Type.Metadata.LineHeight">18</sys:Double>
    <sys:Double x:Key="Type.Caption.LineHeight">16</sys:Double>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource ChineseFontFamily}" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /><Setter Property="TextOptions.TextRenderingMode" Value="ClearType" /><Setter Property="Background" Value="{DynamicResource WindowBackgroundBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource ChineseFontFamily}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" /><Setter Property="TextOptions.TextFormattingMode" Value="Display" /></Style>
    <Style x:Key="AppTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource HeroFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="PageTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource PageTitleFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="HeroText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource HeroFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="SectionTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="CardTitleText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource CardFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="BodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
    <Style x:Key="SecondaryBodyText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
    <Style x:Key="CaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource MinimumCaptionFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /></Style>
    <Style x:Key="MinimumCaptionText" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource MinimumCaptionFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style x:Key="NumericLargeText" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource LatinNumericFontFamily}" /><Setter Property="FontSize" Value="{DynamicResource NumericLargeFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    <Style x:Key="PixelTart.Type.Display" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.Display.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.Display.LineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Style>
    <Style x:Key="PixelTart.Type.PageTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.PageTitle.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.PageTitle.LineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Style>
    <Style x:Key="PixelTart.Type.SectionTitle" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.SectionTitle.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.SectionTitle.LineHeight}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Style>
    <Style x:Key="PixelTart.Type.Body" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.Body.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.Body.LineHeight}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" /></Style>
    <Style x:Key="PixelTart.Type.Metadata" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.Metadata.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.Metadata.LineHeight}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" /></Style>
    <Style x:Key="PixelTart.Type.Caption" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" /><Setter Property="FontSize" Value="{StaticResource Type.Caption.FontSize}" /><Setter Property="LineHeight" Value="{StaticResource Type.Caption.LineHeight}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" /></Style>
</ResourceDictionary>
