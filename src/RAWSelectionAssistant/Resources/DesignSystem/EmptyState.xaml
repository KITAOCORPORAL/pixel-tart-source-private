<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="EmptyStateContainer" TargetType="Border"><Setter Property="Background" Value="Transparent" /><Setter Property="Padding" Value="32" /><Setter Property="MinHeight" Value="160" /></Style>
    <Style x:Key="EmptyStateIcon" TargetType="Path" BasedOn="{StaticResource Av2NavigationIcon}"><Setter Property="Width" Value="40" /><Setter Property="Height" Value="40" /><Setter Property="Stroke" Value="{DynamicResource TextMutedBrush}" /></Style>
    <Style x:Key="Av2EmptyStateTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SectionFontSize}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
    <Style x:Key="EmptyStateDescription" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SecondaryFontSize}" /><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="MaxWidth" Value="440" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
</ResourceDictionary>
