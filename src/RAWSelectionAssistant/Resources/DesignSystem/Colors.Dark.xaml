<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pixel Tart A-v2 locked dark palette. Legacy aliases remain in Theme.Dark.xaml. -->
    <!-- Pixel Tart Original Palette: graphite, mineral, oxidized copper and warm silver. -->
    <Color x:Key="AppBackgroundColor">#111312</Color>
    <Color x:Key="Surface01Color">#191B19</Color>
    <Color x:Key="Surface02Color">#222522</Color>
    <Color x:Key="Surface03Color">#2B2F2C</Color>
    <Color x:Key="SurfaceElevatedColor">#353A36</Color>
    <Color x:Key="BorderSubtleColor">#343936</Color>
    <Color x:Key="BorderStrongColor">#555C56</Color>
    <Color x:Key="TextPrimaryColor">#E7E5E1</Color>
    <Color x:Key="TextSecondaryColor">#A8A49F</Color>
    <Color x:Key="TextMutedColor">#77736F</Color>
    <Color x:Key="TextDisabledColor">#5D625E</Color>
    <Color x:Key="PrimaryColor">#6E9B91</Color>
    <Color x:Key="PrimaryHoverColor">#86B0A5</Color>
    <Color x:Key="PrimaryPressedColor">#567B73</Color>
    <Color x:Key="PhotographyGoldColor">#C79B5B</Color>
    <Color x:Key="SuccessColor">#42B883</Color>
    <Color x:Key="WarningColor">#E0AD43</Color>
    <Color x:Key="DangerColor">#D85A5A</Color>
    <Color x:Key="InfoColor">#4E8FD4</Color>
    <Color x:Key="CalendarFreeColor">#59616B</Color>
    <Color x:Key="CalendarScheduledColor">#E05252</Color>
    <Color x:Key="CalendarShotColor">#3DB879</Color>
    <Color x:Key="CalendarPendingReturnColor">#DDAF32</Color>
    <Color x:Key="CalendarReturnedColor">#3E8ED0</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="Surface01Brush" Color="{StaticResource Surface01Color}" />
    <SolidColorBrush x:Key="Surface02Brush" Color="{StaticResource Surface02Color}" />
    <SolidColorBrush x:Key="Surface03Brush" Color="{StaticResource Surface03Color}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <Color x:Key="TextValueColor">#C8BEAD</Color>
    <Color x:Key="TextValueStrongColor">#DDD2BE</Color>
    <Color x:Key="RatingEmptyColor">#55514E</Color>
    <Color x:Key="RatingPreviewColor">#BA9659</Color>
    <Color x:Key="RatingCommittedColor">#D1AB6A</Color>
    <Color x:Key="MetadataValueSurfaceColor">#211F27</Color>
    <Color x:Key="FilmstripActiveBorderColor">#86B0A5</Color>
    <Color x:Key="FilmstripSelectedBorderColor">#52756E</Color>
    <SolidColorBrush x:Key="TextValueBrush" Color="{StaticResource TextValueColor}" />
    <SolidColorBrush x:Key="TextValueStrongBrush" Color="{StaticResource TextValueStrongColor}" />
    <SolidColorBrush x:Key="RatingEmptyBrush" Color="{StaticResource RatingEmptyColor}" />
    <SolidColorBrush x:Key="RatingPreviewBrush" Color="{StaticResource RatingPreviewColor}" />
    <SolidColorBrush x:Key="RatingCommittedBrush" Color="{StaticResource RatingCommittedColor}" />
    <SolidColorBrush x:Key="MetadataValueSurfaceBrush" Color="{StaticResource MetadataValueSurfaceColor}" />
    <SolidColorBrush x:Key="FilmstripActiveBorderBrush" Color="{StaticResource FilmstripActiveBorderColor}" />
    <SolidColorBrush x:Key="FilmstripSelectedBorderBrush" Color="{StaticResource FilmstripSelectedBorderColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PhotographyGoldBrush" Color="{StaticResource PhotographyGoldColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="CalendarFreeBrush" Color="{StaticResource CalendarFreeColor}" />
    <SolidColorBrush x:Key="CalendarScheduledBrush" Color="{StaticResource CalendarScheduledColor}" />
    <SolidColorBrush x:Key="CalendarShotBrush" Color="{StaticResource CalendarShotColor}" />
    <SolidColorBrush x:Key="CalendarPendingReturnBrush" Color="{StaticResource CalendarPendingReturnColor}" />
    <SolidColorBrush x:Key="CalendarReturnedBrush" Color="{StaticResource CalendarReturnedColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#F8F5FA" />
    <SolidColorBrush x:Key="CalendarFreeForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarScheduledForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarShotForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarPendingReturnForegroundBrush" Color="#1D1503" />
    <SolidColorBrush x:Key="CalendarReturnedForegroundBrush" Color="#FFFFFF" />

    <!-- Pixel Tart v1.0 canonical semantic aliases. -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Surface01Color}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Surface03Color}" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Surface02Color}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Active" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="{StaticResource PrimaryColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#F8F5FA" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#D10E0D12" />
    <Color x:Key="Color.Shadow">#000000</Color>
    <Color x:Key="Color.Transparent">#00000000</Color>
</ResourceDictionary>
