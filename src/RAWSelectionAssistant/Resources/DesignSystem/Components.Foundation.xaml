<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Canonical Button API. Loading is an explicit, layout-stable style. -->
    <ControlTemplate x:Key="PixelTart.Button.Template" TargetType="Button">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="FocusRing"
                    Margin="-3"
                    BorderBrush="Transparent"
                    BorderThickness="2"
                    CornerRadius="{DynamicResource RadiusControl}" />
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{DynamicResource RadiusControl}"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  RecognizesAccessKey="True" />
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.54" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PixelTart.Button.Base" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family.UI}" />
        <Setter Property="FontSize" Value="{DynamicResource Type.Body.FontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control.Default}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Control.Padding}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template" Value="{StaticResource PixelTart.Button.Template}" />
    </Style>
    <Style x:Key="PixelTart.Button.Primary" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Active}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PixelTart.Button.Secondary" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Base}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Panel}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PixelTart.Button.Ghost" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style x:Key="PixelTart.Button.Danger" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Secondary}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error}" />
    </Style>
    <Style x:Key="PixelTart.Button.Loading" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Secondary}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- Canonical surface API: Panel, Card, Border and Inspector. -->
    <Style x:Key="PixelTart.Surface.Border" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusCard}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" /></Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /><Setter Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.54" /></Trigger>
            <Trigger Property="Tag" Value="Active"><Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}" /></Trigger>
            <Trigger Property="Tag" Value="Loading"><Setter Property="Opacity" Value="0.72" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PixelTart.Surface.Panel" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource Space.Panel.Padding}" />
    </Style>
    <Style x:Key="PixelTart.Surface.Card" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="Padding" Value="{DynamicResource Space.Card.Padding}" />
    </Style>
    <Style x:Key="PixelTart.Surface.Inspector" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Panel}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.Inspector.MinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Size.Inspector.MaxWidth}" />
    </Style>
    <Style x:Key="PixelTart.Surface.Loading" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Panel}">
        <Setter Property="Opacity" Value="0.72" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- Canonical menu API; existing implicit menu templates remain compatible. -->
    <Style x:Key="PixelTart.Menu.Context" TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MaxWidth" Value="280" />
        <Setter Property="Padding" Value="{DynamicResource Space.Menu.Padding}" />
    </Style>
    <Style x:Key="PixelTart.Menu.Item" TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="MinHeight" Value="{DynamicResource Size.MenuItem.Default}" />
        <Setter Property="Padding" Value="{DynamicResource Space.MenuItem.Padding}" />
    </Style>
    <Style x:Key="PixelTart.Menu.Loading" TargetType="MenuItem" BasedOn="{StaticResource PixelTart.Menu.Item}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0.72" />
    </Style>
</ResourceDictionary>
