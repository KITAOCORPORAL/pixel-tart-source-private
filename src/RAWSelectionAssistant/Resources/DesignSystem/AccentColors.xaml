<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Legacy interaction aliases are locked to Pixel Tart Primary by default; AppearanceService may replace them at runtime for existing user settings. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#6E9B91" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#86B0A5" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#567B73" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1D3430" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
