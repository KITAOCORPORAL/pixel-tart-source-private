<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Legacy interaction aliases are locked to Pixel Tart Primary by default; AppearanceService may replace them at runtime for existing user settings. -->
    <SolidColorBrush x:Key="AccentBrush" Color="#18A88C" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#20B89B" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#128671" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#173A34" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
</ResourceDictionary>
