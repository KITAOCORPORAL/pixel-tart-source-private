<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="DrawerSurface" TargetType="Border"><Setter Property="Width" Value="{DynamicResource DrawerDefaultWidth}" /><Setter Property="HorizontalAlignment" Value="Right" /><Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" /><Setter Property="BorderThickness" Value="1,0,0,0" /><Setter Property="CornerRadius" Value="{DynamicResource RadiusDrawer}" /></Style>
    <Style x:Key="DrawerHeader" TargetType="Border"><Setter Property="Padding" Value="16" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" /></Style>
    <Style x:Key="DrawerFooter" TargetType="Border"><Setter Property="Padding" Value="16" /><Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}" /><Setter Property="BorderThickness" Value="0,1,0,0" /></Style>
</ResourceDictionary>
