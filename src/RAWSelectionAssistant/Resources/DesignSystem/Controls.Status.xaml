<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ProgressBar"><Setter Property="Foreground" Value="{DynamicResource AccentBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Height" Value="4" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style x:Key="StatusBadge" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="10,5" /></Style>
    <Style x:Key="TopBarBadge" TargetType="Border" BasedOn="{StaticResource StatusBadge}"><Setter Property="Height" Value="32" /><Setter Property="MinWidth" Value="64" /><Setter Property="Padding" Value="12,0" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="UseLayoutRounding" Value="True" /><Setter Property="SnapsToDevicePixels" Value="True" /></Style>
    <Style x:Key="SidebarEditionCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="6,5" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Height" Value="40" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="ToastCard" TargetType="Border" BasedOn="{StaticResource PanelBorder}"><Setter Property="Background" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Padding" Value="14,10" /></Style>
</ResourceDictionary>
