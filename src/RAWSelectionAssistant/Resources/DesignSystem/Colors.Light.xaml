<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- A-v2 light companion: identical semantic/action hues, lighter surfaces. -->
    <Color x:Key="AppBackgroundColor">#F4F6F8</Color>
    <Color x:Key="Surface01Color">#FFFFFF</Color>
    <Color x:Key="Surface02Color">#EEF1F4</Color>
    <Color x:Key="Surface03Color">#E6EAEE</Color>
    <Color x:Key="SurfaceElevatedColor">#FFFFFF</Color>
    <Color x:Key="BorderSubtleColor">#D9DEE4</Color>
    <Color x:Key="BorderStrongColor">#AEB7C1</Color>
    <Color x:Key="TextPrimaryColor">#1C2228</Color>
    <Color x:Key="TextSecondaryColor">#4D5660</Color>
    <Color x:Key="TextMutedColor">#6F7882</Color>
    <Color x:Key="TextDisabledColor">#9CA3AB</Color>
    <Color x:Key="PrimaryColor">#18A88C</Color>
    <Color x:Key="PrimaryHoverColor">#20B89B</Color>
    <Color x:Key="PrimaryPressedColor">#128671</Color>
    <Color x:Key="PhotographyGoldColor">#D79A32</Color>
    <Color x:Key="SuccessColor">#42B883</Color>
    <Color x:Key="WarningColor">#E0AD43</Color>
    <Color x:Key="DangerColor">#D85A5A</Color>
    <Color x:Key="InfoColor">#4E8FD4</Color>
    <Color x:Key="CalendarFreeColor">#59616B</Color>
    <Color x:Key="CalendarScheduledColor">#E05252</Color>
    <Color x:Key="CalendarShotColor">#3DB879</Color>
    <Color x:Key="CalendarPendingReturnColor">#DDAF32</Color>
    <Color x:Key="CalendarReturnedColor">#3E8ED0</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="Surface01Brush" Color="{StaticResource Surface01Color}" />
    <SolidColorBrush x:Key="Surface02Brush" Color="{StaticResource Surface02Color}" />
    <SolidColorBrush x:Key="Surface03Brush" Color="{StaticResource Surface03Color}" />
    <SolidColorBrush x:Key="SurfaceElevatedBrush" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="TextDisabledBrush" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="{StaticResource PrimaryHoverColor}" />
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="{StaticResource PrimaryPressedColor}" />
    <SolidColorBrush x:Key="PhotographyGoldBrush" Color="{StaticResource PhotographyGoldColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="InfoSoftBrush" Color="{StaticResource InfoColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="CalendarFreeBrush" Color="{StaticResource CalendarFreeColor}" />
    <SolidColorBrush x:Key="CalendarScheduledBrush" Color="{StaticResource CalendarScheduledColor}" />
    <SolidColorBrush x:Key="CalendarShotBrush" Color="{StaticResource CalendarShotColor}" />
    <SolidColorBrush x:Key="CalendarPendingReturnBrush" Color="{StaticResource CalendarPendingReturnColor}" />
    <SolidColorBrush x:Key="CalendarReturnedBrush" Color="{StaticResource CalendarReturnedColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarFreeForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarScheduledForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarShotForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CalendarPendingReturnForegroundBrush" Color="#1D1503" />
    <SolidColorBrush x:Key="CalendarReturnedForegroundBrush" Color="#FFFFFF" />

    <!-- Pixel Tart v1.0 canonical semantic aliases. -->
    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Surface01Color}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Surface03Color}" />
    <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{StaticResource SurfaceElevatedColor}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Surface02Color}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource BorderSubtleColor}" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="{StaticResource BorderStrongColor}" />
    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource TextMutedColor}" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="{StaticResource TextDisabledColor}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#087D6A" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#0A8C76" />
    <SolidColorBrush x:Key="Brush.Accent.Active" Color="#066957" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#087D6A" Opacity="0.09" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource DangerColor}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource InfoColor}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="#990D0F12" />
    <Color x:Key="Color.Shadow">#000000</Color>
</ResourceDictionary>
