<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <Geometry x:Key="PixelTart.Symbol.Minus">M4,12 L20,12</Geometry>
    <!-- Optical sizes retain reviewed photographic/calendar compositions. -->
    <sys:Double x:Key="Type.Calendar.Badge.FontSize">9</sys:Double>
    <sys:Double x:Key="Type.Calendar.Compact.FontSize">10</sys:Double>
    <sys:Double x:Key="Type.Calendar.Day.FontSize">38</sys:Double>
    <sys:Double x:Key="Type.Proposal.ListTitle.FontSize">19</sys:Double>
    <sys:Double x:Key="Type.Proposal.Project.FontSize">15</sys:Double>
    <sys:Double x:Key="Type.Proposal.Header.FontSize">21</sys:Double>
    <sys:Double x:Key="Type.Photography.EmptyTitle.FontSize">30</sys:Double>
    <sys:Double x:Key="Type.Photography.Support.FontSize">15</sys:Double>
    <!-- Explicit route migration resources. Core sample templates remain authoritative. -->
    <sys:Double x:Key="Type.Metric.FontSize">24</sys:Double>
    <sys:Double x:Key="Type.Micro.FontSize">11</sys:Double>
    <Style x:Key="PixelTart.Type.Metric" TargetType="TextBlock" BasedOn="{StaticResource PixelTart.Type.BodyStrong}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Numeric}"/>
        <Setter Property="FontSize" Value="{DynamicResource Type.Metric.FontSize}"/>
        <Setter Property="LineHeight" Value="32"/>
    </Style>
    <Style x:Key="PixelTart.PageHeader" TargetType="views:StudioPageHeader">
        <Setter Property="Margin" Value="0,0,0,20"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
    </Style>
    <Style x:Key="PixelTart.SectionSurface" TargetType="Border" BasedOn="{StaticResource PixelTart.Panel}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Padding" Value="0,12"/>
    </Style>
    <Style x:Key="PixelTart.StatusStrip.Item" TargetType="Border" BasedOn="{StaticResource PixelTart.SectionSurface}">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
    </Style>
    <!-- Native DataGrid selection templates can otherwise paint system white/blue. -->
    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                <ContentPresenter VerticalAlignment="Center" SnapsToDevicePixels="True"/>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/></Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PixelTart.DataGrid.CheckBox" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}"><Setter Property="HorizontalAlignment" Value="Center"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style x:Key="PixelTart.DataGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="None"/>
        <Setter Property="MinRowHeight" Value="36"/>
        <Setter Property="RowBackground" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource SurfacePrimaryBrush}"/>
        <Setter Property="FrozenColumnCount" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource PixelTart.Focus}"/>
    </Style>
    <Style x:Key="PixelTart.WorkflowStep" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Ghost}">
        <Setter Property="Margin" Value="0,0,6,4"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="32"/>
    </Style>
</ResourceDictionary>
