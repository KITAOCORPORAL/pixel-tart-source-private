<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Studio v2 evolves the existing semantic API. This dictionary is intentionally
         merged last so product pages keep one theme vocabulary while the prototype is reviewed. -->
    <GridLength x:Key="StudioV2.CommandBarHeight">52</GridLength>
    <GridLength x:Key="StudioV2.StatusBarHeight">28</GridLength>
    <sys:Double x:Key="Size.Control.Default">32</sys:Double>
    <sys:Double x:Key="ControlHeight">32</sys:Double>
    <sys:Double x:Key="Size.MenuItem.Default">34</sys:Double>
    <sys:Double x:Key="Type.PageTitle.FontSize">22</sys:Double>
    <sys:Double x:Key="Type.Body.FontSize">13</sys:Double>
    <sys:Double x:Key="Type.Metadata.FontSize">11.5</sys:Double>
    <sys:Double x:Key="Type.Caption.FontSize">11.5</sys:Double>
    <Thickness x:Key="Space.Control.Padding">13,6</Thickness>
    <Thickness x:Key="ControlPadding">13,6</Thickness>

    <Style x:Key="PixelTart.Button.Primary" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Base}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="13,5" />
        <Setter Property="Background" Value="{DynamicResource Brush.Accent}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnAccent}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Accent.Active}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource Brush.Panel}" /><Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PixelTart.Button.Secondary" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Base}">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="13,5" />
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
        <Setter Property="BorderBrush" Value="#16FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface.Hover}" /><Setter Property="BorderBrush" Value="#28FFFFFF" /></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource Brush.Surface}" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".48" /></Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="PixelTart.Button.Ghost" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Secondary}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Compatibility button names used by the shell and older pages. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Primary}" />
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Secondary}" />
    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Ghost}" />

    <Style x:Key="PixelTart.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30" Background="Transparent">
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource Brush.Accent}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="Thumb" Width="20" Height="20"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse x:Name="Halo" Fill="Transparent" Stroke="Transparent" StrokeThickness="1" Margin="-2" /><Ellipse x:Name="Disc" Fill="#E5E4E7" /></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Disc" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.1" ScaleY="1.1" CenterX="10" CenterY="10" /></Setter.Value></Setter></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Halo" Property="Stroke" Value="{DynamicResource Brush.Accent}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                            <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{DynamicResource ControlTrackBrush}" CornerRadius="2" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42" /></Trigger></ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource PixelTart.Slider}" />

    <Style x:Key="PixelTart.Toggle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border x:Name="Rail" Width="32" Height="18" Background="{DynamicResource SurfaceTertiaryBrush}" CornerRadius="9" VerticalAlignment="Center" />
                        <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="2,0" Fill="#DAD8DE" HorizontalAlignment="Left" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True"><Setter TargetName="Rail" Property="Background" Value="{DynamicResource AccentBrush}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Thumb" Property="Fill" Value="#F7F4FA" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Rail" Property="BorderBrush" Value="{DynamicResource AccentValueBrush}" /><Setter TargetName="Rail" Property="BorderThickness" Value="1" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".42" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PixelTart.Surface.Panel" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Border}">
        <Setter Property="Background" Value="{DynamicResource Brush.Panel}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="PixelTart.Surface.Inspector" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Panel}">
        <Setter Property="Background" Value="{DynamicResource InspectorBackgroundBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinWidth" Value="{DynamicResource Size.Inspector.MinWidth}" />
        <Setter Property="MaxWidth" Value="{DynamicResource Size.Inspector.MaxWidth}" />
    </Style>
    <Style x:Key="PixelTart.Panel" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Panel}" />
    <Style x:Key="PixelTart.Inspector" TargetType="Border" BasedOn="{StaticResource PixelTart.Surface.Inspector}" />

    <Style x:Key="PixelTart.Popup.V2" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceElevatedBrush}" />
        <Setter Property="BorderBrush" Value="#26FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Effect"><Setter.Value><DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="5" Opacity=".34" /></Setter.Value></Setter>
    </Style>

    <Style x:Key="StudioV2.WindowButton" TargetType="Button" BasedOn="{StaticResource PixelTart.Button.Ghost}">
        <Setter Property="Width" Value="42" /><Setter Property="Height" Value="34" /><Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="0" /><Setter Property="FontFamily" Value="Segoe UI" /><Setter Property="FontSize" Value="13" />
    </Style>
    <Style x:Key="StudioV2.CloseButton" TargetType="Button" BasedOn="{StaticResource StudioV2.WindowButton}">
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#B64C4C" /><Setter Property="Foreground" Value="White" /></Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
