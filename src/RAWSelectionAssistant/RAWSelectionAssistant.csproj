<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RAWSelectionAssistant.Core\RAWSelectionAssistant.Core.csproj" />
    <ProjectReference Include="..\PixelTart.Kernel\PixelTart.Kernel.csproj" />
    <ProjectReference Include="..\PixelTart.Modules.AssetLibrary\PixelTart.Modules.AssetLibrary.csproj" />
    <ProjectReference Include="..\PixelTart.Modules.RawTool\PixelTart.Modules.RawTool.csproj" />
    <ProjectReference Include="..\PixelTart.Modules.OnlineSelection\PixelTart.Modules.OnlineSelection.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KitaoPhotoSelector</AssemblyName>
    <AssemblyName Condition="'$(AcceptanceBuild)' == 'true'">KitaoPhotoSelector.Acceptance</AssemblyName>
    <AssemblyName Condition="'$(UiReviewBuild)' == 'true'">KitaoPhotoSelector.UiReview</AssemblyName>
    <AssemblyName Condition="'$(ModularHarnessDevPreview)' == 'true'">PixelTart_ModularHarness_V1_DevPreview</AssemblyName>
    <DefineConstants Condition="'$(UiReviewBuild)' == 'true'">$(DefineConstants);UI_REVIEW_BUILD;RC3_REVIEW_ONLY</DefineConstants>
    <DefineConstants Condition="'$(InputRoutingDiagnostics)' == 'true'">$(DefineConstants);INPUT_ROUTING_DIAGNOSTICS</DefineConstants>
    <DefineConstants Condition="'$(ModularHarnessDevPreview)' == 'true'">$(DefineConstants);MODULAR_HARNESS_DEV_PREVIEW</DefineConstants>
    <DefineConstants Condition="'$(ModularHarnessDevPreview)' == 'true' and '$(AssetLibraryP1StateAcceptance)' == 'true' and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' != 'Release'">$(DefineConstants);ASSET_LIBRARY_P1_STATE_ACCEPTANCE</DefineConstants>
    <DefineConstants Condition="'$(ModularHarnessDevPreview)' == 'true' and '$(AssetLibraryP1AutomatedAcceptance)' == 'true' and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' == 'Debug'">$(DefineConstants);ASSET_LIBRARY_P1_AUTOMATED_ACCEPTANCE</DefineConstants>
    <DefineConstants Condition="'$(ModularHarnessDevPreview)' == 'true' and '$(AssetLibraryP2AutomatedAcceptance)' == 'true' and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' == 'Debug'">$(DefineConstants);ASSET_LIBRARY_P2_AUTOMATED_ACCEPTANCE</DefineConstants>
    <RootNamespace>RAWSelectionAssistant</RootNamespace>
    <Version>$(PixelTartVersion)</Version>
    <AssemblyVersion>$(PixelTartAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(PixelTartAssemblyVersion)</FileVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(ModularHarnessDevPreview)' == 'true' and ('$(AssetLibraryP1StateAcceptance)' == 'true' or ('$(AssetLibraryP1AutomatedAcceptance)' == 'true' and '$(Configuration)' == 'Debug')) and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' != 'Release'">true</IncludeSourceRevisionInInformationalVersion>
    <IncludeSourceRevisionInInformationalVersion Condition="'$(ModularHarnessDevPreview)' == 'true' and '$(AssetLibraryP2AutomatedAcceptance)' == 'true' and '$(AcceptanceBuild)' != 'true' and '$(Configuration)' == 'Debug'">true</IncludeSourceRevisionInInformationalVersion>
    <Authors>像素蛋挞</Authors>
    <Product>像素蛋挞</Product>
    <Description>面向摄影师的本地分片、归片与照片处理工具平台</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.license.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="Licenses\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\WorkbenchProjectCover.png" />
    <Resource Include="Assets\Brand\*.png" />
  </ItemGroup>

  <Target Name="ValidateProductVersion" BeforeTargets="BeforeBuild">
    <Error Condition="'$(PixelTartVersion)' != '2.3.0'" Text="PixelTartVersion 必须为 2.3.0。" />
    <Error Condition="'$(Version)' != '$(PixelTartVersion)'" Text="项目 Version 与统一版本不一致。" />
    <Error Condition="'$(AssemblyVersion)' != '$(PixelTartAssemblyVersion)'" Text="程序集版本与统一版本不一致。" />
  </Target>

  <Target Name="ValidateAssetLibraryP1StateAcceptanceBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AssetLibraryP1StateAcceptance)' == 'true'">
    <Error Condition="'$(ModularHarnessDevPreview)' != 'true'"
           Text="AssetLibraryP1StateAcceptance requires ModularHarnessDevPreview=true." />
    <Error Condition="'$(AcceptanceBuild)' == 'true'"
           Text="AssetLibraryP1StateAcceptance cannot be combined with AcceptanceBuild." />
    <Error Condition="'$(Configuration)' == 'Release'"
           Text="AssetLibraryP1StateAcceptance is forbidden in Release builds." />
  </Target>

  <Target Name="ValidateAssetLibraryP1AutomatedAcceptanceBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AssetLibraryP1AutomatedAcceptance)' == 'true'">
    <Error Condition="'$(ModularHarnessDevPreview)' != 'true'"
           Text="AssetLibraryP1AutomatedAcceptance requires ModularHarnessDevPreview=true." />
    <Error Condition="'$(AcceptanceBuild)' == 'true'"
           Text="AssetLibraryP1AutomatedAcceptance cannot be combined with AcceptanceBuild." />
    <Error Condition="'$(Configuration)' != 'Debug'"
           Text="AssetLibraryP1AutomatedAcceptance is restricted to Debug builds." />
    <Error Condition="'$(AssetLibraryP1StateAcceptance)' == 'true'"
           Text="AssetLibraryP1AutomatedAcceptance cannot be combined with the historical manual state seam." />
  </Target>

  <Target Name="ValidateAssetLibraryP2AutomatedAcceptanceBuild"
          BeforeTargets="PrepareForBuild"
          Condition="'$(AssetLibraryP2AutomatedAcceptance)' == 'true'">
    <Error Condition="'$(ModularHarnessDevPreview)' != 'true'"
           Text="AssetLibraryP2AutomatedAcceptance requires ModularHarnessDevPreview=true." />
    <Error Condition="'$(AcceptanceBuild)' == 'true'"
           Text="AssetLibraryP2AutomatedAcceptance cannot be combined with AcceptanceBuild." />
    <Error Condition="'$(Configuration)' != 'Debug'"
           Text="AssetLibraryP2AutomatedAcceptance is restricted to Debug builds." />
    <Error Condition="'$(AssetLibraryP1StateAcceptance)' == 'true' or '$(AssetLibraryP1AutomatedAcceptance)' == 'true'"
           Text="AssetLibraryP2AutomatedAcceptance cannot be combined with a P1 acceptance seam." />
  </Target>

</Project>
