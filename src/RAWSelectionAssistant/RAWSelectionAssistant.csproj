<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\RAWSelectionAssistant.Core\RAWSelectionAssistant.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>KitaoPhotoSelector</AssemblyName>
    <AssemblyName Condition="'$(AcceptanceBuild)' == 'true'">KitaoPhotoSelector.Acceptance</AssemblyName>
    <AssemblyName Condition="'$(UiReviewBuild)' == 'true'">KitaoPhotoSelector.UiReview</AssemblyName>
    <DefineConstants Condition="'$(UiReviewBuild)' == 'true'">$(DefineConstants);UI_REVIEW_BUILD</DefineConstants>
    <RootNamespace>RAWSelectionAssistant</RootNamespace>
    <Version>2.0.3</Version>
    <Authors>像素蛋挞</Authors>
    <Product>像素蛋挞</Product>
    <Description>面向摄影师的本地分片、归片与照片处理工具平台</Description>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="appsettings.license.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Resource Include="Assets\AppIcon.ico" />
    <Resource Include="Assets\AppIcon.png" />
    <Resource Include="Assets\WorkbenchProjectCover.png" />
    <Resource Include="Assets\Brand\*.png" />
  </ItemGroup>

</Project>
