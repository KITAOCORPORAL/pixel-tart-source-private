<UserControl x:Class="RAWSelectionAssistant.Views.PhotoGradePageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RAWSelectionAssistant.Views">
 <UserControl.Resources><BooleanToVisibilityConverter x:Key="Bool"/></UserControl.Resources>
 <Grid Background="{DynamicResource CanvasBackgroundBrush}" Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="120"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,8">
   <Button DockPanel.Dock="Right" Content="{views:StudioText PhotoGradeLegacy}" Command="{Binding TogglePhotoGradePageCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText Import}" Command="{Binding ChooseTargetCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText SaveBatch}" Command="{Binding SaveSessionCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText OpenBatch}" Command="{Binding OpenSessionCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText PhotoGradeUndo}" x:Name="PhotoUndo" Command="{Binding PhotoGradeUndoCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText PhotoGradeRedo}" x:Name="PhotoRedo" Command="{Binding PhotoGradeRedoCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText Cancel}" Command="{Binding StopProcessingCommand}"/>
   <Button DockPanel.Dock="Left" Content="{views:StudioText InstantSkipDemo}" Command="{Binding SkipInstantDemoCommand}"/>
   <views:StudioExportMenu DockPanel.Dock="Left"/>
   <TextBlock Text="{views:StudioText PhotoGradeTitle}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" Margin="12,0"/>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
   <StackPanel Grid.Column="0" Margin="0,0,8,0">
    <TextBlock Text="{views:StudioText PhotoGradeSteps}" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <WrapPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}" ToolTip="{views:StudioText PhotoGradeRasterHelp}"><Button Content="{views:StudioText PhotoGradeBasic}" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="BasicTone"/><Button Content="{views:StudioText Curve}" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="Curve"/></WrapPanel>
    <ListBox IsEnabled="{Binding PhotoGradeRasterToolsEnabled}" x:Name="OrderedSteps" ItemsSource="{Binding Editor.AdjustmentNodes}" SelectedItem="{Binding Editor.SelectedAdjustmentNode}" DisplayMemberPath="Name" MaxHeight="350"/>
    <WrapPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}" ToolTip="{views:StudioText PhotoGradeRasterHelp}"><Button Content="{views:StudioText PhotoGradeMoveUp}" Command="{Binding Editor.MoveAdjustmentNodeUpCommand}"/><Button Content="{views:StudioText PhotoGradeMoveDown}" Command="{Binding Editor.MoveAdjustmentNodeDownCommand}"/><Button Content="{views:StudioText PhotoGradeRemove}" Command="{Binding Editor.DeleteAdjustmentNodeCommand}"/></WrapPanel>
    <Expander Header="{views:StudioText PhotoGradeHistory}"><StackPanel><ListBox ItemsSource="{Binding ActiveTarget.EditVersions}" SelectedItem="{Binding SelectedCatalogVersion}" DisplayMemberPath="Name" MaxHeight="170"/><Button Content="{views:StudioText SelectVersion}" Command="{Binding SelectEditVersionCommand}"/></StackPanel></Expander>

   </StackPanel>
   <Grid Grid.Column="1" Margin="0,0,8,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><ComboBox x:Name="ComparisonMode" ItemsSource="{Binding Editor.ViewModes}" SelectedItem="{Binding Editor.ViewMode}"/>
    <TextBlock x:Name="ComparisonStatus" Text="{Binding ComparisonStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <Button x:Name="PrepareComparison" Content="准备当前配方基准对照（含第二曝光／几何）" Command="{Binding PrepareComparisonCommand}"/></StackPanel>
    <views:ColorStudioImageViewport x:Name="PhotoViewport" Grid.Row="1" Original="{Binding Editor.SourceImage}" Matched="{Binding Editor.MatchedImage}" Mode="{Binding Editor.EffectiveViewMode}" Split="{Binding Editor.SplitPosition}"/>
    <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
   </Grid>
   <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
    <TextBlock Text="{views:StudioText PhotoGradeParameters}" Foreground="{DynamicResource TextPrimaryBrush}"/>
    <Expander Header="{views:StudioText SrgbExposureTitle}"><StackPanel><TextBlock Text="{views:StudioText SrgbExposureHelp}" TextWrapping="Wrap"/><StackPanel IsEnabled="{Binding SrgbExposureAvailable}"><Slider Minimum="-5" Maximum="5" Value="{Binding SrgbExposureEv}"/><TextBox Text="{Binding SrgbExposureEv}"/><Button Content="{views:StudioText SrgbExposureApply}" Command="{Binding ApplySrgbExposureCommand}"/></StackPanel></StackPanel></Expander>
    <Expander x:Name="V3Controls" Header="{views:StudioText PhotoGradePresets}" IsExpanded="True"><views:InstantV3Editor x:Name="V3Editor"/></Expander>
    <TextBlock Text="{views:StudioText PhotoGradeRasterHelp}" TextWrapping="Wrap"/>
    <views:StudioToolPanel x:Name="CurrentParameters" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}" NodeTypes="BasicTone"/>
    <Expander Header="{views:StudioText PhotoGradeAnalysis}"><StackPanel><TextBlock Text="{Binding PhotoGradeContract}" TextWrapping="Wrap"/><TextBlock Text="{Binding RawPipelineStatus}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/></StackPanel></Expander>
    <TextBlock Text="{views:StudioText PhotoGradeMask}"/><ComboBox ItemsSource="{Binding PhotoMaskColors}" SelectedItem="{Binding PhotoMaskColor}"/>
    <TextBlock Text="{views:StudioText PhotoGradeSync}" TextWrapping="Wrap"/>
    <Button IsEnabled="{Binding PhotoGradeCanSyncStep}" ToolTip="{views:StudioText PhotoGradeRasterHelp}" Content="{views:StudioText PhotoGradeApply}" Command="{Binding PhotoGradeSyncStepCommand}"/>
   </StackPanel></ScrollViewer>
  </Grid>
  <ListBox Grid.Row="2" x:Name="PhotoStrip" ItemsSource="{Binding Targets}" SelectedItem="{Binding ActiveTarget,Mode=OneWay}" ScrollViewer.HorizontalScrollBarVisibility="Auto">
   <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
   <ListBox.ItemTemplate><DataTemplate><StackPanel Width="110"><Button Command="{Binding DataContext.ActivateTargetCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><Image Source="{Binding Thumbnail}" Height="65"/></Button><CheckBox IsChecked="{Binding IsSelected}" Content="{Binding FileName}"/><TextBlock Text="{Binding Status}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</UserControl>
