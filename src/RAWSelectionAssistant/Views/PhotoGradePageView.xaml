<UserControl x:Class="RAWSelectionAssistant.Views.PhotoGradePageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RAWSelectionAssistant.Views" FontFamily="Microsoft YaHei UI" FontSize="11" Background="#0E0E10" Foreground="#E7E6E2">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <SolidColorBrush x:Key="R3Panel" Color="#1D1D20"/><SolidColorBrush x:Key="R3Line" Color="#303034"/>
  <Style TargetType="Button"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="20"/><Setter Property="MinWidth" Value="22"/><Setter Property="Padding" Value="5,0"/><Setter Property="Margin" Value="1,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#B6B6BB"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#303034"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B8B8BE"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="20"/><Setter Property="MinHeight" Value="18"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#C8C8CD"/><Setter Property="Background" Value="#26262A"/><Setter Property="Margin" Value="2,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" Background="#26262A" Foreground="#C8C8CD" BorderBrush="#3B3B40" BorderThickness="1" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Right" Content="⌄" Padding="3,0"/><ContentPresenter Margin="5,0,18,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#26262A" BorderBrush="#4A4A50" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#D0D0D6"/><Setter Property="Background" Value="#26262A"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="1"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#B6B6BD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LI" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LI" Property="BorderBrush" Value="#6E9B91"/><Setter TargetName="LI" Property="Background" Value="#293A36"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LI" Property="Background" Value="#29292D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid MinHeight="18"><Track x:Name="PART_Track" Height="12" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#424247" BorderThickness="0" Height="2"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="8" Height="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#BFC0C0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#424247" BorderThickness="0" Height="2"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#1D1D20"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A9A9AE"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="#1D1D20" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E7E6E2"/><Setter TargetName="Tab" Property="BorderBrush" Value="#6E9B91"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#D5D5D9"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><Border BorderBrush="#303034" BorderThickness="0,1,0,0"><ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}" Height="24" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#D7D7DC" FontSize="11" Padding="8,0"/></Border><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="8,1,6,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="16"/></Style>
 </UserControl.Resources>
 <Grid x:Name="R3Root" Background="#0E0E10"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#151517" BorderBrush="#29292C" BorderThickness="0,0,0,1"><DockPanel Margin="6,0"><TextBlock DockPanel.Dock="Right" Text="暗室 · 本地项目  ●" FontSize="10" Foreground="#6E9B91"/><TextBlock Text="光镜" Foreground="#9CC4BA" FontWeight="SemiBold" Margin="2,0,12,0"/><Button Content="文件" Click="FileMenu"/><Button Content="编辑" Click="EditMenu"/><Button Content="调整" Click="AdjustMenu"/><Button Content="视图" Click="ViewMenu"/><Button Content="帮助" Click="HelpMenu"/><Border/></DockPanel></Border>
  <Border Grid.Row="1" Background="#19191B" BorderBrush="#303034" BorderThickness="0,0,0,1"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="⇩" ToolTip="导入照片" Command="{Binding ChooseTargetCommand}"/><Button x:Name="PhotoUndo" Content="↶" ToolTip="撤销" Command="{Binding PhotoGradeUndoCommand}"/><Button x:Name="PhotoRedo" Content="↷" ToolTip="重做" Command="{Binding PhotoGradeRedoCommand}"/><Separator Margin="7,4"/><Button Content="↖" Click="SelectTool" ToolTip="选择"/><Button Content="♧" Click="HandTool" ToolTip="抓手"/><Button Content="⌕" Click="ZoomTool" ToolTip="缩放"/><Button Content="◧" ToolTip="配方基准 / 对比" Click="CompareMenu"/></StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding TargetName}" HorizontalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Margin="12,0"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="◇ 变体" Click="ShowVariants"/><Button Content="▱ 复制调整" Command="{Binding CopyAdjustmentsCommand}"/><Button Content="▱ 粘贴调整" Command="{Binding ApplyAdjustmentsCommand}"/><Button Content="⟳ 批量同步" Command="{Binding PhotoGradeSyncStepCommand}"/><Button Content="◫" Click="TogglePanel" ToolTip="显示/隐藏面板"/><Button x:Name="PhotoExport" Content="⇧ 导出" Background="#4A766C" Foreground="White" Padding="10,0" Click="OpenExport"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition x:Name="SplitterColumn" Width="4"/><ColumnDefinition x:Name="PanelColumn" Width="304" MinWidth="280" MaxWidth="460"/></Grid.ColumnDefinitions>
   <Border x:Name="AppRail" Background="#141416" BorderBrush="#29292C" BorderThickness="0,0,1,0"><StackPanel Margin="3,6"><Button Style="{StaticResource RailButton}" Content="▦" ToolTip="工作台" IsEnabled="False"/><Button Style="{StaticResource RailButton}" Content="▣" ToolTip="照片" IsEnabled="False"/><Button Style="{StaticResource RailButton}" Content="☼" ToolTip="暗室" Background="#253A36" Foreground="#9CC4BA"/><Button Style="{StaticResource RailButton}" Content="▱" ToolTip="保存项目" Command="{Binding SaveSessionCommand}"/><Button Style="{StaticResource RailButton}" Content="□" ToolTip="打开项目" Command="{Binding OpenSessionCommand}"/></StackPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="143"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D1D20" BorderBrush="#303034" BorderThickness="0,0,0,1"><DockPanel Margin="6,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="适合" Click="FitPhoto"/><Button Content="100%" Click="ActualPhoto"/><Button Content="−" Click="ZoomOut"/><Button Content="＋" Click="ZoomIn"/></StackPanel><TextBlock Text="选择" Margin="2,0,8,0"/><TextBlock Text="参考线" Foreground="#76767C"/><TextBlock Text="无" Foreground="#9CC4BA" Margin="6,0" ToolTip="此构建未接入参考线"/><Border/></DockPanel></Border>
    <Grid Grid.Row="1" x:Name="ViewerArea" Background="#0E0E10" ClipToBounds="True"><Border Margin="12"><views:ColorStudioImageViewport x:Name="PhotoViewport" SourcePixelSize="{Binding Editor.SourcePixelSize}" Original="{Binding Editor.SourceImage}" Matched="{Binding Editor.MatchedImage}" Mode="{Binding Editor.EffectiveViewMode}" Split="{Binding Editor.SplitPosition}" MouseWheel="PhotoWheel" MouseLeftButtonDown="PhotoDown" MouseMove="PhotoMove" MouseLeftButtonUp="PhotoUp"/></Border>
     <Border Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8" Background="#C91A1A1C" CornerRadius="3" Padding="7,3"><TextBlock x:Name="PreviewPill" Visibility="Collapsed" Text="{Binding LightPrintStatus}" MaxWidth="330" TextTrimming="CharacterEllipsis" FontSize="10"/></Border>
     <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="适合 · 视图" Margin="8" FontSize="10"/>
    </Grid>
    <Border Grid.Row="2" x:Name="FilmstripArea" Background="#1D1D20" BorderBrush="#303034" BorderThickness="0,1,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="6,0"><TextBlock Text="⌄  照片"/><TextBlock Text="{Binding Targets.Count}" Margin="8,0"/><ComboBox Width="78" ItemsSource="{Binding FilterScopes}" SelectedValuePath="Id" SelectedValue="{Binding FilterScope,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Width="68" ItemsSource="{Binding ColorLabelFilters}" SelectedValuePath="Id" SelectedValue="{Binding ColorLabelFilter,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="清除筛选" Command="{Binding ClearFilmstripFiltersCommand}" Foreground="#76767C"/><Border/></DockPanel>
     <ListBox Grid.Row="1" x:Name="PhotoStrip" ItemsSource="{Binding VisibleTargets}" SelectedItem="{Binding ActiveTarget,Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="104" Margin="0,0,7,0"><Grid Height="68"><Button Padding="1" Height="68" Command="{Binding DataContext.ActivateTargetCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="100" Height="66"/></Button><CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding IsSelected}" Margin="3"/></Grid><TextBlock Text="{Binding Rating,StringFormat=★ {0}}" FontSize="10" Foreground="#A68B43" HorizontalAlignment="Center"/><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="9" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
   </Grid>
   <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="#19191B"/>
   <Grid Grid.Column="3" x:Name="RightPanel" Background="#1D1D20"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="144"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="EditModes" SelectedIndex="0" SelectionChanged="EditingModeChanged" Grid.Row="0"><TabItem Header="☷" ToolTip="调整" x:Name="BasicTab"/><TabItem Header="▣ 光片" ToolTip="光片" x:Name="PolaroidTab"/><TabItem Header="▱" ToolTip="图层"/><TabItem Header="☆" ToolTip="风格"/><TabItem Header="◷" ToolTip="变体" x:Name="VariantsTab"/></TabControl>
    <Border Grid.Row="1" BorderBrush="#303034" BorderThickness="0,0,0,1" Padding="8,4"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="90"/><RowDefinition Height="22"/></Grid.RowDefinitions><TextBlock x:Name="PanelTitle" Text="调整" Foreground="#9CC4BA"/><views:StudioHistogramView Grid.Row="1" Histogram="{Binding PreviewHistogram}" Height="90"/><TextBlock Grid.Row="2" x:Name="ToneRatios" Text="影调分区 · 当前预览" FontSize="9" Foreground="#86868D"/></Grid></Border>
    <ScrollViewer Grid.Row="2" x:Name="AdjustmentScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Expander Header="⌄ 曝光" IsExpanded="True"><views:StudioToolPanel x:Name="CurrentParameters" CompactRows="True" NodeTypes="BasicTone" ParameterKeys="exposure,contrast,brightness" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 高动态范围" IsExpanded="True"><views:StudioToolPanel CompactRows="True" NodeTypes="BasicTone" ParameterKeys="highlights,shadows,whites,blacks" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 色阶"><views:StudioToolPanel CompactRows="True" NodeTypes="Levels" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 曲线" IsExpanded="True"><views:StudioCurveEditor x:Name="PhotographerCurve" Compact="True" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 白平衡" IsExpanded="False"><views:StudioToolPanel CompactRows="True" NodeTypes="WhiteBalance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 基础色彩" IsExpanded="False"><views:StudioToolPanel x:Name="BasicColorParameters" CompactRows="True" NodeTypes="BasicTone" ParameterKeys="saturation,vibrance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 分级调色"><views:StudioToolPanel CompactRows="True" NodeTypes="ColorBalance" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 肤色"><views:StudioToolPanel CompactRows="True" NodeTypes="SkinTone" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 清晰度与结构"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="clarity,structure" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 锐化"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="sharpen,radius,threshold" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 降噪"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="luma_noise,chroma_noise" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Button Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}" Content="应用窗口调整" Command="{Binding ApplyWindowGradeCommand}" ToolTip="只作用于已显影光片的画面窗口"/>
     <Expander x:Name="DiagnosticsSection" Header="帮助与诊断"><StackPanel><TextBlock Text="{Binding RasterAvailabilityReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding RawPipelineStatus}" TextWrapping="Wrap"/><Button Content="旧版工作区" Command="{Binding TogglePhotoGradePageCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="PaperScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel>
     <Expander Header="⌄ 相纸" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Editor" Section="Picker"/></Expander>
     <Expander Header="⌄ 相机" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}" IsExpanded="True"><StackPanel><UniformGrid Columns="2" IsEnabled="{Binding LightPrintControlsEnabled}"><Button Content="◉  i-2" Height="56" Click="CameraI2"/><Button Content="▣  SX-70" Height="56" Click="CameraSX70"/></UniformGrid><CheckBox IsEnabled="{Binding LightPrintControlsEnabled}" Content="相机动画" IsChecked="{Binding InstantCameraAnimation}" FontSize="10" Margin="0,4"/></StackPanel></Expander>
     <Expander x:Name="FrameSection" Header="⌄ 相框" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><ListBox x:Name="FrameChoice" ItemsSource="{Binding LightPrintFrameChoices}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightPrintFrameId,Mode=TwoWay}" IsEnabled="{Binding LightPrintControlsEnabled}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="78" Margin="2"><views:LightPrintFrameThumbnail Frame="{Binding}" Height="76"/><TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
     <Expander Header="⌄ 常用参数" IsEnabled="{Binding LightPrintControlsEnabled}" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="效果强度"/><Slider x:Name="LightPrintAmount" Minimum="0" Maximum="1" Value="{Binding InstantAmount,Mode=TwoWay}"/><TextBlock Text="曝光"/><Slider x:Name="LightPrintExposure" Minimum="-2" Maximum="2" Value="{Binding InstantV3Exposure,Mode=TwoWay}"/></StackPanel></Expander>
     <Expander Header="⌄ 进阶参数" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Advanced" Section="Advanced"/></Expander>
     <Expander Header="⌄ 已显影 · 配方（只读）" IsExpanded="True" Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="{Binding LightPrintRecipeSummary}" TextWrapping="Wrap"/><Button Content="进阶调色" Click="ShowAdjust"/><Button Content="从原图重新拍一张" Command="{Binding ReshootLightPrintCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="LayersScroll" Visibility="Collapsed"><StackPanel><ListBox x:Name="OrderedSteps" ItemsSource="{Binding Editor.AdjustmentNodes}" SelectedItem="{Binding Editor.SelectedAdjustmentNode}" DisplayMemberPath="Name"/><WrapPanel><Button Content="上移" Command="{Binding Editor.MoveAdjustmentNodeUpCommand}"/><Button Content="下移" Command="{Binding Editor.MoveAdjustmentNodeDownCommand}"/><Button Content="删除" Command="{Binding Editor.DeleteAdjustmentNodeCommand}"/></WrapPanel></StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="StylesScroll" Visibility="Collapsed"><StackPanel Margin="8"><TextBlock Text="普通胶片风格"/><CheckBox Content="启用胶片" IsChecked="{Binding Editor.FilmEnabled}"/><ComboBox ItemsSource="{Binding Editor.FilmProfiles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding Editor.FilmProfileId}"/><Slider Minimum="0" Maximum="1" Value="{Binding Editor.FilmProfileAmount,Mode=TwoWay}"/></StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="VariantsScroll" Visibility="Collapsed"><StackPanel Margin="8"><Button Content="新建变体（从原图）" Command="{Binding NewNormalLightPrintVariantCommand}"/><TextBlock Text="照片信息" Margin="0,8"/><TextBlock Text="{Binding TargetName}"/><TextBlock Text="变体" Margin="0,10,0,3"/><ListBox x:Name="HistoryVersions" ItemsSource="{Binding ActiveTarget.EditVersions}" SelectedItem="{Binding SelectedCatalogVersion,Mode=TwoWay}" DisplayMemberPath="Name"/><Button Content="切换所选变体" Command="{Binding SelectEditVersionCommand}"/></StackPanel></ScrollViewer>
    <Border Grid.Row="3" x:Name="FilmAction" Visibility="Collapsed" Background="#232327" BorderBrush="#303034" BorderThickness="0,1,0,0" Padding="8"><StackPanel><TextBlock Text="{Binding LightPrintStatus}" FontSize="10" TextWrapping="Wrap"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="取消" Command="{Binding CancelLightPrintPreviewCommand}"/><Button Grid.Column="1" x:Name="DevelopPrint" Content="显影" Command="{Binding DevelopLightPrintCommand}" Background="#4A766C" Foreground="White"/></Grid></StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
