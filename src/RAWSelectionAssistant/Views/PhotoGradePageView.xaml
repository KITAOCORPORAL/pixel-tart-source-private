<UserControl x:Class="RAWSelectionAssistant.Views.PhotoGradePageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:RAWSelectionAssistant.Views" FontFamily="Microsoft YaHei UI" FontSize="11" Background="#0E0E10" Foreground="#E7E6E2">
 <UserControl.Resources>
  <BooleanToVisibilityConverter x:Key="Bool"/>
  <SolidColorBrush x:Key="R3IconBrush" Color="#A6A6AB"/><SolidColorBrush x:Key="R3Panel" Color="#1D1D20"/><SolidColorBrush x:Key="R3Line" Color="#303034"/>
  <Style TargetType="Button"><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="20"/><Setter Property="MinWidth" Value="22"/><Setter Property="Padding" Value="5,0"/><Setter Property="Margin" Value="1,0"/><Setter Property="FontSize" Value="11"/><Setter Property="Foreground" Value="#B6B6BB"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="3"><Grid><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center"/><views:DarkroomIcon x:Name="ButtonIcon" Kind="{Binding Tag,RelativeSource={RelativeSource TemplatedParent}}" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="Content" Value="{x:Null}"><Setter TargetName="ButtonIcon" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#303034"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#B8B8BE"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Height" Value="20"/><Setter Property="MinHeight" Value="18"/><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#C8C8CD"/><Setter Property="Background" Value="#26262A"/><Setter Property="Margin" Value="2,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton Focusable="False" Background="#26262A" Foreground="#C8C8CD" BorderBrush="#3B3B40" BorderThickness="1" IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" HorizontalContentAlignment="Right" Content="⌄" Padding="3,0"/><ContentPresenter Margin="5,0,18,0" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding ItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border Background="#26262A" BorderBrush="#4A4A50" BorderThickness="1" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#D0D0D6"/><Setter Property="Background" Value="#26262A"/><Setter Property="FontSize" Value="11"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="1"/><Setter Property="Margin" Value="0"/><Setter Property="Foreground" Value="#B6B6BD"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="LI" BorderBrush="Transparent" BorderThickness="1" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="LI" Property="BorderBrush" Value="#6E9B91"/><Setter TargetName="LI" Property="Background" Value="#293A36"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="LI" Property="Background" Value="#29292D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Slider"><Setter Property="Height" Value="20"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid MinHeight="18"><Track x:Name="PART_Track" Height="12" VerticalAlignment="Center"><Track.DecreaseRepeatButton><RepeatButton Command="{x:Static Slider.DecreaseLarge}" Background="#424247" BorderThickness="0" Height="2"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="8" Height="8"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#BFC0C0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="{x:Static Slider.IncreaseLarge}" Background="#424247" BorderThickness="0" Height="2"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TabControl"><Setter Property="Background" Value="#1D1D20"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#A9A9AE"/><Setter Property="Padding" Value="10,0"/><Setter Property="Height" Value="30"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="Tab" Background="#1D1D20" BorderThickness="0,0,0,2" BorderBrush="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#E7E6E2"/><Setter TargetName="Tab" Property="BorderBrush" Value="#6E9B91"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="Expander"><Setter Property="Foreground" Value="#D5D5D9"/><Setter Property="Margin" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Expander"><StackPanel><Border BorderBrush="#303034" BorderThickness="0,1,0,0"><ToggleButton MinHeight="0" MinWidth="0" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded,RelativeSource={RelativeSource TemplatedParent}}" Height="24" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="#D7D7DC" FontSize="11" Padding="8,0"/></Border><ContentPresenter x:Name="Body" ContentSource="Content" Visibility="Collapsed" Margin="8,1,6,0"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="FontSize" Value="16"/></Style>
 </UserControl.Resources>
 <Grid x:Name="R3Root" Background="#0E0E10"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="34"/><RowDefinition/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#151517" BorderBrush="#29292C" BorderThickness="0,0,0,1"><DockPanel Margin="6,0"><TextBlock DockPanel.Dock="Right" Text="暗室 · 本地项目  ●" FontSize="10" Foreground="#6E9B91"/><TextBlock Text="光镜" Foreground="#9CC4BA" FontWeight="SemiBold" Margin="2,0,12,0"/><Button Content="文件" Click="FileMenu"/><Button Content="编辑" Click="EditMenu"/><Button Content="调整" Click="AdjustMenu"/><Button Content="视图" Click="ViewMenu"/><Button Content="帮助" Click="HelpMenu"/><Border/></DockPanel></Border>
  <Border Grid.Row="1" Background="#19191B" BorderBrush="#303034" BorderThickness="0,0,0,1"><Grid Margin="5,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{x:Null}" Tag="import" ToolTip="导入照片" Command="{Binding ChooseTargetCommand}"/><Button x:Name="PhotoUndo" Content="{x:Null}" Tag="undo" ToolTip="撤销" Command="{Binding PhotoGradeUndoCommand}"/><Button x:Name="PhotoRedo" Content="{x:Null}" Tag="redo" ToolTip="重做" Command="{Binding PhotoGradeRedoCommand}"/><Separator Margin="7,4"/><Button Content="{x:Null}" Tag="pointer" Click="SelectTool" ToolTip="选择"/><Button Content="{x:Null}" Tag="hand" Click="HandTool" ToolTip="抓手"/><Button Content="{x:Null}" Tag="zoom" Click="ZoomTool" ToolTip="缩放"/><Button Content="{x:Null}" Tag="compare" ToolTip="配方基准 / 对比" Click="CompareMenu"/></StackPanel>
   <TextBlock Grid.Column="1" Text="{Binding TargetName}" HorizontalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" Margin="12,0"/>
   <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="变体" Click="ShowVariants"/><Button Content="复制调整" Command="{Binding CopyAdjustmentsCommand}"/><Button Content="粘贴调整" Command="{Binding ApplyAdjustmentsCommand}"/><Button Content="批量同步" Command="{Binding PhotoGradeSyncStepCommand}"/><Button Content="{x:Null}" Tag="panel" Click="TogglePanel" ToolTip="显示/隐藏面板"/><Button x:Name="PhotoExport" Content="导出" Background="#4A766C" Foreground="White" Padding="10,0" Click="OpenExport"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition/><ColumnDefinition x:Name="SplitterColumn" Width="4"/><ColumnDefinition x:Name="PanelColumn" Width="304" MinWidth="280" MaxWidth="460"/></Grid.ColumnDefinitions>
   <Border x:Name="AppRail" Background="#141416" BorderBrush="#29292C" BorderThickness="0,0,1,0"><StackPanel Margin="3,6"><Button Style="{StaticResource RailButton}" Content="{x:Null}" Tag="grid" ToolTip="工作台（旧版工作区）" Command="{Binding TogglePhotoGradePageCommand}"/><Button Style="{StaticResource RailButton}" Content="{x:Null}" Tag="photo" ToolTip="导入照片" Command="{Binding ChooseTargetCommand}"/><Button Style="{StaticResource RailButton}" Content="{x:Null}" Tag="adjust" ToolTip="暗室" Background="#253A36" Foreground="#9CC4BA"/><Button Style="{StaticResource RailButton}" Content="{x:Null}" Tag="save" ToolTip="保存项目" Command="{Binding SaveSessionCommand}"/><Button Style="{StaticResource RailButton}" Content="{x:Null}" Tag="folder" ToolTip="打开项目" Command="{Binding OpenSessionCommand}"/></StackPanel></Border>
   <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition/><RowDefinition Height="143"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#1D1D20" BorderBrush="#303034" BorderThickness="0,0,0,1"><DockPanel Margin="6,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="适合" Click="FitPhoto"/><Button Content="100%" Click="ActualPhoto"/><Button Content="−" Click="ZoomOut"/><Button Content="＋" Click="ZoomIn"/></StackPanel><TextBlock x:Name="ToolLabel" Text="选择" Margin="2,0,12,0"/><TextBlock Text="参考线" Foreground="#86868C"/><ComboBox x:Name="GuideChoice" Width="78" SelectionChanged="GuidesChanged" SelectedIndex="0"><ComboBoxItem Content="无"/><ComboBoxItem Content="三分线"/><ComboBoxItem Content="中心十字"/></ComboBox><TextBlock x:Name="ToolHint" Text="拖动平移 · 滚轮缩放" Foreground="#76767C" Margin="12,0"/><Border/></DockPanel></Border>
    <Grid Grid.Row="1" x:Name="ViewerArea" Background="#0E0E10" ClipToBounds="True"><Border Margin="12"><views:ColorStudioImageViewport x:Name="PhotoViewport" SourcePixelSize="{Binding Editor.SourcePixelSize}" Original="{Binding Editor.SourceImage}" Matched="{Binding Editor.MatchedImage}" Mode="{Binding Editor.EffectiveViewMode}" Split="{Binding Editor.SplitPosition}" MouseWheel="PhotoWheel" MouseLeftButtonDown="PhotoDown" MouseMove="PhotoMove" MouseLeftButtonUp="PhotoUp"/></Border><Canvas x:Name="GuideOverlay" IsHitTestVisible="False" SizeChanged="GuideSizeChanged"/>
     <Border Visibility="Collapsed" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8" Background="#C91A1A1C" CornerRadius="3" Padding="7,3"><TextBlock x:Name="PreviewPill" Visibility="Collapsed" Text="{Binding LightPrintStatus}" MaxWidth="330" TextTrimming="CharacterEllipsis" FontSize="10"/></Border>
     <TextBlock VerticalAlignment="Bottom" HorizontalAlignment="Right" Text="适合 · 视图" Margin="8" FontSize="10"/>
    </Grid>
    <Border Grid.Row="2" x:Name="FilmstripArea" Background="#1D1D20" BorderBrush="#303034" BorderThickness="0,1,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition/></Grid.RowDefinitions><DockPanel Margin="6,0"><TextBlock Text="⌄  照片"/><TextBlock Text="{Binding Targets.Count}" Margin="8,0"/><ComboBox Width="78" ItemsSource="{Binding FilterScopes}" SelectedValuePath="Id" SelectedValue="{Binding FilterScope,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Width="68" ItemsSource="{Binding ColorLabelFilters}" SelectedValuePath="Id" SelectedValue="{Binding ColorLabelFilter,Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" FontSize="10"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Content="清除筛选" Command="{Binding ClearFilmstripFiltersCommand}" Foreground="#76767C"/><Border/></DockPanel>
     <ListBox Grid.Row="1" x:Name="PhotoStrip" ItemsSource="{Binding VisibleTargets}" SelectedItem="{Binding ActiveTarget,Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="6,4" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="104" Margin="0,0,7,0"><Grid Height="68"><Border Background="#080809" CornerRadius="2"/><Button Padding="1" Height="68" Command="{Binding DataContext.ActivateTargetCommand,RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><Image Source="{Binding Thumbnail}" Stretch="Uniform" Width="100" Height="66"/></Button><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#D0000000" CornerRadius="2" Padding="3,0" Margin="3"><TextBlock Text="{Binding EditVersions.Count,StringFormat=▱ {0}}" Foreground="#D6D6DA" FontSize="9"/></Border><CheckBox HorizontalAlignment="Left" VerticalAlignment="Top" IsChecked="{Binding IsSelected}" Margin="3"/></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="★" Tag="1" Height="16" MinHeight="12" MinWidth="12" Padding="0" Click="RatePhoto" Foreground="#D9B44A"/><Button Content="★" Tag="2" Height="16" MinHeight="12" MinWidth="12" Padding="0" Click="RatePhoto" Foreground="#D9B44A"/><Button Content="★" Tag="3" Height="16" MinHeight="12" MinWidth="12" Padding="0" Click="RatePhoto" Foreground="#D9B44A"/><Button Content="★" Tag="4" Height="16" MinHeight="12" MinWidth="12" Padding="0" Click="RatePhoto" Foreground="#D9B44A"/><Button Content="★" Tag="5" Height="16" MinHeight="12" MinWidth="12" Padding="0" Click="RatePhoto" Foreground="#D9B44A"/><TextBlock Text="{Binding Rating}" FontSize="9" Margin="3,0,0,0"/></StackPanel><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" FontSize="9" HorizontalAlignment="Center"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
    </Grid></Border>
   </Grid>
   <GridSplitter Grid.Column="2" HorizontalAlignment="Stretch" Background="#19191B"/>
   <Grid Grid.Column="3" x:Name="RightPanel" Background="#1D1D20"><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition x:Name="HistogramRow" Height="108"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TabControl x:Name="EditModes" SelectedIndex="0" SelectionChanged="EditingModeChanged" Grid.Row="0"><TabItem ToolTip="调整" x:Name="BasicTab"><TabItem.Header><views:DarkroomIcon Kind="adjust"/></TabItem.Header></TabItem><TabItem ToolTip="光片" x:Name="PolaroidTab"><TabItem.Header><StackPanel Orientation="Horizontal"><views:DarkroomIcon Kind="paper"/><TextBlock Text="光片" Margin="4,0,0,0"/></StackPanel></TabItem.Header></TabItem><TabItem ToolTip="图层"><TabItem.Header><views:DarkroomIcon Kind="layers"/></TabItem.Header></TabItem><TabItem ToolTip="风格"><TabItem.Header><views:DarkroomIcon Kind="star"/></TabItem.Header></TabItem><TabItem ToolTip="变体" x:Name="VariantsTab"><TabItem.Header><views:DarkroomIcon Kind="history"/></TabItem.Header></TabItem></TabControl>
    <Border x:Name="HistogramPanel" Grid.Row="1" BorderBrush="#303034" BorderThickness="0,0,0,1" Padding="8,4"><Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="64"/><RowDefinition Height="22"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Right" x:Name="PanelOptions" Content="{x:Null}" Tag="more" Height="20" ToolTip="工具面板选项" Click="PanelMenu"/><TextBlock x:Name="PanelTitle" Text="调整" Foreground="#A6A6AB"/></DockPanel><views:StudioHistogramView Grid.Row="1" Histogram="{Binding PreviewHistogram}" Height="64"/><TextBlock Grid.Row="2" x:Name="ToneRatios" Text="影调分区 · 当前预览" FontSize="9" Foreground="#86868D"/></Grid></Border>
    <ScrollViewer Grid.Row="2" x:Name="AdjustmentScroll" VerticalScrollBarVisibility="Auto"><StackPanel>
     <Expander Header="⌄ 曝光" IsExpanded="True"><views:StudioToolPanel x:Name="CurrentParameters" CompactRows="True" NodeTypes="BasicTone" ParameterKeys="exposure,contrast,brightness" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 高动态范围" IsExpanded="False"><views:StudioToolPanel CompactRows="True" NodeTypes="BasicTone" ParameterKeys="highlights,shadows,whites,blacks" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 色阶"><views:StudioToolPanel CompactRows="True" NodeTypes="Levels" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 曲线" IsExpanded="False"><views:StudioCurveEditor x:Name="PhotographerCurve" Compact="True" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 白平衡" IsExpanded="False"><views:StudioToolPanel CompactRows="True" NodeTypes="WhiteBalance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 基础色彩" IsExpanded="False"><views:StudioToolPanel x:Name="BasicColorParameters" CompactRows="True" NodeTypes="BasicTone" ParameterKeys="saturation,vibrance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Header="⌄ 分级调色"><views:StudioToolPanel CompactRows="True" NodeTypes="ColorBalance" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 肤色"><views:StudioToolPanel CompactRows="True" NodeTypes="SkinTone" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 清晰度与结构"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="clarity,structure" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 锐化"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="sharpen,radius,threshold" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Header="⌄ 降噪"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="luma_noise,chroma_noise" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Button Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}" Content="应用窗口调整" Command="{Binding ApplyWindowGradeCommand}" ToolTip="只作用于已显影光片的画面窗口"/>
     <Expander x:Name="DiagnosticsSection" Header="帮助与诊断"><StackPanel><TextBlock Text="{Binding RasterAvailabilityReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding RawPipelineStatus}" TextWrapping="Wrap"/><Button Content="旧版工作区" Command="{Binding TogglePhotoGradePageCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="PaperScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel>
     <Expander Header="⌄ 相纸" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Editor" Section="Picker"/></Expander>
     <Expander Header="⌄ 相机" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}" IsExpanded="True"><StackPanel><UniformGrid Columns="2" IsEnabled="{Binding LightPrintControlsEnabled}"><Button Content="◉  i-2" Height="56" Click="CameraI2"/><Button Content="▣  SX-70" Height="56" Click="CameraSX70"/></UniformGrid><CheckBox IsEnabled="{Binding LightPrintControlsEnabled}" Content="相机动画" IsChecked="{Binding InstantCameraAnimation}" FontSize="10" Margin="0,4"/></StackPanel></Expander>
     <Expander x:Name="FrameSection" Header="⌄ 相框" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><ListBox x:Name="FrameChoice" ItemsSource="{Binding LightPrintFrameChoices}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightPrintFrameId,Mode=TwoWay}" IsEnabled="{Binding LightPrintControlsEnabled}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="78" Margin="2"><views:LightPrintFrameThumbnail Frame="{Binding}" Height="76"/><TextBlock Text="{Binding Name}" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
     <Expander Header="⌄ 常用参数" IsEnabled="{Binding LightPrintControlsEnabled}" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="效果强度"/><Slider x:Name="LightPrintAmount" Minimum="0" Maximum="1" Value="{Binding InstantAmount,Mode=TwoWay}"/><TextBlock Text="曝光"/><Slider x:Name="LightPrintExposure" Minimum="-2" Maximum="2" Value="{Binding InstantV3Exposure,Mode=TwoWay}"/></StackPanel></Expander>
     <Expander Header="⌄ 进阶参数" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Advanced" Section="Advanced"/></Expander>
     <Expander Header="⌄ 已显影 · 配方（只读）" IsExpanded="True" Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="{Binding LightPrintRecipeSummary}" TextWrapping="Wrap"/><Button Content="进阶调色" Click="ShowAdjust"/><Button Content="从原图重新拍一张" Command="{Binding ReshootLightPrintCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="LayersScroll" Visibility="Collapsed"><StackPanel><ListBox x:Name="OrderedSteps" ItemsSource="{Binding Editor.AdjustmentNodes}" SelectedItem="{Binding Editor.SelectedAdjustmentNode}" DisplayMemberPath="Name"/><WrapPanel><Button Content="上移" Command="{Binding Editor.MoveAdjustmentNodeUpCommand}"/><Button Content="下移" Command="{Binding Editor.MoveAdjustmentNodeDownCommand}"/><Button Content="删除" Command="{Binding Editor.DeleteAdjustmentNodeCommand}"/></WrapPanel></StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="StylesScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<Expander Header="⌄ 胶片风格" IsExpanded="True"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><CheckBox Content="启用胶片" IsChecked="{Binding Editor.FilmEnabled}"/><ListBox ItemsSource="{Binding Editor.FilmProfiles}" SelectedValuePath="Id" SelectedValue="{Binding Editor.FilmProfileId,Mode=TwoWay}" BorderThickness="0" Background="Transparent" MaxHeight="210" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><views:DarkroomIcon Kind="star"/><TextBlock Grid.Column="1" Text="{Binding Name}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel><TextBlock Text="风格强度"/><TextBlock DockPanel.Dock="Right" Text="{Binding Editor.FilmProfileAmount,StringFormat=P0}"/></DockPanel><Slider Minimum="0" Maximum="1" Value="{Binding Editor.FilmProfileAmount,Mode=TwoWay}"/></StackPanel></Expander>
<Expander Header="⌄ 我的色彩方案" IsExpanded="True"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><TextBox Text="{Binding Editor.ColorSchemeName,UpdateSourceTrigger=PropertyChanged}" FontSize="11"/><Button Content="存为新方案" Command="{Binding Editor.SaveColorSchemeAsCommand}"/><ListBox ItemsSource="{Binding Editor.ColorSchemes}" SelectedItem="{Binding Editor.SelectedColorScheme}" DisplayMemberPath="Name" MaxHeight="150" Background="Transparent" BorderThickness="0"/><Button Content="应用所选方案" Click="ApplyScheme"/><TextBlock Text="{Binding Editor.CurrentColorSchemeName}" Foreground="#86868C" FontSize="10"/></StackPanel></Expander>
<Expander Header="⌄ Adobe XMP" IsExpanded="False"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><Button Content="导入 Adobe XMP…" Command="{Binding Editor.ImportAdobeXmpCommand}"/><ListBox ItemsSource="{Binding Editor.AdobeXmpPresets}" SelectedItem="{Binding Editor.SelectedAdobeXmpPreset}" DisplayMemberPath="Name" MaxHeight="160" Background="Transparent" BorderThickness="0"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.PresetStrengthPercent,Mode=TwoWay}"/><WrapPanel><Button Content="预览" Command="{Binding Editor.PreviewPresetCommand}"/><Button Content="提交" Command="{Binding Editor.CommitPresetCommand}"/><Button Content="取消" Command="{Binding Editor.CancelPresetCommand}"/></WrapPanel></StackPanel></Expander>
<Expander Header="⌄ 调整剪贴板" IsExpanded="True"><WrapPanel><Button Content="复制调整" Command="{Binding CopyAdjustmentsCommand}"/><Button Content="粘贴调整" Command="{Binding ApplyAdjustmentsCommand}"/></WrapPanel></Expander>
<TextBlock Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}" Text="已显影光片配方只读；请在调整页进行窗口调色，或从原图新建变体。" TextWrapping="Wrap" Foreground="#86868C" Margin="8"/>
</StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="VariantsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<Expander Header="⌄ 照片信息" IsExpanded="True"><StackPanel><TextBlock Text="{Binding TargetName}" Foreground="#E2E1DD"/><TextBlock Text="{Binding ActiveTarget.PixelWidth,StringFormat=宽度  {0} px}" FontSize="10"/><TextBlock Text="{Binding ActiveTarget.PixelHeight,StringFormat=高度  {0} px}" FontSize="10"/><TextBlock Text="{Binding ActiveTarget.MetadataStatus}" Foreground="#86868C" FontSize="10" TextWrapping="Wrap"/></StackPanel></Expander>
<Expander Header="⌄ 变体堆叠" IsExpanded="True"><StackPanel><WrapPanel><Button Content="从原图新建" Command="{Binding NewNormalLightPrintVariantCommand}"/><Button Content="克隆当前变体" Command="{Binding CreateEditVersionCommand}"/></WrapPanel><ListBox x:Name="HistoryVersions" ItemsSource="{Binding ActiveTarget.EditVersions}" SelectedItem="{Binding SelectedCatalogVersion,Mode=TwoWay}" SelectionChanged="VariantPicked" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#343438" BorderThickness="0,0,0,1" Padding="4,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#D5D5D9"/><TextBlock Text="{Binding CreatedAt,StringFormat=yyyy-MM-dd HH:mm}" FontSize="9" Foreground="#86868C"/><TextBlock Text="{Binding RawDefinition.LightPrint.FrameId}" FontSize="9" Foreground="#6E9B91" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><TextBox Text="{Binding EditVersionName,UpdateSourceTrigger=PropertyChanged}" ToolTip="当前变体新名称"/><WrapPanel><Button Content="重命名" Command="{Binding RenameEditVersionCommand}"/><Button Content="保存变体" Command="{Binding SaveEditVersionsCommand}"/><Button Content="下一变体" Command="{Binding NextEditVersionCommand}"/></WrapPanel></StackPanel></Expander>
<Expander Header="⌄ 历史" IsExpanded="True"><StackPanel><WrapPanel><Button Content="撤销" Command="{Binding PhotoGradeUndoCommand}"/><Button Content="重做" Command="{Binding PhotoGradeRedoCommand}"/></WrapPanel><TextBlock Text="{Binding LightPrintStatus}" TextWrapping="Wrap" FontSize="10"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="10" Foreground="#86868C"/><TextBlock Text="显影变体保留在上方；参数撤销按当前照片和窗口历史执行。" TextWrapping="Wrap" FontSize="10" Foreground="#86868C"/></StackPanel></Expander>
</StackPanel></ScrollViewer>
    <Border Grid.Row="3" x:Name="FilmAction" Visibility="Collapsed" Background="#232327" BorderBrush="#303034" BorderThickness="0,1,0,0" Padding="8"><StackPanel><TextBlock Text="{Binding LightPrintStatus}" FontSize="10" TextWrapping="Wrap"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button Content="取消" Command="{Binding CancelLightPrintPreviewCommand}"/><Button Grid.Column="1" x:Name="DevelopPrint" Content="显影" Command="{Binding DevelopLightPrintCommand}" Background="#4A766C" Foreground="White"/></Grid></StackPanel></Border>
   </Grid>
  </Grid>
 </Grid>
</UserControl>
