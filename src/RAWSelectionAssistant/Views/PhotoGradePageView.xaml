     <Expander Tag="AdjustmentScroll.2" Header="⌄ 高动态范围" IsExpanded="False"><views:StudioToolPanel CompactRows="True" NodeTypes="BasicTone" ParameterKeys="highlights,shadows,whites,blacks" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.3" Header="⌄ 色阶"><views:StudioToolPanel CompactRows="True" NodeTypes="Levels" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.4" Header="⌄ 曲线" IsExpanded="False"><views:StudioCurveEditor x:Name="PhotographerCurve" Compact="True" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.5" Header="⌄ 白平衡" IsExpanded="False"><StackPanel><Expander Header="RAW 基础白平衡" IsEnabled="{Binding IsLinearProfessionalRaw}" ToolTip="既有 LibRaw CameraGains：在解码时只应用一次；不是 Kelvin，也不是显示后局部冷暖"><StackPanel><CheckBox Content="相机白平衡" IsChecked="{Binding RawUseCameraWhiteBalance,Mode=TwoWay}"/><TextBlock Text="R / G / B 相对倍率"/><UniformGrid Columns="3"><TextBox Text="{Binding RawRedGain,UpdateSourceTrigger=LostFocus}" ToolTip="红倍率 0.125–8"/><TextBox Text="{Binding RawGreenGain,UpdateSourceTrigger=LostFocus}" ToolTip="绿倍率 0.125–8"/><TextBox Text="{Binding RawBlueGain,UpdateSourceTrigger=LostFocus}" ToolTip="蓝倍率 0.125–8"/></UniformGrid><Button Content="应用基础白平衡" Command="{Binding ApplyProfessionalRawCommand}"/></StackPanel></Expander><views:StudioToolPanel CompactRows="True" NodeTypes="WhiteBalance" IsEnabled="{Binding DarkroomAdjustmentEnabled}" ToolTip="显示后局部白平衡：已解码 sRGB 上的相对冷暖与 tint，不是传感器白平衡"/></StackPanel></Expander>
     <Expander Tag="AdjustmentScroll.6" Header="⌄ 基础色彩" IsExpanded="False"><views:StudioToolPanel x:Name="BasicColorParameters" CompactRows="True" NodeTypes="BasicTone" ParameterKeys="saturation,vibrance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.7" Header="⌄ 分级调色"><views:StudioToolPanel CompactRows="True" NodeTypes="ColorBalance" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.8" Header="⌄ 肤色"><views:StudioToolPanel CompactRows="True" NodeTypes="SkinTone" IsEnabled="{Binding DarkroomAdjustmentEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.9" Header="⌄ 清晰度与结构"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="clarity,structure" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.10" Header="⌄ 锐化"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="sharpen,radius,threshold" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Expander Tag="AdjustmentScroll.11" Header="⌄ 降噪"><views:StudioToolPanel CompactRows="True" NodeTypes="Details" ParameterKeys="luma_noise,chroma_noise" IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"/></Expander>
     <Button Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}" Content="应用窗口调整" Command="{Binding ApplyWindowGradeCommand}" ToolTip="只作用于已显影光片的画面窗口"/>
     <Expander Tag="AdjustmentScroll.12" x:Name="DiagnosticsSection" Header="帮助与诊断"><StackPanel><TextBlock Text="{Binding RasterAvailabilityReason}" TextWrapping="Wrap"/><TextBlock Text="{Binding RawPipelineStatus}" TextWrapping="Wrap"/><Button Content="旧版工作区" Command="{Binding TogglePhotoGradePageCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="PaperScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"><StackPanel>
     <Expander Tag="PaperScroll.1" Header="⌄ 相纸" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Editor" Section="Picker"/></Expander>
     <Expander Tag="PaperScroll.2" Header="⌄ 相机" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}" IsExpanded="True"><StackPanel><UniformGrid Columns="2" IsEnabled="{Binding LightPrintControlsEnabled}"><Button Content="◉  i-2" Height="56" Click="CameraI2"/><Button Content="▣  SX-70" Height="56" Click="CameraSX70"/></UniformGrid><CheckBox IsEnabled="{Binding LightPrintControlsEnabled}" Content="相机动画" IsChecked="{Binding InstantCameraAnimation}" FontSize="11" Margin="0,4"/></StackPanel></Expander>
     <Expander Tag="PaperScroll.3" x:Name="FrameSection" Header="⌄ 相框" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><ListBox x:Name="FrameChoice" ItemsSource="{Binding LightPrintFrameChoices}" SelectedValuePath="Id" SelectedValue="{Binding SelectedLightPrintFrameId,Mode=TwoWay}" IsEnabled="{Binding LightPrintControlsEnabled}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><StackPanel Width="78" Margin="2"><views:LightPrintFrameThumbnail Frame="{Binding}" Height="76"/><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Expander>
     <Expander Tag="PaperScroll.4" Header="⌄ 常用参数" IsEnabled="{Binding LightPrintControlsEnabled}" IsExpanded="True" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="效果强度"/><Slider x:Name="LightPrintAmount" Minimum="0" Maximum="1" Value="{Binding InstantAmount,Mode=TwoWay}"/><TextBlock Text="曝光"/><Slider x:Name="LightPrintExposure" Minimum="-2" Maximum="2" Value="{Binding InstantV3Exposure,Mode=TwoWay}"/></StackPanel></Expander>
     <Expander Tag="PaperScroll.5" Header="⌄ 进阶参数" Visibility="{Binding LightPrintRecipeVisible,Converter={StaticResource Bool}}"><views:InstantV3Editor x:Name="V3Advanced" Section="Advanced"/></Expander>
     <Expander Tag="PaperScroll.6" Header="⌄ 已显影 · 配方（只读）" IsExpanded="True" Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}"><StackPanel><TextBlock Text="{Binding LightPrintRecipeSummary}" TextWrapping="Wrap"/><Button Content="进阶调色" Click="ShowAdjust"/><Button Content="从原图重新拍一张" Command="{Binding ReshootLightPrintCommand}"/></StackPanel></Expander>
    </StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="LayersScroll" Visibility="Collapsed"><StackPanel><TextBox Text="{Binding Editor.SelectedNodeName,UpdateSourceTrigger=LostFocus}" ToolTip="图层名称"/><TextBlock Text="图层强度"/><Slider Minimum="0" Maximum="1" Value="{Binding Editor.SelectedLayerOpacity,Mode=TwoWay}" IsEnabled="{Binding Editor.LocalCompositeEditingAvailable}" AutomationProperties.Name="图层强度"/><ComboBox ItemsSource="{Binding Editor.LayerBlendModes}" SelectedItem="{Binding Editor.SelectedLayerBlend,Mode=TwoWay}" IsEnabled="{Binding Editor.LocalCompositeEditingAvailable}" AutomationProperties.Name="图层混合模式"/><StackPanel x:Name="MaskTools"/><Expander Tag="LayersScroll.SceneExposure" Header="RAW基础 · 场景线性" IsExpanded="False" IsEnabled="{Binding RawLocalEditing}"><StackPanel><TextBlock Text="场景曝光 EV（显示映射前）"/><TextBlock Text="{Binding SceneExposureMaskStatus}" TextWrapping="Wrap"/><Image Source="{Binding SceneExposureMaskPreview}" Width="64" Height="44" Stretch="Uniform" ToolTip="当前独立源坐标蒙版快照；编辑原图层不会自动同步"/><CheckBox Content="锁定场景曝光" IsChecked="{Binding SceneExposureLocked,Mode=TwoWay}"/><Slider Minimum="-5" Maximum="5" IsEnabled="{Binding CanEditSceneExposure}" Value="{Binding SceneLocalExposureEv,Mode=TwoWay}" AutomationProperties.Name="场景线性局部曝光" ToolTip="阶段B V1，位于显示映射前；不重复应用相机白平衡"/><Button Content="更新为当前层蒙版快照" IsEnabled="{Binding CanEditSceneExposure}" Click="BindSceneMask"/><Button Content="清除快照 · 恢复全图" IsEnabled="{Binding CanEditSceneExposure}" Click="ClearSceneMask"/><TextBlock Text="显示后局部工具位于下方" ToolTip="基础RAW曝光/白平衡与显示后局部工具为不同处理阶段"/></StackPanel></Expander><ListBox x:Name="OrderedSteps" ItemsSource="{Binding Editor.AdjustmentNodes}" SelectedItem="{Binding Editor.SelectedAdjustmentNode,Mode=TwoWay}" ItemTemplate="{StaticResource R53LayerCard}" ItemContainerStyle="{StaticResource R53LayerSelection}"/><WrapPanel><Button Content="上移" Command="{Binding Editor.MoveAdjustmentNodeUpCommand}"/><Button Content="下移" Command="{Binding Editor.MoveAdjustmentNodeDownCommand}"/><Button Content="新建" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="BasicTone"/><Button Content="复制" Command="{Binding Editor.DuplicateAdjustmentNodeCommand}"/><Button Content="显隐" Command="{Binding Editor.ToggleAdjustmentNodeCommand}"/><Button Content="删除" Command="{Binding Editor.DeleteAdjustmentNodeCommand}"/><CheckBox Content="锁定" IsChecked="{Binding Editor.SelectedNodeLocked,Mode=TwoWay}"/></WrapPanel></StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="StylesScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<Expander Tag="StylesScroll.1" Header="⌄ 胶片风格" IsExpanded="True"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><CheckBox Content="启用胶片" IsChecked="{Binding Editor.FilmEnabled}"/><ListBox ItemsSource="{Binding Editor.FilmProfiles}" SelectedValuePath="Id" SelectedValue="{Binding Editor.FilmProfileId,Mode=TwoWay}" BorderThickness="0" Background="Transparent" MaxHeight="210" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Grid Margin="3,5"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions><views:DarkroomIcon Kind="star"/><TextBlock Grid.Column="1" Text="{Binding Name}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><DockPanel><TextBlock Text="风格强度"/><TextBlock DockPanel.Dock="Right" Text="{Binding Editor.FilmProfileAmount,StringFormat=P0}"/></DockPanel><Slider Minimum="0" Maximum="1" Value="{Binding Editor.FilmProfileAmount,Mode=TwoWay}"/></StackPanel></Expander>
<Expander Tag="StylesScroll.2" Header="⌄ 我的色彩方案" IsExpanded="True"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><TextBox Text="{Binding Editor.ColorSchemeName,UpdateSourceTrigger=PropertyChanged}" FontSize="11"/><Button Content="存为新方案" Command="{Binding Editor.SaveColorSchemeAsCommand}"/><ListBox ItemsSource="{Binding Editor.ColorSchemes}" SelectedItem="{Binding Editor.SelectedColorScheme}" DisplayMemberPath="Name" MaxHeight="150" Background="Transparent" BorderThickness="0"/><Button Content="应用所选方案" Click="ApplyScheme"/><TextBlock Text="{Binding Editor.CurrentColorSchemeName}" Foreground="#86868C" FontSize="11"/></StackPanel></Expander>
<Expander Tag="StylesScroll.3" Header="⌄ Adobe XMP" IsExpanded="False"><StackPanel IsEnabled="{Binding PhotoGradeRasterToolsEnabled}"><Button Content="导入 Adobe XMP…" Command="{Binding Editor.ImportAdobeXmpCommand}"/><ListBox ItemsSource="{Binding Editor.AdobeXmpPresets}" SelectedItem="{Binding Editor.SelectedAdobeXmpPreset}" DisplayMemberPath="Name" MaxHeight="160" Background="Transparent" BorderThickness="0"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.PresetStrengthPercent,Mode=TwoWay}"/><WrapPanel><Button Content="预览" Command="{Binding Editor.PreviewPresetCommand}"/><Button Content="提交" Command="{Binding Editor.CommitPresetCommand}"/><Button Content="取消" Command="{Binding Editor.CancelPresetCommand}"/></WrapPanel></StackPanel></Expander>
<Expander Tag="StylesScroll.4" Header="⌄ 调整剪贴板" IsExpanded="True"><WrapPanel><Button Content="复制调整" Command="{Binding CopyAdjustmentsCommand}"/><Button Content="粘贴调整" Command="{Binding ApplyAdjustmentsCommand}"/></WrapPanel></Expander>
<TextBlock Visibility="{Binding IsLightPrintLocked,Converter={StaticResource Bool}}" Text="光片配方只读；可调色或新建变体。" TextWrapping="Wrap" Foreground="#86868C" Margin="8"/>
</StackPanel></ScrollViewer>
    <ScrollViewer Grid.Row="2" x:Name="VariantsScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
<Expander Tag="VariantsScroll.1" Header="⌄ 照片信息" IsExpanded="True"><StackPanel><TextBlock Text="{Binding TargetName}" Foreground="#E2E1DD"/><TextBlock Text="{Binding ActiveTarget.PixelWidth,StringFormat=宽度  {0} px}" FontSize="11"/><TextBlock Text="{Binding ActiveTarget.PixelHeight,StringFormat=高度  {0} px}" FontSize="11"/><TextBlock Text="{Binding ActiveTarget.MetadataStatus}" Foreground="#86868C" FontSize="11" TextWrapping="Wrap"/></StackPanel></Expander>
<Expander Tag="VariantsScroll.2" Header="⌄ 变体堆叠" IsExpanded="True"><StackPanel><WrapPanel><Button Content="原始新建 F2" Click="R53NewOriginal"/><Button Content="复制当前 F3" Click="R53Duplicate"/><Button Content="设主变体" Click="R53SetMain"/><Button Content="删除变体" Command="{Binding ArchiveEditVersionCommand}"/><Button Content="撤销删除" Click="R53UndoDelete"/></WrapPanel><ListBox x:Name="HistoryVersions" ItemsSource="{Binding R53Variants}" SelectedItem="{Binding SelectedCatalogVersion,Mode=TwoWay}" SelectionChanged="VariantPicked" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#343438" BorderThickness="0,0,0,1" Padding="4,8"><StackPanel><TextBlock Text="{Binding Name}" Foreground="#D5D5D9"/><TextBlock Text="{Binding CreatedAt,StringFormat=yyyy-MM-dd HH:mm}" FontSize="11" Foreground="#86868C"/><TextBlock Text="{Binding RawDefinition.LightPrint.FrameId}" FontSize="11" Foreground="#6E9B91" TextTrimming="CharacterEllipsis"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><TextBlock Text="评分"/><Slider Width="90" Minimum="0" Maximum="5" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding R53VariantRating,Mode=TwoWay}"/><ComboBox Width="60" SelectedValuePath="Content" SelectedValue="{Binding R53VariantColorLabel,Mode=TwoWay}"><ComboBoxItem Content="无"/><ComboBoxItem Content="红"/><ComboBoxItem Content="橙"/><ComboBoxItem Content="黄"/><ComboBoxItem Content="绿"/><ComboBoxItem Content="蓝"/><ComboBoxItem Content="紫"/></ComboBox></WrapPanel><TextBox Text="{Binding EditVersionName,UpdateSourceTrigger=PropertyChanged}" ToolTip="当前变体新名称"/><WrapPanel><Button Content="重命名" Command="{Binding RenameEditVersionCommand}"/><Button Content="保存变体" Command="{Binding SaveEditVersionsCommand}"/><Button Content="下一变体" Command="{Binding NextEditVersionCommand}"/></WrapPanel></StackPanel></Expander>
<Expander Tag="VariantsScroll.3" Header="⌄ 历史" IsExpanded="True"><StackPanel><WrapPanel><Button Content="撤销" Command="{Binding PhotoGradeUndoCommand}"/><Button Content="重做" Command="{Binding PhotoGradeRedoCommand}"/></WrapPanel><TextBlock Text="{Binding LightPrintStatus}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11" Foreground="#86868C"/><TextBlock Text="撤销仅影响当前照片。" TextWrapping="Wrap" FontSize="11" Foreground="#86868C"/></StackPanel></Expander>
</StackPanel></ScrollViewer>
