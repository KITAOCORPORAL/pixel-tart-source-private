<UserControl x:Class="RAWSelectionAssistant.Views.BatchCompressionModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnPreviewDragOver"
             AutomationProperties.Name="批量压缩">
    <Grid MinHeight="540">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <views:SurfaceHeader Title="批量压缩"
                             Subtitle="输出始终写入独立目录，使用新文件名，不覆盖、移动或删除源文件。"
                             ShowCloseButton="False"
                             CloseAutomationName="关闭批量压缩并返回"
                             CloseAutomationId="BatchCompressCloseButton" />

        <Grid Grid.Row="1" Margin="24,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="24" /><ColumnDefinition Width="320" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelSurface}">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="照片列表" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <Button Content="添加照片（可多选）" Style="{StaticResource Av2SecondaryButton}" Command="{Binding AddFilesCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{Binding Items}" MinHeight="300" Style="{StaticResource Av2ListView}" ItemContainerStyle="{StaticResource Av2ListViewItem}" AutomationProperties.Name="待压缩照片列表">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Av2GridViewHeader}">
                                <GridViewColumn Header="文件" DisplayMemberBinding="{Binding DisplayName}" Width="240" />
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding StateText}" Width="88" />
                                <GridViewColumn Header="说明" DisplayMemberBinding="{Binding StatusText}" Width="160" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelSurface}">
                <StackPanel>
                    <TextBlock Text="压缩参数" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="独立输出目录" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Av2TextBox}" Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" />
                    <Button Content="选择独立输出目录" Style="{StaticResource Av2SecondaryButton}" Command="{Binding ChooseDestinationCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />

                    <TextBlock Text="JPEG 质量" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <Slider Minimum="40" Maximum="100" Value="{Binding JpegQuality}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding JpegQuality}" Style="{StaticResource NumericLargeText}" FontSize="{DynamicResource SectionFontSize}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="最长边（像素）" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Av2TextBox}" Text="{Binding LongestEdge, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox Content="保留元数据" IsChecked="{Binding PreserveMetadata}" Margin="0,16,0,0" />
                    <CheckBox Content="保留 ICC 色彩配置" IsChecked="{Binding PreserveIccProfile}" Margin="0,8,0,0" />

                    <Border Style="{StaticResource SemanticInfoPanel}" Padding="12" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="冲突策略：自动编号" Style="{StaticResource CardTitleText}" />
                            <TextBlock Text="始终新建输出并完成写入刷新；不覆盖、不移动、不删除源照片。" Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ModalFooter}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    <ProgressBar Width="180" Height="6" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消任务" Style="{StaticResource Av2SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="BatchCompressCancelTaskButton" />
                    <Button Content="开始压缩" Style="{StaticResource Av2PrimaryButton}" Command="{Binding StartCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
