<UserControl x:Class="RAWSelectionAssistant.Views.ShootBookingDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="拍摄排期详情"
             AutomationProperties.HelpText="切换排期时默认回到概览并重置滚动位置；金额默认遮罩，归档不会删除任何电脑文件">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="BookingDetailsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="HeaderSurface" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" CornerRadius="5,5,0,0" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter TargetName="HeaderSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderSurface" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}" Padding="0">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="14">
                <Grid>
                    <StackPanel><TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding BookingStatusText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel>
                    <views:SurfaceCloseButton HorizontalAlignment="Right" VerticalAlignment="Top" AutomationName="关闭排期详情" />
                </Grid>
            </Border>

            <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}" BorderThickness="0" Background="{DynamicResource SurfacePrimaryBrush}" ItemContainerStyle="{StaticResource BookingDetailsTabItemStyle}">
                <TabItem Header="概览">
                    <ScrollViewer x:Name="OverviewScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14">
                            <TextBlock Text="拍摄" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding ShootCompletionText}" FontWeight="SemiBold" Margin="0,2,0,8" />
                            <TextBlock Text="工作流" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding WorkflowStageText}" Margin="0,2,0,10" />
                            <TextBlock Text="拍摄流程状态" Style="{StaticResource CaptionText}" />
                            <ComboBox ItemsSource="{Binding WorkflowStatusOptions}" SelectedItem="{Binding SelectedWorkflowStatus, Mode=TwoWay}" DisplayMemberPath="Label" Margin="0,4,0,12" AutomationProperties.Name="修改拍摄流程状态" AutomationProperties.HelpText="选择后立即保存；回退状态时会请求确认" />
                            <TextBlock Text="客户" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding ClientDisplayName}" Margin="0,2,0,10" />
                            <TextBlock Text="时间" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TimeText}" TextWrapping="Wrap" Margin="0,2,0,2" /><TextBlock Text="{Binding TimeZoneText}" Style="{StaticResource CaptionText}" Margin="0,0,0,10" />
                            <TextBlock Text="地点 / 类型" Style="{StaticResource CaptionText}" /><TextBlock Margin="0,2,0,10"><Run Text="{Binding LocationText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ShootingTypeText, Mode=OneWay}" /></TextBlock>
                            <Separator />
                            <TextBlock Text="具体拍摄要求" FontWeight="SemiBold" Margin="0,8,0,3" /><TextBlock Text="{Binding ShootingRequirementsText}" TextWrapping="Wrap" />
                            <TextBlock Text="准备说明" FontWeight="SemiBold" Margin="0,12,0,3" /><TextBlock Text="{Binding PreparationNotesText}" TextWrapping="Wrap" />
                            <TextBlock Text="准备清单" FontWeight="SemiBold" Margin="0,12,0,3" />
                            <ItemsControl ItemsSource="{Binding Requirements}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,2"><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="70" /></Grid.ColumnDefinitions><TextBlock Text="{Binding IsCompleted, StringFormat={}{0}}" /><TextBlock Grid.Column="1" Text="{Binding ItemText}" TextWrapping="Wrap" /><TextBlock Grid.Column="2" Text="{Binding Priority}" Style="{StaticResource CaptionText}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="内部备注" FontWeight="SemiBold" Margin="0,14,0,3" /><TextBlock Text="{Binding NotesText}" TextWrapping="Wrap" />
                            <Border Style="{StaticResource InfoCard}" Margin="0,12,0,0" Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="此排期已归档，只提供查看和恢复；没有永久删除入口。" TextWrapping="Wrap" /></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="资料">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><views:BookingDocumentsPanel DataContext="{Binding Documents}" Margin="12" Visibility="{Binding HasDocumentsPanel, Converter={StaticResource BooleanToVisibilityConverter}}" /></ScrollViewer>
                </TabItem>

                <TabItem Header="人员">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14">
                            <TextBlock Text="联系人" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Contacts}" Margin="0,6,0,12"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InfoCard}" Margin="0,0,0,6"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding ContactText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" /></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                            <TextBlock Text="工作人员" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Staff}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InfoCard}" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="95" /><ColumnDefinition Width="130" /></Grid.ColumnDefinitions><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding RoleText}" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="2" Text="{Binding ArrivalText}" Style="{StaticResource CaptionText}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="天气提醒">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12">
                            <views:BookingWeatherPanel DataContext="{Binding Weather}" Visibility="{Binding HasWeatherPanel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <views:BookingRemindersPanel DataContext="{Binding Reminders}" Margin="0,12,0,0" Visibility="{Binding HasRemindersPanel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="收支">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="14">
                            <Grid><TextBlock Text="本地金额记录" FontWeight="SemiBold" /><Button Content="{Binding AmountVisibilityText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding ToggleAmountsCommand}" AutomationProperties.Name="切换金额显示" /></Grid>
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="拍摄总金额" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding TotalAmountText}" /></Grid>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="定金" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding DepositAmountText}" /></Grid>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="已收金额" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding PaidAmountText}" /></Grid>
                            <Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="120" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding BalanceLabel}" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding BalanceText}" /></Grid>
                            <Border Style="{StaticResource WarningCard}" Margin="0,8,0,0" Visibility="{Binding HasMoneyWarning, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding MoneyWarningText}" TextWrapping="Wrap" /></Border>
                            <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0"><StackPanel><Grid><TextBlock Text="收入与支出摘要" FontWeight="SemiBold" /><Button Content="查看收支" Style="{StaticResource GhostButton}" Command="{Binding ViewFinanceCommand}" HorizontalAlignment="Right" AutomationProperties.Name="查看当前排期收支" /></Grid><UniformGrid Columns="3" Margin="0,8,0,0"><StackPanel><TextBlock Text="预计收入" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding ExpectedIncomeText}" /></StackPanel><StackPanel><TextBlock Text="已收" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding FinanceReceivedText}" /></StackPanel><StackPanel><TextBlock Text="未收" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding FinanceReceivableText}" /></StackPanel><StackPanel Margin="0,8,0,0"><TextBlock Text="已支出" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding FinanceExpenseText}" /></StackPanel><StackPanel Margin="0,8,0,0"><TextBlock Text="待付" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding FinancePayableText}" /></StackPanel><StackPanel Margin="0,8,0,0"><TextBlock Text="当前净收益" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding FinanceNetText}" FontWeight="SemiBold" /></StackPanel></UniformGrid><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="＋ 收入" Style="{StaticResource SecondaryButton}" Command="{Binding AddIncomeCommand}" AutomationProperties.Name="为当前排期添加收入" /><Button Content="＋ 支出" Style="{StaticResource SecondaryButton}" Command="{Binding AddExpenseCommand}" Margin="7,0,0,0" AutomationProperties.Name="为当前排期添加支出" /></StackPanel><TextBlock Text="拍摄完成和交付状态不会自动更改收款状态。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="14,6" />
            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12"><WrapPanel HorizontalAlignment="Right"><Button Content="归档" Style="{StaticResource SecondaryButton}" Command="{Binding ArchiveCommand}" AutomationProperties.Name="归档排期" AutomationProperties.HelpText="归档后隐藏常规日历、关闭提醒并保留全部关联数据和电脑文件" /><Button Content="标记拍摄完成" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding CompleteCommand}" AutomationProperties.Name="标记拍摄完成" AutomationProperties.HelpText="保留排期与提醒历史，并关闭未来未触发提醒" /><Button Content="快速编辑" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding EditCommand}" AutomationProperties.Name="快速编辑排期" /><Button Content="完整拍摄策划" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding FullPlanningCommand}" AutomationProperties.Name="打开完整拍摄策划" /></WrapPanel></Border>
        </Grid>
    </Border>
</UserControl>
