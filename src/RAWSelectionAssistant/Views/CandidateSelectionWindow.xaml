<Window x:Class="RAWSelectionAssistant.Views.CandidateSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
        Title="选择 RAW 候选文件"
        Icon="../Assets/AppIcon.ico"
        Width="960" Height="520" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="选择正确的 RAW 文件" Style="{StaticResource SectionTitleText}" FontSize="18" />
            <TextBlock Text="存在多个精确候选，系统不会自动替你选择。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="CandidatesGrid" Grid.Row="1" ItemsSource="{Binding}" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="180" />
                <DataGridTextColumn Header="完整路径" Binding="{Binding FullPath}" Width="*" />
                <DataGridTextColumn Header="大小" Binding="{Binding Size, Converter={StaticResource FileSizeConverter}}" Width="90" />
                <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                <DataGridTextColumn Header="来源目录" Binding="{Binding SourceRoot}" Width="220" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="在文件资源管理器中显示" Style="{StaticResource SecondaryButton}" Click="Reveal_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click" IsCancel="True" />
                <Button Content="确认选择" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Confirm_Click" IsDefault="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
