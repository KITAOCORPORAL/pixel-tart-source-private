<Window x:Class="RAWSelectionAssistant.Views.FeedbackDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="建议与问题反馈" Width="560" SizeToContent="Height" MinHeight="330"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Icon="../Assets/AppIcon.ico" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid x:Name="FeedbackRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="28,26,28,24">
            <TextBlock Text="建议与问题反馈" Style="{StaticResource DialogTitle}" />
            <TextBlock Margin="0,12,0,22" TextWrapping="Wrap" LineHeight="23"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="如在使用像素蛋挞时遇到问题，或有功能建议，可以通过以下邮箱联系作者。" />
            <TextBlock Text="作者邮箱" FontWeight="SemiBold" Margin="0,0,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="EmailTextBox" IsReadOnly="True" MinHeight="40" VerticalContentAlignment="Center"
                         AutomationProperties.Name="作者邮箱" />
                <Button x:Name="CopyEmailButton" Grid.Column="1" Content="复制邮箱" Style="{StaticResource SecondaryButton}"
                        MinWidth="104" Margin="10,0,0,0" Click="CopyEmail_Click"
                        AutomationProperties.Name="复制邮箱" />
            </Grid>
            <TextBlock x:Name="StatusText" MinHeight="20" Margin="0,10,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource AccentBrush}" AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0" Padding="12,9">
                <TextBlock Text="邮件模板只包含软件版本和 Windows 版本，不会附带照片、项目、授权或日志信息。"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource DialogFooter}">
            <Grid>
                <Button Content="关闭" Style="{StaticResource GhostButton}" HorizontalAlignment="Left"
                        MinWidth="88" IsCancel="True" Click="Close_Click" AutomationProperties.Name="关闭反馈窗口" />
                <Button Content="撰写邮件" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"
                        MinWidth="112" IsDefault="True" Click="ComposeEmail_Click" AutomationProperties.Name="撰写反馈邮件" />
            </Grid>
        </Border>
    </Grid>
</Window>
