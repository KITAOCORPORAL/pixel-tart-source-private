<UserControl x:Class="RAWSelectionAssistant.Views.ArchivedBookingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="已归档排期" AutomationProperties.HelpText="分页查看和恢复排期，不提供永久删除">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="已归档排期" Style="{StaticResource PageTitleText}" /><TextBlock Text="只提供查看和恢复；不会删除准备清单、文档关联或电脑文件" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBox Width="220" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索已归档排期" /><Button Content="查询" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding RefreshCommand}" /></StackPanel></Grid>
        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,14,0,0" HeadersVisibility="Column" SelectionMode="Single">
            <DataGrid.Columns><DataGridTextColumn Header="开始时间" Binding="{Binding StartText}" Width="160" /><DataGridTextColumn Header="项目" Binding="{Binding Title}" Width="2*" /><DataGridTextColumn Header="客户" Binding="{Binding ClientDisplayName}" Width="*" /><DataGridTextColumn Header="地点" Binding="{Binding Location}" Width="*" /><DataGridTextColumn Header="状态" Binding="{Binding StatusText}" Width="100" /><DataGridTemplateColumn Header="操作" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Button Content="查看" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /><Button Content="恢复" Style="{StaticResource SecondaryButton}" Margin="5,0,0,0" Command="{Binding DataContext.RestoreCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title, StringFormat=恢复排期 {0}}" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,10,0,0"><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" /><Button Content="加载更多" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMore, Converter={StaticResource BooleanToVisibilityConverter}}" /><ProgressBar IsIndeterminate="True" Width="120" Height="3" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
    </Grid>
</UserControl>
