<Window x:Class="RAWSelectionAssistant.Views.ClientMonitorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="像素蛋挞 · 客户监看" WindowStyle="None" ResizeMode="CanResize" Background="#080A0D" Foreground="White"
        AutomationProperties.Name="第二显示器客户监看窗口" AutomationProperties.HelpText="默认隐藏文件名、路径和私人备注的只读客户监看窗口">
    <Window.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></Window.Resources>
    <Grid>
        <Image Source="{Binding DisplayImage}" Stretch="Uniform" SnapsToDevicePixels="True" />
        <Border VerticalAlignment="Top" Background="#CC11161D" Padding="16,10">
            <Grid><TextBlock Text="像素蛋挞 · 客户监看" FontSize="18" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="{Binding FollowModeText}" /><TextBlock Text="  ·  " /><TextBlock Text="{Binding StatusText}" /></StackPanel></Grid>
        </Border>
        <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16,0,0,92" Background="#CC11161D" Padding="12,8" CornerRadius="5">
            <StackPanel><TextBlock Text="{Binding SimplifiedFileNumber}" Visibility="{Binding ShowIdentifier, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="{Binding TechnicalSummary}" Visibility="{Binding ShowTechnicalMetadata, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="{Binding RatingText}" Visibility="{Binding ShowRating, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="{Binding LutName}" Foreground="#AEB8C6" /></StackPanel>
        </Border>
        <Border VerticalAlignment="Bottom" Background="#DD11161D" Padding="16" Visibility="{Binding ShowClientControls, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Content="客户收藏" Command="{Binding ToggleFavoriteCommand}" Padding="16,8" AutomationProperties.Name="客户收藏按钮" />
                <StackPanel Grid.Column="1" Margin="16,0"><TextBlock Text="客户备注" /><TextBox Text="{Binding ClientNote, UpdateSourceTrigger=PropertyChanged}" MinWidth="360" MaxWidth="720" Height="42" AutomationProperties.Name="客户备注输入框" /></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Button Content="清空" Command="{Binding ClearNoteCommand}" Padding="12,8" Margin="0,0,8,0" AutomationProperties.Name="清空客户备注" /><Button Content="保存备注" Command="{Binding SaveNoteCommand}" Padding="16,8" AutomationProperties.Name="保存客户备注" /></StackPanel>
            </Grid>
        </Border>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,58,16,0" Background="#CC11161D" Padding="10"><TextBlock Text="{Binding NewAssetText}" Foreground="#F2B84B" /></Border>
    </Grid>
</Window>
