<UserControl x:Class="RAWSelectionAssistant.Views.MonthCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="月视图" AutomationProperties.HelpText="固定六周四十二天日历网格">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <UniformGrid Columns="7" Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock Text="周一" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周二" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="周三" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周四" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="周五" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周六" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="周日" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </UniformGrid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1" Padding="6" MinWidth="118" MinHeight="82" PreviewMouseLeftButtonDown="DayCell_MouseLeftButtonDown" AutomationProperties.Name="{Binding AccessibilityName}">
                        <Border.ContextMenu><ContextMenu><MenuItem Header="创建拍摄任务" Click="CreateBooking_Click" /><Separator /><MenuItem Header="关闭本日档期" Click="CloseDay_Click" /><MenuItem Header="打开本日档期" Click="OpenDay_Click" /><MenuItem Header="本日设置" Click="DaySettings_Click" /><Separator /><MenuItem Header="查看当天详情" Click="ViewDay_Click" /></ContextMenu></Border.ContextMenu>
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.56" /></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsClosed}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Opacity" Value="0.72" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" /><TextBlock Text="  已关闭" Foreground="{DynamicResource WarningBrush}" FontSize="10" Visibility="{Binding IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleBookings}" Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Padding="4,2" MinHeight="22" Margin="0,1" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusGlyph}" Margin="0,0,4,0" /><TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding AccessibilityName}" /><TextBlock Grid.Column="2" Text="{Binding MonthWeatherIcon}" Margin="4,0,0,0" FontSize="11" ToolTip="{Binding WeatherText}" /></Grid></Button></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="2" Text="{Binding OverflowText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
