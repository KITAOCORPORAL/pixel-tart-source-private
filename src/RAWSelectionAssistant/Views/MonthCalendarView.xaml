<UserControl x:Class="RAWSelectionAssistant.Views.MonthCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:RAWSelectionAssistant.Core.Models;assembly=RAWSelectionAssistant.Core"
             xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}}"
             AutomationProperties.Name="月视图" AutomationProperties.HelpText="固定六周四十二天日历网格">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <UniformGrid Columns="7" Background="{DynamicResource SurfaceSecondaryBrush}">
            <TextBlock Text="周一" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周二" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="周三" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周四" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock Text="周五" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周六" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock Text="周日" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </UniformGrid>
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Margin="0,10,0,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,1" Padding="6" MinWidth="118" MinHeight="82" PreviewMouseLeftButtonDown="DayCell_MouseLeftButtonDown" AutomationProperties.Name="{Binding AccessibilityName}"
                            Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="{Binding TooltipText}">
                        <Border.ContextMenu>
                            <ContextMenu AutomationProperties.HelpText="关闭档期只影响新建，不删除已有排期">
                                <MenuItem Header="创建拍摄任务" Command="{Binding PlacementTarget.Tag.Month.CreateBookingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="查看当天详情" Command="{Binding PlacementTarget.Tag.ViewDayDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="关闭本日档期" Command="{Binding PlacementTarget.Tag.Month.CloseDayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="开放本日档期" Command="{Binding PlacementTarget.Tag.Month.OpenDayCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="本日设置" Command="{Binding PlacementTarget.Tag.Month.SelectDateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.56" /></DataTrigger><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CalendarTodayOutlineBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger><DataTrigger Binding="{Binding IsClosed}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Opacity" Value="0.72" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="FullCalendarDayNumberBadge" MinWidth="32" Height="26" Padding="6,0" CornerRadius="6" BorderThickness="1" ToolTip="{Binding PrimaryWorkflowStatus}">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource CalendarStatusFreeBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusFreeBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasBookings}" Value="True"><Setter Property="Background" Value="{DynamicResource CalendarStatusScheduledBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusScheduledBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.PendingDelivery}"><Setter Property="Background" Value="{DynamicResource CalendarStatusPendingDeliveryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusPendingDeliveryBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.Delivered}"><Setter Property="Background" Value="{DynamicResource CalendarStatusDeliveredBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusDeliveredBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <TextBlock Text="{Binding DayNumber}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusFreeForegroundBrush}" /><Style.Triggers><DataTrigger Binding="{Binding HasBookings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusScheduledForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.PendingDelivery}"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusPendingDeliveryForegroundBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.Delivered}"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusDeliveredForegroundBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="{Binding IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" Data="M5,10 L5,7 C5,3 11,3 11,7 L11,10 M3,10 L13,10 13,17 3,17 Z" />
                                    <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.4" Data="M5,10 L5,7 C5,3 11,3 11,7 L11,10 M3,10 L13,10 13,17 3,17 Z" ToolTip="当天已关闭接单" />
                                </StackPanel>
                            </StackPanel>
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding VisibleBookings}" Margin="0,3,0,0">
                                <ItemsControl.ItemTemplate><DataTemplate><Button HorizontalContentAlignment="Stretch" Padding="4,2" MinHeight="22" Margin="0,1" Tag="{Binding Tag, RelativeSource={RelativeSource AncestorType=UserControl}}" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}">
                                    <Button.ContextMenu><ContextMenu>
                                        <MenuItem Header="查看详情" Command="{Binding PlacementTarget.Tag.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <MenuItem Header="编辑排期" Command="{Binding PlacementTarget.Tag.EditBookingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Separator />
                                        <MenuItem Header="修改状态">
                                            <MenuItem Header="有拍摄" Command="{Binding PlacementTarget.Tag.ChangeWorkflowStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.ScheduledStatusRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="标记拍摄完成" Command="{Binding PlacementTarget.Tag.ChangeWorkflowStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.ShotStatusRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="待返图" Command="{Binding PlacementTarget.Tag.ChangeWorkflowStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.PendingDeliveryStatusRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                            <MenuItem Header="已返图" Command="{Binding PlacementTarget.Tag.ChangeWorkflowStatusCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.DeliveredStatusRequest, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="归档" Command="{Binding PlacementTarget.Tag.ArchiveBookingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    </ContextMenu></Button.ContextMenu>
                                    <Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Style.Triggers><DataTrigger Binding="{Binding IsCrossDay}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="1,0" /></DataTrigger><DataTrigger Binding="{Binding IsCrossDayStart}" Value="True"><Setter Property="BorderThickness" Value="1,0,0,0" /></DataTrigger><DataTrigger Binding="{Binding IsCrossDayEnd}" Value="True"><Setter Property="BorderThickness" Value="0,0,1,0" /></DataTrigger></Style.Triggers></Style></Button.Style><StackPanel><TextBlock Text="{Binding MonthTitle}" TextTrimming="CharacterEllipsis" FontSize="11" ToolTip="{Binding AccessibilityName}" /><TextBlock Text="{Binding TimeText, Mode=OneWay}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                                </Button></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Grid.Row="2" Text="{Binding BookingCountText}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                            <TextBlock Grid.Row="2" Text="{Binding ConflictGlyph}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" />
                            <TextBlock Grid.Row="2" Text="{Binding WeatherGlyph}" FontSize="9" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
