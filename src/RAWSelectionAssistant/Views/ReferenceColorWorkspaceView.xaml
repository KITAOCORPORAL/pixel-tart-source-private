    <ItemsControl ItemsSource="{Binding Editor.ReferenceSources}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="Transparent" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,6,4,12" Margin="0,0,0,10"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="54"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Source.SourcePath}" Width="48" Height="48" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SourceLabel}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/></StackPanel></Grid><Grid Margin="0,12,0,0"><TextBlock Text="权重" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding WeightPercent, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0.1" Maximum="100" Value="{Binding WeightPercent}"/><StackPanel Orientation="Horizontal" Margin="0,6,0,0"><Button Content="↑" Command="{Binding DataContext.Editor.MoveReferenceUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="↓" Command="{Binding DataContext.Editor.MoveReferenceDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0"/><Button Content="移除" Command="{Binding DataContext.Editor.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0"/></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
