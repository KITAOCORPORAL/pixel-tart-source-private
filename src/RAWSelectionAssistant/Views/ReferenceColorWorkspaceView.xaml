<UserControl x:Class="RAWSelectionAssistant.Views.ReferenceColorWorkspaceView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:RAWSelectionAssistant.Views" xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters" xmlns:studio="clr-namespace:PixelTart.Modules.AssetLibrary;assembly=PixelTart.Modules.AssetLibrary"
 AutomationProperties.Name="参考仿色工作区">
 <UserControl.Resources>
  <Style x:Key="SchemeCard" TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,6"/><Setter Property="Margin" Value="0,3"/><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></Style.Triggers>
  </Style>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/><conv:FilmTexturePreviewConverter x:Key="FilmTexturePreview"/><views:InverseBooleanToVisibilityConverter x:Key="InverseBoolVisibility"/><views:EnumEqualsVisibilityConverter x:Key="SectionVisibility"/><views:ColorStudioNodeTypeVisibilityConverter x:Key="NodeTypeVisibility"/><views:ColorStudioNodeStrengthConverter x:Key="NodeStrength"/><views:ColorStudioNodeIconConverter x:Key="NodeIcon"/><views:ColorStudioSampleBrushConverter x:Key="SampleBrush"/><views:ColorStudioSchemeSummaryConverter x:Key="SchemeSummary"/>
  <Style x:Key="ParameterLabel" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,9"/></Style>
  <Style x:Key="ParameterValue" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Foreground" Value="{DynamicResource TextValueBrush}"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="Medium"/><Setter Property="HorizontalAlignment" Value="Right"/></Style>
  <Style x:Key="RailButton" TargetType="ListBoxItem" BasedOn="{StaticResource PixelTart.Segmented.Item}"><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0"/><Setter Property="Padding" Value="7,5"/></Style>
 </UserControl.Resources>
 <Grid Background="{DynamicResource CanvasBackgroundBrush}" Margin="20,16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="SourceHeader" Grid.Row="0" Margin="0,0,0,14">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="SourceBars" Orientation="Horizontal">
    <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="8,5" Margin="0,0,8,0" MinWidth="270"><StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource SurfaceTertiaryBrush}" Margin="0,0,8,0"><TextBlock Text="原" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="原片" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><TextBlock Text="  " /><TextBlock Text="{Binding TargetName}" TextTrimming="CharacterEllipsis" MaxWidth="210" VerticalAlignment="Center"/></StackPanel></Border>
    <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="8" Padding="8,5" MinWidth="300"><StackPanel Orientation="Horizontal"><Border Width="22" Height="22" CornerRadius="5" Background="{DynamicResource AccentSoftBrush}" Margin="0,0,8,0"><TextBlock Text="参" FontSize="10" Foreground="{DynamicResource AccentValueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="参考风格" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><TextBlock Text="  " /><TextBlock Text="{Binding Editor.CurrentLookText}" TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/></StackPanel></Border>
   </StackPanel>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal">
    <ListBox Style="{StaticResource PixelTart.Segmented}" ItemsSource="{Binding Editor.WorkspaceModes}" SelectedItem="{Binding Editor.WorkspaceMode}" AutomationProperties.Name="简洁或专业模式"/>
    <Button Content="专注看图" Command="{Binding Editor.ToggleFocusViewCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="8,0,0,0"/>
    <Button x:Name="ContextRailButton" Content="上下文" Command="{Binding Editor.ToggleContextRailCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="8,0,0,0"/>
    <Button Content="导入照片" Command="{Binding ChooseTargetCommand}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
   </StackPanel>
  </Grid>
  <Grid x:Name="WorkspaceGrid" Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="0.19*" MinWidth="206"/><ColumnDefinition x:Name="CenterColumn" Width="0.63*" MinWidth="520"/><ColumnDefinition x:Name="RightColumn" Width="0.18*" MinWidth="224"/></Grid.ColumnDefinitions>
   <Border x:Name="LeftRail" Grid.Column="0" Style="{StaticResource PixelTart.Inspector}" Margin="0,0,14,0" Padding="14,12" Visibility="{Binding Editor.IsLeftRailVisible, Converter={StaticResource BoolVisibility}}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <ListBox Grid.Row="0" Margin="0,0,0,12" Style="{StaticResource PixelTart.Segmented}" ItemContainerStyle="{StaticResource RailButton}" ItemsSource="{Binding Editor.WorkspaceSections}" SelectedItem="{Binding Editor.WorkspaceSection}" AutomationProperties.Name="调色工作区导航"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
      <StackPanel Visibility="{Binding Editor.IsSimpleMode, Converter={StaticResource BoolVisibility}}"><StackPanel Visibility="{Binding Editor.WorkspaceSection, Converter={StaticResource SectionVisibility}, ConverterParameter=调色}">
       <TextBlock Text="调色" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/><CheckBox Content="保持原片影调" Style="{StaticResource PixelTart.Toggle}" IsChecked="{Binding Editor.KeepOriginalTone}"/>
       <Grid Margin="0,22,0,0"><TextBlock Text="对比度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ContrastStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ContrastStrength}"/>
       <Grid Margin="0,22,0,0"><TextBlock Text="饱和度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.SaturationStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SaturationStrength}"/>
      </StackPanel>
      <StackPanel Visibility="{Binding Editor.WorkspaceSection, Converter={StaticResource SectionVisibility}, ConverterParameter=仿色}">
       <TextBlock Text="参考仿色 · 核心调整" Style="{StaticResource SectionTitleText}" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
       <Grid><TextBlock Text="仿色强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.MatchStrength, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextValueBrush}" FontWeight="Medium" HorizontalAlignment="Right"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.MatchStrength}"/>
       <Grid Margin="0,22,0,0"><TextBlock Text="影调匹配" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ToneStrength, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextValueBrush}" FontWeight="Medium" HorizontalAlignment="Right"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ToneStrength}"/>
       <Grid Margin="0,22,0,0"><TextBlock Text="颜色匹配" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ColorStrength, StringFormat={}{0:0}%}" Foreground="{DynamicResource TextValueBrush}" FontWeight="Medium" HorizontalAlignment="Right"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ColorStrength}"/>
       <Expander Header="高级调整 · 保护" IsExpanded="True" Style="{StaticResource PixelTart.Section}" Margin="0,26,0,0"><StackPanel>
        <Grid><TextBlock Text="肤色保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.SkinProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SkinProtection}"/>
        <StackPanel Visibility="{Binding Editor.IsProMode, Converter={StaticResource BoolVisibility}}"><Grid Margin="0,14,0,0"><TextBlock Text="高光保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.HighlightProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.HighlightProtection}"/><Grid Margin="0,14,0,0"><TextBlock Text="中性保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.NeutralProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.NeutralProtection}"/></StackPanel>
       </StackPanel></Expander>
      </StackPanel>
      </StackPanel><StackPanel Visibility="{Binding Editor.IsProMode, Converter={StaticResource BoolVisibility}}" Margin="0,4,0,0"><StackPanel Visibility="{Binding Editor.IsNodeSection, Converter={StaticResource BoolVisibility}}">
       <TextBlock Text="调整节点" Style="{StaticResource SectionTitleText}" />
       <TextBlock Text="线性处理顺序" Style="{StaticResource CaptionText}" Margin="0,4,0,8" />
       <ListBox HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" x:Name="AdjustmentNodeList" ItemsSource="{Binding Editor.AdjustmentNodes}" SelectedItem="{Binding Editor.SelectedAdjustmentNode}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="调整节点列表" PreviewMouseLeftButtonDown="OnNodeDragStart" PreviewMouseMove="OnNodeDragMove" Drop="OnNodeDrop" AllowDrop="True"><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" CornerRadius="5" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></Style.Triggers></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border x:Name="NodeRow" Height="36" Margin="0,2" Padding="2,0" CornerRadius="5" ><Border.Style><Style TargetType="Border"><Setter Property="Opacity" Value="1"/><Style.Triggers><DataTrigger Binding="{Binding Enabled}" Value="False"><Setter Property="Opacity" Value=".48"/></DataTrigger><DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="40"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><TextBlock Text="≡" Style="{StaticResource CaptionText}" VerticalAlignment="Center" ToolTip="拖动排序"/><CheckBox Grid.Column="1" IsChecked="{Binding Enabled, Mode=OneWay}" Click="OnNodeEnableClick" Style="{StaticResource PixelTart.Toggle}" VerticalAlignment="Center" AutomationProperties.Name="启用节点"/><TextBlock Grid.Column="2" Text="{Binding Converter={StaticResource NodeIcon}}" Foreground="{DynamicResource AccentValueBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding Converter={StaticResource NodeStrength}}" Foreground="{DynamicResource TextValueBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/><Button Grid.Column="5" Content="⋯" Style="{StaticResource PixelTart.Button.Ghost}" Padding="0" Click="OnNodeOverflowClick" AutomationProperties.Name="节点更多操作"><Button.ContextMenu><ContextMenu Style="{StaticResource PixelTart.Menu.Context}"><MenuItem Header="重命名" Tag="rename" Click="OnNodeMenuClick"/><MenuItem Header="复制" Tag="duplicate" Click="OnNodeMenuClick"/><MenuItem Header="重置" Tag="reset" Click="OnNodeMenuClick"/><Separator/><MenuItem Header="上移" Tag="up" Click="OnNodeMenuClick"/><MenuItem Header="下移" Tag="down" Click="OnNodeMenuClick"/><MenuItem Header="删除" Tag="delete" Click="OnNodeMenuClick"/></ContextMenu></Button.ContextMenu></Button></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBox Width="120" Text="{Binding Editor.PendingNodeName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding Editor.IsRenamingNode, Converter={StaticResource BoolVisibility}}" KeyDown="OnRenameKeyDown" AutomationProperties.Name="节点名称"/><Button Content="确定" Command="{Binding Editor.CommitNodeRenameCommand}" Visibility="{Binding Editor.IsRenamingNode, Converter={StaticResource BoolVisibility}}" Style="{StaticResource PixelTart.Button.Ghost}"/></StackPanel>
       <WrapPanel Margin="0,8,0,0">
        <Button x:Name="AddAdjustmentAnchor" Content="＋ 添加调整" Command="{Binding Editor.ToggleAddAdjustmentCommand}" Style="{StaticResource SecondaryButton}" />
        <Popup PlacementTarget="{Binding ElementName=AddAdjustmentAnchor}" Placement="Bottom" StaysOpen="False" IsOpen="{Binding Editor.AddAdjustmentOpen}" AllowsTransparency="True"><Border Style="{StaticResource PixelTart.Popup.V2}" Width="160"><StackPanel><Button Content="参考仿色" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="ReferenceMatch" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="颜色范围" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="ColorRange" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="色彩过渡" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="TransitionBlend" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="胶片" Command="{Binding Editor.AddAdjustmentNodeCommand}" CommandParameter="Film" Style="{StaticResource PixelTart.Button.Ghost}"/></StackPanel></Border></Popup>
       </WrapPanel>
       <StackPanel Margin="0,12,0,0" >
        <TextBlock Text="选中节点参数" Style="{StaticResource SectionTitleText}" />
        <TextBlock Text="当前选中节点的参数会进入同一处理链。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,8" />
        <StackPanel Visibility="{Binding Editor.SelectedAdjustmentNode, Converter={StaticResource NodeTypeVisibility}, ConverterParameter=ColorRange}">
        <Grid><TextBlock Text="强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.RangeStrength}"/>
        <Grid><TextBlock Text="范围" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeRadius, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="50" Value="{Binding Editor.RangeRadius}"/>
        <Grid><TextBlock Text="柔和度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeSoftness, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="50" Value="{Binding Editor.RangeSoftness}"/>
        <Grid><TextBlock Text="色相" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeHue, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="-180" Maximum="180" Value="{Binding Editor.RangeHue}"/>
        <Grid><TextBlock Text="饱和度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeSaturation, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="-100" Maximum="100" Value="{Binding Editor.RangeSaturation}"/>
        <Grid><TextBlock Text="色度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeChroma, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="-100" Maximum="100" Value="{Binding Editor.RangeChroma}"/>
        <Grid><TextBlock Text="明度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.RangeLightness, StringFormat={}{0:0}}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="-100" Maximum="100" Value="{Binding Editor.RangeLightness}"/>
        <CheckBox Content="显示选区" Style="{StaticResource PixelTart.Toggle}" IsChecked="{Binding Editor.ShowSelection}" />
        <CheckBox Content="保持原始明度" ToolTip="在调整颜色时尽量保留该区域原本的视觉明暗关系。" Style="{StaticResource PixelTart.Toggle}" IsChecked="{Binding Editor.KeepOriginalLuminance}" Margin="0,10,0,4" />
        <WrapPanel><Button Content="吸管" Command="{Binding Editor.StartSamplingCommand}" CommandParameter="普通取样" Style="{StaticResource PixelTart.Button.Ghost}" /><Button Content="增加取样" Command="{Binding Editor.StartSamplingCommand}" CommandParameter="增加取样" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0" /><Button Content="减少取样" Command="{Binding Editor.StartSamplingCommand}" CommandParameter="减少取样" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0" /><Button Content="清除取样" Command="{Binding Editor.ClearSamplesCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0" /></WrapPanel>
        <TextBlock Text="增加取样" Style="{StaticResource CaptionText}" Margin="0,8,0,2"/><ItemsControl ItemsSource="{Binding Editor.PositiveSamples}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.Editor.RemovePositiveSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PixelTart.Button.Ghost}" ToolTip="移除此取样" Width="28" Height="28" Padding="4"><Ellipse Width="13" Height="13" Fill="{Binding Converter={StaticResource SampleBrush}}" Stroke="{DynamicResource DividerBrush}" StrokeThickness="1"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBlock Text="排除取样" Style="{StaticResource CaptionText}" Margin="0,8,0,2"/><ItemsControl ItemsSource="{Binding Editor.NegativeSamples}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Command="{Binding DataContext.Editor.RemoveNegativeSampleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource PixelTart.Button.Ghost}" ToolTip="移除此排除取样" Width="28" Height="28" Padding="4"><Ellipse Width="13" Height="13" Fill="{Binding Converter={StaticResource SampleBrush}}" Stroke="{DynamicResource TextPrimaryBrush}" StrokeThickness="1"/></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Visibility="{Binding Editor.SelectedAdjustmentNode, Converter={StaticResource NodeTypeVisibility}, ConverterParameter=ReferenceMatch}">
         <Grid><TextBlock Text="仿色强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.MatchStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.MatchStrength}"/>
         <Grid><TextBlock Text="影调" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ToneStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ToneStrength}"/>
         <Grid><TextBlock Text="颜色" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ColorStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ColorStrength}"/>
         <Grid><TextBlock Text="对比度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.ContrastStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ContrastStrength}"/>
         <Grid><TextBlock Text="饱和度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.SaturationStrength, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SaturationStrength}"/>
         <Grid><TextBlock Text="肤色保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.SkinProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SkinProtection}"/>
         <Grid><TextBlock Text="高光保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.HighlightProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.HighlightProtection}"/>
         <Grid><TextBlock Text="中性保护" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.NeutralProtection, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.NeutralProtection}"/>
         <CheckBox Content="保持原片影调" Style="{StaticResource PixelTart.Toggle}" IsChecked="{Binding Editor.KeepOriginalTone}"/>
        </StackPanel>
        <StackPanel Visibility="{Binding Editor.SelectedAdjustmentNode, Converter={StaticResource NodeTypeVisibility}, ConverterParameter=TransitionBlend}"><Grid><TextBlock Text="融合强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.TransitionAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.TransitionAmount}"/></StackPanel>
        <StackPanel Visibility="{Binding Editor.SelectedAdjustmentNode, Converter={StaticResource NodeTypeVisibility}, ConverterParameter=Film}">
         <CheckBox Content="启用胶片质感" Style="{StaticResource PixelTart.Toggle}" IsChecked="{Binding Editor.FilmEnabled}"/>
         <TextBlock Text="胶片方案" Style="{StaticResource ParameterLabel}"/><ComboBox ItemsSource="{Binding Editor.FilmProfiles}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding Editor.FilmProfileId}"/>
         <Grid><TextBlock Text="方案强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmProfileAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmProfileAmount}"/>
         <Grid><TextBlock Text="颗粒" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmGrainAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmGrainAmount}"/>
         <Grid><TextBlock Text="颗粒尺寸" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmGrainSize, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmGrainSize}"/>
         <Grid><TextBlock Text="暖色光晕" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmHalationAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmHalationAmount}"/>
         <Grid><TextBlock Text="高光柔化" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmBloomAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmBloomAmount}"/>
         <Grid><TextBlock Text="暗角" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmVignetteAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmVignetteAmount}"/>
         <TextBlock Text="表面材质" Style="{StaticResource ParameterLabel}"/><ComboBox ItemsSource="{Binding Editor.FilmTextures}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectedValue="{Binding Editor.FilmTextureId}"/>
         <Grid><TextBlock Text="表面强度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmSurfaceAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmSurfaceAmount}"/>
         <Grid><TextBlock Text="纹理不透明度" Style="{StaticResource ParameterLabel}"/><TextBlock Text="{Binding Editor.FilmTextureAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmTextureAmount}"/>
        </StackPanel>
        <WrapPanel Margin="0,8,0,0"><Button Content="撤销" Command="{Binding Editor.UndoAdjustmentCommand}" Style="{StaticResource PixelTart.Button.Ghost}" /><Button Content="重做" Command="{Binding Editor.RedoAdjustmentCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="4,0,0,0" /></WrapPanel>
       </StackPanel>
      </StackPanel>
      </StackPanel>
      <StackPanel Visibility="{Binding Editor.WorkspaceSection, Converter={StaticResource SectionVisibility}, ConverterParameter=预设}">
       <TextBlock Text="当前色彩方案" Style="{StaticResource SectionTitleText}"/>
       <TextBlock Text="{Binding Editor.CurrentColorSchemeName}" Margin="0,6,0,12" Foreground="{DynamicResource TextPrimaryBrush}"/>
       <TextBox Text="{Binding Editor.ColorSchemeName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="色彩方案名称"/>
       <WrapPanel Margin="0,8,0,12"><Button Content="保存当前" Command="{Binding Editor.SaveColorSchemeAsCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="更新" Command="{Binding Editor.UpdateColorSchemeCommand}" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="另存为" Command="{Binding Editor.SaveColorSchemeAsCommand}" Style="{StaticResource PixelTart.Button.Ghost}"/></WrapPanel>
       <TextBlock Text="我的方案" Style="{StaticResource SectionTitleText}"/>
