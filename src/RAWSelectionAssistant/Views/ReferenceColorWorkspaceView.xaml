    <WrapPanel Grid.Row="2" Margin="12,10"><Button Content="适合" Click="OnFitClick" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="100%" Click="OnActualSizeClick" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="−" ToolTip="缩小" Click="OnZoomOutClick" Style="{StaticResource PixelTart.Button.Ghost}"/><TextBlock x:Name="ZoomLabel" Text="适合" Foreground="{DynamicResource TextValueBrush}" VerticalAlignment="Center" Margin="6,0"/><Button Content="＋" ToolTip="放大" Click="OnZoomInClick" Style="{StaticResource PixelTart.Button.Ghost}"/><Button Content="生成高质量预览" Command="{Binding Editor.ApplyCommand}" Style="{StaticResource PrimaryButton}"/><Button Content="停止处理" Command="{Binding StopProcessingCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="8,0,0,0" Visibility="{Binding Editor.IsBusy, Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="停止处理"/><Button Content="重试" Command="{Binding Editor.ApplyCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="{Binding Editor.HasError, Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding Editor.SessionAdjustmentText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0"/></WrapPanel>
   </Grid></Border>
