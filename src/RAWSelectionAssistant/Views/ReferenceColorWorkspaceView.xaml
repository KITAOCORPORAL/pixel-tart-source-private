<UserControl x:Class="RAWSelectionAssistant.Views.ReferenceColorWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="参考仿色完整编辑器">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="参考仿色" Style="{StaticResource PageTitleText}"/><TextBlock Text="借用参考图片的影调与色彩，建立可重复使用的色彩方案。" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/></StackPanel>
            <Button Content="选择目标图片" Style="{StaticResource PrimaryButton}" Command="{Binding ChooseTargetCommand}" HorizontalAlignment="Right" AutomationProperties.Name="选择参考仿色目标图片"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding TargetName}" FontWeight="SemiBold" Margin="14,12"/><Grid Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True"><Image Source="{Binding Editor.SourceImage}" Stretch="Uniform" Visibility="{Binding Editor.ShowOriginal, Converter={StaticResource BooleanToVisibilityConverter}}"/><Image Source="{Binding Editor.MatchedImage}" Stretch="Uniform" Visibility="{Binding Editor.ShowMatched, Converter={StaticResource BooleanToVisibilityConverter}}"/><views:TetherReferenceSplitView Original="{Binding Editor.SourceImage}" Matched="{Binding Editor.MatchedImage}" SplitPosition="{Binding Editor.SplitPosition}" Visibility="{Binding Editor.ShowSplit, Converter={StaticResource BooleanToVisibilityConverter}}"/><Grid Visibility="{Binding Editor.ShowSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Editor.SourceImage}" Stretch="Uniform"/><Border Grid.Column="1" Background="{DynamicResource DividerBrush}"/><Image Grid.Column="2" Source="{Binding Editor.MatchedImage}" Stretch="Uniform"/></Grid></Grid><TextBlock Grid.Row="2" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="14,10"/></Grid></Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="色彩方案" Style="{StaticResource SectionTitleText}"/><ComboBox ItemsSource="{Binding Editor.Looks}" SelectedItem="{Binding Editor.SelectedLook}" DisplayMemberPath="Name" Margin="0,10,0,0"/><Button Content="选择或导入参考来源" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ToggleSourcePickerCommand}" Margin="0,8,0,0"/><Popup IsOpen="{Binding Editor.IsSourcePickerOpen}" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PopoverCornerRadius}" Padding="12" Width="340" MaxHeight="440"><StackPanel><Button Content="导入本地参考图" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ImportExternalReferenceCommand}"/><ListBox ItemsSource="{Binding Editor.SourceChoices}" SelectedItem="{Binding Editor.SelectedLook}" DisplayMemberPath="Name" MaxHeight="320" Margin="0,8,0,0"/></StackPanel></Border></Popup></StackPanel></Border>
                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0"><StackPanel><TextBlock Text="仿色参数" Style="{StaticResource SectionTitleText}"/><TextBlock Text="仿色强度" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.MatchStrength}"/><TextBlock Text="影调" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.ToneStrength}"/><TextBlock Text="色彩" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.ColorStrength}"/><TextBlock Text="对比度" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.ContrastStrength}"/><TextBlock Text="饱和度" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.SaturationStrength}"/><CheckBox Content="保持原片影调" IsChecked="{Binding Editor.KeepOriginalTone}" Margin="0,7,0,0"/><TextBlock Text="肤色保护" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.SkinProtection}"/><TextBlock Text="高光保护" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.HighlightProtection}"/><TextBlock Text="中性色保护" Style="{StaticResource CaptionText}"/><Slider Minimum="0" Maximum="100" Value="{Binding Editor.NeutralProtection}"/><ComboBox ItemsSource="{Binding Editor.ViewModes}" SelectedItem="{Binding Editor.ViewMode}" Margin="0,8,0,0"/><WrapPanel Margin="0,8,0,0"><Button Content="预览结果" Style="{StaticResource PrimaryButton}" Command="{Binding Editor.ApplyCommand}"/><Button Content="保存为色彩方案" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.SaveCurrentAdjustmentCommand}" Margin="6,0,0,0"/><Button Content="导出 3D LUT" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ExportCubeCommand}" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
            </StackPanel></ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
