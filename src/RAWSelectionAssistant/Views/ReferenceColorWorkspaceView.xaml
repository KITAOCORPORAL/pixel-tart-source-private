<UserControl x:Class="RAWSelectionAssistant.Views.ReferenceColorWorkspaceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="参考仿色完整编辑器">
    <UserControl.Resources>
        <!-- This view is initialized before it has a shell parent. -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Margin="32,28,52,28" MaxWidth="1680">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,20,0"><TextBlock Text="参考仿色" Style="{StaticResource PageTitleText}"/><TextBlock Text="借用参考图片的影调与色彩，建立可重复使用的色彩方案。" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="选择照片" Style="{StaticResource PrimaryButton}" Command="{Binding ChooseTargetCommand}" VerticalAlignment="Top" AutomationProperties.Name="选择参考仿色目标图片"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PixelTart.Panel}" Padding="0" ClipToBounds="True"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding TargetName,StringFormat=待调色照片：{0}}" ToolTip="{Binding TargetName}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="14,12"/><Grid Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" ClipToBounds="True"><Image Source="{Binding Editor.SourceImage}" Stretch="Uniform" Visibility="{Binding Editor.ShowOriginal, Converter={StaticResource BooleanToVisibilityConverter}}"/><Image Source="{Binding Editor.MatchedImage}" Stretch="Uniform" Visibility="{Binding Editor.ShowMatched, Converter={StaticResource BooleanToVisibilityConverter}}"/><views:TetherReferenceSplitView Original="{Binding Editor.SourceImage}" Matched="{Binding Editor.MatchedImage}" SplitPosition="{Binding Editor.SplitPosition}" Visibility="{Binding Editor.ShowSplit, Converter={StaticResource BooleanToVisibilityConverter}}"/><Grid Visibility="{Binding Editor.ShowSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Editor.SourceImage}" Stretch="Uniform"/><Border Grid.Column="1" Background="{DynamicResource DividerBrush}"/><Image Grid.Column="2" Source="{Binding Editor.MatchedImage}" Stretch="Uniform"/><TextBlock Text="原片" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="{DynamicResource SurfaceElevatedBrush}"/><TextBlock Grid.Column="2" Text="仿色结果" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12" Padding="8,4" Background="{DynamicResource SurfaceElevatedBrush}"/></Grid></Grid><StackPanel Grid.Row="2" Margin="14,10"><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Editor.StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/><Button Content="重试生成预览" Command="{Binding Editor.ApplyCommand}" Style="{StaticResource PixelTart.Button.Secondary}" HorizontalAlignment="Left" Margin="0,8,0,0" Visibility="{Binding Editor.HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/><ProgressBar IsIndeterminate="True" Margin="0,8,0,0"><ProgressBar.Style><Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoading}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding Editor.IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ProgressBar.Style></ProgressBar></StackPanel></Grid></Border>
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Editor.IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="{Binding Editor.ReferenceSources.Count, StringFormat=参考图片 · {0}}" Style="{StaticResource SectionTitleText}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding Editor.ReferenceSources}" Margin="0,0,0,14"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/></Grid.ColumnDefinitions><Image Source="{Binding Source.SourcePath}" Height="64" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="参考图片 · 权重" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0.1" Maximum="100" Value="{Binding WeightPercent}" AutomationProperties.Name="参考图片权重"/><TextBlock Text="{Binding AvailabilityText}" Style="{StaticResource CaptionText}"/><WrapPanel Margin="0,4,0,0"><Button Style="{StaticResource PixelTart.Button.Icon}" Command="{Binding DataContext.Editor.MoveReferenceUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="上移；原图不变" AutomationProperties.Name="上移参考图片"><Path Style="{StaticResource PixelTart.Symbol}" Data="{StaticResource PixelTart.Symbol.Back}" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform></Path></Button><Button Style="{StaticResource PixelTart.Button.Icon}" Command="{Binding DataContext.Editor.MoveReferenceDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="下移；原图不变" AutomationProperties.Name="下移参考图片"><Path Style="{StaticResource PixelTart.Symbol}" Data="{StaticResource PixelTart.Symbol.Forward}" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="90"/></Path.RenderTransform></Path></Button><Button Style="{StaticResource PixelTart.Button.Icon}" Command="{Binding DataContext.Editor.RemoveReferenceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" ToolTip="移除引用；原图不变" AutomationProperties.Name="移除引用参考图片"><Path Style="{StaticResource PixelTart.Symbol}" Data="{StaticResource PixelTart.Symbol.Close}" RenderTransformOrigin=".5,.5"><Path.RenderTransform><RotateTransform Angle="0"/></Path.RenderTransform></Path></Button></WrapPanel></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <Border Style="{StaticResource PixelTart.Panel}"><StackPanel><TextBlock Text="参考图片 / 色彩方案" Style="{StaticResource SectionTitleText}"/><ComboBox ItemsSource="{Binding Editor.Looks}" SelectedItem="{Binding Editor.SelectedLook}" DisplayMemberPath="Name" Margin="0,10,0,0"/><Button Content="添加参考图片 / 选择色彩方案" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ToggleSourcePickerCommand}" Margin="0,8,0,0"/><Popup IsOpen="{Binding Editor.IsSourcePickerOpen}" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True"><Border Background="{DynamicResource SurfaceElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="{StaticResource PopoverCornerRadius}" Padding="12" Width="340" MaxHeight="440"><StackPanel><Button Content="添加参考图片" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ImportExternalReferenceCommand}"/><ListBox ItemsSource="{Binding Editor.SourceChoices}" SelectedItem="{Binding Editor.SelectedLook}" DisplayMemberPath="Name" MaxHeight="320" Margin="0,8,0,0"/></StackPanel></Border></Popup></StackPanel></Border>
                <Border Style="{StaticResource PixelTart.Panel}" Margin="0,10,0,0"><StackPanel><TextBlock Text="核心调整" Style="{StaticResource SectionTitleText}"/><TextBlock Text="仿色强度" Style="{StaticResource CaptionText}" Margin="0,10,0,0"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.MatchStrength}"/><Expander Header="高级调整" IsExpanded="{Binding Editor.AdvancedExpanded}" Style="{StaticResource PixelTart.Section}"><StackPanel><TextBlock Text="影调" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ToneStrength}"/><TextBlock Text="色彩" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ColorStrength}"/><TextBlock Text="对比度" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.ContrastStrength}"/><TextBlock Text="饱和度" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SaturationStrength}"/><CheckBox Style="{StaticResource PixelTart.Toggle}" Content="保持原片影调" IsChecked="{Binding Editor.KeepOriginalTone}" Margin="0,7,0,0"/><TextBlock Text="肤色保护" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.SkinProtection}"/><TextBlock Text="高光保护" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.HighlightProtection}"/><TextBlock Text="中性色保护" Style="{StaticResource CaptionText}"/><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.NeutralProtection}"/></StackPanel></Expander><ListBox Style="{StaticResource PixelTart.Segmented}" ItemsSource="{Binding Editor.ViewModes}" SelectedItem="{Binding Editor.ViewMode}" Margin="0,8,0,0" AutomationProperties.Name="参考查看模式"/><WrapPanel Margin="0,8,0,0"><Button Content="预览结果" Style="{StaticResource PrimaryButton}" Command="{Binding Editor.ApplyCommand}"/><Button Content="保存为色彩方案" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.SaveCurrentAdjustmentCommand}" Margin="6,0,0,0"/><Button Content="导出 3D LUT" Style="{StaticResource SecondaryButton}" Command="{Binding Editor.ExportCubeCommand}" Margin="6,0,0,0"/></WrapPanel></StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Grid Grid.ColumnSpan="3" Background="{DynamicResource ContentBackgroundBrush}">
                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding HasTarget}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource SurfaceSecondaryBrush}" Padding="24">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="待调色照片" FontSize="24" Margin="0,0,0,20"/><Button Content="选择照片" Command="{Binding ChooseTargetCommand}" Style="{StaticResource PrimaryButton}"/><TextBlock Text="你的原片，始终只读" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel>
                </Border>
                <Border Grid.Column="2" Background="{DynamicResource SurfacePrimaryBrush}" Padding="24">
                    <StackPanel VerticalAlignment="Center" MaxWidth="360"><TextBlock Text="参考图片" FontSize="24" Margin="0,0,0,20"/><Button Content="添加参考图片" Command="{Binding Editor.ImportExternalReferenceCommand}" Style="{StaticResource SecondaryButton}"/><TextBlock Text="或使用已有色彩方案" Style="{StaticResource CaptionText}" Margin="0,16,0,8"/><ComboBox ItemsSource="{Binding Editor.Looks}" SelectedItem="{Binding Editor.SelectedLook}" DisplayMemberPath="Name"/><TextBlock Text="{Binding Editor.StatusText}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,12,0,0"/></StackPanel>
                </Border>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,20,0,0"><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap"/><ProgressBar Height="3" IsIndeterminate="True" Margin="0,8,0,0" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/></StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
