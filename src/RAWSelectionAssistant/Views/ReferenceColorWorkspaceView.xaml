     <Button Content="停止导出" Command="{Binding StopExportCommand}" Style="{StaticResource PixelTart.Button.Ghost}" Margin="8,0,0,0" Visibility="{Binding IsExporting, Converter={StaticResource BoolVisibility}}"/>
     <Button Content="重试失败导出" Command="{Binding RetryFailedExportCommand}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Visibility="{Binding CanRetryFailedExport, Converter={StaticResource BoolVisibility}}"/>
