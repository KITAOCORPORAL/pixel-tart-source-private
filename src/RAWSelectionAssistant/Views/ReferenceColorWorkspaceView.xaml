or.FilmTextureAmount, StringFormat={}{0:0}%}" Style="{StaticResource ParameterValue}"/></Grid><Slider Style="{StaticResource PixelTart.Slider}" Minimum="0" Maximum="100" Value="{Binding Editor.FilmTextureAmount}"/><Button Content="重新生成纹理" Command="{Binding Editor.RegenerateFilmCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/></StackPanel>
