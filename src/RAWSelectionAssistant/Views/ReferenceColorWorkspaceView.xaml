        <StackPanel>
         <Button Command="{Binding DataContext.ActivateTargetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0">
          <StackPanel Orientation="Horizontal"><Image Source="{Binding Thumbnail}" Width="52" Height="52" Stretch="UniformToFill"/><StackPanel Margin="7,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Width="78"/><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel></StackPanel>
         </Button>
         <studio:PixelTartRatingControl Rating="{Binding Rating, Mode=TwoWay}" StarSize="12" HitTarget="25" AutomationProperties.Name="参考照片评分" HorizontalAlignment="Center"/>
        </StackPanel>
       </Border>
       </DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    <StackPanel DockPanel.Dock="Bottom" Margin="8,6,0,0"><TextBlock Text="{Binding ExportStatus}" Style="{StaticResource CaptionText}"/><TextBlock Text="{Binding ExportFailureSummary}" Style="{StaticResource CaptionText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"/></StackPanel>
    </DockPanel>
  </Border>
