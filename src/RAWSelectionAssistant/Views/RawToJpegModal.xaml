<UserControl x:Class="RAWSelectionAssistant.Views.RawToJpegModal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnPreviewDragOver"
             AutomationProperties.Name="RAW 转 JPG">
    <Grid MinHeight="540">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <views:SurfaceHeader Title="RAW 转 JPG"
                             Subtitle="只读取 RAW，输出 JPG；源文件不会被移动、删除或覆盖。"
                             ShowCloseButton="False"
                             CloseAutomationName="关闭 RAW 转 JPG 并返回"
                             CloseAutomationId="RawToJpegCloseButton" />

        <Grid Grid.Row="1" Margin="24,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelSurface}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="RAW 来源" Style="{StaticResource SectionTitleText}" VerticalAlignment="Center" />
                        <Button Content="添加 RAW（可多选）" Style="{StaticResource Av2SecondaryButton}" Command="{Binding AddFilesCommand}" HorizontalAlignment="Right" />
                    </Grid>
                    <ListView Grid.Row="2" ItemsSource="{Binding Items}" MinHeight="300" Style="{StaticResource Av2ListView}" ItemContainerStyle="{StaticResource Av2ListViewItem}" AutomationProperties.Name="待转换 RAW 列表">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource Av2GridViewHeader}">
                                <GridViewColumn Header="文件" DisplayMemberBinding="{Binding DisplayName}" Width="240" />
                                <GridViewColumn Header="状态" DisplayMemberBinding="{Binding StateText}" Width="88" />
                                <GridViewColumn Header="说明" DisplayMemberBinding="{Binding Status}" Width="160" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PanelSurface}">
                <StackPanel>
                    <TextBlock Text="输出参数" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="输出目录" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <TextBox Style="{StaticResource Av2TextBox}" Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AutomationProperties.Name="JPG 输出目录" />
                    <Button Content="选择输出目录" Style="{StaticResource Av2SecondaryButton}" Command="{Binding ChooseDestinationCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />

                    <TextBlock Text="尺寸" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="88" /></Grid.ColumnDefinitions>
                        <ComboBox Style="{StaticResource Av2ComboBox}" SelectedValuePath="Tag" SelectedValue="{Binding LongestEdge}">
                            <ComboBoxItem Content="原始尺寸" Tag="{x:Null}" IsSelected="True" />
                            <ComboBoxItem Content="长边 2560" Tag="2560" />
                            <ComboBoxItem Content="长边 3000" Tag="3000" />
                            <ComboBoxItem Content="长边 4000" Tag="4000" />
                        </ComboBox>
                        <TextBox Grid.Column="2" Style="{StaticResource Av2TextBox}" Text="{Binding LongestEdge, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入自定义最长边；留空为原始尺寸" AutomationProperties.Name="自定义最长边" />
                    </Grid>

                    <TextBlock Text="JPEG 质量" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
                        <Slider Minimum="40" Maximum="100" Value="{Binding JpegQuality}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding JpegQuality}" Style="{StaticResource NumericLargeText}" FontSize="{DynamicResource SectionFontSize}" TextAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="色彩" Style="{StaticResource Av2FieldLabel}" Margin="0,16,0,4" />
                    <Border Style="{StaticResource CardSurface}" Padding="12,8">
                        <TextBlock Text="sRGB（固定输出）" Style="{StaticResource SecondaryBodyText}" />
                    </Border>
                    <CheckBox Content="使用相机白平衡" IsChecked="{Binding UseCameraWhiteBalance}" Margin="0,16,0,0" />
                    <CheckBox Content="保留 EXIF" IsChecked="{Binding PreserveExif}" Margin="0,8,0,0" />
                    <CheckBox Content="自动旋转" IsChecked="{Binding AutoRotate}" Margin="0,8,0,0" />

                    <Border Style="{StaticResource SemanticInfoPanel}" Padding="12" Margin="0,16,0,0">
                        <TextBlock Text="{Binding CapabilityText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="冲突时自动编号；始终新建 JPG，不覆盖已有文件。" Style="{StaticResource MinimumCaptionText}" Margin="0,12,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource ModalFooter}">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" />
                    <ProgressBar Width="180" Height="6" Value="{Binding Progress, Mode=OneWay}" Margin="0,8,0,0" HorizontalAlignment="Left" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="取消任务" Style="{StaticResource Av2SecondaryButton}" Command="{Binding CancelCommand}" Margin="0,0,8,0"
                            AutomationProperties.AutomationId="RawToJpegCancelTaskButton" />
                    <Button Content="开始转换" Style="{StaticResource Av2PrimaryButton}" Command="{Binding StartCommand}" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
