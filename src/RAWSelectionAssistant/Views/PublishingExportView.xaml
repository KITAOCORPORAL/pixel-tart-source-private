<UserControl x:Class="RAWSelectionAssistant.Views.PublishingExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AllowDrop="True" Drop="OnDrop" PreviewDragOver="OnPreviewDragOver" AutomationProperties.Name="发布导出">
    <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Margin="0,0,0,16"><TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="发布导出" Style="{StaticResource PageTitleText}"/><TextBlock Text="成片 → 社媒 / 客户 / 作品集；始终生成新文件，不覆盖源照片。" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/></StackPanel></DockPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="340"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <Border Style="{StaticResource ToolPanelCard}"><StackPanel><DockPanel><ToggleButton DockPanel.Dock="Right" IsChecked="{Binding DimensionsEnabled}" Content="启用"/><TextBlock Text="1  图片尺寸与压缩" Style="{StaticResource SectionTitleText}"/></DockPanel><TextBlock Text="尺寸方式" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/><ComboBox ItemsSource="{Binding SizeModes}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding SizeMode}"/><TextBlock Text="长边" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/><TextBox Text="{Binding LongestEdge}"/><TextBlock Text="指定尺寸（等比适配）" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/><WrapPanel><TextBox Width="120" Text="{Binding ExactWidth}"/><TextBlock Text=" × " VerticalAlignment="Center"/><TextBox Width="120" Text="{Binding ExactHeight}"/></WrapPanel><TextBlock Text="图片质量" Style="{StaticResource CaptionText}" Margin="0,10,0,4"/><Slider Minimum="40" Maximum="100" Value="{Binding JpegQuality}"/><CheckBox Content="保留拍摄信息" IsChecked="{Binding PreserveMetadata}" Margin="0,10,0,0"/></StackPanel></Border>
                <Border Style="{StaticResource ToolPanelCard}" Margin="0,12,0,0"><StackPanel><DockPanel><ToggleButton DockPanel.Dock="Right" IsChecked="{Binding WatermarksEnabled}" Content="启用"/><TextBlock Text="2  水印图层" Style="{StaticResource SectionTitleText}"/></DockPanel><WrapPanel Margin="0,10,0,8"><Button Content="＋ 图片水印" Command="{Binding AddImageWatermarkCommand}" Style="{StaticResource SecondaryButton}"/><Button Content="＋ 文字水印" Command="{Binding AddTextWatermarkCommand}" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0"/></WrapPanel><ItemsControl ItemsSource="{Binding WatermarkLayers}"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource InfoCard}" Margin="0,4"><StackPanel><DockPanel><CheckBox DockPanel.Dock="Right" IsChecked="{Binding Enabled}"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></DockPanel><TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource Av2TextBox}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsText}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><TextBlock Text="不透明度" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/><Slider Minimum="0" Maximum="1" Value="{Binding Opacity}"/><TextBlock Text="大小（输出宽度 %）" Style="{StaticResource CaptionText}"/><Slider Minimum="2" Maximum="50" Value="{Binding Size}"/><TextBlock Text="位置" Style="{StaticResource CaptionText}"/><ComboBox ItemsSource="{Binding DataContext.Positions, RelativeSource={RelativeSource AncestorType=UserControl}}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Position}"/><Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="色相" Style="{StaticResource CaptionText}"/><Slider Minimum="-180" Maximum="180" Value="{Binding Hue}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="饱和度" Style="{StaticResource CaptionText}"/><Slider Minimum="-1" Maximum="1" Value="{Binding Saturation}"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="明度" Style="{StaticResource CaptionText}"/><Slider Minimum="-1" Maximum="1" Value="{Binding Lightness}"/></StackPanel></Grid><CheckBox Content="反相" IsChecked="{Binding Invert}"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
            </StackPanel></ScrollViewer>
            <Border Grid.Column="2" Style="{StaticResource ToolPanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><Button DockPanel.Dock="Left" Content="‹ 上一张" Command="{Binding PreviousCommand}" Style="{StaticResource GhostButton}"/><Button DockPanel.Dock="Right" Content="下一张 ›" Command="{Binding NextCommand}" Style="{StaticResource GhostButton}"/><TextBlock Text="{Binding PreviewCounter}" HorizontalAlignment="Center" VerticalAlignment="Center"/></DockPanel><Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="6" Margin="0,12"><Image Source="{Binding PreviewImage}" Stretch="Uniform"/></Border><Button Grid.Row="2" Content="刷新预览" Command="{Binding RefreshPreviewCommand}" Style="{StaticResource SecondaryButton}"/></Grid></Border>
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto"><StackPanel><Border Style="{StaticResource ToolPanelCard}"><StackPanel><TextBlock Text="3  输出" Style="{StaticResource SectionTitleText}"/><Button Content="添加照片" Command="{Binding AddFilesCommand}" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/><Button Content="添加成片文件夹" Command="{Binding AddFolderCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"/><TextBlock Text="输出目录" Style="{StaticResource CaptionText}" Margin="0,14,0,4"/><TextBox Text="{Binding DestinationDirectory, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/><Button Content="选择输出目录" Command="{Binding ChooseDestinationCommand}" Style="{StaticResource SecondaryButton}" Margin="0,6,0,0"/><TextBlock Text="文件名后缀" Style="{StaticResource CaptionText}" Margin="0,12,0,4"/><TextBox Text="{Binding Suffix, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="同目录且后缀为空时，自动使用 _social；同名文件自动编号。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border><Border Style="{StaticResource ToolPanelCard}" Margin="0,12,0,0"><StackPanel><TextBlock Text="发布预设" Style="{StaticResource SectionTitleText}"/><ComboBox ItemsSource="{Binding Presets}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedPreset}" Margin="0,10,0,0"/><Button Content="保存当前预设" Command="{Binding SavePresetCommand}" Style="{StaticResource SecondaryButton}" Margin="0,8,0,0"/></StackPanel></Border></StackPanel></ScrollViewer>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource ModalFooter}" Margin="0,16,0,0"><Grid><TextBlock Text="JPG / JPEG / PNG · TIFF 暂不支持且会明确跳过" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/><Button Content="开始发布" Command="{Binding StartCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" MinWidth="140"/></Grid></Border>
    </Grid>
</UserControl>
