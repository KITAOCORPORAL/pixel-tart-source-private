<Window x:Class="RAWSelectionAssistant.Views.ThemedMessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
        Width="470" SizeToContent="Height" MinHeight="190" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" WindowStyle="None"
        ShowInTaskbar="False" Background="{DynamicResource WindowBackgroundBrush}"
        AutomationProperties.Name="像素蛋挞消息对话框" PreviewKeyDown="Window_PreviewKeyDown">
    <Border BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource RaisedSurfaceBrush}">
        <Grid><Grid.RowDefinitions><RowDefinition Height="44" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="10,10,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid Margin="16,0"><TextBlock x:Name="TitleTextBlock" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,44,0" /><views:SurfaceCloseButton HorizontalAlignment="Right" VerticalAlignment="Center" ToolTipText="关闭" AutomationName="关闭消息或错误详情" CloseRequested="CloseSurfaceRequested" /></Grid></Border>
            <Grid Grid.Row="1" Margin="20,18"><Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="17" Background="{DynamicResource SurfaceTertiaryBrush}" VerticalAlignment="Top"><TextBlock x:Name="GlyphTextBlock" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ScrollViewer Grid.Column="1" MaxHeight="400" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" FontSize="14" LineHeight="22" /></ScrollViewer></Grid>
            <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="NoButton" Content="取消" Style="{StaticResource SecondaryButton}" Click="NoButton_Click" AutomationProperties.Name="取消" /><Button x:Name="YesButton" Content="确定" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="YesButton_Click" AutomationProperties.Name="确定" /></StackPanel></Border>
        </Grid>
    </Border>
</Window>
