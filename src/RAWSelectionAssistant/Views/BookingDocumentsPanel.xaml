<UserControl x:Class="RAWSelectionAssistant.Views.BookingDocumentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="BookingDocumentsPanel_Loaded" Unloaded="BookingDocumentsPanel_Unloaded"
             AllowDrop="True" PreviewDragOver="BookingDocumentsPanel_PreviewDragOver" Drop="BookingDocumentsPanel_Drop"
             AutomationProperties.Name="本地摄影资料关联" AutomationProperties.HelpText="可拖入单个或多个受支持文件；拖入后默认仅关联原位置，不会自动复制">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}" Padding="12">
        <StackPanel>
            <Grid><StackPanel><TextBlock Text="本地摄影资料" FontWeight="SemiBold" /><TextBlock Text="默认仅关联原位置；不读取正文，不把文件写入数据库" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel><Button Content="检查全部" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding CheckAllCommand}" AutomationProperties.Name="检查全部关联文件" /></Grid>
            <Border Margin="0,10,0,0" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="拖入本地资料区域" AutomationProperties.HelpText="拖入后选择仅关联原位置、复制到项目资料目录并关联或取消；文件夹不会被扫描">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="拖入PDF、Office、TXT、JPG或PNG文件" HorizontalAlignment="Center" /><TextBlock Text="支持一次添加多个文件；不支持递归导入文件夹" Style="{StaticResource CaptionText}" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel>
            </Border>
            <WrapPanel Margin="0,10,0,0"><ComboBox Width="150" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDocumentType}" AutomationProperties.Name="文档分类" /><Button Content="添加文件（仅关联）" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding AddReferenceCommand}" AutomationProperties.Name="添加本地文件引用" /><Button Content="复制到项目资料目录并关联" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding CopyAndAssociateCommand}" AutomationProperties.Name="复制到项目资料目录并关联" /></WrapPanel>
            <Border Style="{StaticResource InfoCard}" Margin="0,9,0,0" Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="已归档排期只允许查看、打开和检查资料，不允许修改或移除关联。" TextWrapping="Wrap" /></Border>

            <ScrollViewer MaxHeight="360" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DocumentTypeText}" /><TextBlock Text="{Binding ExtensionText}" Style="{StaticResource CaptionText}" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding LinkModeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding AddedText, StringFormat=添加：{0}}" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding VerifiedText, StringFormat=检查：{0}}" Style="{StaticResource CaptionText}" /></Grid>
                        <WrapPanel Margin="0,7,0,0"><Button Content="打开" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=打开资料 {0}}" /><Button Content="打开所在位置" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=打开资料所在位置 {0}}" /><Button Content="检查" Style="{StaticResource GhostButton}" Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=检查资料 {0}}" /><Button Content="重新定位" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RelocateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=重新定位资料 {0}}" /><Button Content="移除关联" Style="{StaticResource GhostButton}" Command="{Binding DataContext.RemoveAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=移除资料关联 {0}}" /><Button Content="{Binding PathActionText}" Style="{StaticResource GhostButton}" Command="{Binding DataContext.TogglePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=显示或隐藏资料完整路径 {0}}" /></WrapPanel>
                        <TextBlock Text="{Binding FullPath}" Margin="4,5,4,0" TextWrapping="Wrap" Visibility="{Binding IsPathExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="完整文件路径" />
                    </StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>

            <ItemsControl ItemsSource="{Binding PendingActions}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource WarningCard}" Margin="0,4"><StackPanel><TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,3,0,0" /><WrapPanel Margin="0,8,0,0"><Button Content="重试保存关联" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.RetryAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="重试保存文档关联" /><Button Content="打开输出目录" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.OpenOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="打开文档复制输出目录" /><Button Content="安全撤销本次复制" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.UndoCopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="安全撤销本次文档复制" /><Button Content="保留文件但放弃关联" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding DataContext.AbandonAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="保留文件但放弃文档关联" /></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid Margin="0,8,0,0"><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" /><ProgressBar IsIndeterminate="True" Width="110" Height="3" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
        </StackPanel>
    </Border>
</UserControl>
