<UserControl x:Class="RAWSelectionAssistant.Views.BookingDocumentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="BookingDocumentsPanel_Loaded" Unloaded="BookingDocumentsPanel_Unloaded"
             AllowDrop="True" PreviewDragOver="BookingDocumentsPanel_PreviewDragOver" Drop="BookingDocumentsPanel_Drop"
             AutomationProperties.Name="本地摄影资料关联" AutomationProperties.HelpText="可拖入单个或多个受支持文件；拖入后默认仅关联原位置，不会自动复制">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}" Padding="12">
        <StackPanel>
            <Grid><StackPanel><TextBlock Text="本地摄影资料" FontWeight="SemiBold" /><TextBlock Text="默认仅关联原位置；不读取正文，不把文件写入数据库" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel><Button Content="检查资料状态" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding CheckAllCommand}" AutomationProperties.Name="检查资料状态" /></Grid>
            <Border Margin="0,10,0,0" Padding="12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" Background="{DynamicResource SurfaceSecondaryBrush}" AutomationProperties.Name="拖入本地资料区域" AutomationProperties.HelpText="拖入后选择仅关联原位置、复制到项目资料目录并关联或取消；文件夹不会被扫描">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="拖入图片、PDF、Office、TXT、MD 或其他资料" HorizontalAlignment="Center" /><TextBlock Text="支持一次添加多个文件；不支持递归导入文件夹" Style="{StaticResource CaptionText}" Margin="0,4,0,0" HorizontalAlignment="Center" /></StackPanel>
            </Border>
            <!-- 兼容操作名称：添加文件（仅关联）；复制到项目资料目录并关联。RC4界面合并为一个“添加资料”按钮。 -->
            <WrapPanel Margin="0,10,0,0"><TextBlock Text="分类" VerticalAlignment="Center" /><ComboBox Width="150" ItemsSource="{Binding DocumentTypes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDocumentType}" Margin="6,0,0,0" AutomationProperties.Name="文档分类" /><TextBlock Text="添加方式" VerticalAlignment="Center" Margin="12,0,0,0" /><ComboBox Width="190" ItemsSource="{Binding LinkModes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedLinkMode}" Margin="6,0,0,0" AutomationProperties.Name="资料添加方式" /><Button Content="＋ 添加资料" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding AddDocumentsCommand}" AutomationProperties.Name="按当前方式添加资料" /></WrapPanel>
            <Border Style="{StaticResource InfoCard}" Margin="0,9,0,0" Visibility="{Binding IsArchived, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="已归档排期只允许查看、打开和检查资料，不允许修改或移除关联。" TextWrapping="Wrap" /></Border>

            <ScrollViewer MaxHeight="360" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}"><ItemsControl.ItemTemplate><DataTemplate>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="4,9">
                        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="85" /><ColumnDefinition Width="70" /><ColumnDefinition Width="110" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" /><TextBlock Text="{Binding FileMetadataText}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DocumentTypeText}" /><TextBlock Text="{Binding ExtensionText}" Style="{StaticResource CaptionText}" /></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding StateText}" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding LinkModeText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </Grid>
                        <Grid Margin="0,7,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding AddedText, StringFormat=添加：{0}}" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding VerifiedText, StringFormat=检查：{0}}" Style="{StaticResource CaptionText}" /></Grid>
                        <WrapPanel Margin="0,7,0,0"><Button Content="预览" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=预览资料 {0}}" /><Button Content="打开" Style="{StaticResource GhostButton}" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding DisplayName, StringFormat=打开资料 {0}}" /><Menu Background="Transparent" Margin="3,0,0,0"><MenuItem Header="…" AutomationProperties.Name="更多资料操作"><MenuItem Header="打开所在位置" Command="{Binding DataContext.RevealCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /><MenuItem Header="检查资料状态" Command="{Binding DataContext.CheckCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /><MenuItem Header="重新定位" Command="{Binding DataContext.RelocateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /><MenuItem Header="{Binding PathActionText}" Command="{Binding DataContext.TogglePathCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /><Separator /><MenuItem Header="移除关联" Command="{Binding DataContext.RemoveAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></MenuItem></Menu></WrapPanel>
                        <TextBlock Text="{Binding FullPath}" Margin="4,5,4,0" TextWrapping="Wrap" Visibility="{Binding IsPathExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="完整文件路径" />
                    </StackPanel></Border>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </ScrollViewer>

            <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0" Padding="10" Visibility="{Binding HasPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><TextBlock Text="{Binding PreviewTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="上一份" Style="{StaticResource GhostButton}" Command="{Binding PreviousPreviewCommand}" AutomationProperties.Name="预览上一份资料" /><Button Content="下一份" Style="{StaticResource GhostButton}" Command="{Binding NextPreviewCommand}" Margin="5,0,0,0" AutomationProperties.Name="预览下一份资料" /></StackPanel></Grid>
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="适应" Style="{StaticResource GhostButton}" Command="{Binding FitPreviewCommand}" AutomationProperties.Name="预览适应窗口" /><Button Content="100%" Style="{StaticResource GhostButton}" Command="{Binding ActualSizeCommand}" Margin="5,0,0,0" AutomationProperties.Name="预览百分之百" /><Button Content="－" Style="{StaticResource GhostButton}" Command="{Binding ZoomOutCommand}" Margin="5,0,0,0" AutomationProperties.Name="缩小预览" /><TextBlock Text="{Binding PreviewZoomText}" VerticalAlignment="Center" Margin="7,0" /><Button Content="＋" Style="{StaticResource GhostButton}" Command="{Binding ZoomInCommand}" AutomationProperties.Name="放大预览" /></StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsPdfPreview, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="上一页" Style="{StaticResource GhostButton}" Command="{Binding PreviousPdfPageCommand}" AutomationProperties.Name="PDF上一页" /><TextBlock Text="{Binding PreviewPageText}" VerticalAlignment="Center" Margin="8,0" /><Button Content="下一页" Style="{StaticResource GhostButton}" Command="{Binding NextPdfPageCommand}" AutomationProperties.Name="PDF下一页" /></StackPanel>
                        <Grid Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding PreviewSearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索文本预览" ToolTip="只在已加载的本地文本预览中搜索" /><TextBlock Grid.Column="1" Text="{Binding PreviewSearchResult}" VerticalAlignment="Center" Margin="7,0" Style="{StaticResource CaptionText}" /><Button Grid.Column="3" Content="{Binding PreviewTextWrapLabel}" Style="{StaticResource GhostButton}" Command="{Binding ToggleTextWrapCommand}" AutomationProperties.Name="切换文本自动换行" /></Grid>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,8,0,0" MinHeight="180">
                        <ScrollViewer x:Name="PreviewScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="320" Visibility="{Binding IsImagePreview, Converter={StaticResource BooleanToVisibilityConverter}}" PreviewMouseLeftButtonDown="PreviewScrollViewer_MouseLeftButtonDown" PreviewMouseMove="PreviewScrollViewer_MouseMove" PreviewMouseLeftButtonUp="PreviewScrollViewer_MouseLeftButtonUp" MouseLeave="PreviewScrollViewer_MouseLeave"><Image Source="{Binding PreviewImage}" Width="{Binding PreviewDisplayWidth}" Height="{Binding PreviewDisplayHeight}" Stretch="Uniform" /></ScrollViewer>
                        <TextBox Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas" TextWrapping="{Binding PreviewTextWrapping, Mode=OneWay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" MaxHeight="320" Visibility="{Binding IsTextPreview, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="只读文本预览" />
                        <StackPanel Visibility="{Binding IsCardPreview, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="安全文件卡片" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding SelectedItem.FileMetadataText}" Margin="0,5,0,0" /><TextBlock Text="{Binding PreviewMessage}" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><TextBlock Text="Office 文件不执行宏、不解析嵌入脚本、不联网；未知格式仅显示元数据。" TextWrapping="Wrap" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /></StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="3" Text="{Binding PreviewMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                </Grid>
            </Border>

            <Border Style="{StaticResource InfoCard}" Margin="0,10,0,0" Padding="12" Visibility="{Binding HasNoItems, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center"><TextBlock Text="尚未添加拍摄资料" TextAlignment="Center" FontWeight="SemiBold" /><Button Content="＋ 添加资料" Style="{StaticResource SecondaryButton}" Command="{Binding AddDocumentsCommand}" Margin="0,8,0,0" AutomationProperties.Name="添加拍摄资料" /></StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding PendingActions}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource WarningCard}" Margin="0,4"><StackPanel><TextBlock Text="{Binding DisplayText}" FontWeight="SemiBold" /><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,3,0,0" /><WrapPanel Margin="0,8,0,0"><Button Content="重试保存关联" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.RetryAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="重试保存文档关联" /><Button Content="打开输出目录" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.OpenOutputDirectoryCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="打开文档复制输出目录" /><Button Content="安全撤销本次复制" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.UndoCopyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="安全撤销本次文档复制" /><Button Content="保留文件但放弃关联" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding DataContext.AbandonAssociationCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="保留文件但放弃文档关联" /></WrapPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Grid Margin="0,8,0,0"><TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" /><ProgressBar IsIndeterminate="True" Width="110" Height="3" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid>
        </StackPanel>
    </Border>
</UserControl>
