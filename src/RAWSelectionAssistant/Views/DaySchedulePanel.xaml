<UserControl x:Class="RAWSelectionAssistant.Views.DaySchedulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
             AutomationProperties.Name="当天排期列表">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /><conv:ZeroIntToVisibilityConverter x:Key="ZeroIntToVisibilityConverter" /></UserControl.Resources>
    <Border Style="{StaticResource PanelBorder}" Padding="0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="16,14"><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DateNumberText}" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center" /><StackPanel Margin="10,2,0,0"><TextBlock Text="{Binding MonthYearText}" FontWeight="SemiBold" /><TextBlock Text="{Binding WeekdayText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel></StackPanel><TextBlock Text="{Binding Title}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CaptionText}" /></Grid></Border>
            <UniformGrid Grid.Row="1" Columns="5" Margin="12,10"><StackPanel><TextBlock Text="{Binding BookingCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="任务" Style="{StaticResource CaptionText}" /></StackPanel><StackPanel><TextBlock Text="{Binding UnshotCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="未拍摄" Style="{StaticResource CaptionText}" /></StackPanel><StackPanel><TextBlock Text="{Binding ShotCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="已拍摄" Style="{StaticResource CaptionText}" /></StackPanel><StackPanel><TextBlock Text="{Binding AwaitingReturnCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="待返图" Style="{StaticResource CaptionText}" /></StackPanel><StackPanel><TextBlock Text="{Binding ConflictCount}" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="冲突" Style="{StaticResource CaptionText}" /></StackPanel></UniformGrid>
            <Grid Grid.Row="2" Margin="12,0,12,10">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,18,0,0" Visibility="{Binding BookingCount, Converter={StaticResource ZeroIntToVisibilityConverter}}"><TextBlock Text="{Binding EmptyText}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="可以从下方创建当天拍摄任务。" Style="{StaticResource CaptionText}" Margin="0,5,0,0" HorizontalAlignment="Center" /></StackPanel>
                <ListBox ItemsSource="{Binding VisibleBookings}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="4" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><StackPanel><Grid><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding StatusText}" HorizontalAlignment="Right" Style="{StaticResource CaptionText}" /></Grid><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" /><TextBlock Style="{StaticResource CaptionText}" Margin="0,3,0,0"><Run Text="{Binding ClientDisplayName, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Booking.Location, Mode=OneWay, TargetNullValue=未填写地点}" /></TextBlock><TextBlock Text="{Binding WeatherText}" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel></Button><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><TextBlock Text="{Binding StatusGlyph}" VerticalAlignment="Center" Margin="0,0,5,0" /><TextBlock Text="打开详情以编辑、更新返图状态、查看策划与收支" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Row="1" Content="{Binding OverflowText}" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="4,2,0,4" Visibility="{Binding OverflowCount, Converter={StaticResource ZeroIntToVisibilityConverter}}" />
            </Grid>
            <Border Grid.Row="3" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="12"><Button Content="＋ 创建当天拍摄任务" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Stretch" Command="{Binding NewBookingCommand}" AutomationProperties.Name="创建当天拍摄任务" /></Border>
        </Grid>
    </Border>
</UserControl>
