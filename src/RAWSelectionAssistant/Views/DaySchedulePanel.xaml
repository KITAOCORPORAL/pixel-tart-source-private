<UserControl x:Class="RAWSelectionAssistant.Views.DaySchedulePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="当天排期列表">
    <Border Style="{StaticResource PanelBorder}" Padding="12">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
            <ListBox Grid.Row="1" ItemsSource="{Binding Bookings}" Margin="0,10,0,0" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="7" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><StackPanel><TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource AccentBrush}" FontSize="11" /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Style="{StaticResource CaptionText}"><Run Text="{Binding StatusGlyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding ClientDisplayName, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding WeatherText}" Style="{StaticResource CaptionText}" /></StackPanel></Button></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
