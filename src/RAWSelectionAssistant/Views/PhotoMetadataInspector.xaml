<UserControl x:Class="RAWSelectionAssistant.Views.PhotoMetadataInspector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" AutomationProperties.Name="照片元数据">
 <Border Background="{DynamicResource SurfaceSecondaryBrush}" Padding="14" CornerRadius="8">
  <StackPanel>
   <TextBlock Text="照片信息" Style="{StaticResource SectionTitleText}" Margin="0,0,0,10"/>
   <TextBlock Text="{Binding Metadata.FileName, StringFormat=文件：{0}}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding Metadata.Dimensions, StringFormat=尺寸：{0}}" Style="{StaticResource CaptionText}"/>
   <TextBlock Text="{Binding Metadata.FileSize, StringFormat=大小：{0}}" Style="{StaticResource CaptionText}"/>
   <Expander Header="EXIF 信息" IsExpanded="False" Margin="0,10,0,0">
    <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
     <TextBlock Text="相机" Style="{StaticResource CaptionText}"/><TextBlock Grid.Column="1" Text="{Binding Metadata.Make}" Style="{StaticResource CaptionText}"/>
     <TextBlock Grid.Row="1" Text="镜头" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Metadata.LensModel}" Style="{StaticResource CaptionText}"/>
     <TextBlock Grid.Row="2" Text="焦距" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Metadata.FocalLength}" Style="{StaticResource CaptionText}"/>
     <TextBlock Grid.Row="3" Text="光圈" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Metadata.Aperture}" Style="{StaticResource CaptionText}"/>
     <TextBlock Grid.Row="4" Text="快门" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding Metadata.Shutter}" Style="{StaticResource CaptionText}"/>
     <TextBlock Grid.Row="5" Text="ISO" Style="{StaticResource CaptionText}"/><TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding Metadata.Iso}" Style="{StaticResource CaptionText}"/>
    </Grid>
   </Expander>
  </StackPanel>
 </Border>
</UserControl>
