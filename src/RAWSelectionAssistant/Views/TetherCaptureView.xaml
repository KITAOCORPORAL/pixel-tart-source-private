<UserControl x:Class="RAWSelectionAssistant.Views.TetherCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True"
             AutomationProperties.Name="联机拍摄"
             AutomationProperties.HelpText="使用顶层看守文件夹接收本地相机传输文件">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackgroundBrush}" Margin="20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="联机拍摄" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="当前为看守文件夹模式，并非相机USB直连。本阶段不提供实时取景、遥控快门或相机设置。"
                           Style="{StaticResource CaptionText}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource PanelBorder}" Padding="12,7">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Provider  " Style="{StaticResource CaptionText}" />
                    <TextBlock Text="{Binding ProviderText}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Margin="0,14,0,10" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="看守目录" Style="{StaticResource SectionTitleText}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding WatchDirectory}" IsReadOnly="True" AutomationProperties.Name="看守文件夹路径" />
                        <Button Grid.Column="1" Content="选择目录" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding ChooseWatchFolderCommand}" />
                    </Grid>
                    <TextBlock Text="只监看所选目录的第一层；IncludeSubdirectories 固定为 False，不会递归扫描文件夹。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0" />
                    <WrapPanel Margin="0,10,0,0">
                        <CheckBox Content="导入启动前已有文件" IsChecked="{Binding ImportExisting}" VerticalAlignment="Center"
                                  AutomationProperties.HelpText="默认关闭；开启前可预览顶层候选数量" />
                        <Button Content="预览数量" Style="{StaticResource GhostButton}" Margin="12,0,0,0" Command="{Binding PreviewExistingCommand}" />
                        <TextBlock Text="{Binding ExistingCandidateCount, StringFormat=顶层候选 {0} 个}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </WrapPanel>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="可选安全复制（默认关闭）" Style="{StaticResource SectionTitleText}" />
                    <CheckBox Content="复制到项目资料目录" IsChecked="{Binding CopyToProject}" Margin="0,8,0,0" />
                    <Grid Margin="22,5,0,0" IsEnabled="{Binding CopyToProject}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding ProjectDestination}" IsReadOnly="True" AutomationProperties.Name="项目复制目录" />
                        <Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding ChooseProjectDestinationCommand}" />
                    </Grid>
                    <CheckBox Content="复制到独立备份目录" IsChecked="{Binding CopyToBackup}" Margin="0,8,0,0" />
                    <Grid Margin="22,5,0,0" IsEnabled="{Binding CopyToBackup}">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBox Text="{Binding BackupDestination}" IsReadOnly="True" AutomationProperties.Name="独立备份目录" />
                        <Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding ChooseBackupDestinationCommand}" />
                    </Grid>
                    <CheckBox Content="复制后同时校验 SHA-256（更慢）" IsChecked="{Binding VerifySha256}" Margin="0,8,0,0" />
                    <TextBlock Text="复制固定使用 Copy + CreateNew + AutoNumber；不覆盖、不移动、不删除源文件。"
                               Style="{StaticResource CaptionText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,0,0,10">
            <Grid>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding DiscoveredCount, StringFormat=  · 已发现 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding WaitingStableCount, StringFormat=  · 等待稳定 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding ReadyCount, StringFormat=  · 就绪 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AttentionCount, StringFormat=  · 需处理 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding FailedCount, StringFormat=  · 失败 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding QueueDepth, StringFormat=  · 队列 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CopyStatusText, StringFormat=  · {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" AutomationProperties.Name="明确启动或恢复看守" />
                    <Button Content="停止" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding StopCommand}" />
                    <Button Content="错误处理 / 顶层核对" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding ReconcileCommand}" />
                    <Button Content="清理预览缓存" Style="{StaticResource GhostButton}" Margin="7,0,0,0" Command="{Binding ClearProxyCacheCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="300" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Padding="8">
                <ListBox ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedAsset}" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="联机文件列表">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Width="210" Margin="5" Padding="7" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                <StackPanel>
                                    <Grid Height="128" Background="{DynamicResource SurfaceTertiaryBrush}" ClipToBounds="True">
                                        <Image Source="{Binding ProxyPath}" Stretch="Uniform" />
                                        <Border Background="{DynamicResource SurfaceSecondaryBrush}" Padding="8">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsRaw}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="RAW" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="安全占位预览" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" /></StackPanel>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" />
                                    <TextBlock Text="{Binding PairText}" Style="{StaticResource CaptionText}" />
                                    <Button Content="打开所在位置" Style="{StaticResource GhostButton}" Margin="0,5,0,0"
                                            Command="{Binding DataContext.RevealAssetCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="10,0,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="阶段B边界" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="TetherAnnotations 已预留评分、颜色、摄影师备注、客户收藏、客户备注和拒片标记结构；本阶段不开放标注编辑器。"
                               Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <Border Style="{StaticResource InfoCard}" Padding="10">
                        <StackPanel>
                            <TextBlock Text="目录恢复" FontWeight="SemiBold" />
                            <TextBlock Text="断盘或目录暂时不可访问时，重新连接后选择原目录并点击“恢复目录并继续”；数据库 Ready/Copied 状态是恢复依据。" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource WarningCard}" Padding="10" Margin="0,14,0,0">
                        <TextBlock Text="停止看守、拒片标记或清理预览缓存都不会删除、移动或修改相机原文件。" TextWrapping="Wrap" Foreground="{DynamicResource WarningBrush}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
