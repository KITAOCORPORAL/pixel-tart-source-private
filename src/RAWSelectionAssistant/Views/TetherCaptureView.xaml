<UserControl x:Class="RAWSelectionAssistant.Views.TetherCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             Focusable="True" PreviewKeyDown="View_PreviewKeyDown" PreviewKeyUp="View_PreviewKeyUp" SizeChanged="View_SizeChanged"
             AutomationProperties.Name="联机拍摄现场监看工作区"
             AutomationProperties.HelpText="使用顶层看守文件夹接收照片并进行本地现场监看、比较与标注；L切换LUT，K锁定照片，C开关客户窗口，F11全屏">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="ThumbnailItemStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <EventSetter Event="Loaded" Handler="ThumbnailItem_Loaded" />
            <EventSetter Event="Unloaded" Handler="ThumbnailItem_Unloaded" />
        </Style>
        <DataTemplate x:Key="InspectorTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="现场监看右侧检查器">
                <StackPanel Margin="10">
                    <Expander x:Name="SessionGroup" Header="拍摄会话" IsExpanded="True" AutomationProperties.Name="拍摄会话工具组">
                        <StackPanel Margin="0,8,0,10">
                            <TextBlock Text="{Binding UserFacingProviderText, StringFormat=● {0}}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,8,0,0"><Button Content="{Binding StartButtonText}" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" AutomationProperties.Name="明确启动或恢复看守" /><Button Content="停止" Style="{StaticResource SecondaryButton}" Command="{Binding StopCommand}" Margin="6,0,0,0" AutomationProperties.Name="停止看守文件夹会话" /><Button Content="顶层核对" Style="{StaticResource GhostButton}" Command="{Binding ReconcileCommand}" Margin="6,0,0,0" AutomationProperties.Name="重新核对看守文件夹顶层" /></WrapPanel>
                            <TextBlock Text="{Binding DiscoveredCount, StringFormat=已发现 {0}}" Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="HistogramGroup" Header="直方图" IsExpanded="True" AutomationProperties.Name="直方图工具组">
                        <StackPanel Margin="0,8,0,10">
                            <Grid><TextBlock Text="RGB直方图" Style="{StaticResource SectionTitleText}" /><Button Content="刷新" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Command="{Binding RefreshAnalysisCommand}" AutomationProperties.Name="刷新RGB直方图" /></Grid>
                            <views:TetherHistogramView Histogram="{Binding Histogram}" Height="132" Margin="0,8,0,0" AutomationProperties.Name="RGB直方图" />
                            <TextBlock Text="基于监看代理图；不是RAW显影结果。" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                            <CheckBox Content="显示亮度参考" IsChecked="{Binding ShowLuminanceHistogram}" Margin="0,7,0,0" AutomationProperties.Name="显示亮度参考" />
                            <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><CheckBox Content="高光警告" IsChecked="{Binding HighlightWarningEnabled}" AutomationProperties.Name="显示高光警告" /><TextBlock Text="阈值" Style="{StaticResource CaptionText}" /><Slider Minimum="1" Maximum="255" Value="{Binding HighlightThreshold}" AutomationProperties.Name="高光警告阈值" /></StackPanel><StackPanel Grid.Column="1" Margin="12,0,0,0"><CheckBox Content="阴影警告" IsChecked="{Binding ShadowWarningEnabled}" AutomationProperties.Name="显示阴影警告" /><TextBlock Text="阈值" Style="{StaticResource CaptionText}" /><Slider Minimum="0" Maximum="254" Value="{Binding ShadowThreshold}" AutomationProperties.Name="阴影警告阈值" /></StackPanel></Grid>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ExifGroup" Header="拍摄信息" IsExpanded="False" AutomationProperties.Name="拍摄信息工具组">
                        <StackPanel Margin="0,8,0,10">
                    <TextBlock Text="EXIF 与文件" Style="{StaticResource SectionTitleText}" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="类型" Style="{StaticResource CaptionText}" /><TextBlock Grid.Column="1" Text="{Binding ExifInfo.FileType, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="1" Text="拍摄时间" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ExifInfo.CaptureTime, TargetNullValue=未提供}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="相机品牌" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ExifInfo.CameraMake, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="3" Text="相机型号" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ExifInfo.CameraModel, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="4" Text="镜头" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ExifInfo.Lens, TargetNullValue=未提供}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="5" Text="焦距 / 光圈" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="5" Grid.Column="1"><Run Text="{Binding ExifInfo.FocalLength, TargetNullValue=未提供}" /><Run Text="  ·  " /><Run Text="{Binding ExifInfo.Aperture, TargetNullValue=未提供}" /></TextBlock>
                        <TextBlock Grid.Row="6" Text="快门 / ISO" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="6" Grid.Column="1"><Run Text="{Binding ExifInfo.Shutter, TargetNullValue=未提供}" /><Run Text="  ·  " /><Run Text="{Binding ExifInfo.Iso, TargetNullValue=未提供}" /></TextBlock>
                        <TextBlock Grid.Row="7" Text="曝光补偿" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding ExifInfo.ExposureCompensation, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="8" Text="白平衡" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding ExifInfo.WhiteBalance, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="9" Text="色彩空间" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding ExifInfo.ColorSpace, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="10" Text="像素尺寸" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="10" Grid.Column="1" Text="{Binding ExifInfo.PixelDimensions, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="11" Text="文件大小" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="11" Grid.Column="1" Text="{Binding ExifInfo.FileSize, TargetNullValue=未提供}" />
                        <TextBlock Grid.Row="12" Text="配对状态" Style="{StaticResource CaptionText}" /><TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding ExifInfo.PairingStatus, TargetNullValue=未提供}" />
                        <Button Grid.Row="13" Grid.ColumnSpan="2" Content="显示 / 隐藏完整路径" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Command="{Binding TogglePathCommand}" Margin="0,6,0,0" AutomationProperties.Name="显示或隐藏完整路径" />
                        <TextBlock Grid.Row="14" Grid.ColumnSpan="2" Text="{Binding ExifInfo.SourcePath}" TextWrapping="Wrap" Margin="0,4,0,0">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowFullPath}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Separator Margin="0,12" />
                    <TextBlock Text="比较" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding CompareCandidateText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,7,0,0"><Button Content="并排比较" Style="{StaticResource SecondaryButton}" Command="{Binding StartSideBySideCommand}" AutomationProperties.Name="开始并排比较" /><Button Content="重叠比较" Style="{StaticResource SecondaryButton}" Command="{Binding StartOverlayCommand}" Margin="7,0,0,0" AutomationProperties.Name="开始重叠比较" /><Button Content="退出比较" Style="{StaticResource GhostButton}" Command="{Binding ExitComparisonCommand}" Margin="7,0,0,0" AutomationProperties.Name="退出照片比较" /></WrapPanel>
                    <CheckBox Content="同步缩放" IsChecked="{Binding ComparisonSyncZoom}" Margin="0,7,0,0" AutomationProperties.Name="比较视图同步缩放" /><CheckBox Content="同步拖动" IsChecked="{Binding ComparisonSyncPan}" Margin="0,5,0,0" AutomationProperties.Name="比较视图同步拖动" />
                    <TextBlock Text="重叠透明度" Style="{StaticResource CaptionText}" Margin="0,7,0,0" /><Slider Minimum="0" Maximum="1" Value="{Binding ComparisonOpacity}" AutomationProperties.Name="重叠比较透明度" />
                    <CheckBox Content="闪烁对比" IsChecked="{Binding ComparisonBlink}" Margin="0,5,0,0" AutomationProperties.Name="闪烁对比" />
                    <Separator Margin="0,12" />
                    <TextBlock Text="参考图叠加" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ReferenceStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,7,0,0"><Button Content="选择参考图" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseReferenceCommand}" AutomationProperties.Name="选择参考图" /><Button Content="重新定位" Style="{StaticResource GhostButton}" Command="{Binding RelocateReferenceCommand}" Margin="7,0,0,0" AutomationProperties.Name="重新定位参考图" /><Button Content="清除引用" Style="{StaticResource GhostButton}" Command="{Binding ClearReferenceCommand}" Margin="7,0,0,0" AutomationProperties.Name="清除参考图引用" /></WrapPanel>
                    <CheckBox Content="显示参考图" IsChecked="{Binding ReferenceVisible}" Margin="0,7,0,0" AutomationProperties.Name="显示参考图" /><CheckBox Content="锁定参考图" IsChecked="{Binding ReferenceLocked}" Margin="0,5,0,0" AutomationProperties.Name="锁定参考图" /><CheckBox Content="左右翻转" IsChecked="{Binding ReferenceFlipHorizontal}" Margin="0,5,0,0" AutomationProperties.Name="左右翻转参考图" />
                    <TextBlock Text="透明度" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><Slider Minimum="0" Maximum="1" Value="{Binding ReferenceOpacity}" AutomationProperties.Name="参考图透明度" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AnnotationGroup" Header="标记与备注" IsExpanded="True" AutomationProperties.Name="标记与备注工具组">
                        <StackPanel Margin="0,8,0,10">
                    <TextBlock Text="星级与颜色" Style="{StaticResource SectionTitleText}" />
                    <UniformGrid Columns="6" Margin="0,8,0,0"><Button Content="0" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="0" AutomationProperties.Name="清除星级" /><Button Content="★1" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="1" AutomationProperties.Name="设置一星" /><Button Content="★2" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="2" AutomationProperties.Name="设置二星" /><Button Content="★3" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="3" AutomationProperties.Name="设置三星" /><Button Content="★4" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="4" AutomationProperties.Name="设置四星" /><Button Content="★5" Style="{StaticResource GhostButton}" Command="{Binding SetRatingCommand}" CommandParameter="5" AutomationProperties.Name="设置五星" /></UniformGrid>
                    <ComboBox ItemsSource="{Binding ColorLabels}" SelectedItem="{Binding CurrentColorLabel}" Margin="0,7,0,0" AutomationProperties.Name="颜色标签"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding TargetNullValue=无颜色标签}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                    <Button Content="保存颜色标签" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="0,5,0,0" Command="{Binding SetColorLabelCommand}" CommandParameter="{Binding CurrentColorLabel}" AutomationProperties.Name="保存颜色标签" />
                    <TextBlock Text="摄影师备注" FontWeight="SemiBold" Margin="0,10,0,4" /><TextBox Text="{Binding PhotographerNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="72" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" GotKeyboardFocus="Note_GotKeyboardFocus" LostKeyboardFocus="Note_LostKeyboardFocus" AutomationProperties.Name="摄影师备注" />
                    <TextBlock Text="客户备注" FontWeight="SemiBold" Margin="0,10,0,4" /><TextBox Text="{Binding ClientNote, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="64" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" GotKeyboardFocus="Note_GotKeyboardFocus" LostKeyboardFocus="Note_LostKeyboardFocus" AutomationProperties.Name="客户备注" />
                    <WrapPanel Margin="0,8,0,0"><Button Content="保存备注" Style="{StaticResource PrimaryButton}" Command="{Binding SaveNotesCommand}" AutomationProperties.Name="保存联机照片备注" /><Button Content="客户收藏" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleFavoriteCommand}" Margin="7,0,0,0" AutomationProperties.Name="切换客户收藏" /><Button Content="快速拒绝 / 取消" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleRejectedCommand}" Margin="7,0,0,0" AutomationProperties.Name="切换快速拒绝标记" AutomationProperties.HelpText="只设置拒绝标记，不删除、不移动照片" /></WrapPanel>
                    <TextBlock Text="快速拒绝仅设置 IsRejected；不删除、不移动、不进入回收站、不调用UndoJournal。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="LutGroup" Header="LUT 与色彩" IsExpanded="False" AutomationProperties.Name="LUT与色彩工具组">
                        <StackPanel Margin="0,8,0,10">
                    <TextBlock Text="LUT 监看" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ColorSettings.InputSpaceWarning}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" AutomationProperties.HelpText="输入色彩空间可能未知，监看结果仅供现场参考" />
                    <WrapPanel Margin="0,7,0,0">
                        <Button Content="导入 .cube" Style="{StaticResource SecondaryButton}" Command="{Binding ColorSettings.ImportLutCommand}" AutomationProperties.Name="导入Cube LUT" />
                        <Button Content="{Binding ColorSettings.LutToggleText}" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.ToggleLutCommand}" Margin="6,0,0,0" AutomationProperties.Name="切换LUT" />
                        <Button Content="{Binding ColorSettings.BeforeAfterText}" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.ToggleBeforeCommand}" PreviewMouseLeftButtonDown="LutBefore_MouseDown" PreviewMouseLeftButtonUp="LutBefore_MouseUp" MouseLeave="LutBefore_MouseLeave" Margin="6,0,0,0" AutomationProperties.Name="查看LUT前后对比" />
                        <Button Content="{Binding ColorSettings.SplitViewText}" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.ToggleSplitCommand}" Margin="6,0,0,0" AutomationProperties.Name="LUT分屏对比" />
                    </WrapPanel>
                    <TextBlock Text="当前LUT" Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                    <ComboBox ItemsSource="{Binding ColorSettings.LutView}" DisplayMemberPath="DisplayName" SelectedItem="{Binding ColorSettings.SelectedLut}" AutomationProperties.Name="当前LUT选择" />
                    <TextBlock Text="搜索LUT" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><TextBox Text="{Binding ColorSettings.LutSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索LUT" />
                    <TextBlock Text="{Binding ColorSettings.LutStrengthText, StringFormat=强度 {0}}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><Slider Minimum="0" Maximum="100" Value="{Binding ColorSettings.LutStrengthPercent}" AutomationProperties.Name="LUT强度百分比" />
                    <TextBlock Text="LUT输入解释" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><ComboBox ItemsSource="{Binding ColorSettings.InputInterpretations}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColorSettings.SelectedInputInterpretation}" AutomationProperties.Name="LUT输入色彩空间解释" />
                    <TextBlock Text="{Binding ColorSettings.InputSpaceWarning}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding ColorSettings.LutStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                    <WrapPanel Margin="0,6,0,0"><Button Content="收藏LUT" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.ToggleFavoriteLutCommand}" AutomationProperties.Name="收藏或取消收藏LUT" /><Button Content="会话默认" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.SetSessionDefaultCommand}" Margin="5,0,0,0" AutomationProperties.Name="设为当前会话默认LUT" /><Button Content="项目默认" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.SetProjectDefaultCommand}" Margin="5,0,0,0" AutomationProperties.Name="设为当前项目默认LUT" /></WrapPanel>
                    <WrapPanel Margin="0,5,0,0"><Button Content="打开所在位置" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.RevealLutCommand}" AutomationProperties.Name="打开LUT所在位置" /><Button Content="重新验证" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.RevalidateLutCommand}" Margin="5,0,0,0" AutomationProperties.Name="重新验证LUT" /><Button Content="重新定位" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.RelocateLutCommand}" Margin="5,0,0,0" AutomationProperties.Name="重新定位LUT" /><Button Content="移除引用" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.RemoveLutReferenceCommand}" Margin="5,0,0,0" AutomationProperties.Name="移除LUT引用" /></WrapPanel>
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="ClientGroup" Header="客户监看" IsExpanded="False" AutomationProperties.Name="客户监看工具组">
                        <StackPanel Margin="0,8,0,10">
                    <TextBlock Text="ICC 与客户屏" Style="{StaticResource SectionTitleText}" />
                    <TextBlock Text="{Binding ColorSettings.ColorProfileStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" AutomationProperties.HelpText="ICC异常时安全回退sRGB；软件不能替代显示器校准" Margin="0,5,0,0" />
                    <TextBlock Text="客户显示器" Style="{StaticResource CaptionText}" Margin="0,7,0,0" />
                    <ComboBox ItemsSource="{Binding ColorSettings.Displays}" SelectedItem="{Binding ColorSettings.SelectedClientDisplay}" DisplayMemberPath="FriendlyName" AutomationProperties.Name="客户显示器选择" />
                    <TextBlock Text="客户屏跟随模式" Style="{StaticResource CaptionText}" Margin="0,5,0,0" />
                    <ComboBox ItemsSource="{Binding ColorSettings.ClientFollowModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding ColorSettings.ClientFollowMode}" AutomationProperties.Name="客户屏跟随模式选择" />
                    <WrapPanel Margin="0,7,0,0"><Button Content="开启客户监看" Style="{StaticResource PrimaryButton}" Command="{Binding ColorSettings.OpenClientMonitorCommand}" AutomationProperties.Name="开启客户监看窗口" /><Button Content="关闭客户监看" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.CloseClientMonitorCommand}" Margin="6,0,0,0" AutomationProperties.Name="关闭客户监看窗口" /></WrapPanel>
                    <CheckBox Content="客户屏显示简化文件编号（默认关闭）" IsChecked="{Binding ColorSettings.ShowClientFileName}" Margin="0,7,0,0" AutomationProperties.Name="客户屏显示简化文件编号" />
                    <CheckBox Content="客户屏显示拍摄参数摘要（默认关闭）" IsChecked="{Binding ColorSettings.ShowClientTechnicalMetadata}" Margin="0,5,0,0" AutomationProperties.Name="客户屏显示拍摄参数摘要" />
                    <CheckBox Content="客户屏显示星级（默认关闭）" IsChecked="{Binding ColorSettings.ShowClientRating}" Margin="0,5,0,0" AutomationProperties.Name="客户屏显示星级" />
                    <CheckBox Content="客户屏允许收藏和备注" IsChecked="{Binding ColorSettings.ShowClientControls}" Margin="0,5,0,0" AutomationProperties.Name="客户屏允许收藏和备注" />
                    <TextBlock Text="{Binding ColorSettings.ClientMonitorStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="FileGroup" Header="文件处理" IsExpanded="False" AutomationProperties.Name="文件处理工具组">
                        <StackPanel Margin="0,8,0,10">
                            <TextBlock Text="看守目录" Style="{StaticResource SectionTitleText}" />
                            <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding WatchDirectory}" IsReadOnly="True" AutomationProperties.Name="看守文件夹路径" /><Button Grid.Column="1" Content="选择目录" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding ChooseWatchFolderCommand}" AutomationProperties.Name="选择看守文件夹目录" /></Grid>
                            <TextBlock Text="当前通过看守文件夹接收照片；不提供实时取景、遥控快门或相机参数控制。只监看所选文件夹顶层，不会递归扫描子文件夹。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <WrapPanel Margin="0,7,0,0"><CheckBox Content="导入启动前已有文件" IsChecked="{Binding ImportExisting}" AutomationProperties.Name="导入启动前已有文件" /><Button Content="预览数量" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Command="{Binding PreviewExistingCommand}" AutomationProperties.Name="预览已有文件数量" /></WrapPanel>
                            <TextBlock Text="可选安全复制（默认关闭）" Style="{StaticResource SectionTitleText}" Margin="0,12,0,0" />
                            <CheckBox Content="复制到项目资料目录" IsChecked="{Binding CopyToProject}" Margin="0,6,0,0" AutomationProperties.Name="复制到项目资料目录" />
                            <Grid Margin="20,4,0,0" IsEnabled="{Binding CopyToProject}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding ProjectDestination}" IsReadOnly="True" AutomationProperties.Name="项目复制目标目录" /><Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding ChooseProjectDestinationCommand}" AutomationProperties.Name="选择项目复制目标目录" /></Grid>
                            <CheckBox Content="复制到独立备份目录" IsChecked="{Binding CopyToBackup}" Margin="0,5,0,0" AutomationProperties.Name="复制到独立备份目录" />
                            <Grid Margin="20,4,0,0" IsEnabled="{Binding CopyToBackup}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding BackupDestination}" IsReadOnly="True" AutomationProperties.Name="备份复制目标目录" /><Button Grid.Column="1" Content="选择" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Command="{Binding ChooseBackupDestinationCommand}" AutomationProperties.Name="选择备份复制目标目录" /></Grid>
                            <CheckBox Content="复制后同时校验 SHA-256（更慢）" IsChecked="{Binding VerifySha256}" Margin="0,5,0,0" AutomationProperties.Name="复制后校验SHA256" />
                            <TextBlock Text="复制固定使用复制、新建文件和自动编号；不覆盖、不移动、不删除源文件。" Style="{StaticResource CaptionText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>

                    <Expander x:Name="AttentionGroup" Header="问题与恢复" IsExpanded="{Binding HasAttention, Mode=OneWay}" AutomationProperties.Name="问题与恢复工具组">
                        <StackPanel Margin="0,8,0,10">
                            <TextBlock Text="{Binding AttentionCount, StringFormat=需处理 {0} 项}" FontWeight="SemiBold" />
                            <TextBlock Text="当前没有需要处理的问题" Margin="0,5,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}"><Style.Triggers><DataTrigger Binding="{Binding HasAttention}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding AnnotationStatus}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                            <TextBlock Text="部分完成或需要处理的文件会保留原始文件，并继续通过现有任务中心恢复；不会在此提供删除入口。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBackgroundBrush}" Margin="8">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Border Style="{StaticResource PanelBorder}" Padding="8,6" Visibility="{Binding ShowMonitorWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SessionSummaryText" Text="{Binding UserFacingProviderText, StringFormat=● {0}}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                               ToolTip="当前通过看守文件夹接收照片；不提供实时取景、遥控快门或相机参数控制。" />
                    <TextBlock Text="{Binding ReadyCount, StringFormat= · 就绪 {0}}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AttentionCount, StringFormat= · 需处理 {0}}" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BrowserToolbarButton" Content="照片浏览器" Style="{StaticResource GhostButton}" Click="ToggleBrowser_Click" AutomationProperties.Name="显示或隐藏照片浏览器" />
                    <CheckBox Content="自动最新" IsChecked="{Binding AutoLatest}" Margin="8,0,0,0" VerticalAlignment="Center" AutomationProperties.Name="自动跟随最新照片" />
                    <Button Content="{Binding LockButtonText}" Style="{StaticResource GhostButton}" Command="{Binding ToggleLockCommand}" Margin="6,0,0,0" AutomationProperties.Name="锁定或解锁当前照片" />
                    <Button Content="LUT" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.ToggleLutCommand}" Margin="6,0,0,0" AutomationProperties.Name="切换LUT" />
                    <Button x:Name="ClientMonitorToolbarButton" Content="客户监看" Style="{StaticResource GhostButton}" Command="{Binding ColorSettings.OpenClientMonitorCommand}" Margin="6,0,0,0" AutomationProperties.Name="开启客户监看窗口" />
                    <Button x:Name="InspectorToolbarButton" Content="检查器" Style="{StaticResource GhostButton}" Command="{Binding ToggleInspectorCommand}" Margin="6,0,0,0" AutomationProperties.Name="显示或隐藏现场监看检查器" />
                    <Button x:Name="TaskCenterToolbarButton" Content="任务中心" Style="{StaticResource GhostButton}" Click="OpenTaskCenter_Click" Margin="6,0,0,0" AutomationProperties.Name="打开任务中心" />
                    <Button x:Name="CompactMoreButton" Content="更多 ▾" Style="{StaticResource GhostButton}" Margin="6,0,0,0" Visibility="Collapsed" Click="OpenCompactMenu_Click" AutomationProperties.Name="更多联机监看工具">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="照片浏览器" Click="ToggleBrowser_Click" />
                                <MenuItem Header="客户监看" Command="{Binding ColorSettings.OpenClientMonitorCommand}" />
                                <MenuItem Header="检查器" Command="{Binding ToggleInspectorCommand}" />
                                <MenuItem Header="任务中心" Click="OpenTaskCenter_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button Content="{Binding FullScreenButtonText}" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleFullScreenCommand}" Margin="6,0,0,0" AutomationProperties.Name="全屏监看" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource PanelBorder}" Visibility="{Binding ShowPreSessionPage, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="联机拍摄启动页">
            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="620" Margin="40">
                    <TextBlock Text="联机拍摄" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="选择相机软件正在写入照片的文件夹，像素蛋挞会在文件写入稳定后自动显示。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="15" LineHeight="24" Margin="0,14,0,0" />
                    <Border Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,22,0,0">
                        <StackPanel>
                            <TextBlock Text="看守文件夹" Style="{StaticResource CaptionText}" />
                            <TextBlock Text="{Binding WatchDirectory, TargetNullValue=尚未选择}" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" AutomationProperties.Name="当前看守文件夹" />
                            <TextBlock Text="只监看所选目录顶层；不会递归扫描，不会删除、移动或修改源照片。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                        <Button Content="选择看守文件夹" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseWatchFolderCommand}" AutomationProperties.Name="选择看守文件夹" />
                        <Button Content="开始联机会话" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="10,0,0,0" AutomationProperties.Name="开始联机会话" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="MonitorWorkspace" Grid.Row="2" Visibility="{Binding ShowMonitorWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions><ColumnDefinition x:Name="ThumbnailColumn" Width="270" MinWidth="220" MaxWidth="300" /><ColumnDefinition x:Name="BrowserSplitterColumn" Width="8" /><ColumnDefinition Width="*" MinWidth="640" /><ColumnDefinition Width="8" /><ColumnDefinition x:Name="InspectorColumn" Width="320" MinWidth="280" MaxWidth="340" /></Grid.ColumnDefinitions>

            <Border x:Name="BrowserPanel" Style="{StaticResource PanelBorder}" Padding="8">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding FilterOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedFilter}" AutomationProperties.Name="缩略图筛选" /><ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSort}" Margin="6,0,0,0" AutomationProperties.Name="缩略图排序" /></Grid>
                    <ListBox x:Name="AssetList" Grid.Row="1" ItemsSource="{Binding AssetsView}" SelectedItem="{Binding SelectedAsset}" BorderThickness="0" Background="Transparent" Margin="0,7,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                             ItemContainerStyle="{StaticResource ThumbnailItemStyle}" AutomationProperties.Name="联机文件列表">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate><Border Padding="6" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid Width="104" Height="78" Background="{DynamicResource SurfaceTertiaryBrush}" ClipToBounds="True"><Image Source="{Binding Thumbnail}" Stretch="Uniform" /><Border Background="{DynamicResource SurfaceSecondaryBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRaw}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel VerticalAlignment="Center"><TextBlock Text="RAW" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="安全占位预览" Style="{StaticResource CaptionText}" HorizontalAlignment="Center" /></StackPanel></Border></Grid><StackPanel Grid.Column="1" Margin="8,0,0,0"><Grid><TextBlock Text="{Binding MediaKindText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding CaptureTimeText}" Style="{StaticResource CaptionText}" HorizontalAlignment="Right" /></Grid><TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" /><TextBlock Text="{Binding RatingText}" Foreground="{DynamicResource WarningBrush}" /><WrapPanel><TextBlock Text="{Binding PairText}" Style="{StaticResource CaptionText}" /><TextBlock Text="  ♥" Foreground="{DynamicResource DangerBrush}" Visibility="{Binding ClientFavorite, Converter={StaticResource BooleanToVisibilityConverter}}" /><TextBlock Text="  拒绝" Foreground="{DynamicResource WarningBrush}" Visibility="{Binding IsRejected, Converter={StaticResource BooleanToVisibilityConverter}}" /></WrapPanel><Grid Margin="0,3,0,0"><TextBlock Text="{Binding StateText}" Style="{StaticResource CaptionText}" /><Button Content="加入比较" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="4,1" MinHeight="22" Command="{Binding DataContext.SetCompareCandidateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="将照片加入比较" /></Grid></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowWaitingForFirstPhoto, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="等待照片" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="新照片写入稳定后会出现在这里" Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,6,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Row="2" Text="缩略图会按需加载，快速滚动时仍保持流畅。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="2,6,2,0" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" AutomationProperties.Name="调整照片浏览器宽度" />

            <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <Border Padding="8" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"><StackPanel x:Name="MonitorToolbar" Orientation="Horizontal"><Button Content="上一张  ←" Style="{StaticResource GhostButton}" Command="{Binding PreviousCommand}" AutomationProperties.Name="上一张联机照片" /><Button Content="下一张  →" Style="{StaticResource GhostButton}" Command="{Binding NextCommand}" Margin="5,0,0,0" AutomationProperties.Name="下一张联机照片" /><Button Content="Fit" Style="{StaticResource GhostButton}" Command="{Binding FitCommand}" Margin="10,0,0,0" AutomationProperties.Name="适合窗口查看" /><Button Content="Fill" Style="{StaticResource GhostButton}" Command="{Binding FillCommand}" Margin="5,0,0,0" AutomationProperties.Name="填满窗口查看" /><Button Content="100%" Style="{StaticResource GhostButton}" Command="{Binding ActualSizeCommand}" Margin="5,0,0,0" AutomationProperties.Name="百分之百查看" /><Button Content="重置视图" Style="{StaticResource GhostButton}" Command="{Binding ResetViewCommand}" Margin="5,0,0,0" AutomationProperties.Name="重置监看视图" /></StackPanel></Border>

                    <Grid x:Name="PreviewViewport" Grid.Row="1" Background="{Binding CanvasBackground}" ClipToBounds="True" MouseWheel="PreviewViewport_MouseWheel" MouseLeftButtonDown="PreviewViewport_MouseLeftButtonDown" MouseLeftButtonUp="PreviewViewport_MouseLeftButtonUp" MouseMove="PreviewViewport_MouseMove" MouseLeave="PreviewViewport_MouseLeave">
                        <Grid Visibility="{Binding IsNormalPreview, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Grid.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /><TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" /></TransformGroup></Grid.RenderTransform>
                            <Image Source="{Binding ColorSettings.VisibleImage}" Stretch="{Binding PreviewStretch}" SnapsToDevicePixels="True" MouseLeftButtonDown="PreviewImage_MouseLeftButtonDown" Visibility="{Binding ColorSettings.IsLutSingleView, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Grid Visibility="{Binding ColorSettings.IsSplitView, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="{Binding ColorSettings.SplitLeftWidth}" /><ColumnDefinition Width="4" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource AccentBrush}" AutomationProperties.Name="拖动LUT分屏分割线" />
                                <Image Source="{Binding ColorSettings.SourceImage}" Stretch="{Binding PreviewStretch}" /><Image Grid.Column="2" Source="{Binding ColorSettings.DisplayImage}" Stretch="{Binding PreviewStretch}" />
                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Background="{DynamicResource OverlayBrush}" Padding="8" Margin="10"><TextBlock Text="原图" /></Border>
                                <Border Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right" Background="{DynamicResource OverlayBrush}" Padding="8" Margin="10"><TextBlock Text="LUT结果" /></Border>
                            </Grid>
                            <Image Source="{Binding ClippingOverlay}" Stretch="{Binding PreviewStretch}" IsHitTestVisible="False" />
                            <Image Source="{Binding ReferenceImage}" Stretch="Uniform" Opacity="{Binding ReferenceOpacity}" Visibility="{Binding ReferenceVisible, Converter={StaticResource BooleanToVisibilityConverter}}" IsHitTestVisible="False"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding ReferenceScaleX}" ScaleY="{Binding ReferenceScale}" /><TranslateTransform X="{Binding ReferenceOffsetX}" Y="{Binding ReferenceOffsetY}" /></TransformGroup></Image.RenderTransform></Image>
                            <views:CompositionGuideOverlay GuideMode="{Binding GuideMode}" GuideBrush="{DynamicResource TextPrimaryBrush}" IsHitTestVisible="False" AutomationProperties.Name="构图辅助线" />
                        </Grid>
                        <Grid Visibility="{Binding IsSideBySide, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Image Source="{Binding ComparisonPrimaryImage}" Stretch="Uniform"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /><TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" /></TransformGroup></Image.RenderTransform></Image><Border Grid.Column="1" Background="{DynamicResource DividerBrush}" /><Image Grid.Column="2" Source="{Binding ComparisonSecondaryImage}" Stretch="Uniform"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding ComparisonSecondaryZoom}" ScaleY="{Binding ComparisonSecondaryZoom}" /><TranslateTransform X="{Binding ComparisonSecondaryPanX}" Y="{Binding ComparisonSecondaryPanY}" /></TransformGroup></Image.RenderTransform></Image><Border VerticalAlignment="Bottom" Background="{DynamicResource OverlayBrush}" Padding="8"><TextBlock Text="主选中 · 拍摄参数见右侧" /></Border><Border Grid.Column="2" VerticalAlignment="Bottom" Background="{DynamicResource OverlayBrush}" Padding="8"><TextBlock Text="第二张 · 同步缩放/拖动可选" /></Border></Grid>
                        <Grid Visibility="{Binding IsOverlayCompare, Converter={StaticResource BooleanToVisibilityConverter}}"><Image Source="{Binding ComparisonPrimaryImage}" Stretch="Uniform"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding Zoom}" ScaleY="{Binding Zoom}" /><TranslateTransform X="{Binding PanX}" Y="{Binding PanY}" /></TransformGroup></Image.RenderTransform></Image><Image Source="{Binding ComparisonSecondaryImage}" Stretch="Uniform" Opacity="{Binding ComparisonSecondaryOpacity}"><Image.RenderTransform><TransformGroup><ScaleTransform ScaleX="{Binding ComparisonSecondaryZoom}" ScaleY="{Binding ComparisonSecondaryZoom}" /><TranslateTransform X="{Binding ComparisonSecondaryPanX}" Y="{Binding ComparisonSecondaryPanY}" /></TransformGroup></Image.RenderTransform></Image><TextBlock Text="重叠比较 · 中心对齐" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource OverlayBrush}" Padding="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" /></Grid>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="正在加载…" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="18" HorizontalAlignment="Center" /><ProgressBar Width="240" Height="5" Value="{Binding PreviewProgress, Mode=OneWay}" Margin="0,10,0,0" /></StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520" Visibility="{Binding ShowTetherEmptyState, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="联机监看" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="{Binding TetherEmptyStateText}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,0" /><TextBlock Text="选择一张照片后才能进入全屏监看。" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0"><Button Content="选择看守文件夹" Style="{StaticResource SecondaryButton}" Command="{Binding ChooseWatchFolderCommand}" AutomationProperties.Name="选择看守文件夹" /><Button Content="开始联机会话" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" Margin="8,0,0,0" AutomationProperties.Name="开始联机会话" /></StackPanel></StackPanel>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="8"><Grid><TextBlock Text="{Binding PreviewStatus}" Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Margin="0,0,520,0" /><WrapPanel HorizontalAlignment="Right"><TextBlock Text="构图" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><ComboBox Width="110" ItemsSource="{Binding GuideOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding GuideMode}" Margin="5,0,0,0" AutomationProperties.Name="构图辅助线选择" /><TextBlock Text="画布" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="10,0,0,0" /><ComboBox Width="110" ItemsSource="{Binding CanvasToneOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CanvasTone}" Margin="5,0,0,0" AutomationProperties.Name="监看画布颜色选择" /></WrapPanel></Grid></Border>
                </Grid>
            </Border>

            <Border x:Name="InspectorPanel" Grid.Column="4" Padding="0">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource PanelBorder}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsInspectorCollapsed}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding HasSelection}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource InspectorTemplate}" />
            </Border>
            <Border x:Name="InspectorDrawer" Grid.Column="0" Grid.ColumnSpan="5" Width="330" HorizontalAlignment="Right" Panel.ZIndex="20" Style="{StaticResource PanelBorder}" Padding="0" Visibility="{Binding ShowInspectorDrawer, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid><ContentControl Content="{Binding}" ContentTemplate="{StaticResource InspectorTemplate}" /><Button Content="关闭检查器" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,20,0" Command="{Binding ToggleInspectorCommand}" AutomationProperties.Name="关闭现场监看检查器" /></Grid></Border>
        </Grid>
    </Grid>
</UserControl>
