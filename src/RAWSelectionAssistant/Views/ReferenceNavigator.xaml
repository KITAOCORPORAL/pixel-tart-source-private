<UserControl x:Class="RAWSelectionAssistant.Views.ReferenceNavigator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:RAWSelectionAssistant.Views" AutomationProperties.Name="{views:StudioText ReferenceNavigator}">
 <Grid Background="{DynamicResource CanvasBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Stage" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" MouseWheel="OnMouseWheel">
   <views:ColorStudioImageViewport x:Name="Preview" IsHitTestVisible="False"/>
   <TextBlock x:Name="EmptyText" Text="{views:StudioText ReferenceEmpty}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
  <WrapPanel x:Name="NavigationTools" Grid.Row="1" Margin="0,4">
   <Button Content="{views:StudioText Fit}" Click="FitClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3"/>
   <Button Content="100%" Click="ActualClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" ToolTip="{views:StudioText ReferenceActualSizeHelp}"/>
   <Button Click="ZoomOutClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" ToolTip="{views:StudioText ReferenceZoomOut}" AutomationProperties.Name="{views:StudioText ReferenceZoomOut}"><Path Data="M 3,10 L 17,10" Style="{StaticResource Icon20}"/></Button>
   <TextBlock x:Name="ZoomLabel" Margin="4,0" VerticalAlignment="Center"/>
   <Button Click="ZoomInClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" ToolTip="{views:StudioText ReferenceZoomIn}" AutomationProperties.Name="{views:StudioText ReferenceZoomIn}"><Path Data="M 3,10 L 17,10 M 10,3 L 10,17" Style="{StaticResource Icon20}"/></Button>
  </WrapPanel>
 </Grid>
</UserControl>
