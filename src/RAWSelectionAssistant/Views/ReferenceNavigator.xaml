<UserControl x:Class="RAWSelectionAssistant.Views.ReferenceNavigator"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:RAWSelectionAssistant.Views" AutomationProperties.Name="参考图导航器">
 <Grid Background="{DynamicResource CanvasBackgroundBrush}">
  <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="Stage" Background="Transparent" ClipToBounds="True" MouseLeftButtonDown="OnMouseDown" MouseMove="OnMouseMove" MouseLeftButtonUp="OnMouseUp" MouseWheel="OnMouseWheel">
   <views:ColorStudioImageViewport x:Name="Preview" IsHitTestVisible="False"/>
   <TextBlock x:Name="EmptyText" Text="暂无参考图" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Grid>
  <WrapPanel Grid.Row="1" Margin="0,4">
   <Button Content="适合" Click="FitClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3"/>
   <Button Content="100%" Click="ActualClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" ToolTip="一个源像素对应一个逻辑像素"/>
   <Button Content="缩小" Click="ZoomOutClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" AutomationProperties.Name="参考图缩小"/>
   <TextBlock x:Name="ZoomLabel" Margin="4,0" VerticalAlignment="Center"/>
   <Button Content="放大" Click="ZoomInClick" Style="{StaticResource PixelTart.Button.Ghost}" Padding="6,3" AutomationProperties.Name="参考图放大"/>
  </WrapPanel>
 </Grid>
</UserControl>
