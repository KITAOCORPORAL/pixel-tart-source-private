<Window x:Class="RAWSelectionAssistant.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助 - 光镜" Width="520" Height="300" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="../Assets/AppIcon.ico" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Text="光镜" Style="{StaticResource AppTitleText}"/>
        <TextBlock Grid.Row="1" Text="版本 2.3.0" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12"/>
        <Button Grid.Row="2" Content="关闭" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="90" Click="Close_Click" IsCancel="True"/>
    </Grid>
</Window>
