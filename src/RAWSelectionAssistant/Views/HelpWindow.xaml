<Window x:Class="RAWSelectionAssistant.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="帮助 - 像素蛋挞" Width="520" Height="420" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Icon="../Assets/AppIcon.ico" Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal"><Image Source="../Assets/AppIcon.png" Width="40" Height="40" Margin="0,0,12,0" /><TextBlock Text="像素蛋挞" Style="{StaticResource AppTitleText}" VerticalAlignment="Center" /></StackPanel>
        <TextBlock Grid.Row="1" Text="版本 2.0.3.1 · 本地分片、归片与照片处理工具平台" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,18" />
        <StackPanel Grid.Row="2">
            <TextBlock Text="需要再次熟悉完整流程时，可以重新进入 22 步交互式教程。教程只使用应用创建的演示照片，不会访问或删除你的真实照片。" TextWrapping="Wrap" Margin="0,0,0,18" />
            <Button Content="重新查看完整教程" Style="{StaticResource PrimaryButton}" Click="Replay_Click" />
            <Button Content="重置教程演示数据" Style="{StaticResource SecondaryButton}" Margin="0,10,0,0" Click="Reset_Click" />
            <Button Content="删除教程演示数据" Style="{StaticResource DangerButton}" Margin="0,10,0,0" Click="Delete_Click" />
        </StackPanel>
        <Button Grid.Row="3" Content="关闭" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Width="90" Click="Close_Click" IsCancel="True" />
    </Grid>
</Window>
