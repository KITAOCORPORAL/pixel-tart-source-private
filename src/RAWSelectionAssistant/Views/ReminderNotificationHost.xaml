<UserControl x:Class="RAWSelectionAssistant.Views.ReminderNotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="拍摄提醒通知">
    <ScrollViewer Width="390" MaxHeight="640" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
            <DataTemplate>
                <Border Background="{DynamicResource WorkbenchCardBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="14" Margin="0,0,0,9">
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6,0,10" />
                        <WrapPanel HorizontalAlignment="Right">
                            <Button Content="稍后查看" Style="{StaticResource GhostButton}" Command="{Binding DataContext.LaterCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="稍后查看提醒" />
                            <Button Content="知道了" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="确认拍摄提醒" />
                            <Button Content="打开排期" Style="{StaticResource PrimaryButton}" Margin="6,0,0,0" Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="打开提醒对应排期" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
    </ItemsControl>
    </ScrollViewer>
</UserControl>
