<UserControl x:Class="RAWSelectionAssistant.Views.WeekCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="周视图" AutomationProperties.HelpText="七列时间轴，包含全天区和跨天排期">
    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Width="190" MinHeight="620" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0" Padding="8">
                    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Button Content="{Binding Header}" FontWeight="SemiBold" Style="{StaticResource GhostButton}" Command="{Binding DataContext.SelectDateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Header}" />
                        <Border Grid.Row="1" Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6" Padding="5" Margin="0,4,0,8"><StackPanel><TextBlock Text="全天 / 跨天" Style="{StaticResource CaptionText}" /><ItemsControl ItemsSource="{Binding AllDayBookings}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="4" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" /></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding TimeSlots}"><ItemsControl.ItemTemplate><DataTemplate><Grid MinHeight="38"><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Button Content="{Binding Label}" FontSize="10" Style="{StaticResource GhostButton}" Padding="1" Command="{Binding DataContext.CreateBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=在 {0} 新建排期}" /><Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0"><ItemsControl ItemsSource="{Binding Bookings}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="3" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><StackPanel><TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock FontSize="10"><Run Text="{Binding StatusGlyph, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding StatusText, Mode=OneWay}" /></TextBlock></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
