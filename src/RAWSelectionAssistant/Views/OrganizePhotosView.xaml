<UserControl x:Class="RAWSelectionAssistant.Views.OrganizePhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="720"
             AutomationProperties.Name="整理图片页面">
    <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1120" HorizontalAlignment="Left">
            <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}" />
            <TextBlock Text="分组整理 · 先选择图片来源，再按组名、缩略图和数量检查整理结果。"
                       Style="{StaticResource CaptionText}" Margin="0,7,0,18" />

            <Border Style="{StaticResource ToolPanelCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="图片来源" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="本维护版仅提供可验收页面框架，不读取、移动或改写照片。"
                                   Style="{StaticResource CaptionText}" Margin="0,7,0,10" TextWrapping="Wrap" />
                        <TextBox Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True" MinWidth="420"
                                 AutomationProperties.Name="整理图片来源路径" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="添加图片（开发中）" Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" VerticalAlignment="Bottom" Margin="14,0,0,0"
                            AutomationProperties.Name="添加整理图片来源，开发中" />
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="280" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelBorder}" MinHeight="330">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="分组整理" Style="{StaticResource SectionTitleText}" />
                            <Button Content="新建分组（开发中）" Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Right" IsEnabled="False" />
                        </Grid>
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Groups}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Count, StringFormat={}{0} 张}" HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    AutomationProperties.Name="整理图片暂无分组">
                            <Path Width="48" Height="48" Stretch="Uniform" Stroke="{DynamicResource TextTertiaryBrush}"
                                  StrokeThickness="1.4" Data="{StaticResource ToolIconOrganize}" />
                            <TextBlock Text="暂无分组" Style="{StaticResource EmptyStateTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="后续版本会在这里显示组名、缩略图和图片数量。"
                                       Style="{StaticResource CaptionText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="14,0,0,0">
                    <StackPanel>
                        <TextBlock Text="分组操作" Style="{StaticResource SectionTitleText}" />
                        <Button Content="批量创建文件夹（开发中）" Style="{StaticResource PrimaryButton}"
                                IsEnabled="False" Margin="0,14,0,0" />
                        <Button Content="导出分组结果（开发中）" Style="{StaticResource SecondaryButton}"
                                IsEnabled="False" Margin="0,8,0,0" />
                        <TextBlock Text="当前页面不会执行文件复制、移动、重命名或删除。"
                                   Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
