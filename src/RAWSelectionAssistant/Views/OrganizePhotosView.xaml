<UserControl x:Class="RAWSelectionAssistant.Views.OrganizePhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" AutomationProperties.Name="整理图片页面">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel Margin="0,0,48,0"><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}"/><TextBlock Text="选择照片和整理方式，预览无误后开始。默认保留原文件。" Style="{StaticResource CaptionText}" Margin="0,6,0,14"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="添加照片" Style="{StaticResource PrimaryButton}" Command="{Binding AddPhotosCommand}"/><Button Content="添加文件夹" Style="{StaticResource SecondaryButton}" Command="{Binding AddFolderCommand}" Margin="8,0,0,0"/></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="1  整理哪些照片？" Style="{StaticResource SectionTitleText}"/>
                <ListBox ItemsSource="{Binding SourceInputs}" MinHeight="74" MaxHeight="120" Margin="0,10,0,0" AutomationProperties.Name="要整理的照片"/>
                <TextBlock Text="2  怎么整理？" Style="{StaticResource SectionTitleText}" Margin="0,18,0,6"/><ComboBox ItemsSource="{Binding RuleOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRule}" AutomationProperties.Name="照片整理方式"/>
                <Expander Header="自定义整理方式" Margin="0,10,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="关键词" Style="{StaticResource CaptionText}"/><TextBox Text="{Binding CustomParameter,UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/><TextBlock Text="每组照片数" Style="{StaticResource CaptionText}" Margin="0,10,0,5"/><TextBox Text="{Binding FixedCount,UpdateSourceTrigger=PropertyChanged}"/><Button Content="更新分组" Style="{StaticResource SecondaryButton}" Command="{Binding GroupCommand}" Margin="0,10,0,0"/></StackPanel></Expander>
                <TextBlock Text="3  保存到哪里？" Style="{StaticResource SectionTitleText}" Margin="0,18,0,6"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="整理后照片保存位置"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0"/></Grid>
                <Expander Header="高级设置" Margin="0,16,0,0"><StackPanel Margin="0,8,0,0"><TextBlock Text="整理完成后" Style="{StaticResource CaptionText}"/><ComboBox ItemsSource="{Binding OperationOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedOperation}" Margin="0,5,0,0"/><TextBlock Text="同名文件处理" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding ConflictOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedConflict}"/><CheckBox Content="检查复制后的文件完整性" IsChecked="{Binding VerifySha256}" Margin="0,12,0,0"/></StackPanel></Expander>
            </StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="分组结果" Style="{StaticResource SectionTitleText}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsGroupedStage, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="新建组" Style="{StaticResource GhostButton}" Command="{Binding NewGroupCommand}"/><Button Content="合并" Style="{StaticResource GhostButton}" Command="{Binding MergeGroupCommand}"/><Button Content="拆分" Style="{StaticResource GhostButton}" Command="{Binding SplitGroupCommand}"/><Button Content="排序" Style="{StaticResource GhostButton}" Command="{Binding SortGroupsCommand}"/><Menu Background="Transparent" Margin="6,0,0,0"><MenuItem Header="…"><MenuItem Header="删除组" Command="{Binding DeleteGroupCommand}"/><MenuItem Header="删除空组" Command="{Binding DeleteEmptyGroupsCommand}"/></MenuItem></Menu></StackPanel></Grid>
                <Grid Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmptyStage, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="尚未导入照片" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="添加照片或文件夹后，才会显示分组结果。" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/><Button Content="添加照片" Style="{StaticResource PrimaryButton}" Command="{Binding AddPhotosCommand}"/></StackPanel><ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="0,12,0,10" AllowDrop="True" DragOver="GroupsList_DragOver" Drop="GroupsList_Drop" AutomationProperties.Name="整理图片分组结果" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><Grid><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"/><TextBlock Text="{Binding Count,StringFormat={}{0} 张}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="PhotosGrid" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}" SelectionMode="Extended" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" PreviewMouseLeftButtonDown="PhotosGrid_MouseLeftButtonDown" PreviewMouseMove="PhotosGrid_MouseMove"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="130"/><DataGridTextColumn Header="格式" Binding="{Binding Extension}" Width="62"/><DataGridCheckBoxColumn Header="拍摄日期可用" Binding="{Binding HasCaptureTime}" Width="92"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Content="移动所选到当前组" Style="{StaticResource GhostButton}" Click="MoveSelectedPhotos_Click"/><Button Content="设为封面" Style="{StaticResource GhostButton}" Command="{Binding SetCoverCommand}" Margin="6,0,0,0"/></StackPanel></Grid>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,16">
                <TextBlock Text="4  预览整理结果" Style="{StaticResource SectionTitleText}"/>
                <Border Style="{StaticResource InfoCard}" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding RiskSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <Button Content="预览整理结果" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewPlanCommand}" Margin="0,14,0,0" Visibility="{Binding IsGroupedStage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="开始整理" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" Margin="0,8,0,0" Visibility="{Binding IsPlanReady, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="排除所选照片" Style="{StaticResource GhostButton}" Command="{Binding ExcludeSelectedCommand}" Margin="0,8,0,0" Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="撤销移动整理" Style="{StaticResource SecondaryButton}" Command="{Binding UndoMoveCommand}" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="导出 CSV / JSON / TXT 报告" Style="{StaticResource SecondaryButton}" Command="{Binding ExportReportsCommand}" Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,18,0,0"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="停止" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Margin="0,12,0,0"/>
                <Border Style="{StaticResource WarningCard}" Margin="0,16,0,0"><TextBlock Text="文件确认复制完整后才继续处理原文件。删除分组只会删除分组，不会删除照片。" TextWrapping="Wrap"/></Border>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="可以直接拖入照片或文件夹。同名照片会自动重命名，默认保留原文件。" Style="{StaticResource CaptionText}" Margin="0,12,0,16"/>
    </Grid>
</UserControl>
