<UserControl x:Class="RAWSelectionAssistant.Views.OrganizePhotosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" AutomationProperties.Name="整理图片页面">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel Margin="0,0,48,0"><TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}"/><TextBlock Text="导入照片后先生成分组和版本化操作清单，再执行复制或移动。默认复制、不覆盖、不删除源文件。" Style="{StaticResource CaptionText}" Margin="0,6,0,14"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="添加照片" Style="{StaticResource SecondaryButton}" Command="{Binding AddPhotosCommand}"/><Button Content="添加文件夹" Style="{StaticResource PrimaryButton}" Command="{Binding AddFolderCommand}" Margin="8,0,0,0"/><views:SurfaceCloseButton Margin="8,0,0,0" AutomationName="关闭整理图片并返回" /></StackPanel></Grid>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="290"/><ColumnDefinition Width="*" MinWidth="420"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,12,0"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                <TextBlock Text="来源和分组规则" Style="{StaticResource SectionTitleText}"/>
                <TextBlock Text="来源" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><ListBox ItemsSource="{Binding SourceInputs}" MinHeight="74" MaxHeight="120" AutomationProperties.Name="整理图片来源"/>
                <TextBlock Text="分组规则" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding RuleOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRule}" AutomationProperties.Name="整理图片分组规则"/>
                <TextBlock Text="自定义关键词" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><TextBox Text="{Binding CustomParameter,UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="每组数量" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><TextBox Text="{Binding FixedCount,UpdateSourceTrigger=PropertyChanged}"/>
                <Button Content="重新分组" Style="{StaticResource SecondaryButton}" Command="{Binding GroupCommand}" Margin="0,14,0,0"/>
                <Separator Margin="0,16"/>
                <TextBlock Text="执行模式" Style="{StaticResource CaptionText}"/><ComboBox ItemsSource="{Binding OperationOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedOperation}" Margin="0,5,0,0"/>
                <TextBlock Text="同名策略" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><ComboBox ItemsSource="{Binding ConflictOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedConflict}"/>
                <CheckBox Content="使用 SHA-256 校验" IsChecked="{Binding VerifySha256}" Margin="0,12,0,0"/>
                <TextBlock Text="输出目录" Style="{StaticResource CaptionText}" Margin="0,12,0,5"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding OutputPath,UpdateSourceTrigger=PropertyChanged}"/><Button Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Command="{Binding BrowseOutputCommand}" Margin="6,0,0,0"/></Grid>
            </StackPanel></ScrollViewer></Border>
            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="160"/></Grid.RowDefinitions>
                <Grid><TextBlock Text="分组结果" Style="{StaticResource SectionTitleText}"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsGroupedStage, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="新建组" Style="{StaticResource GhostButton}" Command="{Binding NewGroupCommand}"/><Button Content="合并" Style="{StaticResource GhostButton}" Command="{Binding MergeGroupCommand}"/><Button Content="拆分" Style="{StaticResource GhostButton}" Command="{Binding SplitGroupCommand}"/><Button Content="排序" Style="{StaticResource GhostButton}" Command="{Binding SortGroupsCommand}"/><Menu Background="Transparent" Margin="6,0,0,0"><MenuItem Header="…"><MenuItem Header="删除组" Command="{Binding DeleteGroupCommand}"/><MenuItem Header="删除空组" Command="{Binding DeleteEmptyGroupsCommand}"/></MenuItem></Menu></StackPanel></Grid>
                <Grid Grid.Row="1"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEmptyStage, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="尚未导入照片" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="添加照片或文件夹后，才会显示分组结果。" Style="{StaticResource CaptionText}" Margin="0,6,0,12"/><Button Content="添加照片" Style="{StaticResource PrimaryButton}" Command="{Binding AddPhotosCommand}"/></StackPanel><ListBox x:Name="GroupsList" ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Margin="0,12,0,10" AllowDrop="True" DragOver="GroupsList_DragOver" Drop="GroupsList_Drop" AutomationProperties.Name="整理图片分组结果" Visibility="{Binding HasGroups, Converter={StaticResource BooleanToVisibilityConverter}}"><ListBox.ItemTemplate><DataTemplate><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,6"><Grid><TextBox Text="{Binding Name,UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" FontWeight="SemiBold"/><TextBlock Text="{Binding Count,StringFormat={}{0} 张}" HorizontalAlignment="Right" Foreground="{DynamicResource TextSecondaryBrush}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
                <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DataGrid x:Name="PhotosGrid" ItemsSource="{Binding Photos}" SelectedItem="{Binding SelectedPhoto}" SelectionMode="Extended" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" PreviewMouseLeftButtonDown="PhotosGrid_MouseLeftButtonDown" PreviewMouseMove="PhotosGrid_MouseMove"><DataGrid.Columns><DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="*"/><DataGridTextColumn Header="分组" Binding="{Binding GroupName}" Width="130"/><DataGridTextColumn Header="格式" Binding="{Binding Extension}" Width="62"/><DataGridCheckBoxColumn Header="缺元数据" Binding="{Binding MetadataMissing}" Width="72"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0"><Button Content="移动所选到当前组" Style="{StaticResource GhostButton}" Click="MoveSelectedPhotos_Click"/><Button Content="设为封面" Style="{StaticResource GhostButton}" Command="{Binding SetCoverCommand}" Margin="6,0,0,0"/></StackPanel></Grid>
            </Grid></Border>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,8,16">
                <TextBlock Text="操作摘要和执行" Style="{StaticResource SectionTitleText}"/>
                <Border Style="{StaticResource InfoCard}" Margin="0,12,0,0"><StackPanel><TextBlock Text="{Binding PlanSummary}" TextWrapping="Wrap"/><TextBlock Text="{Binding RiskSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,7,0,0"/></StackPanel></Border>
                <TextBlock Text="下一步" Style="{StaticResource CaptionText}" Margin="0,14,0,3"/>
                <Button Content="生成并预览操作清单" Style="{StaticResource SecondaryButton}" Command="{Binding PreviewPlanCommand}" Margin="0,5,0,0" Visibility="{Binding IsGroupedStage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="执行当前清单" Style="{StaticResource PrimaryButton}" Command="{Binding ExecuteCommand}" Margin="0,8,0,0" Visibility="{Binding IsPlanReady, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="排除所选照片" Style="{StaticResource GhostButton}" Command="{Binding ExcludeSelectedCommand}" Margin="0,8,0,0" Visibility="{Binding HasPhotos, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="撤销移动整理" Style="{StaticResource SecondaryButton}" Command="{Binding UndoMoveCommand}" Margin="0,16,0,0" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Button Content="导出 CSV / JSON / TXT 报告" Style="{StaticResource SecondaryButton}" Command="{Binding ExportReportsCommand}" Margin="0,8,0,0" Visibility="{Binding HasResult, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ProgressBar Value="{Binding Progress, Mode=OneWay}" Height="5" Margin="0,18,0,0"/><TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <Button Content="取消当前操作" Style="{StaticResource DangerButton}" Command="{Binding CancelCommand}" Margin="0,12,0,0"/>
                <Border Style="{StaticResource WarningCard}" Margin="0,16,0,0"><TextBlock Text="移动模式会先复制、校验，再删除源文件；删除分组只删除定义，不删除照片。" TextWrapping="Wrap"/></Border>
            </StackPanel></ScrollViewer></Border>
        </Grid>
        <TextBlock Grid.Row="2" Text="支持拖入照片或目录。来源文件只读打开，目标始终新建文件，同名自动编号。" Style="{StaticResource CaptionText}" Margin="0,12,0,16"/>
    </Grid>
</UserControl>
