<UserControl x:Class="RAWSelectionAssistant.Views.DayCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="日视图" AutomationProperties.HelpText="单日时间轴，点击时间槽新建排期">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Background="{DynamicResource SurfaceSecondaryBrush}" Padding="10"><StackPanel><TextBlock Text="全天 / 跨天" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding AllDayBookings}"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><StackPanel><TextBlock><Run Text="{Binding StatusGlyph, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Title, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding StatusText, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding WeatherText}" Style="{StaticResource CaptionText}" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding TimeSlots}" MinWidth="620"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid MinHeight="54" Background="{DynamicResource SurfacePrimaryBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Button Content="{Binding Label}" Style="{StaticResource GhostButton}" Command="{Binding DataContext.CreateAtCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Label, StringFormat=在 {0} 新建排期}" />
                    <Border Grid.Column="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="4"><ItemsControl ItemsSource="{Binding Bookings}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource SecondaryButton}" Margin="0,0,5,0" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}"><StackPanel><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding StatusGlyph}" Margin="0,0,4,0" /><TextBlock Text="{Binding TimeText}" /><TextBlock Text=" · " /><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /></StackPanel><TextBlock Text="{Binding WeatherText}" FontSize="10" /></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                </Grid>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
