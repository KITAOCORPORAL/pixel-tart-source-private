<Window x:Class="RAWSelectionAssistant.Views.ShotReferenceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="像素蛋挞 · 拍摄参考" Width="900" Height="650" MinWidth="560" MinHeight="420" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" WindowStartupLocation="CenterOwner" AutomationProperties.Name="第二显示器拍摄参考窗口">
    <Grid Margin="18"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="{Binding ShotPositionText}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="灯位 · 姿势 · 分镜 · 造型" Style="{StaticResource CaptionText}" Margin="0,4,0,0"/></StackPanel>
        <Grid Grid.Row="1" Margin="0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{DynamicResource SurfaceSecondaryBrush}" CornerRadius="{StaticResource LargePanelCornerRadius}" Padding="10"><Image Source="{Binding PinnedReferenceImage}" Stretch="Uniform"/></Border><StackPanel Grid.Column="1" Margin="16,0,0,0"><TextBlock Text="当前参考" Style="{StaticResource SectionTitleText}"/><TextBlock Text="{Binding PinnedReference.Title, TargetNullValue=尚未固定参考}" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock Text="{Binding PinnedReference.Note}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,0"/></StackPanel></Grid>
        <TextBlock Grid.Row="2" Text="{Binding Notes, StringFormat=拍摄备注：{0}}" TextWrapping="Wrap"/>
    </Grid>
</Window>
