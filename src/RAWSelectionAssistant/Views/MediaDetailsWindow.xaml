<Window x:Class="RAWSelectionAssistant.Views.MediaDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
        Title="格式匹配明细"
        Icon="../Assets/AppIcon.ico"
        Width="1320" Height="680" MinWidth="920" MinHeight="500"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBackgroundBrush}">
    <Window.Resources>
        <conv:FileSizeConverter x:Key="FileSizeConverter" />
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{Binding OriginalInput, StringFormat=格式匹配明细：{0}}" Style="{StaticResource SectionTitleText}" FontSize="18" />
            <TextBlock x:Name="DetailsExplanation" Text="JPG 质量信息仅用于风险提示和推荐排序，不能单独证明文件是原图；冲突和智能备用均需手动确认。" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
        </StackPanel>
        <DataGrid x:Name="DetailsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="DetailsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="类别" Binding="{Binding CategoryText}" Width="70" />
                <DataGridTextColumn Header="文件来源" Binding="{Binding SourceText}" Width="115" />
                <DataGridTextColumn Header="扩展名" Binding="{Binding File.Extension}" Width="70" />
                <DataGridTextColumn Header="匹配状态" Binding="{Binding StatusText}" Width="108" />
                <DataGridTextColumn Header="已选" Binding="{Binding SelectedText}" Width="58" />
                <DataGridTextColumn Header="推荐" Binding="{Binding RecommendedText}" Width="58" />
                <DataGridTextColumn Header="需确认" Binding="{Binding ManualConfirmationText}" Width="65" />
                <DataGridTextColumn Header="文件名" Binding="{Binding File.FileName}" Width="165" />
                <DataGridTextColumn Header="像素尺寸" Binding="{Binding PixelDimensions}" Width="110" />
                <DataGridTextColumn Header="总像素" Binding="{Binding TotalPixelsText}" Width="105" />
                <DataGridTextColumn Header="EXIF" Binding="{Binding ExifStatusText}" Width="92" />
                <DataGridTextColumn Header="相机型号" Binding="{Binding CameraText}" Width="150" />
                <DataGridTextColumn Header="拍摄时间" Binding="{Binding DateTimeOriginalText}" Width="145" />
                <DataGridTextColumn Header="ICC" Binding="{Binding IccStatusText}" Width="82" />
                <DataGridTextColumn Header="软件标记" Binding="{Binding SoftwareText}" Width="150" />
                <DataGridTextColumn Header="方向" Binding="{Binding OrientationText}" Width="100" />
                <DataGridTextColumn Header="大小" Binding="{Binding FileSizeBytes, Converter={StaticResource FileSizeConverter}}" Width="88" />
                <DataGridTextColumn Header="质量风险" Binding="{Binding QualityWarningsText}" Width="320" />
                <DataGridTextColumn Header="推荐理由" Binding="{Binding RecommendedReason}" Width="300" />
                <DataGridTextColumn Header="来源/客户对比" Binding="{Binding ComparisonSummary}" Width="420" />
                <DataGridTextColumn Header="完整路径" Binding="{Binding File.FullPath}" Width="300" />
                <DataGridTextColumn Header="修改时间" Binding="{Binding File.LastWriteTimeUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="在文件资源管理器中显示" Style="{StaticResource SecondaryButton}" Click="Reveal_Click" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="设为所选格式文件" Style="{StaticResource PrimaryButton}" Click="Choose_Click" />
                <Button Content="关闭" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="Close_Click" IsCancel="True" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
