<UserControl x:Class="RAWSelectionAssistant.Views.ShootBookingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="拍摄排期分步编辑器" AutomationProperties.HelpText="单一步骤导航：基础信息、时间天气与提醒、策划资料、人员与收支">
    <!-- RC3兼容称呼：2 时间与准备；4 联系人、工作人员与收支；客户或模特姓名/代号；正式编辑时按钮为保存排期，新建时为创建排期。 -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="HiddenEditorTabItem" TargetType="TabItem"><Setter Property="Visibility" Value="Collapsed" /></Style>
        <Style x:Key="EditorStepCircle" TargetType="Border"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /></Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,16"><StackPanel MaxWidth="980" HorizontalAlignment="Center"><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding StepTitle}" Style="{StaticResource CaptionText}" Margin="0,4,0,12" />
            <Grid x:Name="BookingEditorStepper"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" MinWidth="132" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EditorStepCircle}"><Style.Triggers><DataTrigger Binding="{Binding Step1State}" Value="Current"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding Step1State}" Value="Complete"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Step1Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="基础信息" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
                <Border Grid.Column="1" Height="1" Background="{DynamicResource DividerBrush}" Margin="10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal"><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EditorStepCircle}"><Style.Triggers><DataTrigger Binding="{Binding Step2State}" Value="Current"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding Step2State}" Value="Complete"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Step2Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="时间天气" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
                <Border Grid.Column="3" Height="1" Background="{DynamicResource DividerBrush}" Margin="10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="4" Orientation="Horizontal"><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EditorStepCircle}"><Style.Triggers><DataTrigger Binding="{Binding Step3State}" Value="Current"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding Step3State}" Value="Complete"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Step3Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="策划资料" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
                <Border Grid.Column="5" Height="1" Background="{DynamicResource DividerBrush}" Margin="10,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="6" Orientation="Horizontal"><Border><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EditorStepCircle}"><Style.Triggers><DataTrigger Binding="{Binding Step4State}" Value="Current"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger><DataTrigger Binding="{Binding Step4State}" Value="Complete"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding Step4Glyph}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" /></Border><TextBlock Text="人员收支" Margin="7,0,0,0" VerticalAlignment="Center" /></StackPanel>
            </Grid>
        </StackPanel></Border>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource DangerCard}" Margin="20,12,20,0" Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" /><ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0" Visibility="{Binding IsConflictVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,4,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock><Run Text="{Binding Title}" FontWeight="SemiBold" /><Run Text=" · " /><Run Text="{Binding ClientDisplayName}" /></TextBlock><TextBlock Style="{StaticResource CaptionText}" TextWrapping="Wrap"><Run Text="日期：" /><Run Text="{Binding DateText}" /><Run Text="；开始：" /><Run Text="{Binding StartText}" /><Run Text="；结束：" /><Run Text="{Binding EndText}" /><Run Text="；时长：" /><Run Text="{Binding DurationText}" /><Run Text="；" /><Run Text="{Binding CrossDayText}" /></TextBlock><TextBlock Style="{StaticResource CaptionText}"><Run Text="重叠：" /><Run Text="{Binding OverlapText}" /><Run Text="；地点：" /><Run Text="{Binding Location}" /><Run Text="；状态：" /><Run Text="{Binding StatusText}" /></TextBlock></StackPanel><Button Grid.Column="1" Content="打开冲突排期" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0" Command="{Binding DataContext.OpenConflictCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="打开冲突排期" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,8,0,0" Visibility="{Binding IsConflictVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="返回修改" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnToEditCommand}" /><Button Content="仍然保存" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding SaveAnywayCommand}" /><Button Content="标记允许重叠并保存" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding MarkOverlapAndSaveCommand}" /></WrapPanel></StackPanel></Border>
            <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentStepIndex}" Margin="24,12,24,16" MaxWidth="980" HorizontalAlignment="Center" Background="{DynamicResource WindowBackgroundBrush}" BorderThickness="0" ItemContainerStyle="{StaticResource HiddenEditorTabItem}">
                <TabItem Header="1 基础信息"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid x:Name="BookingEditorPrimaryFields"><Grid.ColumnDefinitions><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /><ColumnDefinition Width="132" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="项目名称 *" Margin="0,0,8,0" VerticalAlignment="Center" /><TextBox x:Name="TitleInput" Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="项目名称" />
                        <TextBlock Grid.Column="2" Text="客户或模特代号" Margin="20,0,8,0" VerticalAlignment="Center" AutomationProperties.HelpText="客户显示名称" /><TextBox Grid.Column="3" Text="{Binding ClientDisplayName}" AutomationProperties.Name="客户或模特代号" />
                        <TextBlock Grid.Row="1" Text="拍摄地点" Margin="0,10,0,0" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Location}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="拍摄类型 *" Margin="18,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding ShootingTypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedShootingType}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="拍摄状态 / 业务状态 *" Margin="0,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="关联单一项目" Margin="18,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="3" Text="内部备注" Margin="0,10,0,0" VerticalAlignment="Top" /><TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </Grid>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="2 时间、天气与提醒"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="开始日期 *" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><DatePicker x:Name="StartDateInput" Width="150" SelectedDate="{Binding StartDate}" AutomationProperties.Name="开始日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding StartTimeText}" /></StackPanel>
                        <TextBlock Grid.Column="2" Text="结束日期 *" Margin="18,0,0,0" VerticalAlignment="Center" /><StackPanel Grid.Column="3" Orientation="Horizontal"><DatePicker Width="150" SelectedDate="{Binding EndDate}" AutomationProperties.Name="结束日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding EndTimeText}" /></StackPanel>
                        <TextBlock Grid.Row="1" Text="拍摄时区 *" Margin="0,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding TimeZoneOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTimeZone}" Margin="0,10,18,0" ToolTip="界面按中国标准时间 UTC+8 显示；完整城市说明保存在此列表" /><CheckBox Grid.Row="1" Grid.Column="3" Content="全天排期" IsChecked="{Binding IsAllDay}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="拍摄地点" Margin="0,10,0,0" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Location}" Margin="0,10,18,0" AutomationProperties.Name="天气与排期拍摄地点" />
                        <CheckBox Grid.Row="2" Grid.Column="3" Content="允许排期重叠" IsChecked="{Binding AllowOverlap}" Margin="0,10,0,0" />
                    </Grid>
                    <TextBlock Text="具体拍摄要求" FontWeight="SemiBold" Margin="0,16,0,5" /><TextBox Text="{Binding ShootingRequirements}" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap" />
                    <TextBlock Text="准备说明" FontWeight="SemiBold" Margin="0,12,0,5" /><TextBox Text="{Binding PreparationNotes}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" />
                    <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><views:ShootRequirementsPanel DataContext="{Binding Requirements}" /></Border>
                    <views:BookingWeatherPanel DataContext="{Binding Weather}" Margin="0,12,0,0" Visibility="{Binding HasWeatherPanel, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Border Margin="0,12,0,0"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource InfoCard}"><Style.Triggers><DataTrigger Binding="{Binding HasWeatherPanel}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
                        <TextBlock Text="天气预览" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WeatherPreviewText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="天气风险" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding WeatherRiskText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock Text="提醒设置" FontWeight="SemiBold" Margin="0,10,0,0" />
                        <TextBlock Text="{Binding ReminderSummaryText}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel></Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="3 策划资料"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <TextBlock Text="拍摄策划与资料" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="支持多选和拖入；默认仅关联原位置。创建排期前只暂存选择，排期提交成功后才写入资料关联；复制失败会保留待处理状态。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <views:BookingDocumentsPanel DataContext="{Binding Documents}" />
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="4 人员与收支"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid><TextBlock Text="联系人" FontSize="17" FontWeight="SemiBold" /><Button Content="＋ 添加联系人" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding AddContactCommand}" /></Grid>
                    <ItemsControl ItemsSource="{Binding Contacts}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><Grid><TextBlock Text="联系人卡片" FontWeight="SemiBold" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><CheckBox Content="主要联系人" IsChecked="{Binding IsPrimary}" Margin="0,0,8,0" /><Button Content="移除" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></StackPanel></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="客户或模特姓名 / 代号" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding DisplayName}" AutomationProperties.Name="联系人姓名或代号" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="手机" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Phone}" AutomationProperties.Name="联系人手机" /></StackPanel><StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="微信" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding WeChat}" AutomationProperties.Name="联系人微信" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><TextBlock Text="邮箱" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Email}" AutomationProperties.Name="联系人邮箱" /></StackPanel><StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="其他联系方式" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding OtherContact}" AutomationProperties.Name="联系人其他联系方式" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"><TextBlock Text="联系人备注" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Note}" AutomationProperties.Name="联系人备注" /></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Grid Margin="0,14,0,0"><TextBlock Text="工作人员" FontSize="17" FontWeight="SemiBold" /><Button Content="＋ 添加工作人员" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding AddStaffCommand}" /></Grid>
                    <ItemsControl ItemsSource="{Binding Staff}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><StackPanel><Grid><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding DisplayName, TargetNullValue=工作人员}" FontWeight="SemiBold" /><TextBlock Text=" · " Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding SelectedRole.Label}" Style="{StaticResource CaptionText}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="↑" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding DataContext.MoveStaffUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="上移工作人员" /><Button Content="↓" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding DataContext.MoveStaffDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="下移工作人员" /><Button Content="移除" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Command="{Binding DataContext.RemoveStaffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></StackPanel></Grid><Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="工作人员姓名或代号" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding DisplayName}" AutomationProperties.Name="工作人员姓名或代号" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="角色" Style="{StaticResource CaptionText}" /><ComboBox ItemsSource="{Binding DataContext.StaffRoleOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRole}" AutomationProperties.Name="工作人员角色" /></StackPanel><StackPanel Grid.Row="1" Margin="0,8,0,0"><TextBlock Text="到场时间" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding ArrivalTimeText}" ToolTip="例如 2026-08-06 08:30" AutomationProperties.Name="工作人员到场时间" /></StackPanel><StackPanel Grid.Row="1" Grid.Column="2" Margin="0,8,0,0"><TextBlock Text="手机" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Phone}" AutomationProperties.Name="工作人员手机" /></StackPanel><StackPanel Grid.Row="2" Margin="0,8,0,0"><TextBlock Text="微信" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding WeChat}" AutomationProperties.Name="工作人员微信" /></StackPanel><StackPanel Grid.Row="2" Grid.Column="2" Margin="0,8,0,0"><TextBlock Text="邮箱" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Email}" AutomationProperties.Name="工作人员邮箱" /></StackPanel><StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0"><TextBlock Text="工作人员备注" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding Note}" AutomationProperties.Name="工作人员备注" /></StackPanel></Grid></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><StackPanel><TextBlock Text="排期金额摘要" FontWeight="SemiBold" /><TextBlock Text="标记已拍摄或已交付不会自动假设收款状态；收入与支出需由用户在“收支”模块明确记录。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="拍摄总金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding TotalAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="定金（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding DepositAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="已收金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><Grid Margin="0,9,0,0"><TextBlock><Run Text="{Binding BalanceLabel, Mode=OneWay}" /><Run Text="：" /><Run Text="{Binding BalanceText, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding MoneyWarningText, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" Visibility="{Binding HasMoneyWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><StackPanel Orientation="Horizontal"><Button Content="上一步" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousStepCommand}" Visibility="{Binding CanGoPrevious, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Content="下一步" Style="{StaticResource SecondaryButton}" Command="{Binding NextStepCommand}" Margin="7,0,0,0" Visibility="{Binding CanGoNext, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" /><Button Content="保存草稿" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SaveDraftCommand}" /><Button Content="{Binding PrimarySaveText}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SaveCommand}" Visibility="{Binding IsFinalStep, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="创建或保存排期" /></StackPanel></Grid></Border>
    </Grid>
</UserControl>
