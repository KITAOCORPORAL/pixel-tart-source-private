<UserControl x:Class="RAWSelectionAssistant.Views.ShootBookingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="拍摄排期分步编辑器" AutomationProperties.HelpText="四步编辑基础信息、时间准备、策划资料、联系人工作人员和收支">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14"><Grid><StackPanel><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding StepTitle}" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="1 基础" Margin="0,0,14,0" /><TextBlock Text="2 准备" Margin="0,0,14,0" /><TextBlock Text="3 资料" Margin="0,0,14,0" /><TextBlock Text="4 人员与收支" /></StackPanel></Grid></Border>
        <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border Style="{StaticResource DangerCard}" Margin="20,12,20,0" Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" /><WrapPanel Margin="0,8,0,0" Visibility="{Binding IsConflictVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><Button Content="返回修改" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnToEditCommand}" /><Button Content="仍然保存" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding SaveAnywayCommand}" /><Button Content="标记允许重叠并保存" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding MarkOverlapAndSaveCommand}" /></WrapPanel></StackPanel></Border>
            <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentStepIndex}" Margin="20,10,20,12" Background="Transparent" BorderThickness="0">
                <TabItem Header="1 基础信息"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="项目名称 *" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="项目名称" />
                        <TextBlock Grid.Column="2" Text="客户或模特代号（客户显示名称）" Margin="18,0,0,0" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding ClientDisplayName}" AutomationProperties.Name="客户或模特代号" />
                        <TextBlock Grid.Row="1" Text="拍摄地点" Margin="0,10,0,0" VerticalAlignment="Center" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Location}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="拍摄类型 *" Margin="18,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="3" ItemsSource="{Binding ShootingTypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedShootingType}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Text="拍摄状态 / 业务状态 *" Margin="0,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="关联单一项目" Margin="18,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="3" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject}" Margin="0,10,0,0" />
                        <TextBlock Grid.Row="3" Text="内部备注" Margin="0,10,0,0" VerticalAlignment="Top" /><TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Notes}" AcceptsReturn="True" MinHeight="90" TextWrapping="Wrap" Margin="0,10,0,0" />
                    </Grid>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="2 时间与准备"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="开始日期 *" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Orientation="Horizontal"><DatePicker Width="150" SelectedDate="{Binding StartDate}" AutomationProperties.Name="开始日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding StartTimeText}" /></StackPanel>
                        <TextBlock Grid.Column="2" Text="结束日期 *" Margin="18,0,0,0" VerticalAlignment="Center" /><StackPanel Grid.Column="3" Orientation="Horizontal"><DatePicker Width="150" SelectedDate="{Binding EndDate}" AutomationProperties.Name="结束日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding EndTimeText}" /></StackPanel>
                        <TextBlock Grid.Row="1" Text="拍摄时区 *" Margin="0,10,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding TimeZoneOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTimeZone}" Margin="0,10,18,0" ToolTip="界面按中国标准时间 UTC+8 显示；完整城市说明保存在此列表" /><CheckBox Grid.Row="1" Grid.Column="3" Content="全天排期" IsChecked="{Binding IsAllDay}" Margin="0,10,0,0" />
                        <CheckBox Grid.Row="2" Grid.Column="1" Content="允许排期重叠" IsChecked="{Binding AllowOverlap}" Margin="0,10,0,0" />
                    </Grid>
                    <TextBlock Text="具体拍摄要求" FontWeight="SemiBold" Margin="0,16,0,5" /><TextBox Text="{Binding ShootingRequirements}" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap" />
                    <TextBlock Text="准备说明" FontWeight="SemiBold" Margin="0,12,0,5" /><TextBox Text="{Binding PreparationNotes}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" />
                    <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><views:ShootRequirementsPanel DataContext="{Binding Requirements}" /></Border>
                    <Border Style="{StaticResource InfoCard}" Margin="0,12,0,0"><TextBlock Text="天气与提醒是辅助信息：天气失败不会阻止保存；提醒默认关闭，需在保存后的排期详情中明确启用。" TextWrapping="Wrap" /></Border>
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="3 策划资料"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <TextBlock Text="拍摄策划与资料" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="支持多选和拖入；默认仅关联原位置。新排期先保存基础信息，再从详情继续添加与预览，避免未落库记录产生孤立文件关系。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                    <views:BookingDocumentsPanel DataContext="{Binding Documents}" />
                </StackPanel></ScrollViewer></TabItem>
                <TabItem Header="4 联系人、工作人员与收支"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="8">
                    <Grid><TextBlock Text="联系人" FontSize="17" FontWeight="SemiBold" /><Button Content="＋ 添加联系人" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding AddContactCommand}" /></Grid>
                    <ItemsControl ItemsSource="{Binding Contacts}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBox Text="{Binding DisplayName}" ToolTip="客户或模特姓名/代号" AutomationProperties.Name="联系人姓名或代号" /><TextBox Grid.Column="1" Text="{Binding Phone}" Margin="8,0,0,0" ToolTip="手机" /><TextBox Grid.Column="2" Text="{Binding WeChat}" Margin="8,0,0,0" ToolTip="微信" /><Button Grid.Column="3" Content="移除" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Margin="8,0,0,0" Command="{Binding DataContext.RemoveContactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /><TextBox Grid.Row="1" Text="{Binding Email}" Margin="0,8,0,0" ToolTip="邮箱" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding OtherContact}" Margin="8,8,0,0" ToolTip="其他联系方式" /><CheckBox Grid.Row="1" Grid.Column="2" Content="主要联系人" IsChecked="{Binding IsPrimary}" Margin="8,8,0,0" /><TextBox Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Note}" Margin="0,8,0,0" ToolTip="联系人备注" AutomationProperties.Name="联系人备注" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Grid Margin="0,14,0,0"><TextBlock Text="工作人员" FontSize="17" FontWeight="SemiBold" /><Button Content="＋ 添加工作人员" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" Command="{Binding AddStaffCommand}" /></Grid>
                    <ItemsControl ItemsSource="{Binding Staff}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource PanelBorder}" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBox Text="{Binding DisplayName}" ToolTip="工作人员姓名或代号" AutomationProperties.Name="工作人员姓名或代号" /><ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.StaffRoleOptions, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedRole}" Margin="8,0,0,0" /><TextBox Grid.Column="2" Text="{Binding ArrivalTimeText}" Margin="8,0,0,0" ToolTip="到场时间，例如 2026-08-06 08:30" /><StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0,0,0"><Button Content="↑" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding DataContext.MoveStaffUpCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="上移工作人员" /><Button Content="↓" Style="{StaticResource GhostButton}" Padding="6,2" Command="{Binding DataContext.MoveStaffDownCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" AutomationProperties.Name="下移工作人员" /><Button Content="移除" Style="{StaticResource GhostButton}" Foreground="{DynamicResource DangerBrush}" Command="{Binding DataContext.RemoveStaffCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" /></StackPanel><TextBox Grid.Row="1" Text="{Binding Phone}" Margin="0,8,0,0" ToolTip="手机" /><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WeChat}" Margin="8,8,0,0" ToolTip="微信" /><TextBox Grid.Row="1" Grid.Column="2" Text="{Binding Email}" Margin="8,8,0,0" ToolTip="邮箱" /><TextBox Grid.Row="2" Grid.ColumnSpan="3" Text="{Binding Note}" Margin="0,8,0,0" ToolTip="工作人员备注" AutomationProperties.Name="工作人员备注" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><StackPanel><TextBlock Text="排期金额摘要" FontWeight="SemiBold" /><TextBlock Text="标记已拍摄或已交付不会自动假设收款状态；收入与支出需由用户在“收支”模块明确记录。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,3,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="拍摄总金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding TotalAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="定金（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding DepositAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="已收金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid><Grid Margin="0,9,0,0"><TextBlock><Run Text="{Binding BalanceLabel, Mode=OneWay}" /><Run Text="：" /><Run Text="{Binding BalanceText, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding MoneyWarningText, Mode=OneWay}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" Visibility="{Binding HasMoneyWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer></TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><StackPanel Orientation="Horizontal"><Button Content="上一步" Style="{StaticResource SecondaryButton}" Command="{Binding PreviousStepCommand}" /><Button Content="下一步" Style="{StaticResource SecondaryButton}" Command="{Binding NextStepCommand}" Margin="7,0,0,0" /></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" /><Button Content="保存草稿" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SaveDraftCommand}" /><Button Content="保存排期" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SaveCommand}" /></StackPanel></Grid></Border>
    </Grid>
</UserControl>
