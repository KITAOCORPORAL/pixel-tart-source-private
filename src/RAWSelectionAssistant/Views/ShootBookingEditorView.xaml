<UserControl x:Class="RAWSelectionAssistant.Views.ShootBookingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             AutomationProperties.Name="拍摄排期编辑器" AutomationProperties.HelpText="编辑本地排期、准备清单和金额，不执行支付或文件操作">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <Grid Background="{DynamicResource WindowBackgroundBrush}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,14"><StackPanel><TextBlock Text="{Binding DialogTitle}" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="时间按所选时区保存为 UTC；金额只保存在当前电脑" Style="{StaticResource CaptionText}" Margin="0,4,0,0" /></StackPanel></Border>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="20">
            <Border Style="{StaticResource DangerCard}" Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding ValidationText}" TextWrapping="Wrap" /></Border>
            <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <TextBlock Text="项目名称 *" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="项目名称" />
                <TextBlock Grid.Column="2" Text="客户显示名称" Margin="18,0,0,0" VerticalAlignment="Center" /><TextBox Grid.Column="3" Text="{Binding ClientDisplayName}" AutomationProperties.Name="客户显示名称" />
                <TextBlock Grid.Row="1" Text="开始日期 *" Margin="0,9,0,0" VerticalAlignment="Center" /><StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,9,0,0"><DatePicker Width="150" SelectedDate="{Binding StartDate}" AutomationProperties.Name="开始日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding StartTimeText}" AutomationProperties.Name="开始时间" /></StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="结束日期 *" Margin="18,9,0,0" VerticalAlignment="Center" /><StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal" Margin="0,9,0,0"><DatePicker Width="150" SelectedDate="{Binding EndDate}" AutomationProperties.Name="结束日期" /><TextBox Width="78" Margin="6,0,0,0" Text="{Binding EndTimeText}" AutomationProperties.Name="结束时间" /></StackPanel>
                <TextBlock Grid.Row="2" Text="时区 *" Margin="0,9,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding TimeZoneOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedTimeZone}" Margin="0,9,0,0" AutomationProperties.Name="拍摄时区" />
                <CheckBox Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Content="全天排期（结束日期为不包含边界）" IsChecked="{Binding IsAllDay}" Margin="18,9,0,0" VerticalAlignment="Center" AutomationProperties.Name="全天排期" />
                <TextBlock Grid.Row="3" Text="拍摄地点" Margin="0,9,0,0" VerticalAlignment="Center" /><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Location}" Margin="0,9,0,0" AutomationProperties.Name="拍摄地点" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="拍摄类型 *" Margin="18,9,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="3" Grid.Column="3" ItemsSource="{Binding ShootingTypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedShootingType}" Margin="0,9,0,0" AutomationProperties.Name="拍摄类型" />
                <TextBlock Grid.Row="4" Text="拍摄状态 *" Margin="0,9,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" Margin="0,9,0,0" AutomationProperties.Name="拍摄状态" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="关联单一项目" Margin="18,9,0,0" VerticalAlignment="Center" /><ComboBox Grid.Row="4" Grid.Column="3" ItemsSource="{Binding ProjectOptions}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProject}" Margin="0,9,0,0" AutomationProperties.Name="关联单一项目" />
                <CheckBox Grid.Row="5" Grid.Column="1" Content="允许与其他排期重叠" IsChecked="{Binding AllowOverlap}" Margin="0,10,0,0" AutomationProperties.Name="允许排期重叠" />
            </Grid>

            <TextBlock Text="具体拍摄要求" FontWeight="SemiBold" Margin="0,18,0,5" /><TextBox Text="{Binding ShootingRequirements}" AcceptsReturn="True" MinHeight="74" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="具体拍摄要求" />
            <TextBlock Text="准备说明" FontWeight="SemiBold" Margin="0,14,0,5" /><TextBox Text="{Binding PreparationNotes}" AcceptsReturn="True" MinHeight="60" TextWrapping="Wrap" AutomationProperties.Name="准备说明" />
            <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><views:ShootRequirementsPanel DataContext="{Binding Requirements}" /></Border>

            <Border Style="{StaticResource PanelBorder}" Margin="0,14,0,0"><StackPanel><TextBlock Text="本地金额记录" FontWeight="SemiBold" /><TextBlock Text="金额采用整数最小货币单位保存；已收可以高于总额，软件只提示不自动修改" Style="{StaticResource CaptionText}" Margin="0,3,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="拍摄总金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding TotalAmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="拍摄总金额" /></StackPanel><StackPanel Grid.Column="1" Margin="10,0"><TextBlock Text="定金（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding DepositAmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="定金" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="已收金额（CNY）" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="已收金额" /></StackPanel></Grid><Grid Margin="0,9,0,0"><TextBlock><Run Text="{Binding BalanceLabel, Mode=OneWay}" /><Run Text="：" /><Run Text="{Binding BalanceText, Mode=OneWay}" /></TextBlock><TextBlock Text="{Binding MoneyWarningText}" Foreground="{DynamicResource DangerBrush}" HorizontalAlignment="Right" Visibility="{Binding HasMoneyWarning, Converter={StaticResource BooleanToVisibilityConverter}}" /></Grid></StackPanel></Border>
            <TextBlock Text="内部备注" FontWeight="SemiBold" Margin="0,14,0,5" /><TextBox Text="{Binding Notes}" AcceptsReturn="True" MinHeight="64" TextWrapping="Wrap" AutomationProperties.Name="内部备注" />

            <Border Style="{StaticResource WarningCard}" Margin="0,14,0,0" Visibility="{Binding IsConflictVisible, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="检测到时间冲突" FontWeight="SemiBold" /><ItemsControl ItemsSource="{Binding Conflicts}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /><ColumnDefinition Width="*" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{Binding ClientDisplayName}" /><TextBlock Grid.Column="2" Text="{Binding TimeText}" /><TextBlock Grid.Column="3" Text="{Binding Location}" /><TextBlock Grid.Column="4" Text="{Binding OverlapText}" /><TextBlock Grid.Column="5" Text="{Binding StatusText}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><WrapPanel Margin="0,10,0,0"><Button Content="返回修改" Style="{StaticResource SecondaryButton}" Command="{Binding ReturnToEditCommand}" /><Button Content="仍然保存" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding SaveAnywayCommand}" /><Button Content="标记允许重叠并保存" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding MarkOverlapAndSaveCommand}" /></WrapPanel></StackPanel></Border>
        </StackPanel></ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16"><Grid><TextBlock Text="Esc 取消并关闭" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" /><Button Content="保存排期" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding SaveCommand}" AutomationProperties.Name="保存排期" /></StackPanel></Grid></Border>
    </Grid>
</UserControl>
