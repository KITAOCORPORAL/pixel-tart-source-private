<UserControl x:Class="RAWSelectionAssistant.Views.SurfaceHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             x:Name="Root"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Border Style="{StaticResource ModalHeader}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="48" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource ModalTitleText}" />
                <TextBlock Text="{Binding Subtitle, ElementName=Root}" Style="{StaticResource CaptionText}"
                           Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <views:SurfaceCloseButton Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top"
                                      ToolTipText="{Binding CloseToolTip, ElementName=Root}"
                                      AutomationName="{Binding CloseAutomationName, ElementName=Root}"
                                      AutomationId="{Binding CloseAutomationId, ElementName=Root}"
                                      Visibility="{Binding ShowCloseButton, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Border>
</UserControl>
