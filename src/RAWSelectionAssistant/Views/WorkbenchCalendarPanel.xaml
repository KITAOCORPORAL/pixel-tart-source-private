<UserControl x:Class="RAWSelectionAssistant.Views.WorkbenchCalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
             AutomationProperties.Name="工作台右侧工作日历"
             AutomationProperties.HelpText="与完整工作日历共享同一排期数据源">
    <UserControl.Resources>
        <conv:ZeroIntToVisibilityConverter x:Key="ZeroIntToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="188" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="104" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="工作日历" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="打开完整日历" Style="{StaticResource GhostButton}" Margin="8,0,8,0" Padding="5,2" HorizontalAlignment="Left"
                    MinHeight="26" Click="OpenFullCalendar_Click" AutomationProperties.Name="打开完整工作日历" />
            <Button Grid.Column="2" Content="＋" Style="{StaticResource PrimaryButton}" Width="32" Height="30" Padding="0"
                    Command="{Binding NewBookingCommand}" ToolTip="新建拍摄排期" AutomationProperties.Name="新建拍摄排期" />
        </Grid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,2">
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="未拍摄" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" /><TextBlock Text="已拍摄" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" /><TextBlock Text="待返图" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
        </StackPanel>
        <Grid Grid.Row="2" Margin="0,3,0,4">
            <Button Content="‹" Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" HorizontalAlignment="Left" Command="{Binding PreviousCommand}" AutomationProperties.Name="上个月" />
            <Button Content="{Binding DisplayPeriod}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Command="{Binding TodayCommand}" ToolTip="返回今天" AutomationProperties.Name="返回今天" />
            <Button Content="›" Style="{StaticResource GhostButton}" Width="30" Height="28" Padding="0" HorizontalAlignment="Right" Command="{Binding NextCommand}" AutomationProperties.Name="下个月" />
        </Grid>
        <UniformGrid Grid.Row="3" Columns="7">
            <TextBlock Text="一" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="二" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="三" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="四" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="五" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="六" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="日" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
        </UniformGrid>
        <ItemsControl Grid.Row="4" ItemsSource="{Binding Month.Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="1" Padding="3" CornerRadius="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Focusable="True"
                            PreviewMouseLeftButtonDown="DayCell_MouseLeftButtonDown" PreviewKeyDown="DayCell_PreviewKeyDown" AutomationProperties.Name="{Binding AccessibilityName}" ToolTip="{Binding AccessibilityName}">
                        <Border.ContextMenu><ContextMenu><MenuItem Header="在此日期新建拍摄任务" Click="CreateBooking_Click" /><MenuItem Header="查看当天详情" Click="ViewDayDetails_Click" /></ContextMenu></Border.ContextMenu>
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.46" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid>
                            <TextBlock Text="{Binding DayNumber}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <Border CornerRadius="7" MinWidth="14" Height="14" Padding="3,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="{Binding HasBookings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding PrimaryBusinessState}" Value="已拍摄"><Setter Property="Background" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryBusinessState}" Value="待返图"><Setter Property="Background" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                <TextBlock Text="{Binding BookingCountText}" Foreground="White" FontSize="9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding HasBookings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Ellipse Width="7" Height="7" VerticalAlignment="Center" Tag="{Binding PrimaryStatusGlyph}"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /><Style.Triggers><DataTrigger Binding="{Binding PrimaryBusinessState}" Value="已拍摄"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}" /></DataTrigger><DataTrigger Binding="{Binding PrimaryBusinessState}" Value="待返图"><Setter Property="Fill" Value="{DynamicResource WarningBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse>
                                <TextBlock Text="{Binding ConflictGlyph}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" Margin="3,0,0,0" FontSize="10" />
                            </StackPanel>
                            <TextBlock Text="{Binding WeatherGlyph}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid Grid.Row="5" Margin="0,8,0,5">
            <TextBlock Text="{Binding DaySchedule.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="＋ 新建拍摄" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="5,2" MinHeight="26" Command="{Binding NewBookingCommand}" AutomationProperties.Name="为选中日期新建拍摄排期" />
        </Grid>
        <Grid Grid.Row="6">
            <TextBlock Text="当天暂无排期，双击日期或点击“新建拍摄”。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DaySchedule.Bookings.Count, Converter={StaticResource ZeroIntToVisibilityConverter}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding DaySchedule.Bookings}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="7,5" Margin="0,0,0,3" Command="{Binding DataContext.DaySchedule.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding StatusGlyph}" Margin="4,0,0,0" /></Grid>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
