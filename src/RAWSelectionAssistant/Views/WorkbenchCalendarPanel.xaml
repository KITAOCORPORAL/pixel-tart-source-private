<UserControl x:Class="RAWSelectionAssistant.Views.WorkbenchCalendarPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
             xmlns:models="clr-namespace:RAWSelectionAssistant.Core.Models;assembly=RAWSelectionAssistant.Core"
             AutomationProperties.Name="工作台右侧工作日历"
             AutomationProperties.HelpText="与完整工作日历共享同一排期数据源">
    <UserControl.Resources>
        <conv:ZeroIntToVisibilityConverter x:Key="ZeroIntToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid SnapsToDevicePixels="True" UseLayoutRounding="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="216" MinHeight="216" />
            <RowDefinition Height="Auto" MinHeight="40" />
            <RowDefinition Height="*" MinHeight="0" MaxHeight="64" />
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="工作日历" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="打开完整日历" Style="{StaticResource GhostButton}" Margin="8,0,8,0" Padding="5,2" HorizontalAlignment="Left"
                    MinHeight="26" Click="OpenFullCalendar_Click" AutomationProperties.Name="打开完整工作日历" />
            <Button Grid.Column="2" Content="＋" Style="{StaticResource PrimaryButton}" Width="32" Height="30" Padding="0"
                    Command="{Binding NewBookingCommand}" ToolTip="新建拍摄排期" AutomationProperties.Name="新建拍摄排期" />
        </Grid>
        <WrapPanel Grid.Row="1" Margin="0,7,0,2">
            <StackPanel Orientation="Horizontal" Margin="0,0,10,2"><Ellipse Width="7" Height="7" Fill="{DynamicResource CalendarStatusFreeBrush}" VerticalAlignment="Center" /><TextBlock Text="空闲" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,2"><Ellipse Width="7" Height="7" Fill="{DynamicResource CalendarStatusScheduledBrush}" VerticalAlignment="Center" /><TextBlock Text="有拍摄" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,10,2"><Ellipse Width="7" Height="7" Fill="{DynamicResource CalendarStatusPendingDeliveryBrush}" VerticalAlignment="Center" /><TextBlock Text="待返图" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,2"><Ellipse Width="7" Height="7" Fill="{DynamicResource CalendarStatusDeliveredBrush}" VerticalAlignment="Center" /><TextBlock Text="已返图" Style="{StaticResource CaptionText}" Margin="4,0,0,0" /></StackPanel>
        </WrapPanel>
        <Grid Grid.Row="2" Margin="0,2,0,2">
            <Button x:Name="PreviousMonthButton" Content="‹" Style="{StaticResource GhostButton}" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" HorizontalAlignment="Left" VerticalAlignment="Center" Command="{Binding PreviousCommand}" AutomationProperties.Name="上个月" />
            <Button Content="{Binding DisplayPeriod}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" Command="{Binding TodayCommand}" ToolTip="返回今天" AutomationProperties.Name="返回今天" />
            <Button x:Name="NextMonthButton" Content="›" Style="{StaticResource GhostButton}" Width="30" Height="30" MinWidth="30" MinHeight="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding NextCommand}" AutomationProperties.Name="下个月" />
        </Grid>
        <UniformGrid Grid.Row="3" Columns="7" VerticalAlignment="Center">
            <TextBlock Text="一" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="二" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="三" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="四" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="五" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" /><TextBlock Text="六" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
            <TextBlock Text="日" HorizontalAlignment="Center" Style="{StaticResource CaptionText}" />
        </UniformGrid>
        <ItemsControl x:Name="CalendarDaysGrid" Grid.Row="4" ItemsSource="{Binding Month.Days}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="7" Rows="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="CalendarDayCell" Margin="2" MinHeight="32" Padding="3" CornerRadius="5" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Focusable="True"
                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                            PreviewMouseLeftButtonDown="DayCell_MouseLeftButtonDown" PreviewKeyDown="DayCell_PreviewKeyDown" AutomationProperties.Name="{Binding AccessibilityName}" ToolTip="{Binding TooltipText}">
                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="在此日期新建拍摄任务"
                                          Command="{Binding PlacementTarget.Tag.Month.CreateBookingCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="查看当天详情"
                                          Command="{Binding PlacementTarget.Tag.ViewDayDetailsCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Border.ContextMenu>
                        <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource SurfacePrimaryBrush}" /><Style.Triggers>
                            <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False"><Setter Property="Opacity" Value="0.46" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderThickness" Value="2" /></DataTrigger>
                            <DataTrigger Binding="{Binding IsClosed}" Value="True"><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Opacity" Value="0.78" /></DataTrigger>
                        </Style.Triggers></Style></Border.Style>
                        <Grid>
                            <Border x:Name="DayNumberBadge" CornerRadius="5" MinWidth="24" Height="22" Padding="5,0" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{Binding TooltipText}">
                                <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{DynamicResource CalendarStatusFreeBrush}" /><Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers>
                                    <DataTrigger Binding="{Binding HasBookings}" Value="True"><Setter Property="Background" Value="{DynamicResource CalendarStatusScheduledBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusScheduledForegroundBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.PendingDelivery}"><Setter Property="Background" Value="{DynamicResource CalendarStatusPendingDeliveryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusPendingDeliveryForegroundBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.Delivered}"><Setter Property="Background" Value="{DynamicResource CalendarStatusDeliveredBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource CalendarStatusDeliveredForegroundBrush}" /></DataTrigger>
                                    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource CalendarTodayOutlineBrush}" /></DataTrigger>
                                </Style.Triggers></Style></Border.Style>
                                <TextBlock x:Name="DayNumberText" Text="{Binding DayNumber}" FontSize="12" FontWeight="SemiBold" LineHeight="16" LineStackingStrategy="BlockLineHeight" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusFreeForegroundBrush}" /><Style.Triggers>
                                        <DataTrigger Binding="{Binding HasBookings}" Value="True"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusScheduledForegroundBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.PendingDelivery}"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusPendingDeliveryForegroundBrush}" /></DataTrigger>
                                        <DataTrigger Binding="{Binding PrimaryWorkflowStatus}" Value="{x:Static models:CalendarWorkflowStatus.Delivered}"><Setter Property="Foreground" Value="{DynamicResource CalendarStatusDeliveredForegroundBrush}" /></DataTrigger>
                                    </Style.Triggers></Style></TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <Border CornerRadius="5" MinWidth="18" Height="18" Padding="3,1" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{DynamicResource SurfaceSecondaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" Visibility="{Binding HasMultipleBookings, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <TextBlock Text="{Binding BookingCountBadgeText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="9" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="{Binding ConflictGlyph}" Foreground="{DynamicResource DangerBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="10" />
                            <TextBlock Text="{Binding WeatherGlyph}" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                            <Path Width="10" Height="10" Stretch="Uniform" Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Top" Data="M5,10 L5,7 C5,3 11,3 11,7 L11,10 M3,10 L13,10 13,17 3,17 Z" Visibility="{Binding IsClosed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Grid x:Name="DayDetailsHeader" Grid.Row="5" Margin="0,16,0,4">
            <TextBlock Text="{Binding DaySchedule.Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Content="＋ 新建拍摄" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" Padding="5,2" MinHeight="26" Command="{Binding NewBookingCommand}" AutomationProperties.Name="为选中日期新建拍摄排期" />
        </Grid>
        <Grid Grid.Row="6">
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock Text="当天暂无排期，双击日期或点击“新建拍摄”。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding DaySchedule.Bookings.Count, Converter={StaticResource ZeroIntToVisibilityConverter}}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding DaySchedule.VisibleBookings}"><ItemsControl.ItemTemplate><DataTemplate>
                <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Padding="7,5" Margin="0,0,0,3" Command="{Binding DataContext.DaySchedule.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibilityName}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="52" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" /><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding StatusGlyph}" Margin="4,0,0,0" /></Grid>
                </Button>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
            <Button Grid.Row="1" Content="{Binding DaySchedule.OverflowText}" Style="{StaticResource GhostButton}" Padding="2" HorizontalAlignment="Left" Click="OpenSelectedDayDetails_Click" Visibility="{Binding DaySchedule.OverflowCount, Converter={StaticResource ZeroIntToVisibilityConverter}}" AutomationProperties.Name="查看选中日期的完整排期" />
        </Grid>
    </Grid>
</UserControl>
