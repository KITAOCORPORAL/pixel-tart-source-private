<Window x:Class="RAWSelectionAssistant.Views.QuickToolsManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="快捷工具管理" Width="720" Height="480" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        AutomationProperties.Name="快捷工具管理窗口">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="快捷工具管理" Style="{StaticResource PageTitleText}"/><TextBlock Text="最多固定 3 个普通工具。可拖动已固定工具排序，工具箱始终可访问。" Style="{StaticResource CaptionText}" Margin="0,6,0,16"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="72"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="已固定工具" Style="{StaticResource SectionTitleText}"/><ListBox x:Name="PinnedList" Grid.Row="1" Margin="0,12,0,0" AllowDrop="True" PreviewMouseLeftButtonDown="PinnedList_MouseLeftButtonDown" PreviewMouseMove="PinnedList_MouseMove" DragOver="PinnedList_DragOver" Drop="PinnedList_Drop" AutomationProperties.Name="已固定快捷工具"/></Grid></Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0"><Button Content="←" Style="{StaticResource SecondaryButton}" Click="Add_Click" ToolTip="添加到快捷工具"/><Button Content="→" Style="{StaticResource SecondaryButton}" Click="Remove_Click" Margin="0,8,0,0" ToolTip="从快捷工具移除"/><Button Content="↑" Style="{StaticResource SecondaryButton}" Click="Up_Click" Margin="0,24,0,0" ToolTip="向左移动"/><Button Content="↓" Style="{StaticResource SecondaryButton}" Click="Down_Click" Margin="0,8,0,0" ToolTip="向右移动"/></StackPanel>
            <Border Grid.Column="2" Style="{StaticResource PanelBorder}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="可添加工具" Style="{StaticResource SectionTitleText}"/><ListBox x:Name="AvailableList" Grid.Row="1" Margin="0,12,0,0" AutomationProperties.Name="可添加快捷工具"/></Grid></Border>
        </Grid>
        <Grid Grid.Row="2" Margin="0,18,0,0"><Button Content="恢复默认" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Click="Reset_Click"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="取消" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/><Button Content="保存" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="Save_Click"/></StackPanel></Grid>
    </Grid>
</Window>
