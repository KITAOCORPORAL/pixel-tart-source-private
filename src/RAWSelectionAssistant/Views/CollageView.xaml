<UserControl x:Class="RAWSelectionAssistant.Views.CollageView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1100" d:DesignHeight="720"
             AutomationProperties.Name="拼图页面">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="选择 2 至 6 张模板并预览画布参数；真实导出能力尚未启用。"
                           Style="{StaticResource CaptionText}" Margin="0,7,0,18" />
            </StackPanel>
            <Button Content="导出拼图（开发中）" Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right" IsEnabled="False" AutomationProperties.Name="导出拼图，开发中" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="460" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource ToolPanelCard}" Background="{DynamicResource CanvasBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Width="64" Height="64" Stretch="Uniform" Stroke="{DynamicResource TextTertiaryBrush}"
                          StrokeThickness="1.4" Data="{StaticResource ToolIconCollage}" />
                    <TextBlock Text="拼图画布" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock Text="尚未导入图片 · 不会生成或修改文件" Style="{StaticResource CaptionText}"
                               HorizontalAlignment="Center" Margin="0,7,0,0" />
                    <Button Content="添加图片（开发中）" Style="{StaticResource SecondaryButton}"
                            IsEnabled="False" Margin="0,16,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="模板与参数" Style="{StaticResource SectionTitleText}" />
                        <TextBlock Text="图片数量" Style="{StaticResource CaptionText}" Margin="0,14,0,5" />
                        <ComboBox ItemsSource="{Binding TemplateCategories}"
                                  SelectedItem="{Binding SelectedTemplateCategory}"
                                  AutomationProperties.Name="拼图图片数量" />
                        <TextBlock Text="模板" Style="{StaticResource CaptionText}" Margin="0,14,0,5" />
                        <ComboBox ItemsSource="{Binding TemplateOptions}" SelectedIndex="0"
                                  AutomationProperties.Name="拼图模板" />
                        <TextBlock Text="背景颜色" Style="{StaticResource CaptionText}" Margin="0,14,0,5" />
                        <TextBox Text="{Binding BackgroundColor, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="拼图背景颜色" />
                        <TextBlock Text="边框" Style="{StaticResource CaptionText}" Margin="0,14,0,5" />
                        <Slider Minimum="0" Maximum="40" Value="8" AutomationProperties.Name="拼图边框" />
                        <TextBlock Text="间距" Style="{StaticResource CaptionText}" Margin="0,12,0,5" />
                        <Slider Minimum="0" Maximum="40" Value="8" AutomationProperties.Name="拼图间距" />
                        <TextBlock Text="圆角" Style="{StaticResource CaptionText}" Margin="0,12,0,5" />
                        <Slider Minimum="0" Maximum="32" Value="6" AutomationProperties.Name="拼图圆角" />
                        <Border Style="{StaticResource InfoCard}" Margin="0,16,0,0">
                            <TextBlock Text="此页面仅提供模板和参数壳子，不会伪造导出文件。"
                                       TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
