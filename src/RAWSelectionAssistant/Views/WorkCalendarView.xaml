<UserControl x:Class="RAWSelectionAssistant.Views.WorkCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             Loaded="WorkCalendarView_Loaded" Focusable="True"
             AutomationProperties.Name="工作日历" AutomationProperties.HelpText="管理本地拍摄排期，支持月、周、日视图和归档恢复">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBookingCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TodayCommand}" />
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding SetMonthViewCommand}" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding SetWeekViewCommand}" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding SetDayViewCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDetailsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <conv:StatusToTextConverter x:Key="StatusToTextConverter" />
        <Style x:Key="FilterToggleButton" TargetType="ToggleButton"><Setter Property="Padding" Value="12,7" /><Setter Property="MinHeight" Value="34" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Style.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger></Style.Triggers></Style>
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackgroundBrush}" Margin="20,16,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="工作日历" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="拍摄时间、地点、准备事项和本地金额记录集中管理" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="已归档" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleArchivedCommand}" AutomationProperties.Name="查看已归档排期" />
                <Button Content="＋ 新建排期" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding NewBookingCommand}" AutomationProperties.Name="新建拍摄排期" AutomationProperties.HelpText="快捷键 Ctrl+N" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="12" Margin="0,14,0,18">
            <Grid x:Name="CalendarToolbar" SizeChanged="CalendarToolbar_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel x:Name="CalendarViewGroup" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="日历视图组">
                <ComboBox Width="118" ItemsSource="{Binding PresentationOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPresentation}" AutomationProperties.Name="工作日历视图" />
            </StackPanel>
            <Grid x:Name="CalendarDateNavigationGroup" Grid.Column="2" MinWidth="392" VerticalAlignment="Center" AutomationProperties.Name="年月导航组">
                <Grid.ColumnDefinitions><ColumnDefinition Width="36" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="‹" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Command="{Binding PreviousCommand}" AutomationProperties.Name="上一个周期" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="{Binding DisplayYear}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="76" TextAlignment="Center" />
                    <TextBlock Text="{Binding DisplayMonth}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" MinWidth="48" TextAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Content="›" Style="{StaticResource SecondaryButton}" Width="36" Padding="0" Command="{Binding NextCommand}" AutomationProperties.Name="下一个周期" />
                <Button Grid.Column="3" Content="今天" Style="{StaticResource SecondaryButton}" Margin="12,0,0,0" Command="{Binding TodayCommand}" AutomationProperties.Name="回到今天" AutomationProperties.HelpText="今日；快捷键 Ctrl+T" />
            </Grid>
            <StackPanel x:Name="CalendarFilterSearchGroup" Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="日历筛选与搜索组">
                <ComboBox Width="118" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="拍摄状态筛选" />
                <Grid Width="270" Margin="10,0,0,0" AutomationProperties.HelpText="搜索排期"><TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="搜索项目、客户、地点或拍摄内容" AutomationProperties.Name="搜索工作日历" AutomationProperties.HelpText="搜索词只用于本地查询且不写入日志，快捷键 Ctrl+F" /><TextBlock Text="搜索项目、客户、地点或拍摄内容" Foreground="{DynamicResource TextTertiaryBrush}" IsHitTestVisible="False" Margin="12,0" VerticalAlignment="Center"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                <ToggleButton x:Name="MoreFiltersButton" Content="更多筛选" Style="{StaticResource FilterToggleButton}" Margin="10,0,0,0" ToolTip="日期跳转、排序、类型、关闭档期和搜索范围" AutomationProperties.Name="更多日历筛选" />
            </StackPanel>
            <Popup PlacementTarget="{Binding ElementName=MoreFiltersButton}" Placement="Bottom" VerticalOffset="6" IsOpen="{Binding IsChecked, ElementName=MoreFiltersButton}" StaysOpen="False" AllowsTransparency="True">
                <Border Style="{StaticResource PopupSurfaceBorder}" Padding="12" Width="310"><StackPanel>
                    <TextBlock Text="日历粒度" Style="{StaticResource CaptionText}" />
                    <UniformGrid Columns="3" Margin="0,4,0,10"><Button Content="月" Style="{StaticResource SecondaryButton}" Command="{Binding SetMonthViewCommand}" AutomationProperties.HelpText="Alt+1" /><Button Content="周" Style="{StaticResource SecondaryButton}" Margin="4,0" Command="{Binding SetWeekViewCommand}" AutomationProperties.HelpText="Alt+2" /><Button Content="日" Style="{StaticResource SecondaryButton}" Command="{Binding SetDayViewCommand}" AutomationProperties.HelpText="Alt+3" /></UniformGrid>
                    <TextBlock Text="日期跳转" Style="{StaticResource CaptionText}" /><DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Margin="0,4,0,10" AutomationProperties.Name="日期跳转" />
                    <TextBlock Text="详细状态" Style="{StaticResource CaptionText}" /><ComboBox ItemsSource="{Binding DetailedStatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedDetailedStatus}" Margin="0,4,0,10" AutomationProperties.Name="详细拍摄状态筛选" ToolTip="未拍摄；已拍摄；待发送选片 / 待选片 / 已选片；待精修 / 已精修 / 待交付；已返图；时间冲突；天气风险" />
                    <TextBlock Text="排序" Style="{StaticResource CaptionText}" /><ComboBox ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}" Margin="0,4,0,10" AutomationProperties.Name="工作日历排序" />
                    <TextBlock Text="拍摄类型" Style="{StaticResource CaptionText}" /><ComboBox ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedType}" Margin="0,4,0,10" AutomationProperties.Name="拍摄类型筛选" />
                    <TextBlock Text="搜索范围" Style="{StaticResource CaptionText}" /><ComboBox ItemsSource="{Binding SearchScopeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSearchScope}" Margin="0,4,0,0" AutomationProperties.Name="搜索范围" />
                </StackPanel></Border>
            </Popup>
            </Grid>
        </Border>

        <Expander Grid.Row="2" Header="四态工作流图例" IsExpanded="True" Margin="0,0,0,12" AutomationProperties.Name="四态工作流图例" AutomationProperties.HelpText="可折叠状态图例">
            <Border Style="{StaticResource PanelBorder}" Padding="10,7">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource CalendarStatusFreeBrush}" VerticalAlignment="Center" /><TextBlock Text="空闲" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource CalendarStatusScheduledBrush}" VerticalAlignment="Center" /><TextBlock Text="有拍摄" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,14,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource CalendarStatusPendingDeliveryBrush}" VerticalAlignment="Center" /><TextBlock Text="后期待处理" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal"><Ellipse Width="8" Height="8" Fill="{DynamicResource CalendarStatusDeliveredBrush}" VerticalAlignment="Center" /><TextBlock Text="已返图" Margin="4,0,0,0" /></StackPanel>
            </WrapPanel>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="60*" MinWidth="520" /><ColumnDefinition Width="8" /><ColumnDefinition Width="40*" MinWidth="320" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True">
                <Grid>
                    <views:MonthCalendarView DataContext="{Binding Month}" Visibility="{Binding DataContext.IsMonthView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:WeekCalendarView DataContext="{Binding Week}" Visibility="{Binding DataContext.IsWeekView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:DayCalendarView DataContext="{Binding Day}" Visibility="{Binding DataContext.IsDayView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="8" Visibility="{Binding IsListPresentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="当前周期拍摄列表" FontSize="16" FontWeight="SemiBold" Margin="16,14" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding CurrentDisplayItems}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StartText}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding ClientDisplayName}" Style="{StaticResource CaptionText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Location}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding StatusText}" /></Grid></Button>
                        </DataTemplate></ListBox.ItemTemplate></ListBox>
                    </Grid>
                    <Grid Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="8" Visibility="{Binding IsOverviewPresentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="22"><TextBlock Text="当前周期总览" FontSize="20" FontWeight="SemiBold" /><UniformGrid Columns="2" Margin="0,18,0,0"><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding UnshotCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="进行中" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding ShotCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="待确认" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding AwaitingReturnCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="后期待处理" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}"><StackPanel><TextBlock Text="{Binding DeliveredCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="已完成" Style="{StaticResource CaptionText}" /></StackPanel></Border></UniformGrid></StackPanel>
                    </Grid>
                    <Grid Visibility="{Binding IsGlobalSearch, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="全部未归档排期（每页50条）" FontSize="16" FontWeight="SemiBold" Margin="16,14" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding GlobalSearchDisplayItems}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StartText}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ClientDisplayName}" Style="{StaticResource CaptionText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Location}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding StatusText}" /></Grid></Button></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Content="加载更多" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,10" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMoreGlobalResults, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="加载更多未归档排期" />
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" AutomationProperties.Name="调整日历和当天详情宽度" />
            <Grid x:Name="DayDetailsHost" Grid.Column="2" Margin="12,0,0,0" Focusable="True">
                <views:DaySchedulePanel DataContext="{Binding DaySchedule}" />
                <views:ShootBookingDetailsView x:Name="DayDetailsPanel" Focusable="True" DataContext="{Binding Details}" Panel.ZIndex="5" Visibility="{Binding DataContext.IsDetailsOpen, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.ColumnSpan="3" Panel.ZIndex="30" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsArchivedPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:ArchivedBookingsView DataContext="{Binding Archived}" />
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,8,2,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
            <ProgressBar IsIndeterminate="True" Width="120" Height="3" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
