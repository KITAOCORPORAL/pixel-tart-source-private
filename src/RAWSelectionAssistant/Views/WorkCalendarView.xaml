<UserControl x:Class="RAWSelectionAssistant.Views.WorkCalendarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
             Loaded="WorkCalendarView_Loaded" Focusable="True"
             AutomationProperties.Name="工作日历" AutomationProperties.HelpText="管理本地拍摄排期，支持月、周、日视图和归档恢复">
    <UserControl.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewBookingCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding TodayCommand}" />
        <KeyBinding Key="D1" Modifiers="Alt" Command="{Binding SetMonthViewCommand}" />
        <KeyBinding Key="D2" Modifiers="Alt" Command="{Binding SetWeekViewCommand}" />
        <KeyBinding Key="D3" Modifiers="Alt" Command="{Binding SetDayViewCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PreviousCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDetailsCommand}" />
    </UserControl.InputBindings>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid Background="{DynamicResource ContentBackgroundBrush}" Margin="20,16,20,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="工作日历" Style="{StaticResource PageTitleText}" />
                <TextBlock Text="拍摄时间、地点、准备事项和本地金额记录集中管理" Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="已归档" Style="{StaticResource SecondaryButton}" Command="{Binding ToggleArchivedCommand}" AutomationProperties.Name="查看已归档排期" />
                <Button Content="＋ 新建排期" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Command="{Binding NewBookingCommand}" AutomationProperties.Name="新建拍摄排期" AutomationProperties.HelpText="快捷键 Ctrl+N" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="10" Margin="0,14,0,12">
            <WrapPanel VerticalAlignment="Center">
                <ComboBox Width="118" ItemsSource="{Binding PresentationOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedPresentation}" AutomationProperties.Name="工作日历视图" />
                <ComboBox Width="126" Margin="6,0,10,0" ItemsSource="{Binding SortOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSort}" AutomationProperties.Name="工作日历排序" />
                <Button Content="今日" Style="{StaticResource SecondaryButton}" Command="{Binding TodayCommand}" AutomationProperties.HelpText="快捷键 Ctrl+T" />
                <Button Content="‹" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding PreviousCommand}" AutomationProperties.Name="上一个周期" />
                <Button Content="›" Style="{StaticResource SecondaryButton}" Margin="4,0,12,0" Command="{Binding NextCommand}" AutomationProperties.Name="下一个周期" />
                <TextBlock Text="{Binding DisplayPeriod}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="210" />
                <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" Width="150" Margin="8,0" AutomationProperties.Name="日期跳转" />
                <Button Content="月" Style="{StaticResource SecondaryButton}" Command="{Binding SetMonthViewCommand}" AutomationProperties.HelpText="Alt+1" />
                <Button Content="周" Style="{StaticResource SecondaryButton}" Margin="4,0,0,0" Command="{Binding SetWeekViewCommand}" AutomationProperties.HelpText="Alt+2" />
                <Button Content="日" Style="{StaticResource SecondaryButton}" Margin="4,0,10,0" Command="{Binding SetDayViewCommand}" AutomationProperties.HelpText="Alt+3" />
                <ComboBox Width="118" ItemsSource="{Binding StatusOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedStatus}" AutomationProperties.Name="拍摄状态筛选" />
                <ComboBox Width="112" Margin="6,0,0,0" ItemsSource="{Binding TypeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedType}" AutomationProperties.Name="拍摄类型筛选" />
                <TextBox x:Name="SearchBox" Width="190" Margin="8,0,0,0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=250}" ToolTip="搜索项目、客户、地点、类型、要求或备注" AutomationProperties.Name="搜索排期" AutomationProperties.HelpText="搜索词只用于本地查询且不写入日志，快捷键 Ctrl+F" />
                <ComboBox Width="160" Margin="6,0,0,0" ItemsSource="{Binding SearchScopeOptions}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedSearchScope}" AutomationProperties.Name="搜索范围" />
            </WrapPanel>
        </Border>

        <Expander Grid.Row="2" Header="状态图例" IsExpanded="True" Margin="0,0,0,10" AutomationProperties.Name="可折叠状态图例">
            <Border Style="{StaticResource PanelBorder}" Padding="10,7">
            <WrapPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="未拍摄" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" /><TextBlock Text="已拍摄" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" /><TextBlock Text="待发送选片 / 待选片 / 已选片" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource WarningBrush}" VerticalAlignment="Center" /><TextBlock Text="待精修 / 已精修 / 待交付" Margin="4,0,0,0" /></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"><Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" /><TextBlock Text="已交付" Margin="4,0,0,0" /></StackPanel>
                <TextBlock Text="× 已取消   ↷ 已延期   ! 时间冲突   ☁ 天气风险   关闭档期" Style="{StaticResource CaptionText}" VerticalAlignment="Center" />
            </WrapPanel>
            </Border>
        </Expander>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="65*" MinWidth="520" /><ColumnDefinition Width="8" /><ColumnDefinition Width="35*" MinWidth="320" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Padding="0" ClipToBounds="True">
                <Grid>
                    <views:MonthCalendarView DataContext="{Binding Month}" Visibility="{Binding DataContext.IsMonthView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:WeekCalendarView DataContext="{Binding Week}" Visibility="{Binding DataContext.IsWeekView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <views:DayCalendarView DataContext="{Binding Day}" Visibility="{Binding DataContext.IsDayView, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <Grid Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="8" Visibility="{Binding IsListPresentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <TextBlock Text="当前周期拍摄列表" FontSize="16" FontWeight="SemiBold" Margin="16,14" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding CurrentItems}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate>
                            <Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"><Grid Margin="8"><Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="100" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StartAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding ClientDisplayName}" Style="{StaticResource CaptionText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Location, TargetNullValue=未填写地点}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" /></Grid></Button>
                        </DataTemplate></ListBox.ItemTemplate></ListBox>
                    </Grid>
                    <Grid Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="8" Visibility="{Binding IsOverviewPresentation, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Margin="22"><TextBlock Text="当前周期总览" FontSize="20" FontWeight="SemiBold" /><UniformGrid Columns="2" Margin="0,18,0,0"><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,8,8"><StackPanel><TextBlock Text="{Binding UnshotCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="未拍摄" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding ShotCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="已拍摄" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}" Margin="0,0,8,0"><StackPanel><TextBlock Text="{Binding AwaitingReturnCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="待返图" Style="{StaticResource CaptionText}" /></StackPanel></Border><Border Style="{StaticResource DashboardPanelCard}"><StackPanel><TextBlock Text="{Binding DeliveredCount}" FontSize="30" FontWeight="SemiBold" /><TextBlock Text="已交付" Style="{StaticResource CaptionText}" /></StackPanel></Border></UniformGrid></StackPanel>
                    </Grid>
                    <Grid Visibility="{Binding IsGlobalSearch, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource SurfacePrimaryBrush}" Panel.ZIndex="10">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <TextBlock Text="全部未归档排期（每页50条）" FontSize="16" FontWeight="SemiBold" Margin="16,14" />
                        <ListBox Grid.Row="1" ItemsSource="{Binding GlobalSearchResults}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate><DataTemplate><Button Style="{StaticResource GhostButton}" HorizontalContentAlignment="Stretch" Command="{Binding DataContext.OpenBookingCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}"><Grid Margin="6"><Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StartAtUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ClientDisplayName}" Style="{StaticResource CaptionText}" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding Location, TargetNullValue=未填写地点}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding Status, Converter={StaticResource StatusToTextConverter}}" /></Grid></Button></DataTemplate></ListBox.ItemTemplate>
                        </ListBox>
                        <Button Grid.Row="2" Content="加载更多" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Center" Margin="0,10" Command="{Binding LoadMoreCommand}" Visibility="{Binding HasMoreGlobalResults, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.Name="加载更多未归档排期" />
                    </Grid>
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" AutomationProperties.Name="调整日历和当天详情宽度" />
            <Grid Grid.Column="2" Margin="12,0,0,0">
                <views:DaySchedulePanel DataContext="{Binding DaySchedule}" />
                <views:ShootBookingDetailsView DataContext="{Binding Details}" Panel.ZIndex="5" Visibility="{Binding DataContext.IsDetailsOpen, RelativeSource={RelativeSource AncestorType={x:Type views:WorkCalendarView}}, Converter={StaticResource BooleanToVisibilityConverter}}" />
            </Grid>

            <Border Grid.ColumnSpan="3" Panel.ZIndex="30" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Visibility="{Binding IsArchivedPaneOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:ArchivedBookingsView DataContext="{Binding Archived}" />
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="2,8,2,0">
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource CaptionText}" />
            <ProgressBar IsIndeterminate="True" Width="120" Height="3" HorizontalAlignment="Right" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
        </Grid>
    </Grid>
</UserControl>
