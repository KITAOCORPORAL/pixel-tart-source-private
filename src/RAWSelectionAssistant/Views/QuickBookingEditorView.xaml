<UserControl x:Class="RAWSelectionAssistant.Views.QuickBookingEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             AutomationProperties.Name="拍摄快速编辑器"
             AutomationProperties.HelpText="只显示创建或快速修改拍摄所需的高频字段">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>
    <Grid MaxWidth="820">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="24,20,24,16">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{Binding QuickDialogTitle}" Style="{StaticResource ModalTitleText}" />
                    <TextBlock Text="{Binding QuickDescription}" Style="{StaticResource SecondaryBodyText}" Margin="0,4,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <Button Content="×" Style="{StaticResource GhostButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Command="{Binding CancelCommand}" AutomationProperties.Name="关闭拍摄快速编辑器" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="项目名称" Style="{StaticResource Av2FieldLabel}" />
                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             AutomationProperties.Name="项目名称" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Text="关联项目" Style="{StaticResource Av2FieldLabel}" />
                    <ComboBox ItemsSource="{Binding ProjectOptions}" SelectedItem="{Binding SelectedProject}" Margin="0,8,0,0"
                              AutomationProperties.Name="关联项目" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,16,0,0">
                    <TextBlock Text="客户 / 模特" Style="{StaticResource Av2FieldLabel}" />
                    <TextBox Text="{Binding ClientDisplayName, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             AutomationProperties.Name="客户或模特" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="拍摄日期" Style="{StaticResource Av2FieldLabel}" />
                    <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="0,8,0,0"
                                AutomationProperties.Name="拍摄日期" />
                </StackPanel>
                <Grid Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="开始" Style="{StaticResource Av2FieldLabel}" />
                        <TextBox Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="例如 09:00"
                                 AutomationProperties.Name="开始时间" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="结束" Style="{StaticResource Av2FieldLabel}" />
                        <TextBox Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" ToolTip="例如 11:00"
                                 AutomationProperties.Name="结束时间" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Text="地点" Style="{StaticResource Av2FieldLabel}" />
                    <TextBox Text="{Binding Location, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0"
                             AutomationProperties.Name="拍摄地点" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="2" Margin="0,16,0,0">
                    <TextBlock Text="状态" Style="{StaticResource Av2FieldLabel}" />
                    <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}" DisplayMemberPath="Label" Margin="0,8,0,0"
                              AutomationProperties.Name="拍摄状态" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="24,16">
            <Grid>
                <TextBlock Text="{Binding ValidationText}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap"
                           MaxWidth="360" VerticalAlignment="Center" Visibility="{Binding HasValidationError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="取消" Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}" />
                    <Button Content="{Binding ContinuePlanningText}" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0"
                            Command="{Binding ContinuePlanningCommand}" AutomationProperties.Name="保存并继续完整拍摄策划" />
                    <Button Content="{Binding QuickPrimarySaveText}" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"
                            Command="{Binding SaveCommand}" AutomationProperties.Name="创建或保存拍摄" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
