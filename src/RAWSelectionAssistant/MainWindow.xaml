                </ScrollViewer>

                <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBatchConvertPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left"><TextBlock Text="批量转档" Style="{StaticResource PageTitleText}" /><TextBlock Text="规划源文件格式、输出格式、色彩与尺寸参数。" Style="{StaticResource CaptionText}" Margin="0,7,0,18" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Style="{StaticResource ToolPanelCard}"><StackPanel><TextBlock Text="源文件" Style="{StaticResource SectionTitleText}" /><Button Content="添加源文件" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" /><TextBlock Text="支持格式将在转档引擎接入后显示。" Style="{StaticResource CaptionText}" Margin="0,12,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource ToolPanelCard}"><StackPanel><TextBlock Text="输出设置" Style="{StaticResource SectionTitleText}" /><TextBlock Text="输出格式" Style="{StaticResource CaptionText}" Margin="0,10,0,4" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="JPEG" /><ComboBoxItem Content="PNG" /><ComboBoxItem Content="TIFF" /></ComboBox><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="质量" Style="{StaticResource CaptionText}" /><TextBox Text="90" Margin="0,4,0,0" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="长边" Style="{StaticResource CaptionText}" /><TextBox Text="原始尺寸" Margin="0,4,0,0" /></StackPanel></Grid><TextBlock Text="色彩配置" Style="{StaticResource CaptionText}" Margin="0,10,0,4" /><ComboBox SelectedIndex="0"><ComboBoxItem Content="保留原 ICC" /><ComboBoxItem Content="转换为 sRGB" /></ComboBox></StackPanel></Border></Grid><Button Content="开始转换（开发中）" Style="{StaticResource PrimaryButton}" IsEnabled="False" HorizontalAlignment="Right" Margin="0,12,12,0" /></StackPanel>
                </ScrollViewer>

                <Grid Margin="28" Visibility="{Binding IsHistoryPage, Converter={StaticResource BooleanToVisibilityConverter}}"><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="项目历史" Style="{StaticResource PageTitleText}" /><TextBlock Text="免费版显示最近项目；专业版支持全部历史和批量处理。" Style="{StaticResource CaptionText}" Margin="0,6,0,16" /></StackPanel><Button Content="批量处理项目（专业版）" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Command="{Binding RunBatchCommand}" /></Grid><DataGrid Grid.Row="1" ItemsSource="{Binding ProjectHistory}" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="项目" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="110" /><DataGridTextColumn Header="选片" Binding="{Binding SelectionCount}" Width="90" /><DataGridTextColumn Header="匹配文件" Binding="{Binding MatchedFileCount}" Width="100" /><DataGridTextColumn Header="已复制" Binding="{Binding CopiedFileCount}" Width="90" /><DataGridTextColumn Header="最近更新" Binding="{Binding UpdatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="150" /><DataGridTemplateColumn Header="操作" Width="100"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="打开" Style="{StaticResource SecondaryButton}" Command="{Binding DataContext.ContinueProjectCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn></DataGrid.Columns></DataGrid></Grid>

                <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsActivationPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left"><TextBlock Text="授权与版本" Style="{StaticResource PageTitleText}" /><TextBlock Text="像素蛋挞 2.3.0 · 同一安装包提供免费版和专业版界面能力" Style="{StaticResource CaptionText}" Margin="0,6,0,18" /><Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="{Binding EditionLabel}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /><TextBlock Text="{Binding LicenseStatusMessage}" Margin="0,7,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding LicenseDeviceText}" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /><TextBlock Text="{Binding LicenseKeySuffixText}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding LicenseActivatedAtText}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding LicenseLastValidatedText}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding OfflineLicenseText}" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding LicenseOfflineRemainingText}" Style="{StaticResource CaptionText}" /><Border Style="{StaticResource WarningCard}" Margin="0,12,0,0" Padding="10"><TextBlock Text="{Binding ProductionLicenseConfigurationText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" /></Border></StackPanel></Border><TextBlock Text="激活专业版" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,8" /><TextBlock Text="激活码只加密保存在当前 Windows 用户下，日志仅记录尾号。未配置生产平台时免费版仍可正常使用。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" /><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="15" /><Button Grid.Column="1" Content="激活" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateLicenseCommand}" Margin="8,0,0,0" /></Grid><WrapPanel Margin="0,12,0,0"><Button Content="立即验证" Style="{StaticResource SecondaryButton}" Command="{Binding ValidateLicenseCommand}" /><Button Content="停用本机授权" Style="{StaticResource DangerButton}" Command="{Binding DeactivateLicenseCommand}" Margin="8,0,0,0" /><Button Content="打开购买页面" Style="{StaticResource SecondaryButton}" Command="{Binding PurchaseCommand}" Margin="8,0,0,0" /></WrapPanel></StackPanel>
                </ScrollViewer>

                <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSettingsPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel MaxWidth="980" HorizontalAlignment="Left"><TextBlock Text="设置" Style="{StaticResource PageTitleText}" /><TextBlock Text="外观更改即时生效并自动保存，不会重置当前项目或归片结果。" Style="{StaticResource CaptionText}" Margin="0,6,0,18" />
                        <Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="外观" Style="{StaticResource SectionTitleText}" /><Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="190" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="主题" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}" /><TextBlock Grid.Row="1" Text="强调色" VerticalAlignment="Center" Margin="0,10,0,0" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AccentOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedAccent}" Margin="0,10,0,0" /><TextBlock Grid.Row="2" Text="自定义颜色" VerticalAlignment="Center" Margin="0,10,0,0" /><Grid Grid.Row="2" Grid.Column="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBox Text="{Binding CustomAccentColor, UpdateSourceTrigger=PropertyChanged}" ToolTip="#RRGGBB" /><Button Grid.Column="1" Content="应用颜色" Style="{StaticResource SecondaryButton}" Command="{Binding ApplyCustomAccentCommand}" Margin="8,0,0,0" /><Border Grid.Column="2" Width="58" Height="28" HorizontalAlignment="Left" Margin="12,0,0,0" Background="{DynamicResource AccentBrush}" CornerRadius="6" ToolTip="当前强调色" /></Grid><TextBlock Grid.Row="3" Text="界面密度" VerticalAlignment="Center" Margin="0,10,0,0" /><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding DensityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedDensity}" Margin="0,10,0,0" /><TextBlock Grid.Row="4" Text="侧栏" VerticalAlignment="Center" Margin="0,10,0,0" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding SidebarOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSidebarMode}" Margin="0,10,0,0" /><TextBlock Grid.Row="5" Text="动效 / 字号" VerticalAlignment="Center" Margin="0,10,0,0" /><StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0"><ComboBox Width="220" ItemsSource="{Binding MotionOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedMotion}" /><ComboBox Width="220" Margin="10,0,0,0" ItemsSource="{Binding FontScaleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedFontScale}" /></StackPanel></Grid><Border Style="{StaticResource InfoCard}" Margin="0,16,0,0"><StackPanel><TextBlock Text="实时预览" FontWeight="SemiBold" /><TextBlock Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10"><Run Text="当前主题：" /><Run Text="{Binding ThemeSummary, Mode=OneWay}" /><Run Text="  ·  强调色：" /><Run Text="{Binding AccentPreviewHex, Mode=OneWay}" /></TextBlock><WrapPanel><Button Content="主要操作" Style="{StaticResource PrimaryButton}" /><Button Content="次要操作" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" /><Border Style="{StaticResource StatusBadge}" Margin="8,0,0,0"><TextBlock Text="状态标签" Foreground="{DynamicResource AccentBrush}" /></Border></WrapPanel></StackPanel></Border><Button Content="恢复默认外观" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,14,0,0" Command="{Binding ResetAppearanceCommand}" /></StackPanel></Border>
                        <Border Style="{StaticResource PanelBorder}" Margin="0,12,0,0"><StackPanel><TextBlock Text="输出与报告" Style="{StaticResource SectionTitleText}" /><TextBlock Text="只影响新建项目的初始选择；当前项目中修改不会反写此处。" Style="{StaticResource CaptionText}" Margin="0,6,0,12" /><CheckBox Content="默认导出匹配报告" IsChecked="{Binding DefaultExportReports}" /><TextBlock Text="开启后，新建项目会默认勾选自动导出报告。" Style="{StaticResource CaptionText}" Margin="22,4,0,10" /><TextBlock Text="默认报告类型" FontWeight="SemiBold" Margin="0,2,0,6" /><StackPanel Margin="22,0,0,0"><CheckBox Content="CSV 报告" IsChecked="{Binding DefaultExportCsv}" /><CheckBox Content="JSON 报告（专业版）" IsChecked="{Binding DefaultExportJson}" Margin="0,6,0,0" /><CheckBox Content="操作日志 TXT（专业版）" IsChecked="{Binding DefaultExportLog}" Margin="0,6,0,0" /></StackPanel><Separator Margin="0,16,0,12" /><TextBlock Text="输出预设" Style="{StaticResource SectionTitleText}" /><TextBlock Text="保存当前输出方式与文件夹命名模板，供后续项目复用。" Style="{StaticResource CaptionText}" Margin="0,6,0,10" /><Button Content="保存当前输出预设（专业版）" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding SaveOutputPresetCommand}" /><ItemsControl ItemsSource="{Binding OutputPresets}" Margin="0,10,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name, StringFormat=• {0}}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Margin="28" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsHelpPage, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel MaxWidth="880" HorizontalAlignment="Left"><TextBlock Text="帮助" Style="{StaticResource PageTitleText}" /><TextBlock Text="四步完成归片：添加并扫描来源 → 导入客户编号 → 匹配检查 → 复制并导出报告。" Style="{StaticResource CaptionText}" Margin="0,6,0,18" /><Border Style="{StaticResource PanelBorder}"><StackPanel><TextBlock Text="客户 JPG 安全规则" Style="{StaticResource SectionTitleText}" /><TextBlock Text="客户发回的 JPG 默认只用于识别编号；正式 JPG 优先从照片来源目录查找。质量判断综合尺寸、元数据和文件特征，不仅依赖文件大小。" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border><Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0"><StackPanel><TextBlock Text="需要完整引导？" Style="{StaticResource SectionTitleText}" /><TextBlock Text="可以随时重新播放 22 步交互式教程，教程只使用独立演示文件。" TextWrapping="Wrap" Margin="0,7,0,10" /><Button x:Name="HelpButton" Content="打开帮助与教程" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding HelpCommand}" /></StackPanel></Border><Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0"><StackPanel><TextBlock Text="快捷键与反馈" Style="{StaticResource SectionTitleText}" /><TextBlock Text="Ctrl+B 展开或隐藏侧栏；Ctrl+Shift+F 打开建议与问题反馈。反馈邮件不会自动附带照片、项目、授权或日志信息。" TextWrapping="Wrap" Margin="0,7,0,10" /><Button Content="建议与问题反馈" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Command="{Binding FeedbackCommand}" /></StackPanel></Border><Button Content="打开日志文件夹" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0" Command="{Binding OpenLogDirectoryCommand}" /></StackPanel></ScrollViewer>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Height="34" Background="{DynamicResource SurfacePrimaryBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" UseLayoutRounding="True" SnapsToDevicePixels="True">
            <Grid Margin="18,0"><TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" /><TextBlock Text="{Binding CurrentItem}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="720" /><TextBlock Text="{Binding ProcessedCount, StringFormat=已处理 {0:N0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" /><ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}" Maximum="100" VerticalAlignment="Bottom" Height="3" /></Grid>
        </Border>

        <Border x:Name="SettingsModal" Grid.RowSpan="3" Panel.ZIndex="850" Background="{DynamicResource OverlayBrush}" Visibility="{Binding IsSettingsModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="720" Height="620" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{DynamicResource RaisedSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="0">
                <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.5" /></Border.Effect>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="58" /><RowDefinition Height="*" /><RowDefinition Height="58" /></Grid.RowDefinitions>
                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,0"><Grid><StackPanel VerticalAlignment="Center"><TextBlock Text="设置" FontSize="18" FontWeight="SemiBold" /><TextBlock Text="更改即时生效并自动保存" Style="{StaticResource CaptionText}" Margin="0,3,0,0" /></StackPanel><Button Style="{StaticResource GhostButton}" Width="34" Height="34" HorizontalAlignment="Right" Command="{Binding CloseSettingsCommand}" AutomationProperties.Name="关闭设置"><Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.6" Data="M1,1 L11,11 M11,1 L1,11" /></Button></Grid></Border>
                    <TabControl Grid.Row="1" Margin="18,14" Style="{StaticResource SettingsTabControlStyle}" ItemContainerStyle="{StaticResource SettingsTabItemStyle}">
                        <TabItem Header="常规"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="启动与工作区" Style="{StaticResource SectionTitleText}" /><CheckBox Content="启动后打开工作台" IsChecked="True" Margin="0,14,0,0" /><CheckBox Content="记住窗口尺寸和侧栏状态" IsChecked="True" Margin="0,10,0,0" /><TextBlock Text="默认窗口为 1600 × 920；窗口较窄时任务中心自动折叠。" Style="{StaticResource CaptionText}" Margin="0,14,0,0" TextWrapping="Wrap" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="外观"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><TextBlock Text="主题" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedTheme}" /><TextBlock Grid.Row="1" Text="强调色" VerticalAlignment="Center" Margin="0,12,0,0" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AccentOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedAccent}" Margin="0,12,0,0" /><TextBlock Grid.Row="2" Text="界面密度" VerticalAlignment="Center" Margin="0,12,0,0" /><ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding DensityOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedDensity}" Margin="0,12,0,0" /><TextBlock Grid.Row="3" Text="侧栏" VerticalAlignment="Center" Margin="0,12,0,0" /><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding SidebarOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSidebarMode}" Margin="0,12,0,0" /><TextBlock Grid.Row="4" Text="字号" VerticalAlignment="Center" Margin="0,12,0,0" /><ComboBox Grid.Row="4" Grid.Column="1" ItemsSource="{Binding FontScaleOptions}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedFontScale}" Margin="0,12,0,0" /></Grid><Border Style="{StaticResource InfoCard}" Margin="0,18,0,0"><TextBlock Text="深色工作台是默认设计稿；浅色与跟随系统保持相同布局结构。" TextWrapping="Wrap" /></Border></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="分片与归片"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="默认归片类别" Style="{StaticResource SectionTitleText}" /><ComboBox ItemsSource="{Binding CollectionCategories}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CollectionCategory}" Margin="0,12,0,0" /><TextBlock Text="来源 JPG 未找到时" Style="{StaticResource SectionTitleText}" Margin="0,22,0,0" /><ComboBox ItemsSource="{Binding CustomerJpegModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CustomerJpegMode}" Margin="0,12,0,0" /><TextBlock Text="客户 JPG 默认只用于识别编号，正式文件优先从照片来源目录查找。" Style="{StaticResource CaptionText}" Margin="0,10,0,0" TextWrapping="Wrap" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="输出与报告"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="报告默认行为" Style="{StaticResource SectionTitleText}" /><CheckBox Content="默认导出匹配报告" IsChecked="{Binding DefaultExportReports}" Margin="0,14,0,0" /><StackPanel Margin="22,12,0,0"><CheckBox Content="CSV 报告" IsChecked="{Binding DefaultExportCsv}" /><CheckBox Content="JSON 报告（专业版）" IsChecked="{Binding DefaultExportJson}" Margin="0,8,0,0" /><CheckBox Content="操作日志 TXT（专业版）" IsChecked="{Binding DefaultExportLog}" Margin="0,8,0,0" /></StackPanel><TextBlock Text="默认关闭；新任务可在输出交付页面单独开启。" Style="{StaticResource CaptionText}" Margin="0,14,0,0" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="工具默认值"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="批处理工具" Style="{StaticResource SectionTitleText}" /><TextBlock Text="批量压缩、水印、整理图片、重命名和转档目前提供可浏览的预览配置；未完成能力不会伪装为可执行。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" /><Button Content="打开完整工具箱" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding NavigateCommand}" CommandParameter="Toolbox" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="授权与版本"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="{Binding EditionLabel}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BrandDeepBrush}" /><TextBlock Text="{Binding LicenseStatusMessage}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,10,0,0" /><Border Style="{StaticResource WarningCard}" Margin="0,16,0,0"><TextBlock Text="{Binding ProductionLicenseConfigurationText}" TextWrapping="Wrap" /></Border><Button Content="查看授权与版本" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,18,0,0" Command="{Binding NavigateCommand}" CommandParameter="Activation" /></StackPanel></ScrollViewer></TabItem>
                        <TabItem Header="检查更新"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12,18"><TextBlock Text="像素蛋挞 2.3.0" Style="{StaticResource SectionTitleText}" /><TextBlock Text="当前版本为本地 WinExe 与 self-contained 安装包，不依赖独立后台服务。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,12,0,0" /><Button Content="检查更新（准备中）" Style="{StaticResource SecondaryButton}" IsEnabled="False" HorizontalAlignment="Left" Margin="0,18,0,0" /></StackPanel></ScrollViewer></TabItem>
                    </TabControl>
                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,0"><Grid><TextBlock Text="Esc 可关闭设置" Style="{StaticResource CaptionText}" VerticalAlignment="Center" /><Button Content="完成" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="96" Command="{Binding CloseSettingsCommand}" /></Grid></Border>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="1" Panel.ZIndex="900" Style="{StaticResource ToastCard}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0" Visibility="{Binding IsToastVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ToastMessage}" Foreground="{DynamicResource SurfacePrimaryBrush}" VerticalAlignment="Center" /><Button Content="关闭" Style="{StaticResource GhostButton}" Foreground="{DynamicResource SurfacePrimaryBrush}" Padding="8,2" MinHeight="24" Margin="10,0,0,0" Command="{Binding DismissToastCommand}" AutomationProperties.Name="关闭通知" /></StackPanel>
        </Border>

        <views:ReminderNotificationHost Grid.Row="1" Panel.ZIndex="920" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,22,0" DataContext="{Binding ReminderNotifications}" />

        <Canvas x:Name="TutorialOverlay" Grid.RowSpan="3" Panel.ZIndex="1000" Visibility="Collapsed" ClipToBounds="True">
            <Rectangle x:Name="TutorialMaskTop" Fill="{DynamicResource OverlayBrush}" /><Rectangle x:Name="TutorialMaskLeft" Fill="{DynamicResource OverlayBrush}" /><Rectangle x:Name="TutorialMaskRight" Fill="{DynamicResource OverlayBrush}" /><Rectangle x:Name="TutorialMaskBottom" Fill="{DynamicResource OverlayBrush}" />
            <Border x:Name="TutorialHighlight" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="3" CornerRadius="8" IsHitTestVisible="False"><Border.Effect><DropShadowEffect Color="#C98220" BlurRadius="18" ShadowDepth="0" Opacity="0.9" /></Border.Effect></Border>
            <Line x:Name="TutorialPointer" Stroke="{DynamicResource AccentBrush}" StrokeThickness="3" IsHitTestVisible="False" />
            <Border x:Name="TutorialCard" Width="390" Style="{StaticResource PanelBorder}" Padding="20"><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="5" Opacity="0.28" /></Border.Effect><StackPanel><TextBlock Text="{Binding TutorialStepProgress}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding TutorialTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" /><TextBlock Text="{Binding TutorialInstruction}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="22" /><Border Style="{StaticResource DangerCard}" Padding="9" Margin="0,12,0,0" Visibility="{Binding HasTutorialError, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="{Binding TutorialErrorMessage}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" /><WrapPanel Margin="0,8,0,0"><Button Content="重试当前步骤" Style="{StaticResource SecondaryButton}" Command="{Binding TutorialRetryCommand}" /><Button Content="重新创建教程数据" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding TutorialRecreateDataCommand}" /></WrapPanel></StackPanel></Border><Button x:Name="TutorialPrimaryButton" AutomationProperties.Name="{Binding TutorialPrimaryActionLabel}" Content="{Binding TutorialPrimaryActionLabel}" Style="{StaticResource PrimaryButton}" Margin="0,14,0,0" Visibility="{Binding ShowTutorialPrimaryAction, Converter={StaticResource BooleanToVisibilityConverter}}" Command="{Binding TutorialPrimaryCommand}" /><Grid Margin="0,14,0,0"><Button Content="返回上一步" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Command="{Binding TutorialBackCommand}" Visibility="{Binding TutorialCanGoBack, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Content="退出教程" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Command="{Binding TutorialExitCommand}" /></Grid></StackPanel></Border>
        </Canvas>
    </Grid>
</Window>
