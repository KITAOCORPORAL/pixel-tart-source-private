<Window x:Class="RAWSelectionAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:conv="clr-namespace:RAWSelectionAssistant.Converters"
        xmlns:views="clr-namespace:RAWSelectionAssistant.Views"
        mc:Ignorable="d" Title="像素蛋挞" Icon="Assets/AppIcon.ico"
        Width="1600" Height="920" MinWidth="1180" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        AllowDrop="True" Closing="Window_Closing" PreviewKeyDown="Window_PreviewKeyDown" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewProjectCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveProjectCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="F" Modifiers="Control+Shift" Command="{Binding FeedbackCommand}" />
        <KeyBinding Key="F1" Command="{Binding HelpCommand}" />
        <KeyBinding Key="Enter" Modifiers="Alt" Command="{Binding ShowDetailsCommand}" CommandParameter="{Binding SelectedSelection}" />
    </Window.InputBindings>
    <Window.Resources>
        <conv:StatusToTextConverter x:Key="StatusToTextConverter" />
        <conv:StatusToBrushConverter x:Key="StatusToBrushConverter" />
        <conv:ZeroIntToVisibilityConverter x:Key="ZeroIntToVisibilityConverter" />
        <conv:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="WorkbenchMenuStyle" TargetType="Menu"><Setter Property="Background" Value="{DynamicResource ShellTopBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /></Style>
        <Style x:Key="SettingsTabControlStyle" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <TabPanel IsItemsHost="True" Background="Transparent" />
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SettingsTabItemStyle" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SurfaceHoverBrush}" /></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource ToolAccentBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource ContentBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Style="{StaticResource WorkbenchMenuStyle}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <MenuItem Header="文件(_F)">
                <MenuItem Header="新建本地分片任务" Command="{Binding NavigateCommand}" CommandParameter="LocalSplit" />
                <MenuItem Header="新建归片项目" InputGestureText="Ctrl+N" Command="{Binding NewProjectCommand}" />
                <MenuItem Header="打开最近项目" Command="{Binding ContinueProjectCommand}" />
                <MenuItem Header="保存项目" InputGestureText="Ctrl+S" Command="{Binding SaveProjectCommand}" />
                <MenuItem Header="导入 TXT / 编号" Command="{Binding NavigateCommand}" CommandParameter="LocalSplit" />
                <Separator />
                <MenuItem Header="导出匹配报告" Command="{Binding ExportReportCommand}" />
                <MenuItem Header="打开输出文件夹" Command="{Binding OpenOutputCommand}" />
                <MenuItem Header="打开日志文件夹" Command="{Binding OpenLogDirectoryCommand}" />
                <Separator />
                <MenuItem Header="退出" InputGestureText="Alt+F4" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="项目(_P)">
                <MenuItem Header="工作台首页" Command="{Binding NavigateCommand}" CommandParameter="Workbench" />
                <MenuItem Header="本地分片" Command="{Binding NavigateCommand}" CommandParameter="LocalSplit" />
                <MenuItem Header="归片工作区" Command="{Binding NavigateCommand}" CommandParameter="Workflow" />
                <MenuItem Header="项目历史" Command="{Binding NavigateCommand}" CommandParameter="History" />
                <Separator />
                <MenuItem Header="清空当前任务" Command="{Binding ClearTaskCommand}" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
                <MenuItem Header="撤销" InputGestureText="Ctrl+Z" IsEnabled="False" ToolTip="当前页面没有可撤销的操作" />
                <MenuItem Header="重做" InputGestureText="Ctrl+Y" IsEnabled="False" ToolTip="当前页面没有可重做的操作" />
                <Separator />
                <MenuItem Header="复制" InputGestureText="Ctrl+C" IsEnabled="False" ToolTip="请在输入框中使用系统复制命令" />
                <MenuItem Header="粘贴编号" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                <MenuItem Header="查找" InputGestureText="Ctrl+F" Command="{Binding NavigateCommand}" CommandParameter="Workflow" />
                <Separator />
                <MenuItem Header="解析编号" Command="{Binding ParseTextCommand}" />
                <MenuItem Header="清空选片" Command="{Binding ClearSelectionsCommand}" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
                <MenuItem Header="跟随 Windows" Command="{Binding SetThemeCommand}" CommandParameter="System" />
                <MenuItem Header="浅色模式" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                <MenuItem Header="深色模式" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                <Separator />
                <MenuItem Header="显示侧边栏(_B)" IsCheckable="True" IsChecked="{Binding IsSidebarExpanded, Mode=OneWay}"
                          InputGestureText="Ctrl+B" Command="{Binding ToggleSidebarCommand}" />
                <MenuItem Header="紧凑模式" IsCheckable="True" IsChecked="{Binding IsCompactDensity, Mode=OneWay}" Command="{Binding ToggleCompactDensityCommand}" />
                <MenuItem Header="外观设置" Command="{Binding OpenSettingsCommand}" />
            </MenuItem>
            <MenuItem Header="工具(_T)" ItemsSource="{Binding ToolMenuItems}">
                <MenuItem.ItemContainerStyle>
                    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                        <Setter Property="Header" Value="{Binding EffectiveMenuLabel}" />
                        <Setter Property="ToolTip" Value="{Binding Description}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding EffectiveMenuLabel}" />
                        <Setter Property="Command" Value="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Menu}}" />
                        <Setter Property="CommandParameter" Value="{Binding TargetPageKey}" />
                        <Setter Property="IsEnabled" Value="{Binding IsAvailable}" />
                    </Style>
                </MenuItem.ItemContainerStyle>
            </MenuItem>
            <MenuItem Header="帮助(_H)">
                <MenuItem Header="新手教程" Command="{Binding HelpCommand}" />
                <MenuItem Header="快捷键" Command="{Binding NavigateCommand}" CommandParameter="Help" />
                <MenuItem Header="使用说明" Command="{Binding NavigateCommand}" CommandParameter="Help" />
                <MenuItem Header="建议与问题反馈(_F)" InputGestureText="Ctrl+Shift+F" Command="{Binding FeedbackCommand}" />
                <MenuItem Header="打开日志目录" Command="{Binding OpenLogDirectoryCommand}" />
                <Separator />
                <MenuItem Header="关于像素蛋挞" Command="{Binding NavigateCommand}" CommandParameter="Help" />
            </MenuItem>
        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="SidebarContainer" Width="{Binding SidebarWidth}"
                    MinWidth="{DynamicResource SidebarCollapsedWidth}"
                    Background="{DynamicResource SidebarBackgroundBrush}" BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="0,0,1,0" Padding="0,5,0,8" UseLayoutRounding="True" SnapsToDevicePixels="True">
                <Grid x:Name="SidebarLayout">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="10" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ScrollViewer x:Name="SidebarNavigationScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <TextBlock Text="工作台" Style="{StaticResource SidebarSectionLabel}" Margin="16,4,0,4" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="工作台" Tag="{StaticResource IconWorkbench}" Command="{Binding NavigateCommand}" CommandParameter="Workbench" ToolTip="工作台" AutomationProperties.Name="工作台">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsWorkbenchPage}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="归片工作区" Tag="{StaticResource IconWorkspace}" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Workflow" ToolTip="归片工作区" AutomationProperties.Name="归片工作区" />
                            <Button Content="工作日历" Tag="{StaticResource IconHistory}" Command="{Binding NavigateCommand}" CommandParameter="WorkCalendar" ToolTip="工作日历" AutomationProperties.Name="工作日历">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsWorkCalendarPage}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="联机拍摄" Tag="{StaticResource IconWorkspace}" Command="{Binding NavigateCommand}" CommandParameter="Tether" ToolTip="联机拍摄（看守文件夹）" AutomationProperties.Name="联机拍摄">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}"><Style.Triggers><DataTrigger Binding="{Binding IsTetherPage}" Value="True"><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                            <Button Content="项目历史" Tag="{StaticResource IconHistory}" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="History" ToolTip="项目历史" AutomationProperties.Name="项目历史" />
                            <Separator />
                            <TextBlock Text="应用" Style="{StaticResource SidebarSectionLabel}" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="授权与版本" Tag="{StaticResource IconLicense}" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Activation" ToolTip="授权与版本" AutomationProperties.Name="授权与版本" />
                            <Button x:Name="SidebarSettingsButton" Content="设置" Tag="{StaticResource IconSettings}" Style="{StaticResource SidebarNavButton}" Command="{Binding OpenSettingsCommand}" ToolTip="设置" AutomationProperties.Name="设置" />
                            <Button Content="帮助" Tag="{StaticResource IconHelp}" Style="{StaticResource SidebarNavButton}" Command="{Binding NavigateCommand}" CommandParameter="Help" ToolTip="帮助" AutomationProperties.Name="帮助" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2">
                        <Separator />
                        <Button Content="{Binding ToolboxEntry.DisplayName}"
                                Tag="{Binding ToolboxEntry.IconResourceKey, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                Style="{StaticResource SidebarNavButton}" Click="ToolboxQuickButton_Click"
                                ToolTip="{Binding ToolboxEntry.Description}"
                                AutomationProperties.Name="{Binding ToolboxEntry.DisplayName}" />
                        <Button Content="使用教程" Tag="{StaticResource IconHelp}" Style="{StaticResource SidebarNavButton}" Command="{Binding HelpCommand}" ToolTip="使用教程" AutomationProperties.Name="使用教程" />
                        <Button Content="问题反馈" Tag="{StaticResource IconRename}" Style="{StaticResource SidebarNavButton}" Command="{Binding FeedbackCommand}" ToolTip="建议与问题反馈" AutomationProperties.Name="建议与问题反馈" />
                    </StackPanel>
                    <Border x:Name="EditionStatusArea" Grid.Row="3" Style="{StaticResource SidebarEditionCard}" ToolTip="{Binding EditionLabel}" AutomationProperties.Name="版本状态">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="{Binding EditionLabel}" Foreground="{DynamicResource BrandDeepBrush}" FontSize="12" FontWeight="SemiBold" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Button Content="升级" Style="{StaticResource GhostButton}" Foreground="{DynamicResource BrandDeepBrush}" HorizontalAlignment="Right" Padding="5,2" MinHeight="24" Command="{Binding NavigateCommand}" CommandParameter="Activation" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Grid.Row="1" Text="授权服务准备中" Style="{StaticResource CaptionText}" FontSize="10" Margin="0,3,0,0" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <Ellipse Width="8" Height="8" Fill="{DynamicResource BrandPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </Grid>
                    </Border>
                    <Button x:Name="SidebarCollapseButton" Grid.Row="4" Command="{Binding ToggleSidebarCommand}" MinWidth="0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource SidebarNavButton}">
                                <Setter Property="Content" Value="收起侧栏" />
                                <Setter Property="Tag" Value="{StaticResource IconCollapse}" />
                                <Setter Property="ToolTip" Value="收起侧栏" />
                                <Setter Property="AutomationProperties.Name" Value="收起侧栏" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Content" Value="展开侧栏" />
                                        <Setter Property="Tag" Value="{StaticResource IconExpand}" />
                                        <Setter Property="ToolTip" Value="展开侧栏" />
                                        <Setter Property="AutomationProperties.Name" Value="展开侧栏" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="0" />
                <Grid Grid.Column="1">
                <views:WorkCalendarView DataContext="{Binding WorkCalendarPage}" Visibility="{Binding IsWorkCalendarPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <views:TetherCaptureView DataContext="{Binding TetherPage}" Visibility="{Binding IsTetherPage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                <Grid x:Name="WorkflowWorkspace" Margin="14" Visibility="{Binding IsWorkflowPage, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Style="{StaticResource PanelBorder}" Padding="10">
                        <Grid>
                            <TextBlock Text="{Binding WorkflowStepTitle}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="1  来源与索引" Style="{StaticResource WorkflowStepButton}" Command="{Binding GoToWorkflowStepCommand}" CommandParameter="1" />
                                <TextBlock Text="›" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                <Button Content="2  导入选片" Style="{StaticResource WorkflowStepButton}" Command="{Binding GoToWorkflowStepCommand}" CommandParameter="2" />
                                <TextBlock Text="›" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                <Button Content="3  匹配检查" Style="{StaticResource WorkflowStepButton}" Command="{Binding GoToWorkflowStepCommand}" CommandParameter="3" />
                                <TextBlock Text="›" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="20" VerticalAlignment="Center" />
                                <Button Content="4  输出交付" Style="{StaticResource WorkflowStepButton}" Command="{Binding GoToWorkflowStepCommand}" CommandParameter="4" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="340" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel>
                                <Border Style="{StaticResource PanelBorder}" Visibility="{Binding IsWorkflowStepOne, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,10"><TextBlock Text="照片来源目录" Style="{StaticResource SectionTitleText}" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="AddSourceButton" Content="添加" AutomationProperties.Name="添加照片来源目录" Style="{StaticResource SecondaryButton}" Command="{Binding AddSourceCommand}" /><Button x:Name="RemoveSourceButton" Content="删除" AutomationProperties.Name="删除来源目录" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding RemoveSourceCommand}" /><Button Content="清空" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding ClearSourcesCommand}" /></StackPanel></Grid>
                                        <ListBox ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" Height="108" DisplayMemberPath="DisplayLabel" />
                                        <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding SourceDirectoryTypes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding SelectedSourceDirectoryType}" ToolTip="设置所选目录用途" /><Button Grid.Column="1" Content="上移" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding MoveSourceUpCommand}" /><Button Grid.Column="2" Content="下移" Style="{StaticResource SecondaryButton}" Margin="6,0,0,0" Command="{Binding MoveSourceDownCommand}" /></Grid>
                                        <Button x:Name="ScanButton" Content="扫描照片文件" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0" Command="{Binding ScanCommand}" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Margin="0,10,0,0" Visibility="{Binding IsWorkflowStepOne, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="归片类别" Style="{StaticResource SectionTitleText}" />
                                        <ComboBox x:Name="CategorySelector" ItemsSource="{Binding CollectionCategories}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CollectionCategory}" Margin="0,9,0,0" />
                                        <Border Margin="0,9,0,0" Visibility="{Binding IsCustomCategory, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="目标扩展名" Style="{StaticResource CaptionText}" /><TextBox Text="{Binding CustomExtensionsText, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" /><TextBlock Text="{Binding CustomExtensionsError}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel></Border>
                                        <TextBlock Text="来源 JPG 未找到时" Style="{StaticResource CaptionText}" Margin="0,10,0,4" />
                                        <ComboBox ItemsSource="{Binding CustomerJpegModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding CustomerJpegMode}" />
                                        <Border x:Name="JpegQualityArea" Style="{StaticResource WarningCard}" Padding="9,7" Margin="0,8,0,0" Visibility="{Binding ShowCustomerJpegWarning, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="客户返回的 JPG 可能经过聊天软件压缩。软件会综合检查尺寸、文件大小和元数据，但不会仅凭文件大小判断原图。" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" /></Border>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Visibility="{Binding IsWorkflowStepTwo, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel>
                                        <TextBlock Text="客户选片" Style="{StaticResource SectionTitleText}" />
                                        <Border x:Name="CustomerDropArea" Style="{StaticResource InfoCard}" Padding="14" Margin="0,9,0,0"><StackPanel><TextBlock Text="客户发回的 JPG 默认只用于识别选片编号" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="正式 JPG 将优先从照片来源目录中查找" TextAlignment="Center" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" /><TextBlock Text="拖入 JPG、文件夹、TXT、CSV 或纯文本" TextAlignment="Center" Style="{StaticResource CaptionText}" Margin="0,5,0,0" /></StackPanel></Border>
                                        <TextBox Text="{Binding TextInput, UpdateSourceTrigger=PropertyChanged}" Height="88" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0" />
                                        <WrapPanel Margin="0,8,0,0"><Button x:Name="PasteButton" Content="粘贴编号" Style="{StaticResource SecondaryButton}" Command="{Binding PasteCommand}" /><Button x:Name="ParseButton" Content="解析编号" Style="{StaticResource PrimaryButton}" Margin="7,0,0,0" Command="{Binding ParseTextCommand}" /><Button x:Name="ClearSelectionsButton" Content="清空选片" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding ClearSelectionsCommand}" /></WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource PanelBorder}" Visibility="{Binding IsWorkflowStepThree, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><TextBlock Text="匹配检查" Style="{StaticResource SectionTitleText}" /><TextBlock Text="点击“开始匹配”后检查状态。‘查看明细’已移到状态旁边，无需横向滚动。" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border>
                                <Border Style="{StaticResource PanelBorder}" Visibility="{Binding IsWorkflowStepFour, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <StackPanel><TextBlock Text="输出设置" Style="{StaticResource SectionTitleText}" /><TextBlock Text="项目名称" Style="{StaticResource CaptionText}" Margin="0,9,0,4" /><TextBox x:Name="ProjectNameInput" AutomationProperties.Name="项目名称" Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}" /><TextBlock Text="输出到" Style="{StaticResource CaptionText}" Margin="0,9,0,4" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding OutputBaseDirectory, UpdateSourceTrigger=PropertyChanged}" /><Button x:Name="BrowseOutputButton" Grid.Column="1" Content="选择" Style="{StaticResource SecondaryButton}" Margin="7,0,0,0" Command="{Binding BrowseOutputCommand}" /></Grid><TextBlock Text="{Binding OutputFolderName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding OutputFolderName}" Foreground="{DynamicResource AccentBrush}" Margin="0,6,0,0" /><ComboBox x:Name="OutputModeSelector" ItemsSource="{Binding OutputModes}" DisplayMemberPath="Label" SelectedValuePath="Value" SelectedValue="{Binding OutputMode}" Margin="0,9,0,0" /><Separator Margin="0,14,0,10" /><TextBlock Text="导出报告" Style="{StaticResource SectionTitleText}" /><CheckBox Content="复制完成后自动导出报告" IsChecked="{Binding ExportReportsForCurrentProject}" Margin="0,9,0,0" /><StackPanel Margin="22,8,0,0" IsEnabled="{Binding ExportReportsForCurrentProject}"><CheckBox Content="CSV 报告" IsChecked="{Binding ExportCsvForCurrentProject}" /><CheckBox Content="JSON 报告（专业版）" IsChecked="{Binding ExportJsonForCurrentProject}" IsEnabled="{Binding CanExportAdvancedReports}" Margin="0,6,0,0" /><CheckBox Content="操作日志 TXT（专业版）" IsChecked="{Binding ExportLogForCurrentProject}" IsEnabled="{Binding CanExportAdvancedReports}" Margin="0,6,0,0" /></StackPanel><TextBlock Text="{Binding ReportSelectionSummary}" Style="{StaticResource CaptionText}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <UniformGrid Rows="1" Columns="6">
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="选片记录" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TotalCount}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="目标文件" Style="{StaticResource CaptionText}" /><TextBlock Text="{Binding TargetFileCount}" FontSize="22" FontWeight="SemiBold" /></StackPanel></Border>
                                <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="JPG / RAW" Style="{StaticResource CaptionText}" /><TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource SuccessBrush}"><Run Text="{Binding JpegMatchedCount, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding RawMatchedCount, Mode=OneWay}" /></TextBlock></StackPanel></Border>
