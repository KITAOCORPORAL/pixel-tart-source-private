<Project>
  <Import Project="build\Version.props" />
  <PropertyGroup>
    <Version>$(PixelTartVersion)</Version>
    <AssemblyVersion>$(PixelTartAssemblyVersion)</AssemblyVersion>
    <FileVersion>$(PixelTartAssemblyVersion)</FileVersion>
    <Company>光镜</Company>
    <Product>光镜</Product>
    <AssemblyTitle>光镜</AssemblyTitle>
    <Copyright>Copyright © 2026 光镜</Copyright>
    <Deterministic>true</Deterministic>
    <DebugType Condition="'$(Configuration)' == 'Release'">None</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
  </PropertyGroup>
</Project>
